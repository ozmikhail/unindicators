plot(adxValue, "ADX", display=display.data_window)
plot(stochKVal, "Stoch %K", display=display.data_window)
plot(macdLine, "MACD Line", display=display.data_window)
plot(macdHist, "MACD Histogram", display=display.data_window)
plot(cmfValue, "CMF", display=display.data_window)
plot(atr, "ATR", display=display.data_window)
plot(bbPercent, "BB %", display=display.data_window)
plot(hvRank, "HV Percentile", display=display.data_window)
plot(pressureRatio, "Buy/Sell Pressure", display=display.data_window)

