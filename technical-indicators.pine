//@version=6
indicator("Technical Indicators", overlay=true, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_polylines_count=100, explicit_plot_zorder=true)

// ==================================================================================
// INPUT PARAMETERS
// ==================================================================================

// === Display Indicators Settings ===
var gDisplayIndicators = "Display Indicators"
useDashboard = input.bool(true, "Show Dashboard", group=gDisplayIndicators)
useHullMA = input.bool(false, "Show Hull MA", group=gDisplayIndicators)
useVWAPLine = input.bool(false, "Show VWAP Line", group=gDisplayIndicators)
useBackground = input.bool(false, "Show Trend Background", group=gDisplayIndicators)
useMTFHeatmap = input.bool(true, "Show MTF Trend Heatmap", group=gDisplayIndicators)
useBB = input.bool(true, "Show Bollinger Bands", group=gDisplayIndicators)
usePatternMarkers = input.bool(false, "Show Candlestick Pattern Markers", group=gDisplayIndicators)
useKeltner = input.bool(true, "Show Keltner Channels", group=gDisplayIndicators)
useDonchian = input.bool(true, "Show Donchian Channel", group=gDisplayIndicators)
useMcGinley = input.bool(true, "Show McGinley Dynamic", group=gDisplayIndicators)
useAlligator = input.bool(true, "Show Alligator", group=gDisplayIndicators)
usePivots = input.bool(true, "Show Pivot Points", group=gDisplayIndicators)
useFibLevels = input.bool(false, "Show Fib Levels", group=gDisplayIndicators)
useGMMA = input.bool(true, "Show GMMA", group=gDisplayIndicators)
useSuperTrend = input.bool(true, "Show SuperTrend", group=gDisplayIndicators)
useSAR = input.bool(true, "Show Parabolic SAR", group=gDisplayIndicators)
useIchimoku = input.bool(true, "Show Ichimoku Cloud", group=gDisplayIndicators)
useAroon = input.bool(true, "Enable Aroon", group=gDisplayIndicators)
useLinReg = input.bool(true, "Enable Linear Regression", group=gDisplayIndicators)
useTTMSqueeze = input.bool(true, "Enable TTM Squeeze", group=gDisplayIndicators)
useHVRank = input.bool(true, "Enable HV Percentile Rank", group=gDisplayIndicators)
useChandelier = input.bool(true, "Enable Chandelier Exit", group=gDisplayIndicators)
useVWAP = input.bool(true, "Enable VWAP", group=gDisplayIndicators)
useCMF = input.bool(true, "Enable CMF", group=gDisplayIndicators)
useMFI = input.bool(true, "Enable MFI", group=gDisplayIndicators, tooltip="Money Flow Index (volume-weighted RSI). Distinct from Market Facilitation Index (Bill Williams).")
useADLine = input.bool(true, "Enable A/D Line", group=gDisplayIndicators)
usePVT = input.bool(true, "Enable PVT", group=gDisplayIndicators)
useCCI = input.bool(true, "Enable CCI", group=gDisplayIndicators)
useWilliamsR = input.bool(true, "Enable Williams %R", group=gDisplayIndicators)
useCMO = input.bool(true, "Enable CMO", group=gDisplayIndicators)
useFisher = input.bool(true, "Enable Fisher Transform", group=gDisplayIndicators)
useEFI = input.bool(true, "Enable EFI", group=gDisplayIndicators)
useOrderBlocks = input.bool(true, "Enable Order Blocks", group=gDisplayIndicators)
useCorrelation = input.bool(false, "Enable Correlation Filter", group=gDisplayIndicators, tooltip="Requires benchmark symbol. Uses request.security().")
useRelStrength = input.bool(false, "Enable Relative Strength", group=gDisplayIndicators)
useEngulfing = input.bool(true, "Enable Engulfing Pattern", group=gDisplayIndicators)
usePinBar = input.bool(true, "Enable Pin Bar / Hammer", group=gDisplayIndicators)
useMorningStar = input.bool(true, "Enable Morning/Evening Star", group=gDisplayIndicators)
useDoji = input.bool(true, "Enable Doji", group=gDisplayIndicators)
useHarami = input.bool(true, "Enable Harami", group=gDisplayIndicators)
useThreeSoldiers = input.bool(true, "Enable Three White Soldiers / Black Crows", group=gDisplayIndicators)
useTweezer = input.bool(true, "Enable Tweezer Tops/Bottoms", group=gDisplayIndicators)
usePiercingLine = input.bool(true, "Enable Piercing Line / Dark Cloud Cover", group=gDisplayIndicators)
useZScore = input.bool(true, "Enable Z-Score Filter", group=gDisplayIndicators)
useRSquared = input.bool(true, "Enable R-Squared", group=gDisplayIndicators)
useATRAccel = input.bool(true, "Enable ATR Acceleration", group=gDisplayIndicators)
useBuySellPressure = input.bool(true, "Enable Buy/Sell Pressure", group=gDisplayIndicators)
useEhlersSine = input.bool(true, "Enable Ehlers Sine Wave", group=gDisplayIndicators)
useWyckoff = input.bool(true, "Enable Wyckoff Detection", group=gDisplayIndicators)
useVWMA = input.bool(true, "Enable VWMA Confirmation", group=gDisplayIndicators)
useDisplacement = input.bool(true, "Enable Displacement Detection", group=gDisplayIndicators)
useDEMA = input.bool(true, "Enable DEMA", group=gDisplayIndicators)
useTEMA = input.bool(true, "Enable TEMA", group=gDisplayIndicators)
useGator = input.bool(true, "Enable Gator Oscillator", group=gDisplayIndicators)
useTRIX = input.bool(true, "Enable TRIX", group=gDisplayIndicators)
useUO = input.bool(true, "Enable Oscillator", group=gDisplayIndicators)
useKST = input.bool(true, "Enable KST", group=gDisplayIndicators)
useDPO = input.bool(true, "Enable DPO", group=gDisplayIndicators)
useRVI = input.bool(true, "Enable RVI", group=gDisplayIndicators)
useSchaff = input.bool(true, "Enable Schaff Trend Cycle", group=gDisplayIndicators)
usePGO = input.bool(true, "Enable PGO", group=gDisplayIndicators)
useCoppock = input.bool(true, "Enable Coppock", group=gDisplayIndicators)
useMassIndex = input.bool(true, "Enable Mass Index", group=gDisplayIndicators)
useKlinger = input.bool(true, "Enable Klinger", group=gDisplayIndicators)
useEOM = input.bool(true, "Enable EOM", group=gDisplayIndicators)
useNVI = input.bool(true, "Enable NVI", group=gDisplayIndicators)
usePVI = input.bool(true, "Enable PVI", group=gDisplayIndicators)
useIII = input.bool(true, "Enable III", group=gDisplayIndicators)
useMFI_BW = input.bool(true, "Enable MFI Bill Williams", group=gDisplayIndicators)
useFib = input.bool(true, "Enable Auto Fib", group=gDisplayIndicators)
useSR = input.bool(true, "Enable S/R Levels", group=gDisplayIndicators)
useGap = input.bool(true, "Enable Gap Detection", group=gDisplayIndicators)
useVortex = input.bool(true, "Enable Vortex", group=gDisplayIndicators)
useElderImpulse = input.bool(true, "Enable Elder Impulse", group=gDisplayIndicators)
useVWRSI = input.bool(true, "Enable VW-RSI", group=gDisplayIndicators)
useTwiggs = input.bool(true, "Enable Twiggs MF", group=gDisplayIndicators)

// === Buy/Sell Signal ===
var gBuySell = "Buy/Sell Signal"
useBuySellSignal = input.bool(true, "Enable Buy/Sell Signal", group=gBuySell, tooltip="Toggle for the Buy/Sell signal system. Uses all indicators with weighted category scoring.")
buySellThreshold = input.float(55, "Signal Threshold (0-100)", minval=30, maxval=95, step=5, group=gBuySell, tooltip="Minimum composite score to generate a signal. Higher = fewer but more confident signals.")
buySellCooldown = input.int(5, "Signal Cooldown (bars)", minval=1, maxval=50, group=gBuySell, tooltip="Minimum bars between signals to prevent spam.")
useBuySellSLTP = input.bool(true, "Show SL/TP Levels", group=gBuySell)
slTpDisplayMode = input.string("Lines", "SL/TP Display", options=["Lines", "Zones"], group=gBuySell, tooltip="Lines: Entry, SL and TP as lines only. Zones: Colored background ranges between the levels.")
buySellRR = input.float(2.0, "Risk:Reward Ratio", minval=1.0, maxval=5.0, step=0.5, group=gBuySell, tooltip="Target R:R ratio for TP calculation. SL is ATR-based + structure.")
buySellConfidenceFilter = input.string("All", "Min Confidence Level", options=["All", "Medium+", "High Only"], group=gBuySell, tooltip="All: use score >= threshold. Medium+: score >= 65. High Only: score >= 80.")
usePrevSignals = input.bool(true, "Show Previous Signals", group=gBuySell, tooltip="Show grayed-out previous signal zones and levels. Disable for a cleaner chart.")
useSignalZone = input.bool(true, "Show signal zone", group=gBuySell, tooltip="Show the BUY/SELL score box on the signal candle.")
prevSignalTransparency = input.int(80, "Previous Signal Transparency (%)", minval=50, maxval=98, step=5, group=gBuySell, tooltip="How transparent previous signals appear. Higher = more faded.")

// === Theme ===
var gTheme = "Theme & Colors"
bullPrimary   = input.color(color.rgb(0, 200, 83),   "Bull Primary",    group=gTheme)
bearPrimary   = input.color(color.rgb(234, 57, 67),   "Bear Primary",    group=gTheme)
bullSecondary = input.color(color.rgb(38, 166, 91),   "Bull Secondary",  group=gTheme)
bearSecondary = input.color(color.rgb(178, 50, 58),   "Bear Secondary",  group=gTheme)
neutralColor  = input.color(color.rgb(120, 123, 134), "Neutral",         group=gTheme)
warningColor  = input.color(color.rgb(255, 177, 66),  "Warning/Caution", group=gTheme)
structureClr  = input.color(color.rgb(156, 107, 255), "Structure/Fib",   group=gTheme)
volumeClr     = input.color(color.rgb(66, 165, 245),  "Volume/BB",       group=gTheme)
entryClr      = input.color(color.rgb(100, 181, 246), "Entry Line",      group=gTheme)
bbClr       = volumeClr                         // Blue — Bollinger stays blue
kcClr       = color.rgb(255, 167, 38)           // Amber — Keltner
donchClr    = color.rgb(77, 208, 225)           // Cyan — Donchian
emaFastClr  = color.rgb(255, 183, 77)           // Light amber — EMA 9
emaMidClr   = color.rgb(255, 138, 50)           // Deeper amber — EMA 21
emaSlowClr  = color.rgb(215, 100, 30)           // Dark amber — EMA 50
alligJawClr   = color.rgb(66, 165, 245)         // Blue (matches volumeClr)
alligTeethClr = color.rgb(234, 57, 67)          // Red (matches bearPrimary)
alligLipsClr  = color.rgb(0, 200, 83)           // Green (matches bullPrimary)

// === Trend Filter Settings ===
var gTrendFilter = "Trend Filter"
hullLength = input.int(20, "Hull MA Length", minval=1, group=gTrendFilter)
useHTF = input.bool(true, "Use Higher Timeframe Filter", group=gTrendFilter)
htfTimeframe = input.timeframe("D", "Higher Timeframe", group=gTrendFilter)
htfEmaLength = input.int(50, "HTF EMA Length", group=gTrendFilter)
adxLength = input.int(14, "ADX Length", group=gTrendFilter)
adxThreshold = input.float(25, "ADX Threshold", minval=0, group=gTrendFilter)

// === Momentum Settings ===
var gMomentum = "Momentum"
rsiLength = input.int(14, "RSI Length", minval=1, group=gMomentum)
rsiOverbought = input.float(70, "RSI Overbought", minval=50, maxval=100, group=gMomentum)
rsiOversold = input.float(30, "RSI Oversold", minval=0, maxval=50, group=gMomentum)
macdFast = input.int(12, "MACD Fast", minval=1, group=gMomentum)
macdSlow = input.int(26, "MACD Slow", minval=1, group=gMomentum)
macdSignal = input.int(9, "MACD Signal", minval=1, group=gMomentum)
useRSIRegime = input.bool(false, "Use Trend-Adjusted RSI Levels", group=gMomentum, tooltip="Bull regime: oversold 40, overbought 80. Bear regime: 20/60.")
rsiBullOversold = input.float(40, "RSI Bull Oversold", minval=20, maxval=50, group=gMomentum)
rsiBullOverbought = input.float(80, "RSI Bull Overbought", minval=50, maxval=100, group=gMomentum)
rsiBearOversold = input.float(20, "RSI Bear Oversold", minval=0, maxval=40, group=gMomentum)
rsiBearOverbought = input.float(60, "RSI Bear Overbought", minval=40, maxval=80, group=gMomentum)

// === Volatility Settings ===
var gVolatility = "Volatility"
atrLength = input.int(14, "ATR Length", minval=1, group=gVolatility)
atrMultiplierSL = input.float(2.0, "ATR Stop Loss Multiplier", minval=0.5, step=0.1, group=gVolatility)
atrMultiplierTP = input.float(3.0, "ATR Take Profit Multiplier", minval=0.5, step=0.1, group=gVolatility)
bbLength = input.int(20, "Bollinger Bands Length", minval=1, group=gVolatility)
bbMultiplier = input.float(2.0, "Bollinger Bands StdDev", minval=0.5, step=0.1, group=gVolatility)
squeezeLength = input.int(20, "BB Squeeze Length", minval=1, group=gVolatility)
useBBNotExtremes = input.bool(true, "BB: Not at Band Extremes", group=gVolatility)
useNoSqueeze = input.bool(false, "Avoid BB Squeeze", group=gVolatility)
useATRExpanding = input.bool(false, "Require ATR Expanding", group=gVolatility)

// === Volume Settings ===
var gVolume = "Volume"
volumeLength = input.int(20, "Volume MA Length", minval=1, group=gVolume)
volumeMultiplier = input.float(1.0, "Volume Multiplier", minval=0.1, step=0.1, group=gVolume)
useVolumeTrend = input.bool(true, "Volume Trend Up", group=gVolume)
volumeTrendBars = input.int(3, "Volume Trend Bars", minval=2, group=gVolume)
useOBV = input.bool(true, "Use OBV Alignment", group=gVolume)
obvLength = input.int(5, "OBV MA Length", minval=1, group=gVolume)

// === Signal Settings ===
var gSignalQuality = "Signal Quality"
minSignalScore = input.float(70, "Minimum Signal Score (0-100)", minval=0, maxval=100, group=gSignalQuality)
useDivergence = input.bool(true, "Enable Divergence Detection", group=gSignalQuality)
divergenceLookback = input.int(5, "Divergence Lookback", minval=2, group=gSignalQuality)

// === Structure ===
var gStructure = "Structure"
useStructure = input.bool(true, "Use Structure Filter", group=gStructure)
swingLookback = input.int(5, "Swing Lookback", minval=2, group=gStructure)
useBreakout = input.bool(true, "Require Breakout", group=gStructure)
swingDisplacementATR = input.float(1.0, "Swing Displacement (ATR mult)", minval=0, step=0.1, group=gStructure)
swingMinBars = input.int(5, "Min Bars Left/Right of Pivot", minval=2, group=gStructure)
useBOSBody = input.bool(true, "BOS: Require Close Beyond Swing", group=gStructure)
useCHoCHFilter = input.bool(true, "Disable Trend Entries on CHoCH", group=gStructure)

// === MA Alignment ===
var gMAAlignment = "MA Alignment"
useMAStack = input.bool(true, "Use MA Stack Filter", group=gMAAlignment)
maFastLen = input.int(9, "Fast MA Length", minval=1, group=gMAAlignment)
maSlowLen = input.int(21, "Slow MA Length", minval=1, group=gMAAlignment)
maSlowerLen = input.int(50, "Slower MA Length", minval=1, group=gMAAlignment)

// === Extra Momentum ===
var gExtraMomentum = "Extra Momentum"
useStoch = input.bool(true, "Use Stochastic", group=gExtraMomentum)
stochK = input.int(14, "Stochastic %K", minval=1, group=gExtraMomentum)
stochD = input.int(3, "Stochastic %D", minval=1, group=gExtraMomentum)
stochOverbought = input.int(80, "Stochastic Overbought", minval=50, group=gExtraMomentum)
stochOversold = input.int(20, "Stochastic Oversold", maxval=50, group=gExtraMomentum)
useROC = input.bool(true, "Use ROC", group=gExtraMomentum)
rocLength = input.int(10, "ROC Length", minval=1, group=gExtraMomentum)
useMacdHist = input.bool(true, "Use MACD Histogram", group=gExtraMomentum)

// === Price Action ===
var gPriceAction = "Price Action"
useCandleFilter = input.bool(true, "Candle Direction Filter", group=gPriceAction)

// === Session ===
var gSession = "Session"
useSessionFilter = input.bool(false, "Use Session Filter", group=gSession)
sessionInput = input.string("0800-1700", "Session (HHMM-HHMM)", group=gSession)

// === HTF Momentum ===
var gHTFMomentum = "HTF Momentum"
useHTFRSI = input.bool(true, "Use HTF RSI Filter", group=gHTFMomentum)
htfRsiLength = input.int(14, "HTF RSI Length", minval=1, group=gHTFMomentum)
htfRsiNotOverbought = input.float(70, "HTF RSI Max (buy when below)", minval=50, group=gHTFMomentum)
htfRsiNotOversold = input.float(30, "HTF RSI Min (sell when above)", maxval=50, group=gHTFMomentum)

// === Risk Filter ===
var gRiskFilter = "Risk Filter"
useATRFilter = input.bool(false, "Use ATR Range Filter", group=gRiskFilter)
atrMinPct = input.float(0, "ATR Min (% of avg, 0=off)", minval=0, step=0.1, group=gRiskFilter)
atrMaxPct = input.float(0, "ATR Max (% of avg, 0=off)", minval=0, step=0.1, group=gRiskFilter)

// === Premium/Discount ===
var gPD = "Premium / Discount"
usePremiumDiscount = input.bool(false, "Filter by Premium/Discount", group=gPD)
pdLookback = input.int(50, "Range Lookback Bars", minval=10, group=gPD)

// === FVG ===
var gFVG = "Fair Value Gaps"
useFVG = input.bool(false, "Show Fair Value Gaps", group=gFVG)
fvgMinBodyPct = input.float(0.5, "Min Candle Body % of Range", minval=0.1, step=0.1, group=gFVG)

// === SuperTrend ===
var gST = "SuperTrend"
stFactor = input.float(3.0, "SuperTrend Factor", minval=1.0, step=0.1, group=gST)
stAtrLen = input.int(10, "SuperTrend ATR Length", minval=1, group=gST)

// === Parabolic SAR ===
var gSAR = "Parabolic SAR"
sarStart = input.float(0.02, "SAR Start", minval=0.001, step=0.001, group=gSAR)
sarIncrement = input.float(0.02, "SAR Increment", minval=0.001, step=0.001, group=gSAR)
sarMax = input.float(0.2, "SAR Max", minval=0.01, step=0.01, group=gSAR)

// === Ichimoku Cloud ===
var gICH = "Ichimoku Cloud"
ichConversion = input.int(9, "Conversion Line Period", minval=1, group=gICH)
ichBase = input.int(26, "Base Line Period", minval=1, group=gICH)
ichSpan = input.int(52, "Leading Span B Period", minval=1, group=gICH)

// === Aroon ===
var gAroon = "Aroon"
aroonLength = input.int(25, "Aroon Length", minval=1, group=gAroon)

// === Linear Regression ===
var gLR = "Linear Regression"
linRegLength = input.int(20, "LinReg Length", minval=5, group=gLR)

// === Keltner / TTM Squeeze ===
var gKC = "Keltner / TTM Squeeze"
kcLength = input.int(20, "KC Length", minval=1, group=gKC)
kcMult = input.float(1.5, "KC ATR Multiplier", minval=0.5, step=0.1, group=gKC)

// === Historical Volatility ===
var gHV = "Historical Volatility"
hvLength = input.int(20, "HV Calculation Length", minval=5, group=gHV)
hvRankLength = input.int(252, "HV Rank Lookback", minval=50, group=gHV)

// === Chandelier Exit ===
var gCE = "Chandelier Exit"
chandLength = input.int(22, "Chandelier Length", minval=1, group=gCE)
chandMult = input.float(3.0, "Chandelier ATR Mult", minval=1.0, step=0.1, group=gCE)

// === Chaikin Money Flow ===
var gCMF = "Chaikin Money Flow"
cmfLength = input.int(20, "CMF Length", minval=1, group=gCMF)

// === Money Flow Index ===
var gMFI = "Money Flow Index"
mfiLength = input.int(14, "MFI Length", minval=1, group=gMFI)

// === A/D Line ===
var gAD = "Accumulation/Distribution"
adLineMALen = input.int(20, "A/D MA Length", minval=1, group=gAD)

// === PVT ===
var gPVT = "Price Volume Trend"
pvtMALen = input.int(20, "PVT MA Length", minval=1, group=gPVT)

// === CCI ===
var gCCI = "CCI"
cciLength = input.int(20, "CCI Length", minval=1, group=gCCI)

// === Williams %R ===
var gWR = "Williams %R"
wrLength = input.int(14, "Williams %R Length", minval=1, group=gWR)

// === CMO ===
var gCMO = "Chande Momentum"
cmoLength = input.int(14, "CMO Length", minval=1, group=gCMO)

// === Fisher Transform ===
var gFisher = "Fisher Transform"
fisherLength = input.int(10, "Fisher Length", minval=2, group=gFisher)

// === Elder Force Index ===
var gEFI = "Elder Force Index"
efiLength = input.int(13, "EFI EMA Length", minval=1, group=gEFI)

// === Order Blocks ===
var gOB = "Order Blocks"
obDisplacementMult = input.float(1.5, "OB Displacement ATR Mult", minval=0.5, step=0.1, group=gOB)

// === Intermarket ===
var gIM = "Intermarket"
benchmarkSymbol = input.symbol("SPY", "Benchmark Symbol", group=gIM)
corrLength = input.int(20, "Correlation Length", minval=5, group=gIM)

// === Candlestick Patterns ===
var gPat = "Candlestick Patterns"
pinBarWickRatio = input.float(2.0, "Pin Bar Min Wick/Body Ratio", minval=1.5, step=0.1, group=gPat)
dojiBodyPct = input.float(0.1, "Doji Max Body % of Range", minval=0.05, maxval=0.5, step=0.05, group=gPat)
tweezerTolerance = input.float(0.1, "Tweezer High/Low Tolerance (ATR mult)", minval=0.02, step=0.05, group=gPat)

// === Statistical ===
var gStats = "Statistical"
zScoreLength = input.int(20, "Z-Score Length", minval=5, group=gStats)

// === Sentiment Proxies ===
var gSent = "Sentiment Proxies"
pressureLength = input.int(14, "Pressure Length", minval=5, group=gSent)

// === Cycle Analysis ===
var gCycle = "Cycle Analysis"

// === Wyckoff ===
var gWyck = "Wyckoff"
wyckoffLookback = input.int(50, "Wyckoff Range Lookback", minval=20, group=gWyck)

// === VWMA ===
var gVWMA = "VWMA"
vwmaLength = input.int(20, "VWMA Length", minval=1, group=gVWMA)

// === Displacement Detection ===
var gDisp = "Displacement"
dispBodyMult = input.float(1.5, "Displacement Body Mult", minval=1.0, step=0.1, group=gDisp)

// === Donchian Channel ===
var gDonch = "Donchian Channel"
donchianLength = input.int(20, "Donchian Length", minval=1, group=gDonch)

// === McGinley Dynamic ===
var gMcGinley = "McGinley Dynamic"
mcginleyLength = input.int(14, "McGinley Length", minval=1, group=gMcGinley)

// === DEMA / TEMA ===
var gDEMA = "DEMA / TEMA"
demaLength = input.int(14, "DEMA Length", minval=1, group=gDEMA)
temaLength = input.int(14, "TEMA Length", minval=1, group=gDEMA)

// === GMMA ===
var gGMMA = "GMMA"
gmmaShort = input.string("3,5,8,10,12,15", "Short EMA Periods", group=gGMMA)
gmmaLong = input.string("30,35,40,45,50,60", "Long EMA Periods", group=gGMMA)

// === Williams Alligator ===
var gAlligator = "Williams Alligator"
alligatorJaw = input.int(13, "Jaw Period", minval=1, group=gAlligator)
alligatorTeeth = input.int(8, "Teeth Period", minval=1, group=gAlligator)
alligatorLips = input.int(5, "Lips Period", minval=1, group=gAlligator)

// === TRIX ===
var gTRIX = "TRIX"
trixLength = input.int(14, "TRIX Length", minval=1, group=gTRIX)
trixSignalLen = input.int(9, "TRIX Signal Length", minval=1, group=gTRIX)

// === Oscillator ===
var gUO = "Oscillator"
uoPeriod1 = input.int(7, "UO Period 1", minval=1, group=gUO)
uoPeriod2 = input.int(14, "UO Period 2", minval=1, group=gUO)
uoPeriod3 = input.int(28, "UO Period 3", minval=1, group=gUO)

// === Know Sure Thing ===
var gKST = "Know Sure Thing"
kstRoc1 = input.int(10, "KST ROC 1", minval=1, group=gKST)
kstRoc2 = input.int(15, "KST ROC 2", minval=1, group=gKST)
kstRoc3 = input.int(20, "KST ROC 3", minval=1, group=gKST)
kstRoc4 = input.int(30, "KST ROC 4", minval=1, group=gKST)
kstSmaLen = input.int(10, "KST Signal SMA", minval=1, group=gKST)

// === DPO ===
var gDPO = "Detrended Price Oscillator"
dpoLength = input.int(20, "DPO Length", minval=5, group=gDPO)

// === RVI ===
var gRVI = "Relative Vigor Index"
rviLength = input.int(14, "RVI Length", minval=1, group=gRVI)

// === Schaff Trend Cycle ===
var gSchaff = "Schaff Trend Cycle"
schaffCycle = input.int(10, "Schaff Cycle", minval=1, group=gSchaff)
schaffSmooth1 = input.int(23, "Schaff Smooth 1", minval=1, group=gSchaff)
schaffSmooth2 = input.int(50, "Schaff Smooth 2", minval=1, group=gSchaff)

// === Pretty Good Oscillator ===
var gPGO = "Pretty Good Oscillator"
pgoLength = input.int(14, "PGO Length", minval=1, group=gPGO)

// === Coppock Curve ===
var gCoppock = "Coppock Curve"
coppockRoc1 = input.int(11, "Coppock ROC 1", minval=1, group=gCoppock)
coppockRoc2 = input.int(14, "Coppock ROC 2", minval=1, group=gCoppock)
coppockSma = input.int(10, "Coppock SMA", minval=1, group=gCoppock)

// === Mass Index ===
var gMass = "Mass Index"
massSingle = input.int(9, "Mass Single EMA", minval=1, group=gMass)
massSum = input.int(25, "Mass Sum Period", minval=1, group=gMass)
massThreshold = input.float(27, "Mass Bulge Threshold", minval=20, step=0.5, group=gMass)

// === Klinger Volume ===
var gKlinger = "Klinger Volume"
kvoFast = input.int(34, "KVO Fast", minval=1, group=gKlinger)
kvoSlow = input.int(55, "KVO Slow", minval=1, group=gKlinger)
kvoSignal = input.int(13, "KVO Signal", minval=1, group=gKlinger)

// === Ease of Movement ===
var gEOM = "Ease of Movement"
eomLength = input.int(14, "EOM Length", minval=1, group=gEOM)

// === NVI / PVI ===
var gNVI = "NVI / PVI"
nviPviMALen = input.int(255, "NVI/PVI MA Length", minval=20, group=gNVI)

// === Intraday Intensity ===
var gIII = "Intraday Intensity"
iiiLength = input.int(14, "III Smooth Length", minval=1, group=gIII)

// === Market Facilitation Index (Bill Williams) ===
var gMFI_BW = "Market Facilitation (Bill Williams)"

// === Pivot Points ===
var gPivot = "Pivot Points"
pivotTimeframe = input.timeframe("D", "Pivot Timeframe", group=gPivot)

// === Fibonacci ===
var gFib = "Fibonacci Retracement"
fibLookback = input.int(20, "Fib Swing Lookback", minval=5, group=gFib)

// === Support/Resistance ===
var gSR = "Support/Resistance"
srPivotCount = input.int(3, "S/R Pivot Count", minval=2, group=gSR)

// === Gap Detection ===
var gGap = "Gap Detection"
gapMinATR = input.float(0, "Gap Min ATR (0=any)", minval=0, step=0.1, group=gGap)

// === Vortex ===
var gVortex = "Vortex Indicator"
vortexLength = input.int(14, "Vortex Length", minval=1, group=gVortex)

// === Elder Impulse ===
var gElder = "Elder Impulse"
elderEmaLen = input.int(13, "Elder EMA Length", minval=1, group=gElder)

// === VW-RSI ===
var gVWRSI = "Volume-Weighted RSI"
vwRsiLength = input.int(14, "VW-RSI Length", minval=1, group=gVWRSI)

// === Twiggs Money Flow ===
var gTwiggs = "Twiggs Money Flow"
twiggsLength = input.int(21, "Twiggs Length", minval=1, group=gTwiggs)

// ==================================================================================
// FUNCTIONS
// ==================================================================================

f_hma(src, length) =>
    wma1 = ta.wma(src, length / 2)
    wma2 = ta.wma(src, length)
    ta.wma(2 * wma1 - wma2, math.round(math.sqrt(length)))

f_adx(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trur = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / trur)
    minus = fixnan(100 * ta.rma(minusDM, len) / trur)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), len)
    [adx, plus, minus]

f_divergence(src, oscType) =>
    osc = float(na)
    if oscType == "RSI"
        osc := ta.rsi(src, rsiLength)
    else
        [macdL, _, _] = ta.macd(src, macdFast, macdSlow, macdSignal)
        osc := macdL
    pivotHigh = ta.pivothigh(src, divergenceLookback, divergenceLookback)
    pivotLow = ta.pivotlow(src, divergenceLookback, divergenceLookback)
    oscPivotHigh = ta.pivothigh(osc, divergenceLookback, divergenceLookback)
    oscPivotLow = ta.pivotlow(osc, divergenceLookback, divergenceLookback)
    bullDiv = not na(pivotLow) and not na(oscPivotLow) and pivotLow < pivotLow[divergenceLookback] and oscPivotLow > oscPivotLow[divergenceLookback]
    bearDiv = not na(pivotHigh) and not na(oscPivotHigh) and pivotHigh > pivotHigh[divergenceLookback] and oscPivotHigh < oscPivotHigh[divergenceLookback]
    bullHidden = not na(pivotLow) and not na(oscPivotLow) and pivotLow > pivotLow[divergenceLookback] and oscPivotLow < oscPivotLow[divergenceLookback]
    bearHidden = not na(pivotHigh) and not na(oscPivotHigh) and pivotHigh < pivotHigh[divergenceLookback] and oscPivotHigh > oscPivotHigh[divergenceLookback]
    [bullDiv, bearDiv, bullHidden, bearHidden]

f_fisherTransform(length) =>
    hl2Val = hl2
    maxH = ta.highest(hl2Val, length)
    minL = ta.lowest(hl2Val, length)
    rangeHL = maxH - minL
    var float val = 0.0
    var float fish = 0.0
    var float prevFish = 0.0
    rawVal = rangeHL > 0 ? 2.0 * ((hl2Val - minL) / rangeHL - 0.5) : 0.0
    val := 0.33 * rawVal + 0.67 * nz(val[1])
    val := math.max(-0.999, math.min(0.999, val))
    prevFish := nz(fish[1])
    fish := 0.5 * math.log((1 + val) / (1 - val)) + 0.5 * prevFish
    [fish, prevFish]

f_ehlersSineWave() =>
    var float smooth = 0.0
    var float detrender = 0.0
    var float i1 = 0.0
    var float q1 = 0.0
    var float ji = 0.0
    var float jq = 0.0
    var float i2 = 0.0
    var float q2 = 0.0
    var float re = 0.0
    var float im = 0.0
    var float period = 0.0
    var float smoothPeriod = 0.0
    var float dcPhase = 0.0
    var float sine = 0.0
    var float leadSine = 0.0
    price = (high + low) / 2.0
    smooth := (4 * price + 3 * nz(price[1]) + 2 * nz(price[2]) + nz(price[3])) / 10.0
    detrender := (0.0962 * smooth + 0.5769 * nz(smooth[2]) - 0.5769 * nz(smooth[4]) - 0.0962 * nz(smooth[6])) * (0.075 * nz(period[1]) + 0.54)
    q1 := (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * (0.075 * nz(period[1]) + 0.54)
    i1 := nz(detrender[3])
    ji := (0.0962 * i1 + 0.5769 * nz(i1[2]) - 0.5769 * nz(i1[4]) - 0.0962 * nz(i1[6])) * (0.075 * nz(period[1]) + 0.54)
    jq := (0.0962 * q1 + 0.5769 * nz(q1[2]) - 0.5769 * nz(q1[4]) - 0.0962 * nz(q1[6])) * (0.075 * nz(period[1]) + 0.54)
    i2 := i1 - jq
    q2 := q1 + ji
    i2 := 0.2 * i2 + 0.8 * nz(i2[1])
    q2 := 0.2 * q2 + 0.8 * nz(q2[1])
    re := i2 * nz(i2[1]) + q2 * nz(q2[1])
    im := i2 * nz(q2[1]) - q2 * nz(i2[1])
    re := 0.2 * re + 0.8 * nz(re[1])
    im := 0.2 * im + 0.8 * nz(im[1])
    tempPeriod = im != 0 and re != 0 ? 2 * math.acos(1) / math.atan(im / re) : nz(period[1])
    tempPeriod2 = math.max(math.min(tempPeriod, 1.5 * nz(period[1])), 0.67 * nz(period[1]))
    tempPeriod3 = math.max(math.min(tempPeriod2, 50.0), 6.0)
    period := 0.2 * tempPeriod3 + 0.8 * nz(period[1])
    smoothPeriod := 0.33 * period + 0.67 * nz(smoothPeriod[1])
    dcPeriod = math.round(smoothPeriod)
    realPart = 0.0
    imagPart = 0.0
    for i = 0 to math.max(dcPeriod - 1, 0)
        realPart += math.sin(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
        imagPart += math.cos(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
    dcPhase := imagPart != 0 ? math.atan(realPart / imagPart) * 180 / math.pi : 90.0 * (realPart > 0 ? 1 : -1)
    dcPhase += 90
    dcPhase += (360 / smoothPeriod > 0 ? 360 / smoothPeriod : 1)
    if imagPart < 0
        dcPhase += 180
    if dcPhase > 315
        dcPhase -= 360
    sine := math.sin(dcPhase * math.acos(1) / 180)
    leadSine := math.sin((dcPhase + 45) * math.acos(1) / 180)
    [sine, leadSine, smoothPeriod]

f_mcginley(src, length) =>
    var float mg = na
    mg := na(mg) ? src : mg[1] + (src - mg[1]) / math.max(length * math.pow(src / math.max(mg[1], 1e-10), 4), 1e-10)
    mg

f_trix(src, length, signalLen) =>
    e1 = ta.ema(src, length)
    e2 = ta.ema(e1, length)
    e3 = ta.ema(e2, length)
    trixVal = ta.roc(e3, 1)
    trixSignal = ta.sma(trixVal, signalLen)
    [trixVal, trixSignal]

f_oscillator(period1, period2, period3) =>
    bp = close - math.min(low, low[1])
    tr_uo = math.max(high, high[1]) - math.min(low, low[1])
    avgTrendFilter = ta.rma(bp, period1) / math.max(ta.rma(tr_uo, period1), 1e-10)
    avgMomentum = ta.rma(bp, period2) / math.max(ta.rma(tr_uo, period2), 1e-10)
    avgVolatility = ta.rma(bp, period3) / math.max(ta.rma(tr_uo, period3), 1e-10)
    uo = 100 * (4 * avgTrendFilter + 2 * avgMomentum + avgVolatility) / 7
    uo

f_dpo(src, length) =>
    halfLen = math.round(length / 2) + 1
    smaVal = ta.sma(src, halfLen)
    dpoVal = src[halfLen] - smaVal[halfLen]
    dpoVal

f_rvi(length) =>
    rviRaw = (close - open) / math.max(high - low, 1e-10)
    rviSmooth = ta.sma(rviRaw, length)
    rviSignal = ta.sma(rviSmooth, 4)
    [rviSmooth, rviSignal]

f_schaffTrendCycle(cycleLen, smooth1, smooth2) =>
    var float xmac = 0.0
    var float xmacd = 0.0
    var float stc = 0.0
    xmac := ta.ema(close - ta.ema(close, cycleLen), smooth1)
    xmacd := ta.ema(xmac, smooth2)
    v1 = ta.lowest(xmacd, smooth2) - ta.highest(xmacd, smooth2)
    v2 = v1 != 0 ? (xmacd - ta.lowest(xmacd, smooth2)) / v1 : 0.0
    stc := 0.0
    if not na(v2)
        var float stcPrev = 50.0
        stcPrev := 0.5 * (stcPrev + 100 * (v2 - 0.5))
        stc := math.max(0, math.min(100, stcPrev))
    [xmacd, stc]

f_smma(src, length) =>
    var float sum = na
    sum := na(sum) ? ta.sma(src, length) : (sum[1] * (length - 1) + src) / length
    sum

f_massIndex(singleLen, sumLen) =>
    hlRange = high - low
    hlEma = ta.ema(hlRange, singleLen)
    ratio = hlEma > 0 ? hlRange / hlEma : 0.0
    massSumVal = math.sum(ratio, sumLen)
    massSumVal

f_klinger(fastLen, slowLen, signalLen) =>
    trend = ta.ema(high - low, 5) > ta.ema(high - low, 34) ? 1 : -1
    dm = high - low
    cm = 0.0
    if trend == trend[1]
        cm := nz(cm[1]) + dm
    else
        cm := nz(cm[1]) + dm
    vf = volume * math.abs(2 * dm / math.max(cm, 1e-10) - 1) * trend * 100
    kvo = ta.ema(ta.sma(vf, math.min(fastLen, slowLen)), math.max(fastLen, slowLen) - math.min(fastLen, slowLen) + 1)
    kvoSigLine = ta.ema(kvo, signalLen)
    [kvo, kvoSigLine]

f_eom(length) =>
    dm = (high + low) / 2 - (high[1] + low[1]) / 2
    br = volume / math.max(high - low, 1e-10)
    eomRaw = br != 0 ? dm / br : 0.0
    eomSmooth = ta.sma(eomRaw * 1000000, length)
    eomSmooth

f_vortex(len) =>
    plusVM = math.abs(high - low[1])
    minusVM = math.abs(low - high[1])
    plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
    minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0
    trV = ta.atr(len)
    viPlus = trV != 0 ? ta.rma(plusVM, len) / trV : 0.0
    viMinus = trV != 0 ? ta.rma(minusVM, len) / trV : 0.0
    [viPlus, viMinus]

// ==================================================================================
// CALCULATIONS - EXISTING FACTORS
// ==================================================================================

// === Trend ===
hullMA = f_hma(close, hullLength)
hullTrend = hullMA > hullMA[1]

htfEma = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLength), lookahead=barmerge.lookahead_off)
htfEmaPrev = htfEma[1]
htfTrendUp = close[1] > htfEmaPrev

[adxValue, plusDI, minusDI] = f_adx(adxLength)
adxStrong = adxValue[1] > adxThreshold

trendUp = close[1] > hullMA[1] and hullMA[1] > hullMA[2]
trendDown = close[1] < hullMA[1] and hullMA[1] < hullMA[2]

// === Momentum ===
rsiValue = ta.rsi(close, rsiLength)
rsiPrev = rsiValue[1]
rsiRegimeBull = close[1] > hullMA[1]
rsiOS = useRSIRegime ? (rsiRegimeBull ? rsiBullOversold : rsiBearOversold) : rsiOversold
rsiOB = useRSIRegime ? (rsiRegimeBull ? rsiBullOverbought : rsiBearOverbought) : rsiOverbought
rsiOversoldCross = ta.crossover(rsiValue, rsiOS)
rsiOverboughtCross = ta.crossunder(rsiValue, rsiOB)
rsiBullish = rsiPrev > 50 or rsiOversoldCross[1]
rsiBearish = rsiPrev < 50 or rsiOverboughtCross[1]

[macdLine, macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdLinePrev = macdLine[1]
macdSignalPrev = macdSignalLine[1]
macdCrossUp = ta.crossover(macdLine, macdSignalLine)
macdCrossDown = ta.crossunder(macdLine, macdSignalLine)
macdBullish = macdLinePrev > macdSignalPrev or macdCrossUp[1]
macdBearish = macdLinePrev < macdSignalPrev or macdCrossDown[1]

// === Volatility ===
atr = ta.atr(atrLength)
atrPrev = atr[1]
bbBasis = ta.sma(close, bbLength)
bbDev = bbMultiplier * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbBullish = useBB ? close[1] > bbBasis[1] : true
bbBearish = useBB ? close[1] < bbBasis[1] : true
bbWidth = bbUpper - bbLower
bbWidthSma = ta.sma(bbWidth, squeezeLength)
bbSqueeze = bbWidth < bbWidthSma * 0.7
bbPercent = (close - bbLower) / (bbUpper - bbLower)
notAtExtremes = bbPercent > 0.2 and bbPercent < 0.8

// === Volume ===
volumeMA = ta.sma(volume, volumeLength)
volumeConfirm = volume[1] > volumeMA[1] * volumeMultiplier

// === Divergence ===
[rsiBullDiv, rsiBearDiv, rsiBullHidden, rsiBearHidden] = f_divergence(close, "RSI")
[macdBullDiv, macdBearDiv, macdBullHidden, macdBearHidden] = f_divergence(close, "MACD")
bullDivAny = rsiBullDiv or macdBullDiv
bearDivAny = rsiBearDiv or macdBearDiv
bullHiddenAny = rsiBullHidden or macdBullHidden
bearHiddenAny = rsiBearHidden or macdBearHidden
bullishDivergence = useDivergence and (bullDivAny or bullHiddenAny)
bearishDivergence = useDivergence and (bearDivAny or bearHiddenAny)

// === DI ===
plusDIPrev = plusDI[1]
minusDIPrev = minusDI[1]
diBullish = plusDIPrev > minusDIPrev
diBearish = minusDIPrev > plusDIPrev

// === Premium/Discount ===
rangeHigh = ta.highest(high, pdLookback)
rangeLow = ta.lowest(low, pdLookback)
equilibrium = (rangeHigh + rangeLow) / 2
inPremium = close[1] >= equilibrium
inDiscount = close[1] <= equilibrium
premiumDiscountOkBuy = not usePremiumDiscount or inDiscount
premiumDiscountOkSell = not usePremiumDiscount or inPremium

// === Structure ===
swingHigh = ta.pivothigh(high, swingLookback, swingLookback)
swingLow = ta.pivotlow(low, swingLookback, swingLookback)
lastSwingHigh = ta.valuewhen(not na(swingHigh), swingHigh, 0)
lastSwingLow = ta.valuewhen(not na(swingLow), swingLow, 0)
breakoutUp = useBreakout ? (na(lastSwingHigh) or close[1] > lastSwingHigh) : true
breakoutDown = useBreakout ? (na(lastSwingLow) or close[1] < lastSwingLow) : true
nearSupport = not na(lastSwingLow) and lastSwingLow > 0 and low[1] <= lastSwingLow * 1.002
nearResistance = not na(lastSwingHigh) and lastSwingHigh > 0 and high[1] >= lastSwingHigh * 0.998
structureBull = (not useStructure or (breakoutUp or nearSupport)) and premiumDiscountOkBuy
structureBear = (not useStructure or (breakoutDown or nearResistance)) and premiumDiscountOkSell

displacementThreshold = atr * swingDisplacementATR
validSwingHigh = not na(swingHigh)
validSwingLow = not na(swingLow)
lastValidSwingHigh = ta.valuewhen(validSwingHigh, swingHigh, 0)
lastValidSwingLow = ta.valuewhen(validSwingLow, swingLow, 0)

bosBull = useBOSBody ? (close[1] > lastSwingHigh and lastSwingHigh > 0) : (high[1] > lastSwingHigh and lastSwingHigh > 0)
bosBear = useBOSBody ? (close[1] < lastSwingLow and lastSwingLow > 0) : (low[1] < lastSwingLow and lastSwingLow > 0)
sfpBear = lastSwingHigh > 0 and high[1] > lastSwingHigh and close[1] <= lastSwingHigh
sfpBull = lastSwingLow > 0 and low[1] < lastSwingLow and close[1] >= lastSwingLow
chochBearish = trendUp and not na(lastSwingLow) and lastSwingLow > 0 and close[1] < lastSwingLow
chochBullish = trendDown and not na(lastSwingHigh) and lastSwingHigh > 0 and close[1] > lastSwingHigh
chochBlockBuy = useCHoCHFilter and chochBearish
chochBlockSell = useCHoCHFilter and chochBullish

// === MA Stack ===
emaFast = ta.ema(close, maFastLen)
emaSlow = ta.ema(close, maSlowLen)
emaSlower = ta.ema(close, maSlowerLen)
maStackUp = useMAStack ? (emaFast[1] > emaSlow[1] and emaSlow[1] > emaSlower[1]) : true
maStackDown = useMAStack ? (emaFast[1] < emaSlow[1] and emaSlow[1] < emaSlower[1]) : true

// === Volatility extended ===
bbNotExtremes = useBBNotExtremes ? notAtExtremes[1] : true
noSqueeze = useNoSqueeze ? not bbSqueeze[1] : true
atrMA = ta.sma(atr, atrLength)
atrExpanding = useATRExpanding ? atr[1] >= atrMA[1] : true

// === Volume extended ===
volumeRising = useVolumeTrend ? (volume[1] >= volume[2] and volume[2] >= volume[volumeTrendBars]) : true
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvMA = ta.sma(obv, obvLength)
obvBullish = useOBV ? obv[1] > obvMA[1] : true
obvBearish = useOBV ? obv[1] < obvMA[1] : true

// === Stochastic ===
stochKVal = ta.stoch(close, high, low, stochK)
stochDVal = ta.sma(stochKVal, stochD)
stochBullish = useStoch ? (stochKVal[1] > stochDVal[1] or stochKVal[1] < stochOversold) : true
stochBearish = useStoch ? (stochKVal[1] < stochDVal[1] or stochKVal[1] > stochOverbought) : true

// === ROC ===
roc = ta.roc(close, rocLength)
rocBullish = useROC ? roc[1] > 0 : true
rocBearish = useROC ? roc[1] < 0 : true

// === MACD Histogram ===
macdHistBullish = useMacdHist ? macdHist[1] > 0 : true
macdHistBearish = useMacdHist ? macdHist[1] < 0 : true

// === Candle direction ===
bullishCandle = useCandleFilter ? close[1] > open[1] : true
bearishCandle = useCandleFilter ? close[1] < open[1] : true

// === Session ===
inSession = useSessionFilter ? not na(time(timeframe.period, sessionInput)) : true

// === HTF RSI ===
htfRsi = request.security(syminfo.tickerid, htfTimeframe, ta.rsi(close, htfRsiLength), lookahead=barmerge.lookahead_off)
htfRsiPrev = htfRsi[1]
htfRsiOkBuy = useHTFRSI ? htfRsiPrev < htfRsiNotOverbought : true
htfRsiOkSell = useHTFRSI ? htfRsiPrev > htfRsiNotOversold : true

// === MTF Heatmap ===
mtfEmaLen = 20
mtf5  = request.security(syminfo.tickerid, "5",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
mtf15 = request.security(syminfo.tickerid, "15", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
mtf60 = request.security(syminfo.tickerid, "60", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
mtf240 = request.security(syminfo.tickerid, "240", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
mtfD  = request.security(syminfo.tickerid, "D",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)

// === ATR Range Filter ===
atrAvg = ta.sma(atr, atrLength * 2)
atrInRange = useATRFilter ? (atrMinPct <= 0 or atr[1] >= atrAvg[1] * (atrMinPct / 100.0)) and (atrMaxPct <= 0 or atr[1] <= atrAvg[1] * (1 + atrMaxPct / 100.0)) : true

// === FVG ===
bodyPctBull = (close[2] - open[2]) / (high[2] - low[2] + 1e-10)
bodyPctBear = (open[2] - close[2]) / (high[2] - low[2] + 1e-10)
bullFVG = low[2] > high[0] and bodyPctBull >= fvgMinBodyPct
bearFVG = high[2] < low[0] and bodyPctBear >= fvgMinBodyPct

// ==================================================================================
// CALCULATIONS - NEW FACTORS (36)
// ==================================================================================

// === 1. SuperTrend ===
[stValue, stDir] = ta.supertrend(stFactor, stAtrLen)
stBullish = useSuperTrend ? stDir[1] < 0 : true
stBearish = useSuperTrend ? stDir[1] > 0 : true

// === 2. Parabolic SAR ===
sarValue = ta.sar(sarStart, sarIncrement, sarMax)
sarBullish = useSAR ? close[1] > sarValue[1] : true
sarBearish = useSAR ? close[1] < sarValue[1] : true

// === 3. Ichimoku Cloud ===
ichConvLine = (ta.highest(high, ichConversion) + ta.lowest(low, ichConversion)) / 2
ichBaseLine = (ta.highest(high, ichBase) + ta.lowest(low, ichBase)) / 2
ichSpanA = (ichConvLine + ichBaseLine) / 2
ichSpanB = (ta.highest(high, ichSpan) + ta.lowest(low, ichSpan)) / 2
ichCloudTop = math.max(ichSpanA[ichBase], ichSpanB[ichBase])
ichCloudBot = math.min(ichSpanA[ichBase], ichSpanB[ichBase])
ichTKCross = ichConvLine > ichBaseLine
ichAboveCloud = close[1] > ichCloudTop[1]
ichBelowCloud = close[1] < ichCloudBot[1]
ichGreenCloud = ichSpanA > ichSpanB
ichBullish = useIchimoku ? (ichAboveCloud and ichTKCross[1]) : true
ichBearish = useIchimoku ? (ichBelowCloud and not ichTKCross[1]) : true

// === 4. Aroon ===
aroonUp = useAroon ? 100.0 * (aroonLength - ta.highestbars(high, aroonLength + 1)) / aroonLength : 50.0
aroonDown = useAroon ? 100.0 * (aroonLength - ta.lowestbars(low, aroonLength + 1)) / aroonLength : 50.0
aroonBullish = useAroon ? (aroonUp[1] > 70 and aroonDown[1] < 30) : true
aroonBearish = useAroon ? (aroonDown[1] > 70 and aroonUp[1] < 30) : true

// === 5. Linear Regression + R-Squared ===
linRegVal = ta.linreg(close, linRegLength, 0)
linRegSlope = linRegVal - ta.linreg(close, linRegLength, 1)
corrVal = ta.correlation(close, bar_index, linRegLength)
rSquared = corrVal * corrVal
linRegBullish = useLinReg ? (linRegSlope[1] > 0 and rSquared[1] > 0.3) : true
linRegBearish = useLinReg ? (linRegSlope[1] < 0 and rSquared[1] > 0.3) : true

// === 6. Keltner Channels + TTM Squeeze ===
kcBasis = ta.ema(close, kcLength)
kcRange = ta.atr(kcLength) * kcMult
kcUpper = kcBasis + kcRange
kcLower = kcBasis - kcRange
ttmSqueezeOn = useTTMSqueeze ? (bbUpper < kcUpper and bbLower > kcLower) : false
ttmSqueezeOff = useTTMSqueeze ? not ttmSqueezeOn : true
ttmMomentum = ta.linreg(close - (ta.highest(high, kcLength) + ta.lowest(low, kcLength)) / 2, kcLength, 0)
ttmFirBull = useTTMSqueeze ? (not ttmSqueezeOn and ttmSqueezeOn[1] and ttmMomentum > 0) : false
ttmFirBear = useTTMSqueeze ? (not ttmSqueezeOn and ttmSqueezeOn[1] and ttmMomentum < 0) : false
kcBullish = useKeltner ? (close[1] > kcBasis[1]) : true
kcBearish = useKeltner ? (close[1] < kcBasis[1]) : true

// === 7. Historical Volatility Percentile ===
hvol = ta.stdev(math.log(close / close[1]), hvLength) * math.sqrt(252)
hvRank = ta.percentrank(hvol, hvRankLength)
hvLow = useHVRank ? hvRank[1] < 25 : false
hvHigh = useHVRank ? hvRank[1] > 75 : false

// === 8. Chandelier Exit ===
chandLong = ta.highest(high, chandLength) - chandMult * ta.atr(chandLength)
chandShort = ta.lowest(low, chandLength) + chandMult * ta.atr(chandLength)
chandBullish = useChandelier ? close[1] > chandLong[1] : true
chandBearish = useChandelier ? close[1] < chandShort[1] : true

// === 9. VWAP ===
vwapValue = ta.vwap(close)
vwapBullish = useVWAP ? close[1] > vwapValue[1] : true
vwapBearish = useVWAP ? close[1] < vwapValue[1] : true

// === 10. Chaikin Money Flow ===
clv = ((close - low) - (high - close)) / math.max(high - low, 1e-10)
cmfValue = ta.sma(clv * volume, cmfLength) / math.max(ta.sma(volume, cmfLength), 1e-10)
cmfBullish = useCMF ? cmfValue[1] > 0 : true
cmfBearish = useCMF ? cmfValue[1] < 0 : true

// === 11. Money Flow Index ===
mfiValue = ta.mfi(hlc3, mfiLength)
mfiBullish = useMFI ? mfiValue[1] > 50 : true
mfiBearish = useMFI ? mfiValue[1] < 50 : true

// === 12. Accumulation/Distribution Line ===
adLine = ta.cum(((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume)
adLineMA = ta.sma(adLine, adLineMALen)
adLineBullish = useADLine ? adLine[1] > adLineMA[1] : true
adLineBearish = useADLine ? adLine[1] < adLineMA[1] : true

// === 13. Price Volume Trend ===
pvtVal = ta.cum(ta.change(close) / math.max(close[1], 1e-10) * volume)
pvtMA = ta.sma(pvtVal, pvtMALen)
pvtBullish = usePVT ? pvtVal[1] > pvtMA[1] : true
pvtBearish = usePVT ? pvtVal[1] < pvtMA[1] : true

// === 14. CCI ===
cciValue = ta.cci(close, cciLength)
cciBullish = useCCI ? cciValue[1] > 0 : true
cciBearish = useCCI ? cciValue[1] < 0 : true

// === 15. Williams %R ===
wrValue = -100 * (ta.highest(high, wrLength) - close) / math.max(ta.highest(high, wrLength) - ta.lowest(low, wrLength), 1e-10)
wrBullish = useWilliamsR ? wrValue[1] > -50 : true
wrBearish = useWilliamsR ? wrValue[1] < -50 : true

// === 16. Chande Momentum Oscillator ===
cmoValue = ta.cmo(close, cmoLength)
cmoBullish = useCMO ? cmoValue[1] > 0 : true
cmoBearish = useCMO ? cmoValue[1] < 0 : true

// === 17. Fisher Transform ===
[fisherVal, fisherPrev] = f_fisherTransform(fisherLength)
fisherBullish = useFisher ? (fisherVal[1] > fisherPrev[1]) : true
fisherBearish = useFisher ? (fisherVal[1] < fisherPrev[1]) : true

// === 18. Elder Force Index ===
efiValue = ta.ema(volume * (close - close[1]), efiLength)
efiBullish = useEFI ? efiValue[1] > 0 : true
efiBearish = useEFI ? efiValue[1] < 0 : true

// === 19. Order Blocks ===
obDispThreshold = atr * obDisplacementMult
bullOBCandle = close[2] < open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] > open[1]
bearOBCandle = close[2] > open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] < open[1]
var float lastBullOBHigh = na
var float lastBullOBLow = na
var float lastBearOBHigh = na
var float lastBearOBLow = na
if useOrderBlocks and bullOBCandle
    lastBullOBHigh := high[2]
    lastBullOBLow := low[2]
if useOrderBlocks and bearOBCandle
    lastBearOBHigh := high[2]
    lastBearOBLow := low[2]
nearBullOB = useOrderBlocks and not na(lastBullOBLow) ? (low[1] <= lastBullOBHigh and low[1] >= lastBullOBLow) : false
nearBearOB = useOrderBlocks and not na(lastBearOBHigh) ? (high[1] >= lastBearOBLow and high[1] <= lastBearOBHigh) : false

// === 20. Intermarket (Correlation + Relative Strength) ===
benchClose = (useCorrelation or useRelStrength) ? request.security(benchmarkSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off) : close
corrValue = useCorrelation ? ta.correlation(close, benchClose, corrLength) : 0.0
benchTrendUp = benchClose > benchClose[1]
corrBullish = useCorrelation ? (corrValue[1] > 0.5 and benchTrendUp[1]) or (corrValue[1] < -0.3 and not benchTrendUp[1]) : true
corrBearish = useCorrelation ? (corrValue[1] > 0.5 and not benchTrendUp[1]) or (corrValue[1] < -0.3 and benchTrendUp[1]) : true

rsRatio = useRelStrength ? close / math.max(benchClose, 1e-10) : 1.0
rsMA = ta.sma(rsRatio, corrLength)
rsBullish = useRelStrength ? rsRatio[1] > rsMA[1] : true
rsBearish = useRelStrength ? rsRatio[1] < rsMA[1] : true

// === 21. Engulfing Pattern ===
bullEngulfing = useEngulfing ? (close[2] < open[2] and close[1] > open[1] and open[1] <= close[2] and close[1] >= open[2]) : false
bearEngulfing = useEngulfing ? (close[2] > open[2] and close[1] < open[1] and open[1] >= close[2] and close[1] <= open[2]) : false

// === 22. Pin Bar / Hammer ===
bodySize = math.abs(close[1] - open[1])
upperWick = high[1] - math.max(close[1], open[1])
lowerWick = math.min(close[1], open[1]) - low[1]
hammerBull = usePinBar ? (lowerWick >= bodySize * pinBarWickRatio and upperWick < bodySize and close[1] > open[1]) : false
shootingStar = usePinBar ? (upperWick >= bodySize * pinBarWickRatio and lowerWick < bodySize and close[1] < open[1]) : false

// === 23. Morning Star / Evening Star ===
bar3Bearish = close[3] < open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
bar2Small = math.abs(close[2] - open[2]) < atr[2] * 0.3
bar1Bullish = close[1] > open[1] and close[1] > (open[3] + close[3]) / 2
morningStar = useMorningStar ? (bar3Bearish and bar2Small and bar1Bullish) : false

bar3BullishStar = close[3] > open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
bar1BearishStar = close[1] < open[1] and close[1] < (open[3] + close[3]) / 2
eveningStar = useMorningStar ? (bar3BullishStar and bar2Small and bar1BearishStar) : false

// === Doji (1-bar) ===
candleRange1 = high[1] - low[1]
doji = useDoji ? (bodySize / math.max(candleRange1, 1e-10) <= dojiBodyPct and bodySize < atr[1] * 0.2) : false

// === Harami (2-bar) ===
bullHarami = useHarami ? (close[2] < open[2] and close[1] > open[1] and open[1] > close[2] and close[1] < open[2]) : false
bearHarami = useHarami ? (close[2] > open[2] and close[1] < open[1] and open[1] < close[2] and close[1] > open[2]) : false

// === Three White Soldiers / Three Black Crows (3-bar) ===
threeWhiteSoldiers = useThreeSoldiers ? (close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and open[1] > open[2] and open[1] < close[2] and open[2] > open[3] and open[2] < close[3] and close[1] > close[2] and close[2] > close[3]) : false
threeBlackCrows = useThreeSoldiers ? (close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and open[1] < open[2] and open[1] > close[2] and open[2] < open[3] and open[2] > close[3] and close[1] < close[2] and close[2] < close[3]) : false

// === Tweezer Bottoms / Tweezer Tops (2-bar) ===
tweezerBottom = useTweezer ? (math.abs(low[1] - low[2]) <= atr * tweezerTolerance and close[1] > open[1] and close[2] < open[2]) : false
tweezerTop = useTweezer ? (math.abs(high[1] - high[2]) <= atr * tweezerTolerance and close[1] < open[1] and close[2] > open[2]) : false

// === Piercing Line / Dark Cloud Cover (2-bar) ===
mid2 = (open[2] + close[2]) / 2
piercingLine = usePiercingLine ? (close[2] < open[2] and open[1] < low[2] and close[1] > mid2 and close[1] < open[2] and close[1] > open[1]) : false
darkCloudCover = usePiercingLine ? (close[2] > open[2] and open[1] > high[2] and close[1] < mid2 and close[1] > close[2] and close[1] < open[1]) : false

// === 24. Z-Score ===
zScore = useZScore ? (close - ta.sma(close, zScoreLength)) / math.max(ta.stdev(close, zScoreLength), 1e-10) : 0.0
zScoreOverextBull = useZScore and zScore[1] > 2.0
zScoreOverextBear = useZScore and zScore[1] < -2.0

// === 25. R-Squared (for meta-modifier) ===
rSqValue = useRSquared ? rSquared[1] : 0.5

// === 26. ATR Acceleration (Sentiment) ===
atrRoc = ta.roc(atr, 10)
atrDecelerating = useATRAccel ? atrRoc[1] < 0 and atrRoc[2] > 0 : false
atrAccelerating = useATRAccel ? atrRoc[1] > 0 and atrRoc[2] < 0 : false

// === 27. Buying/Selling Pressure ===
buyPressure = ta.sma((close - low) / math.max(high - low, 1e-10) * volume, pressureLength)
sellPressure = ta.sma((high - close) / math.max(high - low, 1e-10) * volume, pressureLength)
pressureRatio = buyPressure / math.max(buyPressure + sellPressure, 1e-10)
pressureBullish = useBuySellPressure ? pressureRatio[1] > 0.55 : true
pressureBearish = useBuySellPressure ? pressureRatio[1] < 0.45 : true

// === 28. Ehlers Sine Wave ===
[sineVal, leadSineVal, dominantPeriod] = f_ehlersSineWave()
sineBullish = useEhlersSine ? (sineVal[1] > leadSineVal[1] and sineVal[2] <= leadSineVal[2]) or sineVal[1] > leadSineVal[1] : true
sineBearish = useEhlersSine ? (sineVal[1] < leadSineVal[1] and sineVal[2] >= leadSineVal[2]) or sineVal[1] < leadSineVal[1] : true

// === 29. Wyckoff Phase Detection ===
wyckHigh = ta.highest(high, wyckoffLookback)
wyckLow = ta.lowest(low, wyckoffLookback)
wyckRange = wyckHigh - wyckLow
wyckVolAvg = ta.sma(volume, wyckoffLookback)
wyckInRange = wyckRange > 0 and wyckRange < atr * wyckoffLookback * 0.5
wyckSpring = useWyckoff and wyckInRange ? (low[1] < wyckLow[1] and close[1] > wyckLow[1] and volume[1] > wyckVolAvg[1]) : false
wyckUpthrust = useWyckoff and wyckInRange ? (high[1] > wyckHigh[1] and close[1] < wyckHigh[1] and volume[1] > wyckVolAvg[1]) : false

// === 30. VWMA ===
vwmaVal = ta.vwma(close, vwmaLength)
smaForVwma = ta.sma(close, vwmaLength)
vwmaBullish = useVWMA ? vwmaVal[1] > smaForVwma[1] : true
vwmaBearish = useVWMA ? vwmaVal[1] < smaForVwma[1] : true

// === 31. Displacement Candle ===
avgBody = ta.sma(math.abs(close - open), 20)
bullDisplacement = useDisplacement ? (close[1] > open[1] and math.abs(close[1] - open[1]) > avgBody[1] * dispBodyMult and volume[1] > volumeMA[1]) : false
bearDisplacement = useDisplacement ? (close[1] < open[1] and math.abs(close[1] - open[1]) > avgBody[1] * dispBodyMult and volume[1] > volumeMA[1]) : false

// === 32. Donchian Channel ===
donchianUpper = useDonchian ? ta.highest(high, donchianLength) : high
donchianLower = useDonchian ? ta.lowest(low, donchianLength) : low
donchianMid = (donchianUpper + donchianLower) / 2
donchianBullish = useDonchian ? close[1] > donchianMid[1] : true
donchianBearish = useDonchian ? close[1] < donchianMid[1] : true

// === 33. McGinley Dynamic ===
mcginleyVal = useMcGinley ? f_mcginley(close, mcginleyLength) : close
mcginleyBullish = useMcGinley ? close[1] > mcginleyVal[1] : true
mcginleyBearish = useMcGinley ? close[1] < mcginleyVal[1] : true

// === 34. DEMA ===
demaEma1 = ta.ema(close, demaLength)
demaVal = 2 * demaEma1 - ta.ema(demaEma1, demaLength)
demaBullish = useDEMA ? close[1] > demaVal[1] : true
demaBearish = useDEMA ? close[1] < demaVal[1] : true

// === 35. TEMA ===
temaE1 = ta.ema(close, temaLength)
temaE2 = ta.ema(temaE1, temaLength)
temaE3 = ta.ema(temaE2, temaLength)
temaVal = 3 * temaE1 - 3 * temaE2 + temaE3
temaBullish = useTEMA ? close[1] > temaVal[1] : true
temaBearish = useTEMA ? close[1] < temaVal[1] : true

// === 36. GMMA (fixed periods: 3,5,8,10,12,15 and 30,35,40,45,50,60) ===
gmmaS1 = ta.ema(close, 3)
gmmaS2 = ta.ema(close, 5)
gmmaS3 = ta.ema(close, 8)
gmmaS4 = ta.ema(close, 10)
gmmaS5 = ta.ema(close, 12)
gmmaS6 = ta.ema(close, 15)
gmmaL1 = ta.ema(close, 30)
gmmaL2 = ta.ema(close, 35)
gmmaL3 = ta.ema(close, 40)
gmmaL4 = ta.ema(close, 45)
gmmaL5 = ta.ema(close, 50)
gmmaL6 = ta.ema(close, 60)
gmmaShortAvg = (gmmaS1 + gmmaS2 + gmmaS3 + gmmaS4 + gmmaS5 + gmmaS6) / 6
gmmaLongAvg = (gmmaL1 + gmmaL2 + gmmaL3 + gmmaL4 + gmmaL5 + gmmaL6) / 6
gmmaBullish = useGMMA ? gmmaShortAvg[1] > gmmaLongAvg[1] : true
gmmaBearish = useGMMA ? gmmaShortAvg[1] < gmmaLongAvg[1] : true

// === 37. Williams Alligator ===
alligatorMed = (high + low) / 2
alligatorJawVal = f_smma(alligatorMed, alligatorJaw)
alligatorTeethVal = f_smma(alligatorMed, alligatorTeeth)
alligatorLipsVal = f_smma(alligatorMed, alligatorLips)
alligatorJawPlot = alligatorJawVal[8]
alligatorTeethPlot = alligatorTeethVal[5]
alligatorLipsPlot = alligatorLipsVal[3]
alligatorBullish = useAlligator ? (alligatorLipsPlot > alligatorTeethPlot and alligatorTeethPlot > alligatorJawPlot) : true
alligatorBearish = useAlligator ? (alligatorLipsPlot < alligatorTeethPlot and alligatorTeethPlot < alligatorJawPlot) : true

// === 38. Gator Oscillator ===
gatorUpper = math.abs(alligatorJawPlot - alligatorTeethPlot)
gatorLower = math.abs(alligatorTeethPlot - alligatorLipsPlot)
gatorExpanding = useGator ? (gatorUpper > gatorUpper[1] or gatorLower > gatorLower[1]) : false

// === 39. TRIX ===
[trixVal, trixSignalVal] = f_trix(close, trixLength, trixSignalLen)
trixBullish = useTRIX ? trixVal[1] > trixSignalVal[1] : true
trixBearish = useTRIX ? trixVal[1] < trixSignalVal[1] : true

// === 40. Oscillator ===
uoValue = useUO ? f_oscillator(uoPeriod1, uoPeriod2, uoPeriod3) : 50.0
uoBullish = useUO ? uoValue[1] > 50 : true
uoBearish = useUO ? uoValue[1] < 50 : true

// === 41. Know Sure Thing ===
kstR1 = ta.roc(close, kstRoc1)
kstR2 = ta.roc(close, kstRoc2)
kstR3 = ta.roc(close, kstRoc3)
kstR4 = ta.roc(close, kstRoc4)
kstValue = useKST ? ta.sma(kstR1 * 1 + kstR2 * 2 + kstR3 * 3 + kstR4 * 4, 10) : 0.0
kstSignalVal = ta.sma(kstValue, kstSmaLen)
kstBullish = useKST ? kstValue[1] > kstSignalVal[1] : true
kstBearish = useKST ? kstValue[1] < kstSignalVal[1] : true

// === 42. DPO ===
dpoValue = useDPO ? f_dpo(close, dpoLength) : 0.0
dpoBullish = useDPO ? dpoValue[1] > 0 : true
dpoBearish = useDPO ? dpoValue[1] < 0 : true

// === 43. RVI ===
[rviValue, rviSignalVal] = f_rvi(rviLength)
rviBullish = useRVI ? rviValue[1] > rviSignalVal[1] : true
rviBearish = useRVI ? rviValue[1] < rviSignalVal[1] : true

// === 44. Schaff Trend Cycle ===
[_, schaffVal] = f_schaffTrendCycle(schaffCycle, schaffSmooth1, schaffSmooth2)
schaffBullish = useSchaff ? (schaffVal[1] > 25 and schaffVal[2] <= 25) or schaffVal[1] > 75 : true
schaffBearish = useSchaff ? (schaffVal[1] < 75 and schaffVal[2] >= 75) or schaffVal[1] < 25 : true

// === 45. Pretty Good Oscillator ===
pgoValue = usePGO ? (close - ta.ema(close, pgoLength)) / math.max(ta.atr(pgoLength), 1e-10) : 0.0
pgoBullish = usePGO ? pgoValue[1] > 0 : true
pgoBearish = usePGO ? pgoValue[1] < 0 : true

// === 46. Coppock Curve ===
coppockRaw = ta.roc(close, coppockRoc1) + ta.roc(close, coppockRoc2)
coppockValue = useCoppock ? ta.sma(coppockRaw, coppockSma) : 0.0
coppockBullish = useCoppock ? coppockValue[1] > 0 : true
coppockBearish = useCoppock ? coppockValue[1] < 0 : true

// === 47. Mass Index ===
massValue = useMassIndex ? f_massIndex(massSingle, massSum) : 0.0
massBulge = useMassIndex ? (massValue[1] > massThreshold and massValue[1] < massValue[2]) : false

// === 48. Klinger Volume ===
[kvoValue, kvoSignalLine] = f_klinger(kvoFast, kvoSlow, kvoSignal)
klingerBullish = useKlinger ? kvoValue[1] > kvoSignalLine[1] : true
klingerBearish = useKlinger ? kvoValue[1] < kvoSignalLine[1] : true

// === 50. Ease of Movement ===
eomValue = useEOM ? f_eom(eomLength) : 0.0
eomBullish = useEOM ? eomValue[1] > 0 : true
eomBearish = useEOM ? eomValue[1] < 0 : true

// === 51. NVI ===
var float nviVal = 1000.0
nviVal := volume < volume[1] ? nviVal[1] * (close / math.max(close[1], 1e-10)) : nviVal[1]
nviMA = ta.sma(nviVal, nviPviMALen)
nviBullish = useNVI ? nviVal[1] > nviMA[1] : true
nviBearish = useNVI ? nviVal[1] < nviMA[1] : true

// === 52. PVI ===
var float pviVal = 1000.0
pviVal := volume > volume[1] ? pviVal[1] * (close / math.max(close[1], 1e-10)) : pviVal[1]
pviMA = ta.sma(pviVal, nviPviMALen)
pviBullish = usePVI ? pviVal[1] > pviMA[1] : true
pviBearish = usePVI ? pviVal[1] < pviMA[1] : true

// === 53. Intraday Intensity Index ===
iiiRaw = (high - low) > 0 ? (2 * close - high - low) / (high - low) * volume : 0.0
iiiValue = useIII ? ta.sma(iiiRaw, iiiLength) : 0.0
iiiCum = ta.cum(iiiRaw)
iiiBullish = useIII ? iiiValue[1] > 0 : true
iiiBearish = useIII ? iiiValue[1] < 0 : true

// === 54. Market Facilitation Index (Bill Williams) ===
mfiBWValue = useMFI_BW ? (high - low) / math.max(volume, 1) : 0.0
mfiBWUp = close > close[1]
mfiBWVolUp = volume > volume[1]
mfiBWBullish = useMFI_BW ? (mfiBWUp and mfiBWVolUp) : true
mfiBWBearish = useMFI_BW ? (not mfiBWUp and mfiBWVolUp) : true

// === 55. Pivot Points (HTF) ===
[pivotHighHTF, pivotLowHTF, pivotCloseHTF] = request.security(syminfo.tickerid, pivotTimeframe, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
pivotP = usePivots ? (pivotHighHTF + pivotLowHTF + pivotCloseHTF) / 3 : close
pivotR1 = 2 * pivotP - pivotLowHTF
pivotR2 = pivotP + (pivotHighHTF - pivotLowHTF)
pivotS1 = 2 * pivotP - pivotHighHTF
pivotS2 = pivotP - (pivotHighHTF - pivotLowHTF)
nearPivotR1 = usePivots and close[1] >= pivotR1[1] * 0.998 and close[1] <= pivotR1[1] * 1.002
nearPivotS1 = usePivots and close[1] >= pivotS1[1] * 0.998 and close[1] <= pivotS1[1] * 1.002
pivotCrossUpR1 = ta.crossover(close, pivotR1)
pivotCrossDownS1 = ta.crossunder(close, pivotS1)
pivotBreak = pivotCrossUpR1 or pivotCrossDownS1

// === 56. Auto Fibonacci ===
fibSwingHigh = ta.highest(high, fibLookback)
fibSwingLow = ta.lowest(low, fibLookback)
fibRange = fibSwingHigh - fibSwingLow
fib236 = fibSwingHigh - 0.236 * fibRange
fib382 = fibSwingHigh - 0.382 * fibRange
fib50 = fibSwingHigh - 0.5 * fibRange
fib618 = fibSwingHigh - 0.618 * fibRange
fib786 = fibSwingHigh - 0.786 * fibRange

// === 57. Support/Resistance (from pivots) ===
srSwingHigh = ta.pivothigh(high, swingLookback, swingLookback)
srSwingLow = ta.pivotlow(low, swingLookback, swingLookback)
srResistance = ta.valuewhen(not na(srSwingHigh), srSwingHigh, 0)
srSupport = ta.valuewhen(not na(srSwingLow), srSwingLow, 0)

// === 58. Gap Detection ===
gapUp = useGap and open > high[1]
gapDown = useGap and open < low[1]
gapSize = gapUp ? open - high[1] : gapDown ? low[1] - open : 0.0
gapValid = (gapMinATR <= 0 or gapSize >= atr * gapMinATR) and (gapUp or gapDown)

// === 59. Vortex ===
[viPlus, viMinus] = f_vortex(vortexLength)
vortexBullish = useVortex ? viPlus[1] > viMinus[1] : true
vortexBearish = useVortex ? viMinus[1] > viPlus[1] : true

// === 60. Elder Impulse ===
elderEma = ta.ema(close, elderEmaLen)
elderEmaRising = elderEma > elderEma[1]
elderImpulseBull = useElderImpulse ? (elderEmaRising[1] and macdHist[1] > 0) : true
elderImpulseBear = useElderImpulse ? (not elderEmaRising[1] and macdHist[1] < 0) : true

// === 61. Volume-Weighted RSI ===
vwPrice = ta.vwma(close, vwRsiLength)
vwRsiValue = useVWRSI ? ta.rsi(vwPrice, vwRsiLength) : 50.0
vwRsiBullish = useVWRSI ? vwRsiValue[1] > 50 : true
vwRsiBearish = useVWRSI ? vwRsiValue[1] < 50 : true

// === 62. Twiggs Money Flow ===
twiggsRaw = ((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume
twiggsValue = useTwiggs ? ta.sma(twiggsRaw, twiggsLength) : 0.0
twiggsBullish = useTwiggs ? twiggsValue[1] > 0 : true
twiggsBearish = useTwiggs ? twiggsValue[1] < 0 : true

// ==================================================================================
// BUY/SELL SIGNAL — REVERSAL-BASED SCORING ENGINE
// Philosophy: Detect exhaustion + reversal confirmation, NOT lagging trend stacking
// ==================================================================================

// --- New reversal-specific variables ---
stochCrossUp = ta.crossover(stochKVal, stochDVal)
stochCrossDown = ta.crossunder(stochKVal, stochDVal)
macdHistTurningUp = macdHist[1] > macdHist[2] and macdHist[2] < 0
macdHistTurningDown = macdHist[1] < macdHist[2] and macdHist[2] > 0
// Decaying freshness scores — bar 1 ago = full credit, bar 2 = partial, bar 3 = minimal
macdCrossUpFresh = macdCrossUp[1] ? 2.0 : macdCrossUp[2] ? 1.2 : macdCrossUp[3] ? 0.5 : 0.0
macdCrossDownFresh = macdCrossDown[1] ? 2.0 : macdCrossDown[2] ? 1.2 : macdCrossDown[3] ? 0.5 : 0.0
rsiCrossUpFresh = rsiOversoldCross[1] ? 2.0 : rsiOversoldCross[2] ? 1.2 : rsiOversoldCross[3] ? 0.5 : 0.0
rsiCrossDownFresh = rsiOverboughtCross[1] ? 2.0 : rsiOverboughtCross[2] ? 1.2 : rsiOverboughtCross[3] ? 0.5 : 0.0
stochCrossUpFresh = stochCrossUp[1] ? 1.5 : stochCrossUp[2] ? 0.9 : stochCrossUp[3] ? 0.4 : 0.0
stochCrossDownFresh = stochCrossDown[1] ? 1.5 : stochCrossDown[2] ? 0.9 : stochCrossDown[3] ? 0.4 : 0.0

// Lagging indicator count — when too many align, that's exhaustion not confirmation
lagBuyCount = (trendUp ? 1 : 0) + (maStackUp ? 1 : 0) + (stBullish ? 1 : 0) + (sarBullish ? 1 : 0) + (ichBullish ? 1 : 0) + (aroonBullish ? 1 : 0) + (linRegBullish ? 1 : 0) + (donchianBullish ? 1 : 0) + (mcginleyBullish ? 1 : 0) + (alligatorBullish ? 1 : 0) + (vortexBullish ? 1 : 0) + (demaBullish ? 1 : 0) + (temaBullish ? 1 : 0) + (gmmaBullish ? 1 : 0) + (macdBullish ? 1 : 0) + (rsiBullish ? 1 : 0) + (rocBullish ? 1 : 0)
lagSellCount = (trendDown ? 1 : 0) + (maStackDown ? 1 : 0) + (stBearish ? 1 : 0) + (sarBearish ? 1 : 0) + (ichBearish ? 1 : 0) + (aroonBearish ? 1 : 0) + (linRegBearish ? 1 : 0) + (donchianBearish ? 1 : 0) + (mcginleyBearish ? 1 : 0) + (alligatorBearish ? 1 : 0) + (vortexBearish ? 1 : 0) + (demaBearish ? 1 : 0) + (temaBearish ? 1 : 0) + (gmmaBearish ? 1 : 0) + (macdBearish ? 1 : 0) + (rsiBearish ? 1 : 0) + (rocBearish ? 1 : 0)

// --- 1. EXHAUSTION category (weight 0.30) ---
// For BUY: detect bearish exhaustion (oversold conditions)
// For SELL: detect bullish exhaustion (overbought conditions)
exhWtTotal = 5.0
exhBuyRaw = (rsiPrev < 35 ? 2.0 : rsiPrev < 45 ? 1.0 : 0.0) + (stochKVal[1] < 25 ? 1.5 : 0.0) + (mfiValue[1] < 30 ? 1.0 : 0.0) + (wrValue[1] < -75 ? 1.0 : 0.0) + (bbPercent < 0.15 ? 1.5 : 0.0) + (zScore[1] < -1.5 ? 2.0 : 0.0) + (cciValue[1] < -100 ? 1.0 : 0.0) + (schaffVal[1] < 20 ? 0.8 : 0.0) + (uoValue[1] < 30 ? 0.8 : 0.0)
exhSellRaw = (rsiPrev > 65 ? 2.0 : rsiPrev > 55 ? 1.0 : 0.0) + (stochKVal[1] > 75 ? 1.5 : 0.0) + (mfiValue[1] > 70 ? 1.0 : 0.0) + (wrValue[1] > -25 ? 1.0 : 0.0) + (bbPercent > 0.85 ? 1.5 : 0.0) + (zScore[1] > 1.5 ? 2.0 : 0.0) + (cciValue[1] > 100 ? 1.0 : 0.0) + (schaffVal[1] > 80 ? 0.8 : 0.0) + (uoValue[1] > 70 ? 0.8 : 0.0)
exhBuyScore = math.min(exhBuyRaw / exhWtTotal, 1.0)
exhSellScore = math.min(exhSellRaw / exhWtTotal, 1.0)

// --- 2. REVERSAL TRIGGERS category (weight 0.25) ---
// Fresh momentum shifts — events that JUST happened (crossovers within 3 bars)
revWtTotal = 5.0
revBuyRaw = macdCrossUpFresh + rsiCrossUpFresh + stochCrossUpFresh + (macdHistTurningUp ? 1.5 : 0.0) + (fisherBullish ? 1.0 : 0.0) + (trixBullish ? 1.0 : 0.0) + (kstBullish ? 1.0 : 0.0) + (sineBullish ? 0.8 : 0.0) + (coppockBullish ? 0.8 : 0.0) + (rviBullish ? 0.7 : 0.0) + (elderImpulseBull ? 0.8 : 0.0) + (dpoBullish ? 0.6 : 0.0)
revSellRaw = macdCrossDownFresh + rsiCrossDownFresh + stochCrossDownFresh + (macdHistTurningDown ? 1.5 : 0.0) + (fisherBearish ? 1.0 : 0.0) + (trixBearish ? 1.0 : 0.0) + (kstBearish ? 1.0 : 0.0) + (sineBearish ? 0.8 : 0.0) + (coppockBearish ? 0.8 : 0.0) + (rviBearish ? 0.7 : 0.0) + (elderImpulseBear ? 0.8 : 0.0) + (dpoBearish ? 0.6 : 0.0)
revBuyScore = math.min(revBuyRaw / revWtTotal, 1.0)
revSellScore = math.min(revSellRaw / revWtTotal, 1.0)

// --- 3. STRUCTURE category (weight 0.20) ---
// Price at meaningful reversal levels + pattern confirmation
structWtTotal = 5.5
structBuyRaw = (nearSupport ? 2.0 : 0.0) + (wyckSpring ? 2.5 : 0.0) + (bullishDivergence ? 2.5 : 0.0) + (bosBull ? 1.5 : 0.0) + (chochBullish ? 2.0 : 0.0) + (sfpBull ? 1.5 : 0.0) + (bullFVG ? 1.0 : 0.0) + (bullEngulfing ? 1.5 : 0.0) + (hammerBull ? 1.5 : 0.0) + (morningStar ? 1.5 : 0.0) + (piercingLine ? 1.0 : 0.0) + (tweezerBottom ? 1.0 : 0.0) + (threeWhiteSoldiers ? 1.0 : 0.0) + (doji and rsiPrev < 40 ? 0.5 : 0.0)
structSellRaw = (nearResistance ? 2.0 : 0.0) + (wyckUpthrust ? 2.5 : 0.0) + (bearishDivergence ? 2.5 : 0.0) + (bosBear ? 1.5 : 0.0) + (chochBearish ? 2.0 : 0.0) + (sfpBear ? 1.5 : 0.0) + (bearFVG ? 1.0 : 0.0) + (bearEngulfing ? 1.5 : 0.0) + (shootingStar ? 1.5 : 0.0) + (eveningStar ? 1.5 : 0.0) + (darkCloudCover ? 1.0 : 0.0) + (tweezerTop ? 1.0 : 0.0) + (threeBlackCrows ? 1.0 : 0.0) + (doji and rsiPrev > 60 ? 0.5 : 0.0)
structBuyScore = math.min(structBuyRaw / structWtTotal, 1.0)
structSellScore = math.min(structSellRaw / structWtTotal, 1.0)

// --- 4. VOLUME CONFIRMATION category (weight 0.15) ---
// Smart money supporting the reversal
volWtTotal = 4.0
// Directional volume — only credit volume when it supports the signal direction
volConfirmBuy = volumeConfirm and close[1] > open[1]
volConfirmSell = volumeConfirm and close[1] < open[1]
volRisingBuy = volumeRising and pressureRatio[1] > 0.55
volRisingSell = volumeRising and pressureRatio[1] < 0.45
volBuyRaw = (volConfirmBuy ? 1.2 : 0.0) + (volRisingBuy ? 1.0 : 0.0) + (obvBullish ? 1.0 : 0.0) + (cmfBullish ? 1.0 : 0.0) + (pressureBullish ? 1.2 : 0.0) + (klingerBullish ? 0.8 : 0.0) + (twiggsBullish ? 0.7 : 0.0) + (iiiBullish ? 0.5 : 0.0) + (eomBullish ? 0.5 : 0.0)
volSellRaw = (volConfirmSell ? 1.2 : 0.0) + (volRisingSell ? 1.0 : 0.0) + (obvBearish ? 1.0 : 0.0) + (cmfBearish ? 1.0 : 0.0) + (pressureBearish ? 1.2 : 0.0) + (klingerBearish ? 0.8 : 0.0) + (twiggsBearish ? 0.7 : 0.0) + (iiiBearish ? 0.5 : 0.0) + (eomBearish ? 0.5 : 0.0)
volBuyScore = math.min(volBuyRaw / volWtTotal, 1.0)
volSellScore = math.min(volSellRaw / volWtTotal, 1.0)

// --- 5. TREND ALIGNMENT category (weight 0.10) ---
// Trade reversals WITH the higher timeframe direction
trendAlignWtTotal = 5.0
trendAlignBuyRaw = (mtfD ? 2.5 : 0.0) + (mtf240 ? 2.0 : 0.0) + (htfTrendUp ? 2.0 : 0.0) + (mtf60 ? 1.0 : 0.0) + (adxStrong ? 0.5 : 0.0)
trendAlignSellRaw = (not mtfD ? 2.5 : 0.0) + (not mtf240 ? 2.0 : 0.0) + (not htfTrendUp ? 2.0 : 0.0) + (not mtf60 ? 1.0 : 0.0) + (adxStrong ? 0.5 : 0.0)
trendAlignBuyScore = math.min(trendAlignBuyRaw / trendAlignWtTotal, 1.0)
trendAlignSellScore = math.min(trendAlignSellRaw / trendAlignWtTotal, 1.0)

// --- COMPOSITE SCORE ---
rawBuyScore = (exhBuyScore * 0.30 + revBuyScore * 0.25 + structBuyScore * 0.20 + volBuyScore * 0.15 + trendAlignBuyScore * 0.10) * 100.0
rawSellScore = (exhSellScore * 0.30 + revSellScore * 0.25 + structSellScore * 0.20 + volSellScore * 0.15 + trendAlignSellScore * 0.10) * 100.0

// --- META-MODIFIER MULTIPLIERS ---
// Z-Score: BOOST signals when price is overextended in the right direction
zScoreBuyMult = zScore[1] < -2.0 ? 1.15 : zScore[1] > 2.0 ? 0.50 : 1.0
zScoreSellMult = zScore[1] > 2.0 ? 1.15 : zScore[1] < -2.0 ? 0.50 : 1.0

// R² — much stronger gradient: choppy markets get heavy penalty
rSqMult = rSqValue > 0.7 ? 1.08 : rSqValue > 0.5 ? 1.0 : rSqValue > 0.3 ? 0.80 : rSqValue > 0.15 ? 0.60 : 0.45

// Volatility spike filter using existing hvRank — extreme volatility = unreliable signals
volSpikeMult = hvRank[1] > 95 ? 0.40 : hvRank[1] > 90 ? 0.55 : hvRank[1] > 80 ? 0.80 : 1.0

// Over-alignment penalty: too many lagging indicators aligned = exhaustion in THAT direction
// For BUY: if too many lagging bearish signals → bears are exhausted → BOOST buy
// For BUY: if too many lagging bullish signals → buying at top → PENALIZE buy
exhaustionBoostBuy = lagSellCount >= 14 ? 1.15 : lagSellCount >= 11 ? 1.08 : 1.0
exhaustionPenaltyBuy = lagBuyCount >= 14 ? 0.55 : lagBuyCount >= 11 ? 0.75 : 1.0
exhaustionBoostSell = lagBuyCount >= 14 ? 1.15 : lagBuyCount >= 11 ? 1.08 : 1.0
exhaustionPenaltySell = lagSellCount >= 14 ? 0.55 : lagSellCount >= 11 ? 0.75 : 1.0

// Category agreement
buyCatAgree = (exhBuyScore > 0.35 ? 1 : 0) + (revBuyScore > 0.25 ? 1 : 0) + (structBuyScore > 0.15 ? 1 : 0) + (volBuyScore > 0.3 ? 1 : 0) + (trendAlignBuyScore > 0.35 ? 1 : 0)
sellCatAgree = (exhSellScore > 0.35 ? 1 : 0) + (revSellScore > 0.25 ? 1 : 0) + (structSellScore > 0.15 ? 1 : 0) + (volSellScore > 0.3 ? 1 : 0) + (trendAlignSellScore > 0.35 ? 1 : 0)
agreeMult = buyCatAgree >= 4 ? 1.12 : buyCatAgree >= 3 ? 1.06 : 1.0
agreeMsell = sellCatAgree >= 4 ? 1.12 : sellCatAgree >= 3 ? 1.06 : 1.0

// Divergence mega-bonus (most reliable reversal signal)
divBonusBuy = bullishDivergence ? 8.0 : 0.0
divBonusSell = bearishDivergence ? 8.0 : 0.0

// Wyckoff event bonus
wyckBonusBuy = wyckSpring ? 8.0 : 0.0
wyckBonusSell = wyckUpthrust ? 8.0 : 0.0

// CHoCH confirmation bonus (change of character = confirmed reversal)
chochBonusBuy = chochBullish ? 5.0 : 0.0
chochBonusSell = chochBearish ? 5.0 : 0.0

sessionMult = inSession ? 1.0 : 0.95

// Premium/Discount penalty — buying in premium or selling in discount is against reversal logic
pdPenaltyBuy = inPremium ? 0.82 : 1.0
pdPenaltySell = inDiscount ? 0.82 : 1.0

// Bonuses INSIDE the multiplier bracket — penalties apply to everything, no escape hatch
finalBuyScore = math.min((rawBuyScore + divBonusBuy + wyckBonusBuy + chochBonusBuy) * rSqMult * zScoreBuyMult * exhaustionBoostBuy * exhaustionPenaltyBuy * agreeMult * sessionMult * volSpikeMult * pdPenaltyBuy, 100.0)
finalSellScore = math.min((rawSellScore + divBonusSell + wyckBonusSell + chochBonusSell) * rSqMult * zScoreSellMult * exhaustionBoostSell * exhaustionPenaltySell * agreeMsell * sessionMult * volSpikeMult * pdPenaltySell, 100.0)

// --- SIGNAL GENERATION ---
var int barsSinceLastBuy = 999
var int barsSinceLastSell = 999
barsSinceLastBuy := barsSinceLastBuy + 1
barsSinceLastSell := barsSinceLastSell + 1

buyConfidence = finalBuyScore >= 80 ? "HIGH" : finalBuyScore >= 65 ? "MEDIUM" : "LOW"
sellConfidence = finalSellScore >= 80 ? "HIGH" : finalSellScore >= 65 ? "MEDIUM" : "LOW"

confFilterBuy = buySellConfidenceFilter == "All" ? true : buySellConfidenceFilter == "Medium+" ? finalBuyScore >= 65 : finalBuyScore >= 80
confFilterSell = buySellConfidenceFilter == "All" ? true : buySellConfidenceFilter == "Medium+" ? finalSellScore >= 65 : finalSellScore >= 80

// Opposing signal suppression — buy must dominate sell by ≥10 pts, and candle must confirm direction
buyDominance = finalBuyScore - finalSellScore
sellDominance = finalSellScore - finalBuyScore
signalBarBullish = close > open
signalBarBearish = close < open

// Hard exhaustion gate — a reversal system MUST detect exhaustion first
signalBuy = useBuySellSignal and barstate.isconfirmed and finalBuyScore >= buySellThreshold and barsSinceLastBuy >= buySellCooldown and confFilterBuy and buyDominance >= 10.0 and signalBarBullish and exhBuyScore > 0.15
signalSell = useBuySellSignal and barstate.isconfirmed and finalSellScore >= buySellThreshold and barsSinceLastSell >= buySellCooldown and confFilterSell and sellDominance >= 10.0 and signalBarBearish and exhSellScore > 0.15

if signalBuy
    barsSinceLastBuy := 0
if signalSell
    barsSinceLastSell := 0

// --- SL/TP CALCULATION (Structure-First with Recency Validation) ---
atrSLDist = atrPrev * atrMultiplierSL

// Primary swing: recent (≤30 bars), reasonable distance (0.5-4.5 ATR)
swingAgeBuy = bar_index - ta.valuewhen(not na(swingLow), bar_index, 0)
swingAgeSell = bar_index - ta.valuewhen(not na(swingHigh), bar_index, 0)

structDistBuy = close - lastSwingLow
structSLBuyOk = not na(lastSwingLow) and lastSwingLow > 0 and swingAgeBuy <= 30 and structDistBuy >= atrPrev * 0.5 and structDistBuy <= atrPrev * 4.5

// Secondary swing fallback: older occurrence (≤50 bars, same distance range)
lastSwingLow2 = ta.valuewhen(not na(swingLow), swingLow, 1)
swingAgeBuy2 = bar_index - ta.valuewhen(not na(swingLow), bar_index, 1)
structDistBuy2 = close - lastSwingLow2
structSLBuyOk2 = not na(lastSwingLow2) and lastSwingLow2 > 0 and swingAgeBuy2 <= 50 and structDistBuy2 >= atrPrev * 0.5 and structDistBuy2 <= atrPrev * 4.5

structDistSell = lastSwingHigh - close
structSLSellOk = not na(lastSwingHigh) and lastSwingHigh > 0 and swingAgeSell <= 30 and structDistSell >= atrPrev * 0.5 and structDistSell <= atrPrev * 4.5

lastSwingHigh2 = ta.valuewhen(not na(swingHigh), swingHigh, 1)
swingAgeSell2 = bar_index - ta.valuewhen(not na(swingHigh), bar_index, 1)
structDistSell2 = lastSwingHigh2 - close
structSLSellOk2 = not na(lastSwingHigh2) and lastSwingHigh2 > 0 and swingAgeSell2 <= 50 and structDistSell2 >= atrPrev * 0.5 and structDistSell2 <= atrPrev * 4.5

// Three-tier fallback: primary swing → secondary swing → ATR
buySL = structSLBuyOk ? (lastSwingLow - atrPrev * 0.15) : structSLBuyOk2 ? (lastSwingLow2 - atrPrev * 0.15) : (close - atrSLDist)
sellSL = structSLSellOk ? (lastSwingHigh + atrPrev * 0.15) : structSLSellOk2 ? (lastSwingHigh2 + atrPrev * 0.15) : (close + atrSLDist)

// Floor: 1.0 ATR min
buySL := math.min(buySL, close - atrPrev * 1.0)
sellSL := math.max(sellSL, close + atrPrev * 1.0)

// --- TP CALCULATION (Structure-Aware Targeting) ---
fixedBuyTP = close + (close - buySL) * buySellRR
fixedSellTP = close - (sellSL - close) * buySellRR

// Find nearest structural target above close for BUY
buyRisk = close - buySL
nearBuyTarget = fixedBuyTP
buyTPSource = "R:R"
if srResistance > close * 1.003 and (srResistance - close) / buyRisk >= 1.5
    nearBuyTarget := math.min(nearBuyTarget, srResistance)
    if nearBuyTarget == srResistance
        buyTPSource := "S/R"
if pivotR1 > close * 1.003 and (pivotR1 - close) / buyRisk >= 1.5
    nearBuyTarget := math.min(nearBuyTarget, pivotR1)
    if nearBuyTarget == pivotR1
        buyTPSource := "R1"
buyTP = nearBuyTarget
buyActualRR = buyRisk > 0 ? (buyTP - close) / buyRisk : buySellRR

// Find nearest structural target below close for SELL
sellRisk = sellSL - close
nearSellTarget = fixedSellTP
sellTPSource = "R:R"
if srSupport < close * 0.997 and (close - srSupport) / sellRisk >= 1.5
    nearSellTarget := math.max(nearSellTarget, srSupport)
    if nearSellTarget == srSupport
        sellTPSource := "S/R"
if pivotS1 < close * 0.997 and (close - pivotS1) / sellRisk >= 1.5
    nearSellTarget := math.max(nearSellTarget, pivotS1)
    if nearSellTarget == pivotS1
        sellTPSource := "S1"
sellTP = nearSellTarget
sellActualRR = sellRisk > 0 ? (close - sellTP) / sellRisk : buySellRR

// ==================================================================================
// SCORE THRESHOLD
// ==================================================================================

regime = adxStrong ? (trendUp ? "STRONG UPTREND" : trendDown ? "STRONG DOWNTREND" : "STRONG TREND") : "RANGING/WEAK"
regimeShort = adxStrong ? (trendUp ? "Uptrend" : trendDown ? "Downtrend" : "Trend") : "Ranging"

// ==================================================================================
// VISUALIZATION
// ==================================================================================

// --- Layer 1: Background (transparency 92-97) ---
// Trend background
bgColor = useBackground ? (trendUp and adxStrong ? color.new(bullPrimary, 95) : trendDown and adxStrong ? color.new(bearPrimary, 95) : na) : na
bgcolor(bgColor, title="Trend Background")

// TTM Squeeze active background
bgcolor(useTTMSqueeze and ttmSqueezeOn ? color.new(warningColor, 95) : na, title="Squeeze Active")

// --- Layer 2: Zones (transparency 80-90) ---
// Ichimoku Cloud
ichSpanAPlot = plot(useIchimoku ? ichSpanA : na, "Ichimoku Span A", color=color.new(bullSecondary, 82), offset=ichBase, display=display.all)
ichSpanBPlot = plot(useIchimoku ? ichSpanB : na, "Ichimoku Span B", color=color.new(bearSecondary, 82), offset=ichBase, display=display.all)
fill(ichSpanAPlot, ichSpanBPlot, color=ichGreenCloud ? color.new(bullPrimary, 90) : color.new(bearPrimary, 90), title="Ichimoku Cloud")

// Bollinger Bands
bbRelevant = useBB and (bbSqueeze or bbPercent < 0.1 or bbPercent > 0.9 or true)
bbUpperPlot = plot(bbRelevant ? bbUpper : na, "BB Upper", color=color.new(bbClr, 82), linewidth=1)
bbLowerPlot = plot(bbRelevant ? bbLower : na, "BB Lower", color=color.new(bbClr, 82), linewidth=1)
plot(bbRelevant ? bbBasis : na, "BB Basis", color=color.new(bbClr, 65), linewidth=1)
bbFillIntensity = bbSqueeze ? color.new(warningColor, 88) : color.new(bbClr, 93)
fill(bbUpperPlot, bbLowerPlot, color=bbFillIntensity, title="BB Fill")

// Keltner Channels (only when relevant)
kcVisible = useKeltner
plot(kcVisible ? kcUpper : na, "KC Upper", color=color.new(kcClr, 82), linewidth=1, style=plot.style_circles)
plot(kcVisible ? kcLower : na, "KC Lower", color=color.new(kcClr, 82), linewidth=1, style=plot.style_circles)

// FVG boxes
var box lastBullFvg = na
var box lastBearFvg = na
if useFVG and bullFVG
    if not na(lastBullFvg)
        box.delete(lastBullFvg)
    lastBullFvg := box.new(bar_index - 2, low[2], bar_index + 6, high[0], border_color=color.new(bullPrimary, 45), bgcolor=color.new(bullPrimary, 88), border_width=1)
if useFVG and bearFVG
    if not na(lastBearFvg)
        box.delete(lastBearFvg)
    lastBearFvg := box.new(bar_index - 2, low[0], bar_index + 6, high[2], border_color=color.new(bearPrimary, 45), bgcolor=color.new(bearPrimary, 88), border_width=1)

// --- Layer 3: Moving Averages (transparency 40-70) ---
// EMA Stack
plot(useMAStack ? emaFast : na, "EMA 9", color=color.new(emaFastClr, 35), linewidth=1)
plot(useMAStack ? emaSlow : na, "EMA 21", color=color.new(emaMidClr, 45), linewidth=1)
plot(useMAStack ? emaSlower : na, "EMA 50", color=color.new(emaSlowClr, 55), linewidth=1)

// VWAP
plot(useVWAPLine and useVWAP ? vwapValue : na, "VWAP", color=color.new(volumeClr, 25), linewidth=1, style=plot.style_line)

// Hull MA with ADX-based gradient intensity
hmaGradientBull = color.from_gradient(adxValue, 15, 35, color.new(bullPrimary, 60), color.new(bullPrimary, 0))
hmaGradientBear = color.from_gradient(adxValue, 15, 35, color.new(bearPrimary, 60), color.new(bearPrimary, 0))
hmaColor = hullTrend ? hmaGradientBull : hmaGradientBear
plot(useHullMA ? hullMA : na, "Hull MA", color=hmaColor, linewidth=2)

// --- Layer 4: Signals & Levels ---
// SuperTrend line
stColor = stDir < 0 ? bullPrimary : bearPrimary
plot(useSuperTrend ? stValue : na, "SuperTrend", color=color.new(stColor, 20), linewidth=2, style=plot.style_line)

// Parabolic SAR dots
plotshape(useSAR ? sarValue : na, "SAR", shape.cross, location.absolute, color=color.new(neutralColor, 40), size=size.tiny)

// Candlestick pattern markers (tiered offsets: primary 0.25, secondary 0.45, tertiary 0.65)
// --- Primary tier: strongest patterns ---
if usePatternMarkers and bullEngulfing
    label.new(bar_index, low - atr * 0.25, "E", style=label.style_label_up, color=color.new(structureClr, 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Engulfing")
if usePatternMarkers and bearEngulfing
    label.new(bar_index, high + atr * 0.25, "E", style=label.style_label_down, color=color.new(structureClr, 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Engulfing")
if usePatternMarkers and morningStar
    label.new(bar_index, low - atr * 0.25, "MoS", style=label.style_label_up, color=color.new(bullSecondary, 20), textcolor=color.white, size=size.tiny, tooltip="Morning Star")
if usePatternMarkers and eveningStar
    label.new(bar_index, high + atr * 0.25, "EvS", style=label.style_label_down, color=color.new(bearSecondary, 20), textcolor=color.white, size=size.tiny, tooltip="Evening Star")
if usePatternMarkers and threeWhiteSoldiers
    label.new(bar_index, low - atr * 0.25, "3WS", style=label.style_label_up, color=color.new(bullSecondary, 20), textcolor=color.white, size=size.tiny, tooltip="Three White Soldiers")
if usePatternMarkers and threeBlackCrows
    label.new(bar_index, high + atr * 0.25, "3BC", style=label.style_label_down, color=color.new(bearSecondary, 20), textcolor=color.white, size=size.tiny, tooltip="Three Black Crows")
// --- Secondary tier: reversal patterns ---
if usePatternMarkers and hammerBull
    label.new(bar_index, low - atr * 0.45, "H", style=label.style_label_up, color=color.new(bullSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Hammer")
if usePatternMarkers and shootingStar
    label.new(bar_index, high + atr * 0.45, "S", style=label.style_label_down, color=color.new(bearSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Shooting Star")
if usePatternMarkers and bullHarami
    label.new(bar_index, low - atr * 0.45, "Ha", style=label.style_label_up, color=color.new(bullSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Harami")
if usePatternMarkers and bearHarami
    label.new(bar_index, high + atr * 0.45, "Ha", style=label.style_label_down, color=color.new(bearSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Harami")
if usePatternMarkers and tweezerBottom
    label.new(bar_index, low - atr * 0.45, "TB", style=label.style_label_up, color=color.new(bullSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Bottoms")
if usePatternMarkers and tweezerTop
    label.new(bar_index, high + atr * 0.45, "TT", style=label.style_label_down, color=color.new(bearSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Tops")
// --- Tertiary tier: minor patterns ---
if usePatternMarkers and doji
    label.new(bar_index, low - atr * 0.65, "Do", style=label.style_label_up, color=color.new(structureClr, 30), textcolor=color.white, size=size.tiny, tooltip="Doji")
if usePatternMarkers and piercingLine
    label.new(bar_index, low - atr * 0.65, "PL", style=label.style_label_up, color=color.new(bullSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Piercing Line")
if usePatternMarkers and darkCloudCover
    label.new(bar_index, high + atr * 0.65, "DCC", style=label.style_label_down, color=color.new(bearSecondary, 30), textcolor=color.white, size=size.tiny, tooltip="Dark Cloud Cover")

// --- Layer 5: New indicator overlays ---
// Donchian Channel
plot(useDonchian ? donchianUpper : na, "Donchian Upper", color=color.new(donchClr, 72), linewidth=1)
plot(useDonchian ? donchianLower : na, "Donchian Lower", color=color.new(donchClr, 72), linewidth=1)
plot(useDonchian ? donchianMid : na, "Donchian Mid", color=color.new(donchClr, 80), linewidth=1)

// McGinley Dynamic
plot(useMcGinley ? mcginleyVal : na, "McGinley", color=color.new(structureClr, 50), linewidth=1)

// DEMA / TEMA — using line.new to save plot slots
if useDEMA and useMcGinley and not na(demaVal[1])
    line.new(bar_index - 1, demaVal[1], bar_index, demaVal, color=color.new(warningColor, 60), width=1)
if useTEMA and useMcGinley and not na(temaVal[1])
    line.new(bar_index - 1, temaVal[1], bar_index, temaVal, color=color.new(warningColor, 70), width=1)

// GMMA bands (short avg and long avg)
plot(useGMMA ? gmmaShortAvg : na, "GMMA Short", color=color.new(bullSecondary, 70), linewidth=1)
plot(useGMMA ? gmmaLongAvg : na, "GMMA Long", color=color.new(bearSecondary, 70), linewidth=1)

// Williams Alligator
plot(useAlligator ? alligatorJawPlot : na, "Alligator Jaw", color=color.new(alligJawClr, 45), linewidth=2)
plot(useAlligator ? alligatorTeethPlot : na, "Alligator Teeth", color=color.new(alligTeethClr, 45), linewidth=2)
plot(useAlligator ? alligatorLipsPlot : na, "Alligator Lips", color=color.new(alligLipsClr, 45), linewidth=2)

// Pivot lines (horizontal) — using line.new to save plot slots
var line pivotPLine  = na
var line pivotR1Line = na
var line pivotR2Line = na
var line pivotS1Line = na
var line pivotS2Line = na

if barstate.islast and usePivots
    line.delete(pivotPLine)
    line.delete(pivotR1Line)
    line.delete(pivotR2Line)
    line.delete(pivotS1Line)
    line.delete(pivotS2Line)
    pivotPLine  := line.new(bar_index - 200, pivotP,  bar_index + 20, pivotP,  color=color.new(neutralColor, 50), width=1, style=line.style_dotted)
    pivotR1Line := line.new(bar_index - 200, pivotR1, bar_index + 20, pivotR1, color=color.new(bearPrimary, 65),  width=1, style=line.style_dotted)
    pivotR2Line := line.new(bar_index - 200, pivotR2, bar_index + 20, pivotR2, color=color.new(bearPrimary, 75),  width=1, style=line.style_dotted)
    pivotS1Line := line.new(bar_index - 200, pivotS1, bar_index + 20, pivotS1, color=color.new(bullPrimary, 65),  width=1, style=line.style_dotted)
    pivotS2Line := line.new(bar_index - 200, pivotS2, bar_index + 20, pivotS2, color=color.new(bullPrimary, 75),  width=1, style=line.style_dotted)

// Fibonacci levels — using line.new to save plot slots
var line fib50Line  = na
var line fib382Line = na
var line fib618Line = na

if barstate.islast and useFibLevels and useFib
    line.delete(fib50Line)
    line.delete(fib382Line)
    line.delete(fib618Line)
    fib50Line  := line.new(bar_index - 200, fib50,  bar_index + 20, fib50,  color=color.new(structureClr, 70), width=1, style=line.style_dotted)
    fib382Line := line.new(bar_index - 200, fib382, bar_index + 20, fib382, color=color.new(structureClr, 80), width=1, style=line.style_dotted)
    fib618Line := line.new(bar_index - 200, fib618, bar_index + 20, fib618, color=color.new(structureClr, 80), width=1, style=line.style_dotted)

// Gap labels
if gapValid and gapUp
    label.new(bar_index, low, "Gap Up", style=label.style_label_up, color=color.new(bullPrimary, 30), textcolor=color.white, size=size.tiny)
if gapValid and gapDown
    label.new(bar_index, high, "Gap Dn", style=label.style_label_down, color=color.new(bearPrimary, 30), textcolor=color.white, size=size.tiny)

// Elder Impulse background
elderBgColor = useElderImpulse ? (elderImpulseBull ? color.new(bullPrimary, 91) : elderImpulseBear ? color.new(bearPrimary, 91) : color.new(neutralColor, 96)) : na
bgcolor(useBackground and useElderImpulse ? elderBgColor : na, title="Elder Impulse")

// --- Buy/Sell Signal: Labels, SL/TP lines, Tooltips ---
// Timeframe-adaptive line length
tfSeconds = timeframe.in_seconds(timeframe.period)
lineLen = tfSeconds >= 86400 ? 8 : tfSeconds >= 14400 ? 10 : tfSeconds >= 3600 ? 12 : 15

// Active signal tracking for dashboard
var float activeRR = 0.0
var string activeSLType = "-"
var float activeTP = na
var float activeSL = na

var line buySLLine = na
var line buyTPLine = na
var label buySLLabel = na
var label buyTPLabel = na
var line sellSLLine = na
var line sellTPLine = na
var label sellSLLabel = na
var label sellTPLabel = na
var box buyZone = na
var box sellZone = na
var label buyZoneLabel = na
var label sellZoneLabel = na
var box buyRiskZone = na
var box buyRewardZone = na
var box sellRiskZone = na
var box sellRewardZone = na
var line buyEntryLine = na
var label buyEntryLabel = na
var line sellEntryLine = na
var label sellEntryLabel = na

if signalBuy
    // Build key reasons
    buyReasons = ""
    if exhBuyScore > 0.4
        buyReasons += "Bearish exhaustion detected\n"
    if revBuyScore > 0.3
        buyReasons += "Reversal triggers firing\n"
    if structBuyScore > 0.15
        buyReasons += "Structure supports reversal\n"
    if volBuyScore > 0.4
        buyReasons += "Volume confirming\n"
    if trendAlignBuyScore > 0.5
        buyReasons += "HTF trend aligned\n"
    if bullishDivergence
        buyReasons += "Bullish divergence (+8)\n"
    if wyckSpring
        buyReasons += "Wyckoff Spring (+8)\n"
    if chochBullish
        buyReasons += "CHoCH confirmed (+5)\n"
    if lagSellCount >= 11
        buyReasons += "Bears overextended (" + str.tostring(lagSellCount) + "/17 lag)\n"
    if volSpikeMult < 1.0
        buyReasons += "ATTENTION: Vol spike penalty (" + str.tostring(volSpikeMult, "#.##") + "x)\n"
    if inPremium
        buyReasons += "ATTENTION: Buying in Premium zone (0.82x)\n"
    combinedMbuy = rSqMult * volSpikeMult * pdPenaltyBuy * zScoreBuyMult * sessionMult
    buyReasons += "Combined mult: " + str.tostring(combinedMbuy, "#.##") + "x\n"
    buySLSource = structSLBuyOk ? "[Swing]" : structSLBuyOk2 ? "[SwingMomentum]" : "[ATR]"

    buyTooltip = "Buy Signal\n" + "Score: " + str.tostring(finalBuyScore, "#.#") + "/100 (" + buyConfidence + ")\n" + "Dominance: +" + str.tostring(buyDominance, "#.#") + " vs sell\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "Exhaustion:  " + str.tostring(exhBuyScore * 100, "#") + "% (wt 30%)\n" + "Reversal:    " + str.tostring(revBuyScore * 100, "#") + "% (wt 25%)\n" + "Structure:   " + str.tostring(structBuyScore * 100, "#") + "% (wt 20%)\n" + "Volume:      " + str.tostring(volBuyScore * 100, "#") + "% (wt 15%)\n" + "Trend Align: " + str.tostring(trendAlignBuyScore * 100, "#") + "% (wt 10%)\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "Categories agree: " + str.tostring(buyCatAgree) + "/5\n" + "R²: " + str.tostring(rSqValue, "#.##") + " (×" + str.tostring(rSqMult, "#.##") + ")" + " | Z: " + str.tostring(zScore[1], "#.#") + "\n" + "HV Rank: " + str.tostring(hvRank[1], "#") + "%" + (volSpikeMult < 1.0 ? " ⚠" : "") + "\n" + "P/D Zone: " + (inPremium ? "Premium ⚠" : "Discount ✓") + "\n" + "Lagging bull/bear: " + str.tostring(lagBuyCount) + "/" + str.tostring(lagSellCount) + "\n" + "Divergence: " + (bullishDivergence ? "YES (+8)" : "No") + "\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "KEY REASONS:\n" + buyReasons + "━━━━━━━━━━━━━━━━━━━━\n" + "Entry: " + str.tostring(close, "#.##") + "\n" + "SL: " + str.tostring(buySL, "#.##") + " (-" + str.tostring((close - buySL) / close * 100, "#.#") + "%) " + buySLSource + "\n" + "TP: " + str.tostring(buyTP, "#.##") + " (+" + str.tostring((buyTP - close) / close * 100, "#.#") + "%) at " + buyTPSource + "\n" + "R:R = 1:" + str.tostring(buyActualRR, "#.#")

    // --- Handle previous buy signals ---
    if usePrevSignals
        grayLine = color.new(color.rgb(90, 90, 105), prevSignalTransparency)
        grayLabel = color.new(color.rgb(90, 90, 105), math.min(prevSignalTransparency + 10, 99))
        grayTxt = color.new(color.rgb(130, 130, 145), math.max(prevSignalTransparency - 20, 30))
        grayBox = color.new(color.rgb(90, 90, 105), math.min(prevSignalTransparency + 8, 99))
        grayBoxBorder = color.new(color.rgb(90, 90, 105), prevSignalTransparency)
        if not na(buyZone)
            box.set_bgcolor(buyZone, grayBox)
            box.set_border_color(buyZone, grayBoxBorder)
            box.set_text_color(buyZone, grayTxt)
        if not na(buyZoneLabel)
            label.set_color(buyZoneLabel, grayLabel)
            label.set_textcolor(buyZoneLabel, grayTxt)
        if not na(buyEntryLine)
            line.set_color(buyEntryLine, grayLine)
            label.set_color(buyEntryLabel, grayLabel)
            label.set_textcolor(buyEntryLabel, grayTxt)
        if not na(buySLLine)
            line.set_color(buySLLine, grayLine)
            line.set_color(buyTPLine, grayLine)
            label.set_color(buySLLabel, grayLabel)
            label.set_textcolor(buySLLabel, grayTxt)
            label.set_color(buyTPLabel, grayLabel)
            label.set_textcolor(buyTPLabel, grayTxt)
        if not na(buyRiskZone)
            box.set_bgcolor(buyRiskZone, grayBox)
            box.set_border_color(buyRiskZone, grayBoxBorder)
        if not na(buyRewardZone)
            box.set_bgcolor(buyRewardZone, grayBox)
            box.set_border_color(buyRewardZone, grayBoxBorder)
        if not na(sellRiskZone)
            box.set_bgcolor(sellRiskZone, grayBox)
            box.set_border_color(sellRiskZone, grayBoxBorder)
        if not na(sellRewardZone)
            box.set_bgcolor(sellRewardZone, grayBox)
            box.set_border_color(sellRewardZone, grayBoxBorder)
        // --- Gray out previous sell signals (only one active at a time) ---
        if not na(sellZone)
            box.set_bgcolor(sellZone, grayBox)
            box.set_border_color(sellZone, grayBoxBorder)
            box.set_text_color(sellZone, grayTxt)
        if not na(sellZoneLabel)
            label.set_color(sellZoneLabel, grayLabel)
            label.set_textcolor(sellZoneLabel, grayTxt)
        if not na(sellEntryLine)
            line.set_color(sellEntryLine, grayLine)
            label.set_color(sellEntryLabel, grayLabel)
            label.set_textcolor(sellEntryLabel, grayTxt)
        if not na(sellSLLine)
            line.set_color(sellSLLine, grayLine)
            line.set_color(sellTPLine, grayLine)
            label.set_color(sellSLLabel, grayLabel)
            label.set_textcolor(sellSLLabel, grayTxt)
            label.set_color(sellTPLabel, grayLabel)
            label.set_textcolor(sellTPLabel, grayTxt)
    else
        if not na(buyZone)
            box.delete(buyZone)
            buyZone := na
        if not na(buyZoneLabel)
            label.delete(buyZoneLabel)
            buyZoneLabel := na
        if not na(buyEntryLine)
            line.delete(buyEntryLine)
            label.delete(buyEntryLabel)
            buyEntryLine := na
            buyEntryLabel := na
        if not na(buySLLine)
            line.delete(buySLLine)
            line.delete(buyTPLine)
            label.delete(buySLLabel)
            label.delete(buyTPLabel)
            buySLLine := na
            buyTPLine := na
            buySLLabel := na
            buyTPLabel := na
        if not na(buyRiskZone)
            box.delete(buyRiskZone)
            buyRiskZone := na
        if not na(buyRewardZone)
            box.delete(buyRewardZone)
            buyRewardZone := na
        if not na(sellRiskZone)
            box.delete(sellRiskZone)
            sellRiskZone := na
        if not na(sellRewardZone)
            box.delete(sellRewardZone)
            sellRewardZone := na
        if not na(sellZone)
            box.delete(sellZone)
            sellZone := na
        if not na(sellZoneLabel)
            label.delete(sellZoneLabel)
            sellZoneLabel := na
        if not na(sellEntryLine)
            line.delete(sellEntryLine)
            label.delete(sellEntryLabel)
            sellEntryLine := na
            sellEntryLabel := na
        if not na(sellSLLine)
            line.delete(sellSLLine)
            line.delete(sellTPLine)
            label.delete(sellSLLabel)
            label.delete(sellTPLabel)
            sellSLLine := na
            sellTPLine := na
            sellSLLabel := na
            sellTPLabel := na

    // --- New buy zone (body-anchored, ATR-scaled) ---
    if useSignalZone
        zoneHalfH = atrPrev * 0.8
        bodyLow = math.min(open, close)
        buyZoneLow = bodyLow - zoneHalfH * 0.3
        buyZoneHigh = bodyLow + zoneHalfH
        zoneForward = finalBuyScore >= 80 ? 5 : 3
        buyZoneBg = finalBuyScore >= 80 ? color.new(bullPrimary, 78) : color.new(bullSecondary, 82)
        buyZoneBorder = finalBuyScore >= 80 ? color.new(bullPrimary, 35) : color.new(bullSecondary, 50)
        buyZone := box.new(bar_index - 1, buyZoneHigh, bar_index + zoneForward, buyZoneLow, border_color=buyZoneBorder, bgcolor=buyZoneBg, border_width=1, text="BUY " + str.tostring(finalBuyScore, "#"), text_color=color.white, text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
        buyZoneLabel := label.new(bar_index, buyZoneLow - atr * 0.15, "▲ " + str.tostring(finalBuyScore, "#"), style=label.style_label_up, color=buyZoneBorder, textcolor=color.white, size=size.small, tooltip=buyTooltip)

    // --- Entry line ---
    buyEntryLine := line.new(bar_index, close, bar_index + lineLen, close, color=color.new(entryClr, 15), style=line.style_solid, width=2)
    buyEntryLabel := label.new(bar_index + lineLen, close, "ENTRY " + str.tostring(close, "#.##"), style=label.style_label_left, color=color.new(entryClr, 35), textcolor=color.white, size=size.tiny)

    // --- SL/TP lines and/or zones ---
    if useBuySellSLTP
        if slTpDisplayMode == "Zones"
            buyRiskZone := box.new(bar_index, close, bar_index + lineLen, buySL, border_color=color.new(bearPrimary, 40), bgcolor=color.new(bearPrimary, 85), border_width=1)
            buyRewardZone := box.new(bar_index, buyTP, bar_index + lineLen, close, border_color=color.new(bullPrimary, 40), bgcolor=color.new(bullPrimary, 85), border_width=1)
        buySLLine := line.new(bar_index, buySL, bar_index + lineLen, buySL, color=color.new(bearPrimary, 25), style=line.style_dashed, width=2)
        buySLLabel := label.new(bar_index + lineLen, buySL, "SL " + str.tostring(buySL, "#.##"), style=label.style_label_left, color=color.new(bearPrimary, 45), textcolor=color.white, size=size.tiny)
        buyTPLine := line.new(bar_index, buyTP, bar_index + lineLen, buyTP, color=color.new(bullPrimary, 25), style=line.style_dashed, width=1)
        buyTPLabel := label.new(bar_index + lineLen, buyTP, "TP " + str.tostring(buyTP, "#.##") + " " + buyTPSource + " (1:" + str.tostring(buyActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(bullPrimary, 45), textcolor=color.white, size=size.tiny)

    // Track active signal for dashboard
    activeRR := buyActualRR
    activeSLType := structSLBuyOk ? "Swing" : structSLBuyOk2 ? "SwingMomentum" : "ATR"
    activeTP := buyTP
    activeSL := buySL

if signalSell
    sellReasons = ""
    if exhSellScore > 0.4
        sellReasons += "Bullish exhaustion detected\n"
    if revSellScore > 0.3
        sellReasons += "Reversal triggers firing\n"
    if structSellScore > 0.15
        sellReasons += "Structure supports reversal\n"
    if volSellScore > 0.4
        sellReasons += "Volume confirming\n"
    if trendAlignSellScore > 0.5
        sellReasons += "HTF trend aligned\n"
    if bearishDivergence
        sellReasons += "Bearish divergence (+8)\n"
    if wyckUpthrust
        sellReasons += "Wyckoff Upthrust (+8)\n"
    if chochBearish
        sellReasons += "CHoCH confirmed (+5)\n"
    if lagBuyCount >= 11
        sellReasons += "Bulls overextended (" + str.tostring(lagBuyCount) + "/17 lag)\n"
    if volSpikeMult < 1.0
        sellReasons += "ATTENTION: Vol spike penalty (" + str.tostring(volSpikeMult, "#.##") + "x)\n"
    if inDiscount
        sellReasons += "ATTENTION: Selling in Discount zone (0.82x)\n"
    combinedMsell = rSqMult * volSpikeMult * pdPenaltySell * zScoreSellMult * sessionMult
    sellReasons += "Combined mult: " + str.tostring(combinedMsell, "#.##") + "x\n"
    sellSLSource = structSLSellOk ? "[Swing]" : structSLSellOk2 ? "[SwingMomentum]" : "[ATR]"

    sellTooltip = "Sell Signal\n" + "Score: " + str.tostring(finalSellScore, "#.#") + "/100 (" + sellConfidence + ")\n" + "Dominance: +" + str.tostring(sellDominance, "#.#") + " vs buy\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "Exhaustion:  " + str.tostring(exhSellScore * 100, "#") + "% (wt 30%)\n" + "Reversal:    " + str.tostring(revSellScore * 100, "#") + "% (wt 25%)\n" + "Structure:   " + str.tostring(structSellScore * 100, "#") + "% (wt 20%)\n" + "Volume:      " + str.tostring(volSellScore * 100, "#") + "% (wt 15%)\n" + "Trend Align: " + str.tostring(trendAlignSellScore * 100, "#") + "% (wt 10%)\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "Categories agree: " + str.tostring(sellCatAgree) + "/5\n" + "R²: " + str.tostring(rSqValue, "#.##") + " (×" + str.tostring(rSqMult, "#.##") + ")" + " | Z: " + str.tostring(zScore[1], "#.#") + "\n" + "HV Rank: " + str.tostring(hvRank[1], "#") + "%" + (volSpikeMult < 1.0 ? " ⚠" : "") + "\n" + "P/D Zone: " + (inDiscount ? "Discount ⚠" : "Premium ✓") + "\n" + "Lagging bull/bear: " + str.tostring(lagBuyCount) + "/" + str.tostring(lagSellCount) + "\n" + "Divergence: " + (bearishDivergence ? "Yes (+8)" : "No") + "\n" + "━━━━━━━━━━━━━━━━━━━━\n" + "Key Reasons:\n" + sellReasons + "━━━━━━━━━━━━━━━━━━━━\n" + "Entry: " + str.tostring(close, "#.##") + "\n" + "SL: " + str.tostring(sellSL, "#.##") + " (+" + str.tostring((sellSL - close) / close * 100, "#.#") + "%) " + sellSLSource + "\n" + "TP: " + str.tostring(sellTP, "#.##") + " (-" + str.tostring((close - sellTP) / close * 100, "#.#") + "%) at " + sellTPSource + "\n" + "R:R = 1:" + str.tostring(sellActualRR, "#.#")

    // --- Handle previous sell signals ---
    if usePrevSignals
        grayLine = color.new(color.rgb(90, 90, 105), prevSignalTransparency)
        grayLabel = color.new(color.rgb(90, 90, 105), math.min(prevSignalTransparency + 10, 99))
        grayTxt = color.new(color.rgb(130, 130, 145), math.max(prevSignalTransparency - 20, 30))
        grayBox = color.new(color.rgb(90, 90, 105), math.min(prevSignalTransparency + 8, 99))
        grayBoxBorder = color.new(color.rgb(90, 90, 105), prevSignalTransparency)
        if not na(sellZone)
            box.set_bgcolor(sellZone, grayBox)
            box.set_border_color(sellZone, grayBoxBorder)
            box.set_text_color(sellZone, grayTxt)
        if not na(sellZoneLabel)
            label.set_color(sellZoneLabel, grayLabel)
            label.set_textcolor(sellZoneLabel, grayTxt)
        if not na(sellEntryLine)
            line.set_color(sellEntryLine, grayLine)
            label.set_color(sellEntryLabel, grayLabel)
            label.set_textcolor(sellEntryLabel, grayTxt)
        if not na(sellSLLine)
            line.set_color(sellSLLine, grayLine)
            line.set_color(sellTPLine, grayLine)
            label.set_color(sellSLLabel, grayLabel)
            label.set_textcolor(sellSLLabel, grayTxt)
            label.set_color(sellTPLabel, grayLabel)
            label.set_textcolor(sellTPLabel, grayTxt)
        if not na(sellRiskZone)
            box.set_bgcolor(sellRiskZone, grayBox)
            box.set_border_color(sellRiskZone, grayBoxBorder)
        if not na(sellRewardZone)
            box.set_bgcolor(sellRewardZone, grayBox)
            box.set_border_color(sellRewardZone, grayBoxBorder)
        if not na(buyRiskZone)
            box.set_bgcolor(buyRiskZone, grayBox)
            box.set_border_color(buyRiskZone, grayBoxBorder)
        if not na(buyRewardZone)
            box.set_bgcolor(buyRewardZone, grayBox)
            box.set_border_color(buyRewardZone, grayBoxBorder)
        // --- Gray out previous buy signals (only one active at a time) ---
        if not na(buyZone)
            box.set_bgcolor(buyZone, grayBox)
            box.set_border_color(buyZone, grayBoxBorder)
            box.set_text_color(buyZone, grayTxt)
        if not na(buyZoneLabel)
            label.set_color(buyZoneLabel, grayLabel)
            label.set_textcolor(buyZoneLabel, grayTxt)
        if not na(buyEntryLine)
            line.set_color(buyEntryLine, grayLine)
            label.set_color(buyEntryLabel, grayLabel)
            label.set_textcolor(buyEntryLabel, grayTxt)
        if not na(buySLLine)
            line.set_color(buySLLine, grayLine)
            line.set_color(buyTPLine, grayLine)
            label.set_color(buySLLabel, grayLabel)
            label.set_textcolor(buySLLabel, grayTxt)
            label.set_color(buyTPLabel, grayLabel)
            label.set_textcolor(buyTPLabel, grayTxt)
    else
        if not na(sellZone)
            box.delete(sellZone)
            sellZone := na
        if not na(sellZoneLabel)
            label.delete(sellZoneLabel)
            sellZoneLabel := na
        if not na(sellEntryLine)
            line.delete(sellEntryLine)
            label.delete(sellEntryLabel)
            sellEntryLine := na
            sellEntryLabel := na
        if not na(sellSLLine)
            line.delete(sellSLLine)
            line.delete(sellTPLine)
            label.delete(sellSLLabel)
            label.delete(sellTPLabel)
            sellSLLine := na
            sellTPLine := na
            sellSLLabel := na
            sellTPLabel := na
        if not na(sellRiskZone)
            box.delete(sellRiskZone)
            sellRiskZone := na
        if not na(sellRewardZone)
            box.delete(sellRewardZone)
            sellRewardZone := na
        if not na(buyZone)
            box.delete(buyZone)
            buyZone := na
        if not na(buyZoneLabel)
            label.delete(buyZoneLabel)
            buyZoneLabel := na
        if not na(buyEntryLine)
            line.delete(buyEntryLine)
            label.delete(buyEntryLabel)
            buyEntryLine := na
            buyEntryLabel := na
        if not na(buySLLine)
            line.delete(buySLLine)
            line.delete(buyTPLine)
            label.delete(buySLLabel)
            label.delete(buyTPLabel)
            buySLLine := na
            buyTPLine := na
            buySLLabel := na
            buyTPLabel := na
        if not na(buyRiskZone)
            box.delete(buyRiskZone)
            buyRiskZone := na
        if not na(buyRewardZone)
            box.delete(buyRewardZone)
            buyRewardZone := na

    // --- New sell zone (body-anchored, ATR-scaled) ---
    if useSignalZone
        sellZoneHalfH = atrPrev * 0.8
        bodyHigh = math.max(open, close)
        sellZoneHigh = bodyHigh + sellZoneHalfH * 0.3
        sellZoneLow = bodyHigh - sellZoneHalfH
        sellZoneForward = finalSellScore >= 80 ? 5 : 3
        sellZoneBg = finalSellScore >= 80 ? color.new(bearPrimary, 78) : color.new(bearSecondary, 82)
        sellZoneBorder = finalSellScore >= 80 ? color.new(bearPrimary, 35) : color.new(bearSecondary, 50)
        sellZone := box.new(bar_index - 1, sellZoneHigh, bar_index + sellZoneForward, sellZoneLow, border_color=sellZoneBorder, bgcolor=sellZoneBg, border_width=1, text="SELL " + str.tostring(finalSellScore, "#"), text_color=color.white, text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
        sellZoneLabel := label.new(bar_index, sellZoneHigh + atr * 0.15, "▼ " + str.tostring(finalSellScore, "#"), style=label.style_label_down, color=sellZoneBorder, textcolor=color.white, size=size.small, tooltip=sellTooltip)

    // --- Entry line ---
    sellEntryLine := line.new(bar_index, close, bar_index + lineLen, close, color=color.new(entryClr, 15), style=line.style_solid, width=2)
    sellEntryLabel := label.new(bar_index + lineLen, close, "ENTRY " + str.tostring(close, "#.##"), style=label.style_label_left, color=color.new(entryClr, 35), textcolor=color.white, size=size.tiny)

    // --- SL/TP lines and/or zones ---
    if useBuySellSLTP
        if slTpDisplayMode == "Zones"
            sellRewardZone := box.new(bar_index, close, bar_index + lineLen, sellTP, border_color=color.new(bullPrimary, 40), bgcolor=color.new(bullPrimary, 85), border_width=1)
            sellRiskZone := box.new(bar_index, sellSL, bar_index + lineLen, close, border_color=color.new(bearPrimary, 40), bgcolor=color.new(bearPrimary, 85), border_width=1)
        sellSLLine := line.new(bar_index, sellSL, bar_index + lineLen, sellSL, color=color.new(bearPrimary, 25), style=line.style_dashed, width=2)
        sellSLLabel := label.new(bar_index + lineLen, sellSL, "SL " + str.tostring(sellSL, "#.##"), style=label.style_label_left, color=color.new(bearPrimary, 45), textcolor=color.white, size=size.tiny)
        sellTPLine := line.new(bar_index, sellTP, bar_index + lineLen, sellTP, color=color.new(bullPrimary, 25), style=line.style_dashed, width=1)
        sellTPLabel := label.new(bar_index + lineLen, sellTP, "TP " + str.tostring(sellTP, "#.##") + " " + sellTPSource + " (1:" + str.tostring(sellActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(bullPrimary, 45), textcolor=color.white, size=size.tiny)

    // Track active signal for dashboard
    activeRR := sellActualRR
    activeSLType := structSLSellOk ? "Swing" : structSLSellOk2 ? "SwingMomentum" : "ATR"
    activeTP := sellTP
    activeSL := sellSL

// --- Hide signal zones when checkbox is off (runs every bar) ---
if not useSignalZone
    if not na(buyZone)
        box.delete(buyZone)
        buyZone := na
    if not na(buyZoneLabel)
        label.delete(buyZoneLabel)
        buyZoneLabel := na
    if not na(sellZone)
        box.delete(sellZone)
        sellZone := na
    if not na(sellZoneLabel)
        label.delete(sellZoneLabel)
        sellZoneLabel := na

// ==================================================================================
// DASHBOARD functions
// ==================================================================================

f_condColor(met) =>
    met ? color.new(color.rgb(0, 200, 83), 65) : color.new(color.rgb(234, 57, 67), 65)

f_condColor3(bullish, bearish) =>
    bullish ? color.new(color.rgb(0, 200, 83), 65) : bearish ? color.new(color.rgb(234, 57, 67), 65) : color.new(color.rgb(120, 123, 134), 55)

f_condSym(met) =>
    met ? "●" : "○"

f_rowBg(int row) =>
    row % 2 == 0 ? color.rgb(18, 18, 32) : color.rgb(24, 24, 40)

f_sparkline(series float src, lookback) =>
    asciiLadder = " .:-=+#"
    result = ""
    maxVal = ta.highest(src, lookback)
    minVal = ta.lowest(src, lookback)
    rangeVal = math.max(maxVal - minVal, 1e-10)
    for i = lookback - 1 to 0
        idx = math.round((nz(src[i]) - minVal) / rangeVal * 7)
        idx := math.max(0, math.min(7, idx))
        result += str.substring(asciiLadder, idx, idx + 1)
    result

rsiSparkline = f_sparkline(rsiValue, 8)
if useDashboard and barstate.islast
    var table dash = table.new(position.top_right, 5, 61, border_width=0, frame_width=0)

    // Dashboard theme
    headerBg     = color.rgb(22, 22, 36)
    txtLabel     = color.rgb(158, 161, 176)
    txtValue     = color.rgb(225, 227, 234)
    txtSm        = size.tiny
    // Accent colors per section
    accentTrend  = color.rgb(156, 107, 255)
    accentMom    = color.rgb(66, 165, 245)
    accentVol    = color.rgb(0, 200, 83)
    accentVolat  = color.rgb(255, 177, 66)
    accentRegime = color.rgb(255, 112, 67)
    accentMeta   = color.rgb(120, 123, 134)
    accentRisk   = color.rgb(234, 57, 67)
    accentSignal = color.rgb(255, 215, 0)
    accentLevels = color.rgb(255, 167, 38)

    // --- Table Section 1: Title ---
    table.cell(dash, 0, 0, "  Technical Indicators", bgcolor=headerBg, text_color=color.rgb(0, 200, 83), text_size=size.small, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", bgcolor=headerBg)
    table.cell(dash, 2, 0, "", bgcolor=headerBg)
    table.cell(dash, 3, 0, "", bgcolor=headerBg)
    table.cell(dash, 4, 0, "", bgcolor=headerBg)
    table.merge_cells(dash, 0, 0, 4, 0)

    // --- Table Section 2: TREND ---
    table.cell(dash, 0, 2, " TREND", bgcolor=color.new(accentTrend, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 2, "", bgcolor=color.new(accentTrend, 75))
    table.cell(dash, 2, 2, "", bgcolor=color.new(accentTrend, 75))
    table.cell(dash, 3, 2, "", bgcolor=color.new(accentTrend, 75))
    table.cell(dash, 4, 2, "", bgcolor=color.new(accentTrend, 75))
    table.merge_cells(dash, 0, 2, 4, 2)

    table.cell(dash, 0, 3, "Hull MA", bgcolor=f_rowBg(3), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 3, hullTrend ? "Rising" : "Falling", bgcolor=f_condColor(hullTrend), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 3, "SuperTrnd", bgcolor=f_rowBg(3), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 3, stBullish ? "Above" : "Below", bgcolor=f_condColor(stBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 3, f_condSym(hullTrend and stBullish), bgcolor=f_condColor(hullTrend and stBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 4, "ADX", bgcolor=f_rowBg(4), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 4, str.tostring(adxValue[1], "#.#") + ">" + str.tostring(adxThreshold, "#"), bgcolor=f_condColor(adxStrong), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 4, "SAR", bgcolor=f_rowBg(4), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 4, sarBullish ? "Below" : "Above", bgcolor=f_condColor(sarBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 4, f_condSym(adxStrong and sarBullish), bgcolor=f_condColor(adxStrong and sarBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 5, "Ichimoku", bgcolor=f_rowBg(5), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 5, ichBullish ? "Aligned" : ichBearish ? "Bear" : "Mixed", bgcolor=f_condColor(ichBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 5, "Aroon", bgcolor=f_rowBg(5), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 5, "U" + str.tostring(math.round(math.max(0, math.min(100, aroonUp[1]))), "#") + "/D" + str.tostring(math.round(math.max(0, math.min(100, aroonDown[1]))), "#"), bgcolor=f_condColor(aroonBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 5, f_condSym(ichBullish and aroonBullish), bgcolor=f_condColor(ichBullish and aroonBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 6, "LinReg", bgcolor=f_rowBg(6), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 6, linRegSlope[1] > 0 ? "+slope" : "-slope", bgcolor=f_condColor(linRegBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 6, "VWMA", bgcolor=f_rowBg(6), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 6, vwmaBullish ? ">SMA" : "<SMA", bgcolor=f_condColor(vwmaBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 6, f_condSym(linRegBullish and vwmaBullish), bgcolor=f_condColor(linRegBullish and vwmaBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 7, "HTF EMA", bgcolor=f_rowBg(7), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 7, htfTrendUp ? "Above" : "Below", bgcolor=f_condColor(htfTrendUp), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 7, "MA Stack", bgcolor=f_rowBg(7), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 7, maStackUp ? "9>21>50" : maStackDown ? "9<21<50" : "Mixed", bgcolor=f_condColor(maStackUp), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 7, f_condSym(htfTrendUp and maStackUp), bgcolor=f_condColor(htfTrendUp and maStackUp), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 8, "Donchian", bgcolor=f_rowBg(8), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 8, donchianBullish ? ">Mid" : "<Mid", bgcolor=f_condColor(donchianBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 8, "McGinley", bgcolor=f_rowBg(8), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 8, mcginleyBullish ? "Above" : "Below", bgcolor=f_condColor(mcginleyBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 8, f_condSym(donchianBullish and mcginleyBullish), bgcolor=f_condColor(donchianBullish and mcginleyBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 9, "DEMA", bgcolor=f_rowBg(9), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 9, demaBullish ? "Above" : "Below", bgcolor=f_condColor(demaBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 9, "GMMA", bgcolor=f_rowBg(9), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 9, gmmaBullish ? "Short>Long" : "Short<Long", bgcolor=f_condColor(gmmaBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 9, f_condSym(demaBullish and gmmaBullish), bgcolor=f_condColor(demaBullish and gmmaBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 10, "Alligator", bgcolor=f_rowBg(10), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 10, alligatorBullish ? "Aligned^" : alligatorBearish ? "Alignedv" : "Mixed", bgcolor=f_condColor(alligatorBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 10, "Vortex", bgcolor=f_rowBg(10), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 10, vortexBullish ? "VI+>VI-" : "VI-<VI+", bgcolor=f_condColor(vortexBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 10, f_condSym(alligatorBullish and vortexBullish), bgcolor=f_condColor(alligatorBullish and vortexBullish), text_color=txtValue, text_size=txtSm)

    // --- Table Section 2: MOMENTUM ---
    table.cell(dash, 0, 11, " MOMENTUM", bgcolor=color.new(accentMom, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 11, "", bgcolor=color.new(accentMom, 75))
    table.cell(dash, 2, 11, "", bgcolor=color.new(accentMom, 75))
    table.cell(dash, 3, 11, "", bgcolor=color.new(accentMom, 75))
    table.cell(dash, 4, 11, "", bgcolor=color.new(accentMom, 75))
    table.merge_cells(dash, 0, 11, 4, 11)

    table.cell(dash, 0, 12, "RSI", bgcolor=f_rowBg(12), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 12, str.tostring(rsiPrev, "#.#") + " " + rsiSparkline, bgcolor=f_condColor(rsiBullish), text_color=txtValue, text_size=txtSm, text_font_family=font.family_monospace)
    table.cell(dash, 2, 12, "Stoch", bgcolor=f_rowBg(12), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 12, str.tostring(stochKVal[1], "#") + "/" + str.tostring(stochDVal[1], "#"), bgcolor=f_condColor(stochBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 12, f_condSym(rsiBullish and stochBullish), bgcolor=f_condColor(rsiBullish and stochBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 13, "MACD", bgcolor=f_rowBg(13), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 13, macdBullish ? ">Sig" : "<Sig", bgcolor=f_condColor(macdBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 13, "Hist", bgcolor=f_rowBg(13), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 13, str.tostring(macdHist[1], "#.###"), bgcolor=f_condColor(macdHistBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 13, f_condSym(macdBullish and macdHistBullish), bgcolor=f_condColor(macdBullish and macdHistBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 14, "CCI", bgcolor=f_rowBg(14), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 14, str.tostring(cciValue[1], "#"), bgcolor=f_condColor(cciBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 14, "W%R", bgcolor=f_rowBg(14), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 14, str.tostring(wrValue[1], "#"), bgcolor=f_condColor(wrBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 14, f_condSym(cciBullish and wrBullish), bgcolor=f_condColor(cciBullish and wrBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 15, "CMO", bgcolor=f_rowBg(15), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 15, str.tostring(cmoValue[1], "#"), bgcolor=f_condColor(cmoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 15, "Fisher", bgcolor=f_rowBg(15), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 15, fisherBullish ? "Cross^" : "Crossv", bgcolor=f_condColor(fisherBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 15, f_condSym(cmoBullish and fisherBullish), bgcolor=f_condColor(cmoBullish and fisherBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 16, "EFI", bgcolor=f_rowBg(16), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 16, efiBullish ? ">0" : "<0", bgcolor=f_condColor(efiBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 16, "ROC", bgcolor=f_rowBg(16), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 16, str.tostring(roc[1], "#.##") + "%", bgcolor=f_condColor(rocBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 16, f_condSym(efiBullish and rocBullish), bgcolor=f_condColor(efiBullish and rocBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 17, "MFI", bgcolor=f_rowBg(17), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 17, str.tostring(mfiValue[1], "#"), bgcolor=f_condColor(mfiBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 17, "Sine", bgcolor=f_rowBg(17), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 17, sineBullish ? "Bull" : "Bear", bgcolor=f_condColor(sineBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 17, f_condSym(mfiBullish and sineBullish), bgcolor=f_condColor(mfiBullish and sineBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 18, "TRIX", bgcolor=f_rowBg(18), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 18, str.tostring(trixVal[1], "#.####"), bgcolor=f_condColor(trixBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 18, "UO", bgcolor=f_rowBg(18), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 18, str.tostring(uoValue[1], "#"), bgcolor=f_condColor(uoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 18, f_condSym(trixBullish and uoBullish), bgcolor=f_condColor(trixBullish and uoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 19, "KST", bgcolor=f_rowBg(19), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 19, str.tostring(kstValue[1], "#.#"), bgcolor=f_condColor(kstBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 19, "DPO", bgcolor=f_rowBg(19), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 19, str.tostring(dpoValue[1], "#.##"), bgcolor=f_condColor(dpoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 19, f_condSym(kstBullish and dpoBullish), bgcolor=f_condColor(kstBullish and dpoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 20, "RVI", bgcolor=f_rowBg(20), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 20, str.tostring(rviValue[1], "#.##"), bgcolor=f_condColor(rviBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 20, "Schaff", bgcolor=f_rowBg(20), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 20, str.tostring(schaffVal[1], "#"), bgcolor=f_condColor(schaffBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 20, f_condSym(rviBullish and schaffBullish), bgcolor=f_condColor(rviBullish and schaffBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 21, "PGO", bgcolor=f_rowBg(21), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 21, str.tostring(pgoValue[1], "#.##"), bgcolor=f_condColor(pgoBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 21, "Coppock", bgcolor=f_rowBg(21), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 21, str.tostring(coppockValue[1], "#.#"), bgcolor=f_condColor(coppockBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 21, f_condSym(pgoBullish and coppockBullish), bgcolor=f_condColor(pgoBullish and coppockBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 22, "Elder Imp", bgcolor=f_rowBg(22), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 22, elderImpulseBull ? "Bull" : elderImpulseBear ? "Bear" : "Neutral", bgcolor=f_condColor3(elderImpulseBull, elderImpulseBear), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 22, "VW-RSI", bgcolor=f_rowBg(22), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 22, str.tostring(vwRsiValue[1], "#"), bgcolor=f_condColor(vwRsiBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 22, f_condSym(elderImpulseBull and vwRsiBullish), bgcolor=f_condColor(elderImpulseBull and vwRsiBullish), text_color=txtValue, text_size=txtSm)

    // --- Table Section 3: VOLUME ---
    table.cell(dash, 0, 23, " VOLUME", bgcolor=color.new(accentVol, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 23, "", bgcolor=color.new(accentVol, 75))
    table.cell(dash, 2, 23, "", bgcolor=color.new(accentVol, 75))
    table.cell(dash, 3, 23, "", bgcolor=color.new(accentVol, 75))
    table.cell(dash, 4, 23, "", bgcolor=color.new(accentVol, 75))
    table.merge_cells(dash, 0, 23, 4, 23)

    table.cell(dash, 0, 24, "Vol/MA", bgcolor=f_rowBg(24), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 24, str.tostring(volume[1] / math.max(volumeMA[1], 1), "#.#") + "x", bgcolor=f_condColor(volumeConfirm), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 24, "VWAP", bgcolor=f_rowBg(24), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 24, vwapBullish ? "Above" : "Below", bgcolor=f_condColor(vwapBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 24, f_condSym(volumeConfirm and vwapBullish), bgcolor=f_condColor(volumeConfirm and vwapBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 25, "OBV", bgcolor=f_rowBg(25), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 25, obvBullish ? ">MA" : "<MA", bgcolor=f_condColor(obvBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 25, "CMF", bgcolor=f_rowBg(25), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 25, str.tostring(cmfValue[1], "#.##"), bgcolor=f_condColor(cmfBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 25, f_condSym(obvBullish and cmfBullish), bgcolor=f_condColor(obvBullish and cmfBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 26, "A/D", bgcolor=f_rowBg(26), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 26, adLineBullish ? ">MA" : "<MA", bgcolor=f_condColor(adLineBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 26, "PVT", bgcolor=f_rowBg(26), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 26, pvtBullish ? ">MA" : "<MA", bgcolor=f_condColor(pvtBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 26, f_condSym(adLineBullish and pvtBullish), bgcolor=f_condColor(adLineBullish and pvtBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 27, "VolTrend", bgcolor=f_rowBg(27), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 27, volumeRising ? "Rising" : "Flat", bgcolor=f_condColor(volumeRising), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 27, "B/S Pres", bgcolor=f_rowBg(27), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 27, str.tostring(pressureRatio[1] * 100, "#") + "%", bgcolor=f_condColor3(pressureRatio[1] > 0.55, pressureRatio[1] < 0.45), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 27, f_condSym(volumeRising and pressureBullish), bgcolor=f_condColor(volumeRising and pressureBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 28, "Klinger", bgcolor=f_rowBg(28), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 28, klingerBullish ? ">Sig" : "<Sig", bgcolor=f_condColor(klingerBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 28, "EOM", bgcolor=f_rowBg(28), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 28, str.tostring(eomValue[1], "#.##"), bgcolor=f_condColor(eomBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 28, f_condSym(klingerBullish and eomBullish), bgcolor=f_condColor(klingerBullish and eomBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 29, "NVI", bgcolor=f_rowBg(29), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 29, nviBullish ? ">MA" : "<MA", bgcolor=f_condColor(nviBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 29, "PVI", bgcolor=f_rowBg(29), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 29, pviBullish ? ">MA" : "<MA", bgcolor=f_condColor(pviBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 29, f_condSym(nviBullish and pviBullish), bgcolor=f_condColor(nviBullish and pviBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 30, "III", bgcolor=f_rowBg(30), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 30, iiiBullish ? ">0" : "<0", bgcolor=f_condColor(iiiBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 30, "MFI(BW)", bgcolor=f_rowBg(30), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 30, mfiBWBullish ? "Up+Vol" : "Dn+Vol", bgcolor=f_condColor(mfiBWBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 30, f_condSym(iiiBullish and mfiBWBullish), bgcolor=f_condColor(iiiBullish and mfiBWBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 0, 31, "Twiggs MF", bgcolor=f_rowBg(31), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 31, twiggsBullish ? ">0" : "<0", bgcolor=f_condColor(twiggsBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 31, "", bgcolor=f_rowBg(31))
    table.cell(dash, 3, 31, "", bgcolor=f_rowBg(31))
    table.cell(dash, 4, 31, "", bgcolor=f_rowBg(31))

    // --- Table Section 4: VOLATILITY ---
    table.cell(dash, 0, 32, " VOLATILITY", bgcolor=color.new(accentVolat, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 32, "", bgcolor=color.new(accentVolat, 75))
    table.cell(dash, 2, 32, "", bgcolor=color.new(accentVolat, 75))
    table.cell(dash, 3, 32, "", bgcolor=color.new(accentVolat, 75))
    table.cell(dash, 4, 32, "", bgcolor=color.new(accentVolat, 75))
    table.merge_cells(dash, 0, 32, 4, 32)

    table.cell(dash, 0, 33, "BB Pos", bgcolor=f_rowBg(33), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 33, str.tostring(bbPercent[1] * 100, "#") + "%", bgcolor=f_condColor(bbNotExtremes), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 33, "Squeeze", bgcolor=f_rowBg(33), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 33, ttmSqueezeOn ? "ON" : "Off", bgcolor=ttmSqueezeOn ? color.new(warningColor, 40) : f_condColor(true), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 33, f_condSym(bbNotExtremes and not ttmSqueezeOn), bgcolor=f_condColor(bbNotExtremes and not ttmSqueezeOn), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 34, "TTM", bgcolor=f_rowBg(34), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 34, ttmFirBull ? "Fire^" : ttmFirBear ? "Firev" : "-", bgcolor=f_condColor(ttmFirBull), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 34, "Keltner", bgcolor=f_rowBg(34), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 34, kcBullish ? ">Mid" : "<Mid", bgcolor=f_condColor(kcBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 34, f_condSym(kcBullish), bgcolor=f_condColor(kcBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 35, "Chandlr", bgcolor=f_rowBg(35), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 35, chandBullish ? "Above" : "Below", bgcolor=f_condColor(chandBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 35, "ATR Rng", bgcolor=f_rowBg(35), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 35, atrInRange ? "OK" : "Out", bgcolor=f_condColor(atrInRange), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 35, f_condSym(chandBullish and atrInRange), bgcolor=f_condColor(chandBullish and atrInRange), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 36, "Mass Idx", bgcolor=f_rowBg(36), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 36, str.tostring(massValue[1], "#.#") + (massBulge ? " Bulge" : ""), bgcolor=massBulge ? color.new(warningColor, 50) : f_condColor(true), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 36, "BB", bgcolor=f_rowBg(36), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 36, bbBullish ? ">Basis" : "<Basis", bgcolor=f_condColor(bbBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 36, f_condSym(not massBulge and bbBullish), bgcolor=f_condColor(not massBulge and bbBullish), text_color=txtValue, text_size=txtSm)

    // --- Table Section 5: REGIME ---
    table.cell(dash, 0, 37, " REGIME", bgcolor=color.new(accentRegime, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 37, "", bgcolor=color.new(accentRegime, 75))
    table.cell(dash, 2, 37, "", bgcolor=color.new(accentRegime, 75))
    table.cell(dash, 3, 37, "", bgcolor=color.new(accentRegime, 75))
    table.cell(dash, 4, 37, "", bgcolor=color.new(accentRegime, 75))
    table.merge_cells(dash, 0, 37, 4, 37)

    table.cell(dash, 0, 38, "P/D Zone", bgcolor=f_rowBg(38), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 38, inDiscount ? "Discount" : "Premium", bgcolor=f_condColor(premiumDiscountOkBuy), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 38, "HTF RSI", bgcolor=f_rowBg(38), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 38, str.tostring(htfRsiPrev, "#.#"), bgcolor=f_condColor3(htfRsiPrev >= 40 and htfRsiPrev <= 70, false), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 38, f_condSym(premiumDiscountOkBuy and htfRsiOkBuy), bgcolor=f_condColor(premiumDiscountOkBuy and htfRsiOkBuy), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 39, "RelStr", bgcolor=f_rowBg(39), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 39, rsBullish ? ">Bench" : "<Bench", bgcolor=f_condColor(rsBullish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 39, "Corr", bgcolor=f_rowBg(39), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 39, str.tostring(corrValue[1], "#.##"), bgcolor=f_condColor3(corrBullish, corrBearish), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 39, f_condSym(rsBullish and corrBullish), bgcolor=f_condColor(rsBullish and corrBullish), text_color=txtValue, text_size=txtSm)

    table.cell(dash, 0, 40, "HV Rank", bgcolor=f_rowBg(40), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 40, str.tostring(hvRank[1], "#") + "%", bgcolor=hvLow ? color.new(bullSecondary, 50) : hvHigh ? color.new(warningColor, 50) : f_condColor(true), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 40, "Wyckoff", bgcolor=f_rowBg(40), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 40, wyckSpring ? "Spring" : wyckUpthrust ? "Upthr" : "-", bgcolor=f_condColor(wyckSpring), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 40, f_condSym(not hvHigh), bgcolor=f_condColor(not hvHigh), text_color=txtValue, text_size=txtSm)

    // --- Table Section 6: META-MODIFIERS ---
    table.cell(dash, 0, 41, " META-MODIFIERS", bgcolor=color.new(accentMeta, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 41, "", bgcolor=color.new(accentMeta, 75))
    table.cell(dash, 2, 41, "", bgcolor=color.new(accentMeta, 75))
    table.cell(dash, 3, 41, "", bgcolor=color.new(accentMeta, 75))
    table.cell(dash, 4, 41, "", bgcolor=color.new(accentMeta, 75))
    table.merge_cells(dash, 0, 41, 4, 41)

    table.cell(dash, 0, 42, "R²", bgcolor=f_rowBg(42), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 42, str.tostring(rSqValue, "#.##") + (rSqValue > 0.5 ? " Trend" : " Chop"), bgcolor=rSqValue > 0.5 ? color.new(bullSecondary, 50) : color.new(warningColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 42, "Z-Score", bgcolor=f_rowBg(42), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 42, str.tostring(zScore[1], "#.#"), bgcolor=math.abs(zScore[1]) > 2 ? color.new(warningColor, 40) : f_condColor(true), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 42, "", bgcolor=f_rowBg(42))

    table.cell(dash, 0, 43, "Cycle", bgcolor=f_rowBg(43), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 43, str.tostring(dominantPeriod, "#") + " bars", bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 43, "Regime", bgcolor=f_rowBg(43), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 43, regimeShort, bgcolor=trendUp and adxStrong ? color.new(bullPrimary, 50) : trendDown and adxStrong ? color.new(bearPrimary, 50) : color.new(warningColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 43, "", bgcolor=f_rowBg(43))

    // --- Table Section 7: RISK ---
    table.cell(dash, 0, 44, " RISK MANAGEMENT", bgcolor=color.new(accentRisk, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 44, "", bgcolor=color.new(accentRisk, 75))
    table.cell(dash, 2, 44, "", bgcolor=color.new(accentRisk, 75))
    table.cell(dash, 3, 44, "", bgcolor=color.new(accentRisk, 75))
    table.cell(dash, 4, 44, "", bgcolor=color.new(accentRisk, 75))
    table.merge_cells(dash, 0, 44, 4, 44)

    table.cell(dash, 0, 45, "ATR", bgcolor=f_rowBg(45), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 45, str.tostring(atrPrev, "#.##"), bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 45, "SL Dist", bgcolor=f_rowBg(45), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 45, not na(activeSL) ? str.tostring(math.abs(close - activeSL), "#.##") + " (" + activeSLType + ")" : str.tostring(atrPrev * atrMultiplierSL, "#.##") + " (" + str.tostring(atrMultiplierSL, "#.#") + "x)", bgcolor=color.new(bearSecondary, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 45, "", bgcolor=f_rowBg(45))

    table.cell(dash, 0, 46, "TP Dist", bgcolor=f_rowBg(46), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 46, not na(activeTP) ? str.tostring(math.abs(activeTP - close), "#.##") : str.tostring(atrPrev * atrMultiplierTP, "#.##") + " (" + str.tostring(atrMultiplierTP, "#.#") + "x)", bgcolor=color.new(bullSecondary, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 46, "R:R", bgcolor=f_rowBg(46), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 46, activeRR > 0 ? "1:" + str.tostring(activeRR, "#.#") : "1:" + str.tostring(buySellRR, "#.#"), bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 46, "", bgcolor=f_rowBg(46))

    // --- Table Section 8: MTF HEATMAP ---
    if useMTFHeatmap
        table.cell(dash, 0, 47, " MTF HEATMAP", bgcolor=color.new(accentMeta, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
        table.cell(dash, 1, 47, "", bgcolor=color.new(accentMeta, 75))
        table.cell(dash, 2, 47, "", bgcolor=color.new(accentMeta, 75))
        table.cell(dash, 3, 47, "", bgcolor=color.new(accentMeta, 75))
        table.cell(dash, 4, 47, "", bgcolor=color.new(accentMeta, 75))
        table.merge_cells(dash, 0, 47, 4, 47)

        table.cell(dash, 0, 48, "M5", bgcolor=mtf5 ? color.new(bullPrimary, 40) : color.new(bearPrimary, 40), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 1, 48, "M15", bgcolor=mtf15 ? color.new(bullPrimary, 40) : color.new(bearPrimary, 40), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 2, 48, "H1", bgcolor=mtf60 ? color.new(bullPrimary, 40) : color.new(bearPrimary, 40), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 3, 48, "H4", bgcolor=mtf240 ? color.new(bullPrimary, 40) : color.new(bearPrimary, 40), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 4, 48, "D", bgcolor=mtfD ? color.new(bullPrimary, 40) : color.new(bearPrimary, 40), text_color=txtValue, text_size=txtSm)

    // --- BUY/SELL SIGNAL ---
    if useBuySellSignal
        table.cell(dash, 0, 49, " BUY/SELL SIGNAL", bgcolor=color.new(accentSignal, 30), text_color=color.rgb(20, 20, 35), text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
        table.cell(dash, 1, 49, "", bgcolor=color.new(accentSignal, 75))
        table.cell(dash, 2, 49, "", bgcolor=color.new(accentSignal, 75))
        table.cell(dash, 3, 49, "", bgcolor=color.new(accentSignal, 75))
        table.cell(dash, 4, 49, "", bgcolor=color.new(accentSignal, 75))
        table.merge_cells(dash, 0, 49, 4, 49)

        buyScoreBg = finalBuyScore >= 80 ? color.new(bullPrimary, 30) : finalBuyScore >= 65 ? color.new(bullSecondary, 40) : color.new(neutralColor, 50)
        sellScoreBg = finalSellScore >= 80 ? color.new(bearPrimary, 30) : finalSellScore >= 65 ? color.new(bearSecondary, 40) : color.new(neutralColor, 50)

        table.cell(dash, 0, 50, "Buy Score", bgcolor=f_rowBg(50), text_color=txtLabel, text_size=txtSm)
        table.cell(dash, 1, 50, str.tostring(finalBuyScore, "#.#") + "/100", bgcolor=buyScoreBg, text_color=txtValue, text_size=txtSm)
        table.cell(dash, 2, 50, "Sell Score", bgcolor=f_rowBg(50), text_color=txtLabel, text_size=txtSm)
        table.cell(dash, 3, 50, str.tostring(finalSellScore, "#.#") + "/100", bgcolor=sellScoreBg, text_color=txtValue, text_size=txtSm)
        table.cell(dash, 4, 50, buyCatAgree > sellCatAgree ? "BUY" : sellCatAgree > buyCatAgree ? "SELL" : "-", bgcolor=buyCatAgree > sellCatAgree ? color.new(bullPrimary, 40) : sellCatAgree > buyCatAgree ? color.new(bearPrimary, 40) : color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)

        table.cell(dash, 0, 51, "Cats Agree", bgcolor=f_rowBg(51), text_color=txtLabel, text_size=txtSm)
        table.cell(dash, 1, 51, str.tostring(buyCatAgree) + "/5 Buy", bgcolor=f_condColor(buyCatAgree >= 4), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 2, 51, "", bgcolor=f_rowBg(51), text_color=txtLabel, text_size=txtSm)
        table.cell(dash, 3, 51, str.tostring(sellCatAgree) + "/5 Sell", bgcolor=f_condColor(sellCatAgree >= 4), text_color=txtValue, text_size=txtSm)
        table.cell(dash, 4, 51, str.tostring(barsSinceLastBuy) + "/" + str.tostring(barsSinceLastSell) + " ago", bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)

    // --- LEVELS ---
    table.cell(dash, 0, 53, " LEVELS", bgcolor=color.new(accentLevels, 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 53, "", bgcolor=color.new(accentLevels, 75))
    table.cell(dash, 2, 53, "", bgcolor=color.new(accentLevels, 75))
    table.cell(dash, 3, 53, "", bgcolor=color.new(accentLevels, 75))
    table.cell(dash, 4, 53, "", bgcolor=color.new(accentLevels, 75))
    table.merge_cells(dash, 0, 53, 4, 53)
    table.cell(dash, 0, 54, "Pivot P", bgcolor=f_rowBg(54), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 54, str.tostring(pivotP[1], "#.##"), bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 54, "R1/S1", bgcolor=f_rowBg(54), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 54, usePivots ? str.tostring(pivotR1, "#.#") + "/" + str.tostring(pivotS1, "#.#") : "-", bgcolor=nearPivotR1 ? color.new(bearSecondary, 50) : nearPivotS1 ? color.new(bullSecondary, 50) : color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 54, "", bgcolor=f_rowBg(54))
    table.cell(dash, 0, 55, "Fib 0.5", bgcolor=f_rowBg(55), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 1, 55, str.tostring(fib50[1], "#.##"), bgcolor=color.new(neutralColor, 50), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 2, 55, "Gap", bgcolor=f_rowBg(55), text_color=txtLabel, text_size=txtSm)
    table.cell(dash, 3, 55, gapUp ? "Up" : gapDown ? "Dn" : "None", bgcolor=f_condColor3(gapUp, gapDown), text_color=txtValue, text_size=txtSm)
    table.cell(dash, 4, 55, "", bgcolor=f_rowBg(55))

// ==================================================================================
// DATA WINDOW OUTPUTS
// ==================================================================================

