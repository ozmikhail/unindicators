    table.cell(dash, 3, 58, gapUp ? "Up" : gapDown ? "Dn" : "None", bgcolor=f_condColor3(gapUp, gapDown), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 58, "", bgcolor=f_rowBg(58))

f_calcSLTP(float slLastHigh, float slLastLow, int slAgeBuy, int slAgeSell, float slLastLow2, float slLastHigh2, int slAgeBuy2, int slAgeSell2, float cl, float openP, float atrP, float finBuy, float finSell, float atrMultSL, float rrMult, float minSlPct) =>
    atrSLDist = atrP * atrMultSL
    structDistBuy = cl - slLastLow
    structSLBuyOk = not na(slLastLow) and slLastLow > 0 and slAgeBuy <= 30 and structDistBuy >= atrP * 0.5 and structDistBuy <= atrP * 4.5
    structDistBuy2 = cl - slLastLow2
    structSLBuyOk2 = not na(slLastLow2) and slLastLow2 > 0 and slAgeBuy2 <= 50 and structDistBuy2 >= atrP * 0.5 and structDistBuy2 <= atrP * 4.5
    structDistSell = slLastHigh - cl
    structSLSellOk = not na(slLastHigh) and slLastHigh > 0 and slAgeSell <= 30 and structDistSell >= atrP * 0.5 and structDistSell <= atrP * 4.5
    structDistSell2 = slLastHigh2 - cl
    structSLSellOk2 = not na(slLastHigh2) and slLastHigh2 > 0 and slAgeSell2 <= 50 and structDistSell2 >= atrP * 0.5 and structDistSell2 <= atrP * 4.5
    slBufferBuy = finBuy >= 80 ? 0.30 : finBuy >= 65 ? 0.40 : 0.50
    slBufferSell = finSell >= 80 ? 0.30 : finSell >= 65 ? 0.40 : 0.50
    buySL = structSLBuyOk ? (slLastLow - atrP * slBufferBuy) : structSLBuyOk2 ? (slLastLow2 - atrP * slBufferBuy) : (cl - atrSLDist)
    sellSL = structSLSellOk ? (slLastHigh + atrP * slBufferSell) : structSLSellOk2 ? (slLastHigh2 + atrP * slBufferSell) : (cl + atrSLDist)
    zoneMultBuy = finBuy >= 80 ? 0.5 : finBuy >= 65 ? 0.7 : 0.9
    zoneMultSell = finSell >= 80 ? 0.5 : finSell >= 65 ? 0.7 : 0.9
    buyEntryApprox = math.min(openP, cl) + atrP * zoneMultBuy * 0.35
    sellEntryApprox = math.max(openP, cl) - atrP * zoneMultSell * 0.35
    minSlDistBuy = buyEntryApprox * (minSlPct / 100)
    minSlDistSell = sellEntryApprox * (minSlPct / 100)
    buySL := math.min(buySL, buyEntryApprox - math.max(atrP * 1.0, minSlDistBuy))
    sellSL := math.max(sellSL, sellEntryApprox + math.max(atrP * 1.0, minSlDistSell))
    fixedBuyTP = cl + (cl - buySL) * rrMult
    fixedSellTP = cl - (sellSL - cl) * rrMult
    [buySL, sellSL, fixedBuyTP, fixedSellTP, structSLBuyOk, structSLBuyOk2, structSLSellOk, structSLSellOk2]

f_calcTPTargets(float lastSwH, float lastSwL, float pR1, float pS1, float pR2, float pS2, float lastBearOBH, float lastBullOBL, float fib38, float fib61, float vwap, float bbUp, float bbLo, float ema200, float prevDH, float prevDL, float cl, float atrP, bool usePivots, float buySL, float sellSL, float fixedBuyTP, float fixedSellTP, float finBuy, float finSell, float openP, float atrMultTP, bool trendUp, bool trendDown, bool adxStr, float trendAlignBuySc, float trendAlignSellSc, float srR1Top, float srR2Top, float srS1Bot, float srS2Bot, bool tp2UseSR, float tp2MinPct, float tpMinDistPct) =>
    entryZoneMultPre = finBuy >= 80 ? 0.5 : finBuy >= 65 ? 0.7 : 0.9
    buyZoneHighPre = math.min(openP, cl) + atrP * entryZoneMultPre
    sellZoneLowPre = math.max(openP, cl) - atrP * (finSell >= 80 ? 0.5 : finSell >= 65 ? 0.7 : 0.9)
    buyRisk = cl - buySL
    minRRStructural = 1.35
    nearBuyTarget = fixedBuyTP
    buyTPSource = "R:R"
    if not USE_SINGLE_TP
        if lastSwH > cl + atrP * 0.15 and (lastSwH - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, lastSwH)
            buyTPSource := "S/R"
        if usePivots and pR1 > cl + atrP * 0.15 and (pR1 - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, pR1)
            buyTPSource := "R1"
        if not na(lastBearOBH) and lastBearOBH > cl + atrP * 0.15 and (lastBearOBH - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, lastBearOBH)
            buyTPSource := "OB"
        if fib38 > cl + atrP * 0.15 and fib38 < cl + atrP * 6 and (fib38 - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, fib38)
            buyTPSource := "Fib38"
        if fib61 > cl + atrP * 0.15 and fib61 < cl + atrP * 6 and (fib61 - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, fib61)
            buyTPSource := "Fib62"
        if vwap > cl + atrP * 0.15 and (vwap - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, vwap)
            buyTPSource := "VWAP"
        if bbUp > cl + atrP * 0.15 and (bbUp - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, bbUp)
            buyTPSource := "BB"
        if ema200 > cl + atrP * 0.15 and (ema200 - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, ema200)
            buyTPSource := "EMA200"
        if not na(prevDH) and prevDH > cl + atrP * 0.15 and (prevDH - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, prevDH)
            buyTPSource := "PDH"
        if usePivots and pR2 > cl + atrP * 0.15 and (pR2 - cl) / buyRisk >= minRRStructural
            nearBuyTarget := math.min(nearBuyTarget, pR2)
            buyTPSource := "R2"
    trendExtendBuy = trendUp and trendAlignBuySc > 0.35 and (adxStr or trendAlignBuySc > 0.55)
    buyTP = (trendExtendBuy and nearBuyTarget < fixedBuyTP) ? fixedBuyTP : nearBuyTarget
    if trendExtendBuy and nearBuyTarget < fixedBuyTP
        buyTPSource := "R:R"
    buyTP := math.max(buyTP, buyZoneHighPre + atrP * 0.2)
    buyTP := math.min(buyTP, cl + atrP * atrMultTP)
    buyActualRR = buyRisk > 0 ? (buyTP - cl) / buyRisk : 2.0
    sellRisk = sellSL - cl
    nearSellTarget = fixedSellTP
    sellTPSource = "R:R"
    if not USE_SINGLE_TP
        if lastSwL < cl - atrP * 0.15 and (cl - lastSwL) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, lastSwL)
            sellTPSource := "S/R"
        if usePivots and pS1 < cl - atrP * 0.15 and (cl - pS1) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, pS1)
            sellTPSource := "S1"
        if not na(lastBullOBL) and lastBullOBL < cl - atrP * 0.15 and (cl - lastBullOBL) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, lastBullOBL)
            sellTPSource := "OB"
        if fib61 < cl - atrP * 0.15 and fib61 > cl - atrP * 6 and (cl - fib61) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, fib61)
            sellTPSource := "Fib62"
        if fib38 < cl - atrP * 0.15 and fib38 > cl - atrP * 6 and (cl - fib38) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, fib38)
            sellTPSource := "Fib38"
        if vwap < cl - atrP * 0.15 and (cl - vwap) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, vwap)
            sellTPSource := "VWAP"
        if bbLo < cl - atrP * 0.15 and (cl - bbLo) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, bbLo)
            sellTPSource := "BB"
        if ema200 < cl - atrP * 0.15 and (cl - ema200) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, ema200)
            sellTPSource := "EMA200"
        if not na(prevDL) and prevDL < cl - atrP * 0.15 and (cl - prevDL) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, prevDL)
            sellTPSource := "PDL"
        if usePivots and pS2 < cl - atrP * 0.15 and (cl - pS2) / sellRisk >= minRRStructural
            nearSellTarget := math.max(nearSellTarget, pS2)
            sellTPSource := "S2"
    trendExtendSell = trendDown and trendAlignSellSc > 0.35 and (adxStr or trendAlignSellSc > 0.55)
    sellTP = (trendExtendSell and nearSellTarget > fixedSellTP) ? fixedSellTP : nearSellTarget
    if trendExtendSell and nearSellTarget > fixedSellTP
        sellTPSource := "R:R"
    sellTP := math.min(sellTP, sellZoneLowPre - atrP * 0.2)
    sellTP := math.max(sellTP, cl - atrP * atrMultTP)
    sellActualRR = sellRisk > 0 ? (cl - sellTP) / sellRisk : 2.0
    buyTPPct = (buyTP - cl) / cl * 100
    sellTPPct = (cl - sellTP) / cl * 100
    useTwoTPsBuy = false
    useTwoTPsSell = false
    buyTP1 = buyTP
    buyTP2 = buyTP
    sellTP1 = sellTP
    sellTP2 = sellTP
    if not USE_SINGLE_TP
        buyR1Valid = not na(srR1Top) and srR1Top > cl
        buyR2Valid = not na(srR2Top) and srR2Top > cl
        buyFirstR = buyR1Valid ? srR1Top : (buyR2Valid ? srR2Top : na)
        buySecondR = (buyR1Valid and buyR2Valid) ? srR2Top : na
        buyFirstRValid = not na(buyFirstR)
        useSRBuy = tp2UseSR and buyFirstRValid and buyTP > buyFirstR
        useTwoTPsBuy := useSRBuy or (buyTPPct > tp2MinPct)
        buyTP1 := useSRBuy ? buyFirstR : (buyTPPct > tp2MinPct ? cl + (buyTP - cl) * 0.5 : buyTP)
        buyTP2 := useSRBuy ? (not na(buySecondR) ? math.min(buyTP, buySecondR) : buyTP) : (buyTPPct > tp2MinPct ? buyTP : buyTP)
        sellS1Valid = not na(srS1Bot) and srS1Bot < cl
        sellS2Valid = not na(srS2Bot) and srS2Bot < cl
        sellFirstS = sellS1Valid ? srS1Bot : (sellS2Valid ? srS2Bot : na)
        sellSecondS = (sellS1Valid and sellS2Valid) ? srS2Bot : na
        sellFirstSValid = not na(sellFirstS)
        useSRSell = tp2UseSR and sellFirstSValid and sellTP < sellFirstS
        useTwoTPsSell := useSRSell or (sellTPPct > tp2MinPct)
        sellTP1 := useSRSell ? sellFirstS : (sellTPPct > tp2MinPct ? cl - (cl - sellTP) * 0.5 : sellTP)
        sellTP2 := useSRSell ? (not na(sellSecondS) ? math.min(sellTP, sellSecondS) : sellTP) : (sellTPPct > tp2MinPct ? sellTP : sellTP)
        buyTPDistPct = (buyTP2 - buyTP1) / cl * 100
        sellTPDistPct = (sellTP1 - sellTP2) / cl * 100
        buyTPsTooClose = useTwoTPsBuy and buyTPDistPct < tpMinDistPct
        sellTPsTooClose = useTwoTPsSell and sellTPDistPct < tpMinDistPct
        if buyTPsTooClose
            useTwoTPsBuy := false
            buyTP1 := buyTP
            buyTP2 := buyTP
        if sellTPsTooClose
            useTwoTPsSell := false
            sellTP1 := sellTP
            sellTP2 := sellTP
    [nearBuyTarget, buyTPSource, buyTP, buyActualRR, nearSellTarget, sellTPSource, sellTP, sellActualRR, trendExtendBuy, trendExtendSell, useTwoTPsBuy, useTwoTPsSell, buyTP1, buyTP2, sellTP1, sellTP2]

f_calcResistanceZones(array<float> phPrices, array<int> phBars, float zoneWidth, int lookback, int minTouches, int maxZones) =>
    float r1T = na
    float r1B = na
    int r1S = na
    float r2T = na
    float r2B = na
    int r2S = na
    if array.size(phPrices) >= 1
        rLo = array.new_float(20, na)
        rHi = array.new_float(20, na)
        rStartB = array.new_int(20, 2147483647)
        rTouches = array.new_int(20, 0)
        numR = 0
        lb = math.max(0, bar_index - lookback)
        for i = 0 to array.size(phPrices) - 1
            bi = array.get(phBars, i)
            if bi >= lb
                p = array.get(phPrices, i)
                found = false
                for j = 0 to numR - 1
                    zl = array.get(rLo, j) - zoneWidth
                    zh = array.get(rHi, j) + zoneWidth
                    if p >= zl and p <= zh
                        array.set(rLo, j, math.min(array.get(rLo, j), p - zoneWidth * 0.5))
                        array.set(rHi, j, math.max(array.get(rHi, j), p + zoneWidth * 0.5))
                        array.set(rStartB, j, math.min(array.get(rStartB, j), bi))
                        found := true
                        break
                if not found and numR < 20
                    array.set(rLo, numR, p - zoneWidth * 0.5)
                    array.set(rHi, numR, p + zoneWidth * 0.5)
                    array.set(rStartB, numR, bi)
                    numR += 1
        for j = 0 to numR - 1
            tc = 0
            for k = 1 to math.min(lookback, bar_index)
                if high[k] >= array.get(rLo, j) and low[k] <= array.get(rHi, j)
                    tc += 1
            array.set(rTouches, j, tc)
        bestR = -1
        bestRt = 0
        for j = 0 to numR - 1
            if array.get(rTouches, j) >= minTouches and array.get(rTouches, j) > bestRt
                bestRt := array.get(rTouches, j)
                bestR := j
        mergeThreshold = zoneWidth * 2.0
        mergedR1Lo = bestR >= 0 ? array.get(rLo, bestR) : na
        mergedR1Hi = bestR >= 0 ? array.get(rHi, bestR) : na
        mergedR1Start = bestR >= 0 ? array.get(rStartB, bestR) : 2147483647
        for j = 0 to numR - 1
            if j != bestR and bestR >= 0 and array.get(rTouches, j) >= minTouches
                bestCenter = (array.get(rLo, bestR) + array.get(rHi, bestR)) / 2
                candidateCenter = (array.get(rLo, j) + array.get(rHi, j)) / 2
                separation = math.abs(candidateCenter - bestCenter)
                if separation < mergeThreshold
                    mergedR1Lo := math.min(mergedR1Lo, array.get(rLo, j))
                    mergedR1Hi := math.max(mergedR1Hi, array.get(rHi, j))
                    mergedR1Start := math.min(mergedR1Start, array.get(rStartB, j))
        mergedR1Touches = 0
        if not na(mergedR1Lo)
            for k = 1 to math.min(lookback, bar_index)
                if high[k] >= mergedR1Lo and low[k] <= mergedR1Hi
                    mergedR1Touches += 1
        secondR = -1
        secondRt = 0
        minSeparation = zoneWidth
        for j = 0 to numR - 1
            if j != bestR and array.get(rTouches, j) >= minTouches
                bestCenter = bestR >= 0 ? (mergedR1Lo + mergedR1Hi) / 2 : na
                candidateCenter = (array.get(rLo, j) + array.get(rHi, j)) / 2
                separation = not na(bestCenter) ? math.abs(candidateCenter - bestCenter) : 999999
                qualityRatio = array.get(rTouches, j) / math.max(mergedR1Touches, 1)
                if separation >= minSeparation and qualityRatio >= 0.7 and array.get(rTouches, j) > secondRt
                    secondRt := array.get(rTouches, j)
                    secondR := j
        if bestR >= 0
            r1T := mergedR1Hi
            r1B := mergedR1Lo
            r1S := mergedR1Start
        if secondR >= 0 and maxZones >= 2
            r2T := array.get(rHi, secondR)
            r2B := array.get(rLo, secondR)
            r2S := array.get(rStartB, secondR)
    [r1T, r1B, r1S, r2T, r2B, r2S]

f_calcSupportZones(array<float> plPrices, array<int> plBars, float zoneWidth, int lookback, int minTouches, int maxZones) =>
    float s1T = na
    float s1B = na
    int s1S = na
    float s2T = na
    float s2B = na
    int s2S = na
    if array.size(plPrices) >= 1
        sLo = array.new_float(20, na)
        sHi = array.new_float(20, na)
        sStartB = array.new_int(20, 2147483647)
        sTouches = array.new_int(20, 0)
        numS = 0
        lb = math.max(0, bar_index - lookback)
        for i = 0 to array.size(plPrices) - 1
            bi = array.get(plBars, i)
            if bi >= lb
                p = array.get(plPrices, i)
                found = false
                for j = 0 to numS - 1
                    zl = array.get(sLo, j) - zoneWidth
                    zh = array.get(sHi, j) + zoneWidth
                    if p >= zl and p <= zh
                        array.set(sLo, j, math.min(array.get(sLo, j), p - zoneWidth * 0.5))
                        array.set(sHi, j, math.max(array.get(sHi, j), p + zoneWidth * 0.5))
                        array.set(sStartB, j, math.min(array.get(sStartB, j), bi))
                        found := true
                        break
                if not found and numS < 20
                    array.set(sLo, numS, p - zoneWidth * 0.5)
                    array.set(sHi, numS, p + zoneWidth * 0.5)
                    array.set(sStartB, numS, bi)
                    numS += 1
        for j = 0 to numS - 1
            tc = 0
            for k = 1 to math.min(lookback, bar_index)
                if high[k] >= array.get(sLo, j) and low[k] <= array.get(sHi, j)
                    tc += 1
            array.set(sTouches, j, tc)
        bestS = -1
        bestSt = 0
        for j = 0 to numS - 1
            if array.get(sTouches, j) >= minTouches and array.get(sTouches, j) > bestSt
                bestSt := array.get(sTouches, j)
                bestS := j
        mergeThreshold = zoneWidth * 2.0
        mergedS1Lo = bestS >= 0 ? array.get(sLo, bestS) : na
        mergedS1Hi = bestS >= 0 ? array.get(sHi, bestS) : na
        mergedS1Start = bestS >= 0 ? array.get(sStartB, bestS) : 2147483647
        for j = 0 to numS - 1
            if j != bestS and bestS >= 0 and array.get(sTouches, j) >= minTouches
                bestCenter = (array.get(sLo, bestS) + array.get(sHi, bestS)) / 2
                candidateCenter = (array.get(sLo, j) + array.get(sHi, j)) / 2
                separation = math.abs(candidateCenter - bestCenter)
                if separation < mergeThreshold
                    mergedS1Lo := math.min(mergedS1Lo, array.get(sLo, j))
                    mergedS1Hi := math.max(mergedS1Hi, array.get(sHi, j))
                    mergedS1Start := math.min(mergedS1Start, array.get(sStartB, j))
        mergedS1Touches = 0
        if not na(mergedS1Lo)
            for k = 1 to math.min(lookback, bar_index)
                if high[k] >= mergedS1Lo and low[k] <= mergedS1Hi
                    mergedS1Touches += 1
        secondS = -1
        secondSt = 0
        minSeparation = zoneWidth
        for j = 0 to numS - 1
            if j != bestS and array.get(sTouches, j) >= minTouches
                bestCenter = bestS >= 0 ? (mergedS1Lo + mergedS1Hi) / 2 : na
                candidateCenter = (array.get(sLo, j) + array.get(sHi, j)) / 2
                separation = not na(bestCenter) ? math.abs(candidateCenter - bestCenter) : 999999
                qualityRatio = array.get(sTouches, j) / math.max(mergedS1Touches, 1)
                if separation >= minSeparation and qualityRatio >= 0.7 and array.get(sTouches, j) > secondSt
                    secondSt := array.get(sTouches, j)
                    secondS := j
        if bestS >= 0
            s1T := mergedS1Hi
            s1B := mergedS1Lo
            s1S := mergedS1Start
        if secondS >= 0 and maxZones >= 2
            s2T := array.get(sHi, secondS)
            s2B := array.get(sLo, secondS)
            s2S := array.get(sStartB, secondS)
    [s1T, s1B, s1S, s2T, s2B, s2S]

f_updateDonchianLines(line exUpper, line exLower, line exMid, int barIdx, bool useDonchian, float donchUpper, float donchLower, float donchMid) =>
    line.delete(exUpper)
    line.delete(exLower)
    line.delete(exMid)
    line newUpper = na
    line newLower = na
    line newMid = na
    if useDonchian
        newUpper := line.new(barIdx - 200, donchUpper, barIdx + 20, donchUpper, color=color.new(ACCENT_COLOR, 72), width=1)
        newLower := line.new(barIdx - 200, donchLower, barIdx + 20, donchLower, color=color.new(ACCENT_COLOR, 72), width=1)
        newMid := line.new(barIdx - 200, donchMid, barIdx + 20, donchMid, color=color.new(ACCENT_COLOR, 80), width=1)
    [newUpper, newLower, newMid]

f_updatePivotLines(line exP, line exR1, line exR2, line exS1, line exS2, int barIdx, float pivotP, float pivotR1, float pivotR2, float pivotS1, float pivotS2) =>
    line.delete(exP)
    line.delete(exR1)
    line.delete(exR2)
    line.delete(exS1)
    line.delete(exS2)
    [line.new(barIdx - 200, pivotP, barIdx + 20, pivotP, color=color.new(NEUTRAL_COLOR, 50), width=1, style=line.style_dotted),
     line.new(barIdx - 200, pivotR1, barIdx + 20, pivotR1, color=color.new(NEGATIVE_COLOR, 65), width=1, style=line.style_dotted),
     line.new(barIdx - 200, pivotR2, barIdx + 20, pivotR2, color=color.new(NEGATIVE_COLOR, 75), width=1, style=line.style_dotted),
     line.new(barIdx - 200, pivotS1, barIdx + 20, pivotS1, color=color.new(POSITIVE_COLOR, 65), width=1, style=line.style_dotted),
     line.new(barIdx - 200, pivotS2, barIdx + 20, pivotS2, color=color.new(POSITIVE_COLOR, 75), width=1, style=line.style_dotted)]

f_updateFibLines(line ex50, line ex382, line ex618, int barIdx, float fib50, float fib382, float fib618) =>
    line.delete(ex50)
    line.delete(ex382)
    line.delete(ex618)
    [line.new(barIdx - 200, fib50, barIdx + 20, fib50, color=color.new(ACCENT_COLOR, 70), width=1, style=line.style_dotted),
     line.new(barIdx - 200, fib382, barIdx + 20, fib382, color=color.new(ACCENT_COLOR, 80), width=1, style=line.style_dotted),
     line.new(barIdx - 200, fib618, barIdx + 20, fib618, color=color.new(ACCENT_COLOR, 80), width=1, style=line.style_dotted)]

f_createBuySignalDrawings(int barIdx, float openP, float closeP, float atrP, float atrPrevP, float finBuy, float bSL, float bTP, float bTP1, float bTP2, float bRR, string bTPSrc, float vwapV, float fib50v, float lastBullOBH, bool useSLTP, string sltpMode, bool useTwoTPs, string tooltipStr, bool structOK, bool structOK2) =>
    entryZoneMult = finBuy >= 80 ? 0.5 : finBuy >= 65 ? 0.7 : 0.9
    zoneHalfH = atrPrevP * entryZoneMult
    bodyLow = math.min(openP, closeP)
    buyZoneLow = math.max(bodyLow - zoneHalfH * 0.3, bSL)
    buyZoneHigh = bodyLow + zoneHalfH
    buyZoneBorder = finBuy >= 80 ? color.new(POSITIVE_COLOR, 35) : color.new(color.new(POSITIVE_COLOR, 45), 50)
    label buyZoneLbl = label.new(barIdx, buyZoneLow - atrP * 0.15, "▲", style=label.style_label_up, color=buyZoneBorder, textcolor=color.white, size=size.small, tooltip=tooltipStr)
    buyEntryPrice = (buyZoneHigh + buyZoneLow) / 2
    if vwapV >= buyZoneLow and vwapV <= buyZoneHigh
        buyEntryPrice := vwapV
    else if fib50v >= buyZoneLow and fib50v <= buyZoneHigh
        buyEntryPrice := fib50v
    else if not na(lastBullOBH) and lastBullOBH >= buyZoneLow and lastBullOBH <= buyZoneHigh
        buyEntryPrice := lastBullOBH
    line buyEntL = na
    label buyEntLbl = na
    box buyEntZone = na
    if useSLTP and sltpMode == "Zones"
        buyEntZone := box.new(barIdx, buyZoneHigh, barIdx, buyZoneLow, border_color=color.new(ACCENT_COLOR, 40), bgcolor=color.new(ACCENT_COLOR, 85), border_width=1)
        buyEntLbl := label.new(barIdx, buyEntryPrice, "ENTRY " + str.tostring(buyEntryPrice, "#.##"), style=label.style_label_center, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny, tooltip="ENTRY " + str.tostring(buyEntryPrice, "#.##"))
    else
        buyEntL := line.new(barIdx, buyEntryPrice, barIdx, buyEntryPrice, color=color.new(ACCENT_COLOR, 15), style=line.style_solid, width=2)
        buyEntLbl := label.new(barIdx, buyEntryPrice, "ENTRY " + str.tostring(buyEntryPrice, "#.##"), style=label.style_label_left, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny)
    box buyRiskZ = na
    box buyRewZ = na
    line buySLn = na
    label buySLbl = na
    line buyTPLn = na
    label buyTPLbl = na
    line buyTP2Ln = na
    label buyTP2Lbl = na
    box buyRewZ2 = na
    if useSLTP
        if sltpMode == "Zones"
            buyRiskZ := box.new(barIdx, buyZoneLow, barIdx, bSL, border_color=color.new(NEGATIVE_COLOR, 40), bgcolor=color.new(NEGATIVE_COLOR, 85), border_width=1)
            if useTwoTPs
                buyRewZ := box.new(barIdx, bTP1, barIdx, buyZoneHigh, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 65), border_width=1)
                buyRewZ2 := box.new(barIdx, bTP2, barIdx, bTP1, border_color=color.new(POSITIVE_COLOR, 25), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
            else
                buyRewZ := box.new(barIdx, bTP, barIdx, buyZoneHigh, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
        buySLn := line.new(barIdx, bSL, barIdx, bSL, color=color.new(NEGATIVE_COLOR, 25), style=line.style_dashed, width=2)
        buySLbl := label.new(barIdx, bSL, "SL " + str.tostring(bSL, "#.##") + " (" + str.tostring((buyEntryPrice - bSL) / buyEntryPrice * 100, "#.#") + "%)", style=label.style_label_left, color=color.new(NEGATIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
        if useTwoTPs
            buyTPLn := line.new(barIdx, bTP1, barIdx, bTP1, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            buyTPLbl := label.new(barIdx, bTP1, "TP1 " + str.tostring(bTP1, "#.##") + " (" + str.tostring((bTP1 - buyEntryPrice) / buyEntryPrice * 100, "#.#") + "%) " + bTPSrc, style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
            buyTP2Ln := line.new(barIdx, bTP2, barIdx, bTP2, color=color.new(POSITIVE_COLOR, 20), style=line.style_dashed, width=1)
            buyTP2Lbl := label.new(barIdx, bTP2, "TP2 " + str.tostring(bTP2, "#.##") + " (" + str.tostring((bTP2 - buyEntryPrice) / buyEntryPrice * 100, "#.#") + "%) (1:" + str.tostring(bRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 40), textcolor=color.white, size=size.tiny)
        else
            buyTPLn := line.new(barIdx, bTP, barIdx, bTP, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            buyTPLbl := label.new(barIdx, bTP, "TP " + str.tostring(bTP, "#.##") + " (" + str.tostring((bTP - buyEntryPrice) / buyEntryPrice * 100, "#.#") + "%) " + bTPSrc + " (1:" + str.tostring(bRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
    activeSLT = structOK ? "Swing" : structOK2 ? "SwingMomentum" : "ATR"
    [buyEntL, buyEntLbl, buyEntZone, buyZoneLbl, buySLn, buyTPLn, buySLbl, buyTPLbl, buyRiskZ, buyRewZ, buyTP2Ln, buyTP2Lbl, buyRewZ2, bRR, activeSLT, bTP, bSL]

f_createSellSignalDrawings(int barIdx, float openP, float closeP, float atrP, float atrPrevP, float finSell, float sSL, float sTP, float sTP1, float sTP2, float sRR, string sTPSrc, float vwapV, float fib50v, float lastBearOBL, bool useSLTP, string sltpMode, bool useTwoTPs, string tooltipStr, bool structOK, bool structOK2) =>
    sellEntryZoneMult = finSell >= 80 ? 0.5 : finSell >= 65 ? 0.7 : 0.9
    sellZoneHalfH = atrPrevP * sellEntryZoneMult
    bodyHigh = math.max(openP, closeP)
    sellZoneHigh = math.min(bodyHigh + sellZoneHalfH * 0.3, sSL)
    sellZoneLow = bodyHigh - sellZoneHalfH
    sellZoneBorder = finSell >= 80 ? color.new(NEGATIVE_COLOR, 35) : color.new(color.new(NEGATIVE_COLOR, 45), 50)
    label sellZoneLbl = label.new(barIdx, sellZoneHigh + atrP * 0.15, "▼", style=label.style_label_down, color=sellZoneBorder, textcolor=color.white, size=size.small, tooltip=tooltipStr)
    sellEntryPrice = (sellZoneHigh + sellZoneLow) / 2
    if vwapV >= sellZoneLow and vwapV <= sellZoneHigh
        sellEntryPrice := vwapV
    else if fib50v >= sellZoneLow and fib50v <= sellZoneHigh
        sellEntryPrice := fib50v
    else if not na(lastBearOBL) and lastBearOBL >= sellZoneLow and lastBearOBL <= sellZoneHigh
        sellEntryPrice := lastBearOBL
    line sellEntL = na
    label sellEntLbl = na
    box sellEntZone = na
    if useSLTP and sltpMode == "Zones"
        sellEntZone := box.new(barIdx, sellZoneHigh, barIdx, sellZoneLow, border_color=color.new(ACCENT_COLOR, 40), bgcolor=color.new(ACCENT_COLOR, 85), border_width=1)
        sellEntLbl := label.new(barIdx, sellEntryPrice, "ENTRY " + str.tostring(sellEntryPrice, "#.##"), style=label.style_label_center, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny, tooltip="ENTRY " + str.tostring(sellEntryPrice, "#.##"))
    else
        sellEntL := line.new(barIdx, sellEntryPrice, barIdx, sellEntryPrice, color=color.new(ACCENT_COLOR, 15), style=line.style_solid, width=2)
        sellEntLbl := label.new(barIdx, sellEntryPrice, "ENTRY " + str.tostring(sellEntryPrice, "#.##"), style=label.style_label_left, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny)
    box sellRiskZ = na
    box sellRewZ = na
    line sellSLn = na
    label sellSLbl = na
    line sellTPLn = na
    label sellTPLbl = na
    line sellTP2Ln = na
    label sellTP2Lbl = na
    box sellRewZ2 = na
    if useSLTP
        if sltpMode == "Zones"
            if useTwoTPs
                sellRewZ := box.new(barIdx, sellZoneLow, barIdx, sTP1, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 75), border_width=1)
                sellRewZ2 := box.new(barIdx, sTP1, barIdx, sTP2, border_color=color.new(POSITIVE_COLOR, 25), bgcolor=color.new(POSITIVE_COLOR, 50), border_width=1)
            else
                sellRewZ := box.new(barIdx, sellZoneLow, barIdx, sTP, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
            sellRiskZ := box.new(barIdx, sSL, barIdx, sellZoneHigh, border_color=color.new(NEGATIVE_COLOR, 40), bgcolor=color.new(NEGATIVE_COLOR, 85), border_width=1)
        sellSLn := line.new(barIdx, sSL, barIdx, sSL, color=color.new(NEGATIVE_COLOR, 25), style=line.style_dashed, width=2)
        sellSLbl := label.new(barIdx, sSL, "SL " + str.tostring(sSL, "#.##") + " (" + str.tostring((sSL - sellEntryPrice) / sellEntryPrice * 100, "#.#") + "%)", style=label.style_label_left, color=color.new(NEGATIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
        if useTwoTPs
            sellTPLn := line.new(barIdx, sTP1, barIdx, sTP1, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            sellTPLbl := label.new(barIdx, sTP1, "TP1 " + str.tostring(sTP1, "#.##") + " (" + str.tostring((sellEntryPrice - sTP1) / sellEntryPrice * 100, "#.#") + "%) " + sTPSrc, style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
            sellTP2Ln := line.new(barIdx, sTP2, barIdx, sTP2, color=color.new(POSITIVE_COLOR, 20), style=line.style_dashed, width=1)
            sellTP2Lbl := label.new(barIdx, sTP2, "TP2 " + str.tostring(sTP2, "#.##") + " (" + str.tostring((sellEntryPrice - sTP2) / sellEntryPrice * 100, "#.#") + "%) (1:" + str.tostring(sRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 40), textcolor=color.white, size=size.tiny)
        else
            sellTPLn := line.new(barIdx, sTP, barIdx, sTP, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            sellTPLbl := label.new(barIdx, sTP, "TP " + str.tostring(sTP, "#.##") + " (" + str.tostring((sellEntryPrice - sTP) / sellEntryPrice * 100, "#.#") + "%) " + sTPSrc + " (1:" + str.tostring(sRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
    activeSLT = structOK ? "Swing" : structOK2 ? "SwingMomentum" : "ATR"
    [sellEntL, sellEntLbl, sellEntZone, sellZoneLbl, sellSLn, sellTPLn, sellSLbl, sellTPLbl, sellRiskZ, sellRewZ, sellTP2Ln, sellTP2Lbl, sellRewZ2, sRR, activeSLT, sTP, sSL]

// ==================================================================================
// CALCULATIONS
// ==================================================================================

[hullMA, hullTrend, htfEma, htfEmaPrev, htfTrendUp, plusDI, minusDI, adxValue, adxStrong, trendUp, trendDown] = f_calcTrend()

[rsiValue, rsiPrev, rsiOS, rsiOB, rsiOversoldCross, rsiOverboughtCross, rsiBullish, rsiBearish, macdLine, macdSignalLine, macdHist, macdLinePrev, macdSignalPrev, macdCrossUp, macdCrossDown, macdBullish, macdBearish] = f_calcMomentum(hullMA)

[atr, atrPrev, bbBasis, bbDev, bbUpper, bbLower, bbBullish, bbBearish, bbWidth, bbWidthSma, bbSqueeze, bbPercent, notAtExtremes] = f_calcVolatility()

[volumeMA, volumeConfirm, volZScore, volClimax, volClimaxBuy, volClimaxSell] = f_calcVolume()

[rsiBullDiv, rsiBearDiv, rsiBullHidden, rsiBearHidden] = f_divergence(close, "RSI")
[macdBullDiv, macdBearDiv, macdBullHidden, macdBearHidden] = f_divergence(close, "MACD")
bullDivAny = rsiBullDiv or macdBullDiv
bearDivAny = rsiBearDiv or macdBearDiv
bullHiddenAny = rsiBullHidden or macdBullHidden
bearHiddenAny = rsiBearHidden or macdBearHidden
bullishDivergence = bullDivAny
bearishDivergence = bearDivAny

plusDIPrev = plusDI[1]
minusDIPrev = minusDI[1]
diBullish = plusDIPrev > minusDIPrev
diBearish = minusDIPrev > plusDIPrev

rangeHigh = ta.highest(high, PD_LOOKBACK)
rangeLow = ta.lowest(low, PD_LOOKBACK)
equilibrium = (rangeHigh + rangeLow) / 2
inPremium = close[1] >= equilibrium
inDiscount = close[1] <= equilibrium
premiumDiscountOkBuy = not USE_PREMIUM_DISCOUNT or inDiscount
premiumDiscountOkSell = not USE_PREMIUM_DISCOUNT or inPremium

[swingHigh, swingLow, lastSwingHigh, lastSwingLow, barsSinceSwingLow, barsSinceSwingHigh, extendedBearRun, extendedBullRun, breakoutUp, breakoutDown, nearSupport, nearResistance, lastValidSwingHigh, lastValidSwingLow, bosBull, bosBear, sfpBear, sfpBull, liqSweepBuy, liqSweepSell, chochBearish, chochBullish, chochBlockBuy, chochBlockSell] = f_calcStructure(atr, trendUp, trendDown)

structureBull = (not USE_STRUCTURE or (breakoutUp or nearSupport)) and premiumDiscountOkBuy
structureBear = (not USE_STRUCTURE or (breakoutDown or nearResistance)) and premiumDiscountOkSell

[emaFast, emaSlow, emaSlower, ema200, maStackUp, maStackDown] = f_calcMAStack()

bbNotExtremes = USE_BB_NOT_EXTREMES ? notAtExtremes[1] : true
noSqueeze = USE_NO_SQUEEZE ? not bbSqueeze[1] : true
atrMA = ta.sma(atr, ATR_LENGTH)
atrExpanding = USE_ATR_EXPANDING ? atr[1] >= atrMA[1] : true

volumeRising = USE_VOLUME_TREND ? (volume[1] >= volume[2] and volume[2] >= volume[VOLUME_TREND_BARS]) : true
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvMA = ta.sma(obv, OBV_LENGTH)
obvBullish = USE_OBV ? obv[1] > obvMA[1] : true
obvBearish = USE_OBV ? obv[1] < obvMA[1] : true

[stochKVal, stochDVal, stochBullish, stochBearish, roc, rocBullish, rocBearish, macdHistBullish, macdHistBearish, bullishCandle, bearishCandle] = f_calcStochRocCandle(macdHist)

[atrInRange, htfRsi, htfRsiPrev, htfRsiOkBuy, htfRsiOkSell, htfRsiForDiv, htfRsiForDivPrev, mtf5, mtf15, mtf60, mtf240, mtfD, prevDayHigh, prevDayLow, inSession] = f_calcFiltersAndMTF(atr)

[bodyPctBull, bodyPctBear, bullFVG, bearFVG, stValue, stDir, stBullish, stBearish, sarValue, sarBullish, sarBearish] = f_calcFVGSTSAR()

[ichConvLine, ichBaseLine, ichSpanA, ichSpanB, ichCloudTop, ichCloudBot, ichTKCross, ichAboveCloud, ichBelowCloud, ichGreenCloud, ichBullish, ichBearish] = f_calcIchimoku()

[aroonUp, aroonDown, aroonBullish, aroonBearish, linRegVal, linRegSlope, corrVal, rSquared, linRegBullish, linRegBearish] = f_calcAroonLinReg()

[kcBasis, kcRange, kcUpper, kcLower, ttmSqueezeOn, ttmSqueezeOff, ttmMomentum, ttmFirBull, ttmFirBear, kcBullish, kcBearish] = f_calcKeltnerTTM(bbUpper, bbLower)

[hvol, hvRank, hvLow, hvHigh, chandLong, chandShort, chandBullish, chandBearish, vwapValue, vwapBullish, vwapBearish] = f_calcHVChandVWAP()

clv = ((close - low) - (high - close)) / math.max(high - low, 1e-10)
cmfValue = ta.sma(clv * volume, CMF_LENGTH) / math.max(ta.sma(volume, CMF_LENGTH), 1e-10)
cmfBullish = cmfValue[1] > 0
cmfBearish = cmfValue[1] < 0

mfiValue = ta.mfi(hlc3, MFI_LENGTH)
mfiBullish = mfiValue[1] > 50
mfiBearish = mfiValue[1] < 50

adLine = ta.cum(((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume)
adLineMA = ta.sma(adLine, AD_LINE_MA_LEN)
adLineBullish = adLine[1] > adLineMA[1]
adLineBearish = adLine[1] < adLineMA[1]

pvtVal = ta.cum(ta.change(close) / math.max(close[1], 1e-10) * volume)
pvtMA = ta.sma(pvtVal, PVT_MA_LEN)
pvtBullish = pvtVal[1] > pvtMA[1]
pvtBearish = pvtVal[1] < pvtMA[1]

cciValue = ta.cci(close, CCI_LENGTH)
cciBullish = cciValue[1] > 0
cciBearish = cciValue[1] < 0

wrValue = -100 * (ta.highest(high, WR_LENGTH) - close) / math.max(ta.highest(high, WR_LENGTH) - ta.lowest(low, WR_LENGTH), 1e-10)
wrBullish = wrValue[1] > -50
wrBearish = wrValue[1] < -50

cmoValue = ta.cmo(close, CMO_LENGTH)
cmoBullish = cmoValue[1] > 0
cmoBearish = cmoValue[1] < 0

[fisherVal, fisherPrev] = f_fisherTransform(FISHER_LENGTH)
fisherBullish = (fisherVal[1] > fisherPrev[1])
fisherBearish = (fisherVal[1] < fisherPrev[1])

efiValue = ta.ema(volume * (close - close[1]), EFI_LENGTH)
efiBullish = efiValue[1] > 0
efiBearish = efiValue[1] < 0

obDispThreshold = atr * OB_DISPLACEMENT_MULT
bullOBCandle = close[2] < open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] > open[1]
bearOBCandle = close[2] > open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] < open[1]
var float lastBullOBHigh = na
var float lastBullOBLow = na
var float lastBearOBHigh = na
var float lastBearOBLow = na
if bullOBCandle
    lastBullOBHigh := high[2]
    lastBullOBLow := low[2]
if bearOBCandle
    lastBearOBHigh := high[2]
    lastBearOBLow := low[2]
nearBullOB = not na(lastBullOBLow) ? (low[1] <= lastBullOBHigh and low[1] >= lastBullOBLow) : false
nearBearOB = not na(lastBearOBHigh) ? (high[1] >= lastBearOBLow and high[1] <= lastBearOBHigh) : false

benchClose = request.security(BENCHMARK_SYMBOL, timeframe.period, close, lookahead=barmerge.lookahead_off)
corrValue = ta.correlation(close, benchClose, CORR_LENGTH)
benchTrendUp = benchClose > benchClose[1]
corrBullish = (corrValue[1] > 0.5 and benchTrendUp[1]) or (corrValue[1] < -0.3 and not benchTrendUp[1])
corrBearish = (corrValue[1] > 0.5 and not benchTrendUp[1]) or (corrValue[1] < -0.3 and benchTrendUp[1])

rsRatio = close / math.max(benchClose, 1e-10)
rsMA = ta.sma(rsRatio, CORR_LENGTH)
rsBullish = rsRatio[1] > rsMA[1]
rsBearish = rsRatio[1] < rsMA[1]

[bullEngulfing, bearEngulfing, hammerBull, shootingStar, morningStar, eveningStar, doji, bullHarami, bearHarami, threeWhiteSoldiers, threeBlackCrows, tweezerBottom, tweezerTop, piercingLine, darkCloudCover, wickRejectionBuy, wickRejectionSell] = f_calcCandlePatterns(atr)

zScore = (close - ta.sma(close, Z_SCORE_LENGTH)) / math.max(ta.stdev(close, Z_SCORE_LENGTH), 1e-10)
zScoreOverextBull = zScore[1] > 2.0
zScoreOverextBear = zScore[1] < -2.0

rSqValue = rSquared[1]

atrRoc = ta.roc(atr, 10)
atrDecelerating = atrRoc[1] < 0 and atrRoc[2] > 0
atrAccelerating = atrRoc[1] > 0 and atrRoc[2] < 0

buyPressure = ta.sma((close - low) / math.max(high - low, 1e-10) * volume, PRESSURE_LENGTH)
sellPressure = ta.sma((high - close) / math.max(high - low, 1e-10) * volume, PRESSURE_LENGTH)
pressureRatio = buyPressure / math.max(buyPressure + sellPressure, 1e-10)
pressureBullish = pressureRatio[1] > 0.55
pressureBearish = pressureRatio[1] < 0.45

[sineVal, leadSineVal, dominantPeriod] = f_ehlersSineWave()
sineBullish = (sineVal[1] > leadSineVal[1] and sineVal[2] <= leadSineVal[2]) or sineVal[1] > leadSineVal[1]
sineBearish = (sineVal[1] < leadSineVal[1] and sineVal[2] >= leadSineVal[2]) or sineVal[1] < leadSineVal[1]

[wyckHigh, wyckLow, wyckRange, wyckVolAvg, wyckInRange, wyckSpring, wyckUpthrust, vwmaVal, smaForVwma, vwmaBullish, vwmaBearish, avgBody, bullDisplacement, bearDisplacement] = f_calcWyckoffVWMADisplacement(volumeMA, atr)

[donchianUpper, donchianLower, donchianMid, donchianBullish, donchianBearish, donchianBreakoutUp, donchianBreakoutDown, mcginleyVal, mcginleyBullish, mcginleyBearish] = f_calcDonchianMcGinley()

[demaVal, temaVal, demaBullish, demaBearish, temaBullish, temaBearish] = f_calcDEMATEMA()
[gmmaShortAvg, gmmaLongAvg, gmmaBullish, gmmaBearish] = f_calcGMMA()
[alligatorJawPlot, alligatorTeethPlot, alligatorLipsPlot, alligatorBullish, alligatorBearish, gatorUpper, gatorLower, gatorExpanding] = f_calcAlligator()

[trixVal, trixSignalVal, trixBullish, trixBearish, uoValue, uoBullish, uoBearish, kstValue, kstSignalVal, kstBullish, kstBearish, dpoValue, dpoBullish, dpoBearish, rviValue, rviSignalVal, rviBullish, rviBearish, schaffVal, schaffBullish, schaffBearish, pgoValue, pgoBullish, pgoBearish, coppockValue, coppockBullish, coppockBearish, massValue, massBulge] = f_calcMomentumOscillators()

[kvoValue, KVO_SIGNALLine] = f_klinger(KVO_FAST, KVO_SLOW, KVO_SIGNAL)
klingerBullish = kvoValue[1] > KVO_SIGNALLine[1]
klingerBearish = kvoValue[1] < KVO_SIGNALLine[1]

eomValue = f_eom(EOM_LENGTH)
eomBullish = eomValue[1] > 0
eomBearish = eomValue[1] < 0

var float nviVal = 1000.0
nviVal := volume < volume[1] ? nviVal[1] * (close / math.max(close[1], 1e-10)) : nviVal[1]
nviMA = ta.sma(nviVal, NVI_PVI_MA_LEN)
nviBullish = nviVal[1] > nviMA[1]
nviBearish = nviVal[1] < nviMA[1]

var float pviVal = 1000.0
pviVal := volume > volume[1] ? pviVal[1] * (close / math.max(close[1], 1e-10)) : pviVal[1]
pviMA = ta.sma(pviVal, NVI_PVI_MA_LEN)
pviBullish = pviVal[1] > pviMA[1]
pviBearish = pviVal[1] < pviMA[1]

iiiRaw = (high - low) > 0 ? (2 * close - high - low) / (high - low) * volume : 0.0
iiiValue = ta.sma(iiiRaw, III_LENGTH)
iiiCum = ta.cum(iiiRaw)
iiiBullish = iiiValue[1] > 0
iiiBearish = iiiValue[1] < 0

mfiBWValue = (high - low) / math.max(volume, 1)
mfiBWUp = close > close[1]
mfiBWVolUp = volume > volume[1]
mfiBWBullish = (mfiBWUp and mfiBWVolUp)
mfiBWBearish = (not mfiBWUp and mfiBWVolUp)

[pivotHighHTF, pivotLowHTF, pivotCloseHTF] = request.security(syminfo.tickerid, PIVOT_TIMEFRAME, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
[pivotP, pivotR1, pivotR2, pivotS1, pivotS2, nearPivotR1, nearPivotS1, pivotCrossUpR1, pivotCrossDownS1, pivotBreak] = f_calcPivotLevels(pivotHighHTF, pivotLowHTF, pivotCloseHTF)
[fib236, fib382, fib50, fib618, fib786] = f_calcFibLevels()

gapUp = USE_GAP and open > high[1]
gapDown = USE_GAP and open < low[1]
gapSize = gapUp ? open - high[1] : gapDown ? low[1] - open : 0.0
gapValid = (GAP_MIN_ATR <= 0 or gapSize >= atr * GAP_MIN_ATR) and (gapUp or gapDown)

srPivotHigh = ta.pivothigh(high, SR_ZONE_PIVOT_LB, SR_ZONE_PIVOT_LB)
srPivotLow  = ta.pivotlow(low, SR_ZONE_PIVOT_LB, SR_ZONE_PIVOT_LB)
var array<float> srPhPrices = array.new_float(0)
var array<int>   srPhBars   = array.new_int(0)
var array<float> srPlPrices = array.new_float(0)
var array<int>   srPlBars   = array.new_int(0)
if not na(srPivotHigh)
    array.push(srPhPrices, srPivotHigh)
    array.push(srPhBars, bar_index - SR_ZONE_PIVOT_LB)
    if array.size(srPhPrices) > 50
        array.shift(srPhPrices)
        array.shift(srPhBars)
if not na(srPivotLow)
    array.push(srPlPrices, srPivotLow)
    array.push(srPlBars, bar_index - SR_ZONE_PIVOT_LB)
    if array.size(srPlPrices) > 50
        array.shift(srPlPrices)
        array.shift(srPlBars)
srZoneWidth = atr * SR_ZONE_WIDTH_ATR
[srR1Top, _, _, srR2Top, _, _] = f_calcResistanceZones(srPhPrices, srPhBars, srZoneWidth, SR_ZONE_LOOKBACK, SR_ZONE_MIN_TOUCHES, SR_ZONE_MAX_ZONES)
[_, srS1Bot, _, _, srS2Bot, _] = f_calcSupportZones(srPlPrices, srPlBars, srZoneWidth, SR_ZONE_LOOKBACK, SR_ZONE_MIN_TOUCHES, SR_ZONE_MAX_ZONES)

[viPlus, viMinus, vortexBullish, vortexBearish, elderEma, elderEmaRising, elderImpulseBull, elderImpulseBear, vwPrice, vwRsiValue, vwRsiBullish, vwRsiBearish, twiggsValue, twiggsBullish, twiggsBearish] = f_calcVortexElderVWRsiTwiggs(macdHist)

// ==================================================================================
// BUY/SELL SIGNAL ENGINE
// ==================================================================================

stochCrossUp = ta.crossover(stochKVal, stochDVal)
stochCrossDown = ta.crossunder(stochKVal, stochDVal)
macdHistTurningUp = macdHist[1] > macdHist[2] and macdHist[2] < 0
macdHistTurningDown = macdHist[1] < macdHist[2] and macdHist[2] > 0
macdCrossUpFresh = macdCrossUp[1] ? 2.0 : macdCrossUp[2] ? 1.2 : macdCrossUp[3] ? 0.5 : 0.0
macdCrossDownFresh = macdCrossDown[1] ? 2.0 : macdCrossDown[2] ? 1.2 : macdCrossDown[3] ? 0.5 : 0.0
rsiCrossUpFresh = rsiOversoldCross[1] ? 2.0 : rsiOversoldCross[2] ? 1.2 : rsiOversoldCross[3] ? 0.5 : 0.0
rsiCrossDownFresh = rsiOverboughtCross[1] ? 2.0 : rsiOverboughtCross[2] ? 1.2 : rsiOverboughtCross[3] ? 0.5 : 0.0
stochCrossUpFresh = stochCrossUp[1] ? 1.5 : stochCrossUp[2] ? 0.9 : stochCrossUp[3] ? 0.4 : 0.0
stochCrossDownFresh = stochCrossDown[1] ? 1.5 : stochCrossDown[2] ? 0.9 : stochCrossDown[3] ? 0.4 : 0.0
rsiVelocity = rsiValue - rsiValue[3]
rsiAccelBuy = rsiPrev < 40 and rsiVelocity > 8
rsiAccelSell = rsiPrev > 60 and rsiVelocity < -8

lagEnabledCount = 9 + (USE_MA_STACK ? 1 : 0) + (USE_SUPER_TREND ? 1 : 0) + (USE_SAR ? 1 : 0) + (USE_ICHIMOKU ? 1 : 0) + (USE_STOCH ? 1 : 0) + 1 + (USE_GMMA ? 1 : 0) + 1 + (USE_ROC ? 1 : 0)
lagBuyCount = (trendUp ? 1 : 0) + (USE_MA_STACK and maStackUp ? 1 : 0) + (USE_SUPER_TREND and stBullish ? 1 : 0) + (USE_SAR and sarBullish ? 1 : 0) + (USE_ICHIMOKU and ichBullish ? 1 : 0) + (USE_STOCH and stochBullish ? 1 : 0) + (aroonBullish ? 1 : 0) + (linRegBullish ? 1 : 0) + (donchianBullish ? 1 : 0) + (mcginleyBullish ? 1 : 0) + (alligatorBullish ? 1 : 0) + (vortexBullish ? 1 : 0) + (demaBullish ? 1 : 0) + (temaBullish ? 1 : 0) + (USE_GMMA and gmmaBullish ? 1 : 0) + (macdBullish ? 1 : 0) + (rsiBullish ? 1 : 0) + (USE_ROC and rocBullish ? 1 : 0)
lagSellCount = (trendDown ? 1 : 0) + (USE_MA_STACK and maStackDown ? 1 : 0) + (USE_SUPER_TREND and stBearish ? 1 : 0) + (USE_SAR and sarBearish ? 1 : 0) + (USE_ICHIMOKU and ichBearish ? 1 : 0) + (USE_STOCH and stochBearish ? 1 : 0) + (aroonBearish ? 1 : 0) + (linRegBearish ? 1 : 0) + (donchianBearish ? 1 : 0) + (mcginleyBearish ? 1 : 0) + (alligatorBearish ? 1 : 0) + (vortexBearish ? 1 : 0) + (demaBearish ? 1 : 0) + (temaBearish ? 1 : 0) + (USE_GMMA and gmmaBearish ? 1 : 0) + (macdBearish ? 1 : 0) + (rsiBearish ? 1 : 0) + (USE_ROC and rocBearish ? 1 : 0)
lagBuyRatio = lagBuyCount / math.max(lagEnabledCount, 1)
lagSellRatio = lagSellCount / math.max(lagEnabledCount, 1)

[exhBuyScore, exhSellScore] = f_exhaustionScore(rsiPrev, stochKVal, mfiValue, wrValue, bbPercent, zScore, cciValue, schaffVal, uoValue, volClimaxBuy, extendedBearRun, massBulge, cmoValue, volClimaxSell, extendedBullRun, USE_STOCH)
[revBuyScore, revSellScore] = f_reversalScore(macdCrossUpFresh, rsiCrossUpFresh, USE_STOCH ? stochCrossUpFresh : 0.0, macdHistTurningUp, fisherBullish, trixBullish, kstBullish, sineBullish, coppockBullish, rviBullish, elderImpulseBull, dpoBullish, rsiAccelBuy, chandBullish, ttmFirBull, macdCrossDownFresh, rsiCrossDownFresh, USE_STOCH ? stochCrossDownFresh : 0.0, macdHistTurningDown, fisherBearish, trixBearish, kstBearish, sineBearish, coppockBearish, rviBearish, elderImpulseBear, dpoBearish, rsiAccelSell, chandBearish, ttmFirBear)
[structBuyScore, structSellScore] = f_structureScore(bullEngulfing, hammerBull, morningStar, piercingLine, tweezerBottom, threeWhiteSoldiers, doji, rsiPrev, bullHarami, bearEngulfing, shootingStar, eveningStar, darkCloudCover, tweezerTop, threeBlackCrows, bearHarami, pivotCrossUpR1, pivotCrossDownS1, donchianBreakoutUp, donchianBreakoutDown, nearSupport, wyckSpring, bullDivAny, bosBull, chochBullish, sfpBull, liqSweepBuy, bullFVG, nearBullOB, wickRejectionBuy, bullDisplacement, nearPivotS1, nearResistance, wyckUpthrust, bearDivAny, bosBear, chochBearish, sfpBear, liqSweepSell, bearFVG, nearBearOB, wickRejectionSell, bearDisplacement, nearPivotR1)
[volBuyScore, volSellScore] = f_volumeScore(volumeConfirm, volumeRising, pressureBullish, pressureBearish, obvBullish, cmfBullish, klingerBullish, twiggsBullish, iiiBullish, eomBullish, nviBullish, pviBullish, efiBullish, adLineBullish, obvBearish, cmfBearish, klingerBearish, twiggsBearish, iiiBearish, eomBearish, nviBearish, pviBearish, efiBearish, adLineBearish)
[trendAlignBuyScore, trendAlignSellScore] = f_trendAlignScore(mtfD, mtf240, mtf60, mtf15, mtf5, htfTrendUp, adxStrong, vwRsiBullish, vortexBullish, vwapBullish, mcginleyBullish, alligatorBullish, vwRsiBearish, vortexBearish, vwapBearish, mcginleyBearish, alligatorBearish, bullHiddenAny, bearHiddenAny)

r2Trend = rSqValue > 0.7 ? 1.12 : rSqValue > 0.5 ? 1.04 : rSqValue > 0.3 ? 0.94 : 0.88
r2Reversal = rSqValue < 0.3 ? 1.08 : rSqValue < 0.5 ? 1.0 : rSqValue < 0.7 ? 0.96 : 0.92

rawBuyScore = (exhBuyScore * 0.20 * r2Reversal + revBuyScore * 0.18 * r2Reversal + structBuyScore * 0.22 + volBuyScore * 0.22 + trendAlignBuyScore * 0.18 * r2Trend) * 100.0
rawSellScore = (exhSellScore * 0.20 * r2Reversal + revSellScore * 0.18 * r2Reversal + structSellScore * 0.22 + volSellScore * 0.22 + trendAlignSellScore * 0.18 * r2Trend) * 100.0

[rSqMult, zScoreBuyMult, zScoreSellMult, volSpikeMult, adxReversalMult, exhaustionBoostBuy, exhaustionPenaltyBuy, exhaustionBoostSell, exhaustionPenaltySell, agreeMult, agreeMsell, sessionMult, buyCatAgreeStrong, buyCatAgree, sellCatAgreeStrong, sellCatAgree] = f_metaMultipliers(exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, zScore, hvRank, adxValue, adxStrong, lagSellCount, lagEnabledCount, lagBuyCount, USE_SESSION_FILTER, inSession)

divBonusBuy = bullishDivergence ? 8.0 : 0.0
divBonusSell = bearishDivergence ? 8.0 : 0.0
wyckBonusBuy = USE_WYCKOFF and wyckSpring ? 8.0 : 0.0
wyckBonusSell = USE_WYCKOFF and wyckUpthrust ? 8.0 : 0.0
chochBonusBuy = USE_SMC and chochBullish ? 5.0 : 0.0
chochBonusSell = USE_SMC and chochBearish ? 5.0 : 0.0

mtfDivMultBuy = 1.0
mtfDivMultSell = 1.0

pdPenaltyBuy = 1.0
pdPenaltySell = 1.0

signalBodyPct = math.abs(close - open) / math.max(high - low, 1e-10)
bodyMult = signalBodyPct > 0.6 ? 1.08 : signalBodyPct < 0.25 ? 0.85 : 1.0

adxFalling = adxValue[1] < adxValue[4]
adxRisingStrong = adxValue[1] > adxValue[4] and adxStrong

multProductBuy = zScoreBuyMult * exhaustionBoostBuy * exhaustionPenaltyBuy * agreeMult * sessionMult * volSpikeMult * pdPenaltyBuy * mtfDivMultBuy * bodyMult * adxReversalMult
multProductSell = zScoreSellMult * exhaustionBoostSell * exhaustionPenaltySell * agreeMsell * sessionMult * volSpikeMult * pdPenaltySell * mtfDivMultSell * bodyMult * adxReversalMult
finalBuyScore = math.min((rawBuyScore + divBonusBuy + wyckBonusBuy + chochBonusBuy) * math.min(multProductBuy, 1.80), 100.0)
finalSellScore = math.min((rawSellScore + divBonusSell + wyckBonusSell + chochBonusSell) * math.min(multProductSell, 1.80), 100.0)

var int barsSinceLastBuy = 999
var int barsSinceLastSell = 999
barsSinceLastBuy := barsSinceLastBuy + 1
barsSinceLastSell := barsSinceLastSell + 1

buyConfidence = finalBuyScore >= 80 ? "High" : finalBuyScore >= 65 ? "Medium" : "Low"
sellConfidence = finalSellScore >= 80 ? "High" : finalSellScore >= 65 ? "Medium" : "Low"

buyDominance = finalBuyScore - finalSellScore
sellDominance = finalSellScore - finalBuyScore
dominanceRatioBuy = finalBuyScore / math.max(finalSellScore, 1.0)
dominanceRatioSell = finalSellScore / math.max(finalBuyScore, 1.0)
signalBarBullish = close > open and signalBodyPct > 0.15
signalBarBearish = close < open and signalBodyPct > 0.15
signalBarInside = high <= high[1] and low >= low[1]
r2RegimeOk = (rSqValue >= 0.15 and adxStrong) or (math.abs(zScore[1]) > 2.0)

signalBuy = USE_BUY_SELL_SIGNAL and barstate.isconfirmed and finalBuyScore >= BUY_SELL_THRESHOLD and barsSinceLastBuy >= BUY_SELL_COOLDOWN and dominanceRatioBuy >= 1.25 and buyDominance >= 8.0 and r2RegimeOk and (lagSellRatio < 0.75 or finalBuyScore >= 85)
signalSell = USE_BUY_SELL_SIGNAL and barstate.isconfirmed and finalSellScore >= BUY_SELL_THRESHOLD and barsSinceLastSell >= BUY_SELL_COOLDOWN and dominanceRatioSell >= 1.25 and sellDominance >= 8.0 and r2RegimeOk and (lagBuyRatio < 0.75 or finalSellScore >= 85)

if signalBuy
    barsSinceLastBuy := 0
if signalSell
    barsSinceLastSell := 0

rsiSparkline = f_sparkline(rsiValue, 8)

var float activeRR = 0.0
var string activeSLType = "-"
var float activeTP = na
var float activeSL = na

if USE_DASHBOARD and isRightVisibleBar
    var table dash = table.new(position.top_right, 5, 61, border_width=0, frame_width=0)
    f_dashBuySellSignal(dash, USE_BUY_SELL_SIGNAL, finalBuyScore, finalSellScore, buyCatAgree, sellCatAgree, barsSinceLastBuy, barsSinceLastSell)
    f_dashTrend(dash, hullTrend, stBullish, adxValue[1], ADX_THRESHOLD, adxStrong, sarBullish, ichBullish, ichBearish, aroonUp[1], aroonDown[1], aroonBullish, linRegSlope[1], linRegBullish, vwmaBullish, htfTrendUp, maStackUp, maStackDown, donchianBullish, mcginleyBullish, demaBullish, gmmaBullish, alligatorBullish, alligatorBearish, vortexBullish)
    f_dashMomentum(dash, rsiPrev, rsiSparkline, rsiBullish, stochKVal[1], stochDVal[1], stochBullish, macdBullish, macdHist[1], macdHistBullish, cciValue[1], cciBullish, wrValue[1], wrBullish, cmoValue[1], cmoBullish, fisherBullish, efiBullish, roc[1], rocBullish, mfiValue[1], mfiBullish, sineBullish, trixVal[1], trixBullish, uoValue[1], uoBullish, kstValue[1], kstBullish, dpoValue[1], dpoBullish, rviValue[1], rviBullish, schaffVal[1], schaffBullish, pgoValue[1], pgoBullish, coppockValue[1], coppockBullish, elderImpulseBull, elderImpulseBear, vwRsiValue[1], vwRsiBullish)
    f_dashVolume(dash, volume[1], volumeMA[1], volumeConfirm, vwapBullish, obvBullish, cmfValue[1], cmfBullish, adLineBullish, pvtBullish, volumeRising, pressureRatio[1], klingerBullish, eomValue[1], eomBullish, nviBullish, pviBullish, iiiBullish, mfiBWBullish, twiggsBullish)
    f_dashVolatility(dash, bbPercent[1], bbNotExtremes, ttmSqueezeOn, ttmFirBull, ttmFirBear, kcBullish, chandBullish, atrInRange, massValue[1], massBulge, bbBullish)
    f_dashRegimeMetaRisk(dash, inDiscount, premiumDiscountOkBuy, htfRsiPrev, htfRsiOkBuy, rsBullish, corrValue[1], corrBullish, corrBearish, hvRank[1], hvLow, hvHigh, wyckSpring, wyckUpthrust, rSqValue, zScore[1], dominantPeriod, adxStrong, trendUp, trendDown, atrPrev, activeSL, activeSLType, activeTP, ATR_MULTIPLIER_SL, ATR_MULTIPLIER_TP, activeRR, BUY_SELL_RR)
    f_dashMTFLevels(dash, USE_MTF_HEATMAP, mtf5, mtf15, mtf60, mtf240, mtfD, pivotP[1], pivotR1, pivotS1, USE_PIVOTS, nearPivotR1, nearPivotS1, fib50[1], gapUp, gapDown)

slSwingHigh = ta.pivothigh(high, SL_SWING_LOOKBACK, SL_SWING_LOOKBACK)
slSwingLow = ta.pivotlow(low, SL_SWING_LOOKBACK, SL_SWING_LOOKBACK)
slLastSwingHigh = ta.valuewhen(not na(slSwingHigh), slSwingHigh, 0)
slLastSwingLow = ta.valuewhen(not na(slSwingLow), slSwingLow, 0)
slSwingAgeBuy = bar_index - ta.valuewhen(not na(slSwingLow), bar_index, 0)
slSwingAgeSell = bar_index - ta.valuewhen(not na(slSwingHigh), bar_index, 0)
slLastSwingLow2 = ta.valuewhen(not na(slSwingLow), slSwingLow, 1)
slSwingAgeBuy2 = bar_index - ta.valuewhen(not na(slSwingLow), bar_index, 1)
slLastSwingHigh2 = ta.valuewhen(not na(slSwingHigh), slSwingHigh, 1)
slSwingAgeSell2 = bar_index - ta.valuewhen(not na(slSwingHigh), bar_index, 1)

[buySL, sellSL, fixedBuyTP, fixedSellTP, structSLBuyOk, structSLBuyOk2, structSLSellOk, structSLSellOk2] = f_calcSLTP(slLastSwingHigh, slLastSwingLow, slSwingAgeBuy, slSwingAgeSell, slLastSwingLow2, slLastSwingHigh2, slSwingAgeBuy2, slSwingAgeSell2, close, open, atrPrev, finalBuyScore, finalSellScore, ATR_MULTIPLIER_SL, BUY_SELL_RR, SL_MIN_PCT)
[nearBuyTarget, buyTPSource, buyTP, buyActualRR, nearSellTarget, sellTPSource, sellTP, sellActualRR, trendExtendBuy, trendExtendSell, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, buyTP2, sellTP1, sellTP2] = f_calcTPTargets(lastSwingHigh, lastSwingLow, pivotR1, pivotS1, pivotR2, pivotS2, USE_SMC ? lastBearOBHigh : na, USE_SMC ? lastBullOBLow : na, fib382, fib618, vwapValue, bbUpper, bbLower, ema200, prevDayHigh, prevDayLow, close, atrPrev, USE_PIVOTS, buySL, sellSL, fixedBuyTP, fixedSellTP, finalBuyScore, finalSellScore, open, ATR_MULTIPLIER_TP, trendUp, trendDown, adxStrong, trendAlignBuyScore, trendAlignSellScore, srR1Top, srR2Top, srS1Bot, srS2Bot, TP2_USE_SR, TP2_MIN_PCT, TP_MIN_DISTANCE_PCT)

buyEntryZoneMult = finalBuyScore >= 80 ? 0.5 : finalBuyScore >= 65 ? 0.7 : 0.9
buyZoneHalfH = atrPrev * buyEntryZoneMult
buyBodyLow = math.min(open, close)
buyZoneLow = math.max(buyBodyLow - buyZoneHalfH * 0.3, buySL)
buyZoneHigh = buyBodyLow + buyZoneHalfH
buyEntryPrice = (buyZoneHigh + buyZoneLow) / 2
buyEntryPrice := vwapValue >= buyZoneLow and vwapValue <= buyZoneHigh ? vwapValue : buyEntryPrice
buyEntryPrice := not (vwapValue >= buyZoneLow and vwapValue <= buyZoneHigh) and fib50 >= buyZoneLow and fib50 <= buyZoneHigh ? fib50 : buyEntryPrice
buyEntryPrice := not (vwapValue >= buyZoneLow and vwapValue <= buyZoneHigh) and not (fib50 >= buyZoneLow and fib50 <= buyZoneHigh) and USE_SMC and not na(lastBullOBHigh) and lastBullOBHigh >= buyZoneLow and lastBullOBHigh <= buyZoneHigh ? lastBullOBHigh : buyEntryPrice
buyRiskFromEntry = buyEntryPrice - buySL
buyActualRR := buyRiskFromEntry > 0 ? (buyTP - buyEntryPrice) / buyRiskFromEntry : buyActualRR

sellEntryZoneMult = finalSellScore >= 80 ? 0.5 : finalSellScore >= 65 ? 0.7 : 0.9
sellZoneHalfH = atrPrev * sellEntryZoneMult
sellBodyHigh = math.max(open, close)
sellZoneHigh = math.min(sellBodyHigh + sellZoneHalfH * 0.3, sellSL)
sellZoneLow = sellBodyHigh - sellZoneHalfH
sellEntryPrice = (sellZoneHigh + sellZoneLow) / 2
sellEntryPrice := vwapValue >= sellZoneLow and vwapValue <= sellZoneHigh ? vwapValue : sellEntryPrice
sellEntryPrice := not (vwapValue >= sellZoneLow and vwapValue <= sellZoneHigh) and fib50 >= sellZoneLow and fib50 <= sellZoneHigh ? fib50 : sellEntryPrice
sellEntryPrice := not (vwapValue >= sellZoneLow and vwapValue <= sellZoneHigh) and not (fib50 >= sellZoneLow and fib50 <= sellZoneHigh) and USE_SMC and not na(lastBearOBLow) and lastBearOBLow >= sellZoneLow and lastBearOBLow <= sellZoneHigh ? lastBearOBLow : sellEntryPrice
sellRiskFromEntry = sellSL - sellEntryPrice
sellActualRR := sellRiskFromEntry > 0 ? (sellEntryPrice - sellTP) / sellRiskFromEntry : sellActualRR

// ==================================================================================
// VISUALIZATION
// ==================================================================================

bgColor = USE_BACKGROUND ? (trendUp and adxStrong ? color.new(POSITIVE_COLOR, 95) : trendDown and adxStrong ? color.new(NEGATIVE_COLOR, 95) : na) : na
squeezeBg = USE_TTM_SQUEEZE and ttmSqueezeOn ? color.new(WARNING_COLOR, 95) : na
elderBgColor = elderImpulseBull ? color.new(POSITIVE_COLOR, 91) : elderImpulseBear ? color.new(NEGATIVE_COLOR, 91) : color.new(NEUTRAL_COLOR, 96)
combinedBg = not na(squeezeBg) ? squeezeBg : not na(bgColor) ? bgColor : USE_BACKGROUND ? elderBgColor : na
bgcolor(combinedBg, title="Trend/Squeeze/Elder Background")

ichSpanAPlot = plot(USE_ICHIMOKU ? ichSpanA : na, "Ichimoku Span A", color=color.new(color.new(POSITIVE_COLOR, 45), 82), offset=ICH_BASE, display=display.all)
ichSpanBPlot = plot(USE_ICHIMOKU ? ichSpanB : na, "Ichimoku Span B", color=color.new(color.new(NEGATIVE_COLOR, 45), 82), offset=ICH_BASE, display=display.all)
fill(ichSpanAPlot, ichSpanBPlot, color=color.new(POSITIVE_COLOR, 90), title="Ichimoku Cloud")

bbRelevant = USE_BB and (bbSqueeze or bbPercent < 0.1 or bbPercent > 0.9 or true)
bbUpperPlot = plot(bbRelevant ? bbUpper : na, "BB Upper", color=color.new(ACCENT_COLOR, 82), linewidth=1)
bbLowerPlot = plot(bbRelevant ? bbLower : na, "BB Lower", color=color.new(ACCENT_COLOR, 82), linewidth=1)
plot(bbRelevant ? bbBasis : na, "BB Basis", color=color.new(ACCENT_COLOR, 65), linewidth=1)
fill(bbUpperPlot, bbLowerPlot, color=color.new(ACCENT_COLOR, 93), title="BB Fill")

kcVisible = USE_KELTNER
plot(kcVisible ? kcUpper : na, "KC Upper", color=color.new(ACCENT_COLOR, 82), linewidth=1, style=plot.style_circles)
plot(kcVisible ? kcLower : na, "KC Lower", color=color.new(ACCENT_COLOR, 82), linewidth=1, style=plot.style_circles)

var box lastBullFvg = na
var box lastBearFvg = na
if USE_FVG and bullFVG
    if not na(lastBullFvg)
        box.delete(lastBullFvg)
    lastBullFvg := box.new(bar_index - 2, low[2], bar_index + 6, high[0], border_color=color.new(POSITIVE_COLOR, 45), bgcolor=color.new(POSITIVE_COLOR, 88), border_width=1)
if USE_FVG and bearFVG
    if not na(lastBearFvg)
        box.delete(lastBearFvg)
    lastBearFvg := box.new(bar_index - 2, low[0], bar_index + 6, high[2], border_color=color.new(NEGATIVE_COLOR, 45), bgcolor=color.new(NEGATIVE_COLOR, 88), border_width=1)

plot(USE_MA_STACK_LINES ? emaFast : na, "EMA 9", color=color.new(color.new(ACCENT_COLOR, 35), 35), linewidth=1)
plot(USE_MA_STACK_LINES ? emaSlow : na, "EMA 21", color=color.new(color.new(ACCENT_COLOR, 45), 45), linewidth=1)
plot(USE_MA_STACK_LINES ? emaSlower : na, "EMA 50", color=color.new(color.new(ACCENT_COLOR, 55), 55), linewidth=1)

plot(USE_VWAP_LINE ? vwapValue : na, "VWAP", color=color.new(ACCENT_COLOR, 25), linewidth=1, style=plot.style_line)

plot(USE_HULL_MA ? hullMA : na, "Hull MA", color=color.new(ACCENT_COLOR, 40), linewidth=2)

plot(USE_SUPER_TREND ? stValue : na, "SuperTrend", color=color.new(ACCENT_COLOR, 20), linewidth=2, style=plot.style_line)

plotshape(USE_SAR ? sarValue : na, "SAR", shape.cross, location.absolute, color=color.new(NEUTRAL_COLOR, 40), size=size.tiny)

if USE_PATTERN_MARKERS and bullEngulfing
    label.new(bar_index, low - atr * 0.25, "E", style=label.style_label_up, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Engulfing")
if USE_PATTERN_MARKERS and bearEngulfing
    label.new(bar_index, high + atr * 0.25, "E", style=label.style_label_down, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Engulfing")
if USE_PATTERN_MARKERS and morningStar
    label.new(bar_index, low - atr * 0.25, "MoS", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Morning Star")
if USE_PATTERN_MARKERS and eveningStar
    label.new(bar_index, high + atr * 0.25, "EvS", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Evening Star")
if USE_PATTERN_MARKERS and threeWhiteSoldiers
    label.new(bar_index, low - atr * 0.25, "3WS", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Three White Soldiers")
if USE_PATTERN_MARKERS and threeBlackCrows
    label.new(bar_index, high + atr * 0.25, "3BC", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Three Black Crows")
if USE_PATTERN_MARKERS and hammerBull
    label.new(bar_index, low - atr * 0.45, "H", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Hammer")
if USE_PATTERN_MARKERS and shootingStar
    label.new(bar_index, high + atr * 0.45, "S", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Shooting Star")
if USE_PATTERN_MARKERS and bullHarami
    label.new(bar_index, low - atr * 0.45, "Ha", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Harami")
if USE_PATTERN_MARKERS and bearHarami
    label.new(bar_index, high + atr * 0.45, "Ha", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Harami")
if USE_PATTERN_MARKERS and tweezerBottom
    label.new(bar_index, low - atr * 0.45, "TB", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Bottoms")
if USE_PATTERN_MARKERS and tweezerTop
    label.new(bar_index, high + atr * 0.45, "TT", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Tops")
if USE_PATTERN_MARKERS and doji
    label.new(bar_index, low - atr * 0.65, "Do", style=label.style_label_up, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Doji")
if USE_PATTERN_MARKERS and piercingLine
    label.new(bar_index, low - atr * 0.65, "PL", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Piercing Line")
if USE_PATTERN_MARKERS and darkCloudCover
    label.new(bar_index, high + atr * 0.65, "DCC", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Dark Cloud Cover")

var line donchianUpperLine = na
var line donchianLowerLine = na
var line donchianMidLine = na
if isRightVisibleBar
    [dU, dL, dM] = f_updateDonchianLines(donchianUpperLine, donchianLowerLine, donchianMidLine, bar_index, USE_DONCHIAN, donchianUpper, donchianLower, donchianMid)
    donchianUpperLine := dU
    donchianLowerLine := dL
    donchianMidLine := dM

plot(USE_MC_GINLEY ? mcginleyVal : na, "McGinley", color=color.new(ACCENT_COLOR, 50), linewidth=1)

if USE_MC_GINLEY and not na(demaVal[1])
    line.new(bar_index - 1, demaVal[1], bar_index, demaVal, color=color.new(WARNING_COLOR, 60), width=1)
if USE_MC_GINLEY and not na(temaVal[1])
    line.new(bar_index - 1, temaVal[1], bar_index, temaVal, color=color.new(WARNING_COLOR, 70), width=1)

plot(USE_GMMA ? gmmaShortAvg : na, "GMMA Short", color=color.new(color.new(POSITIVE_COLOR, 45), 70), linewidth=1)
plot(USE_GMMA ? gmmaLongAvg : na, "GMMA Long", color=color.new(color.new(NEGATIVE_COLOR, 45), 70), linewidth=1)

plot(USE_ALLIGATOR ? alligatorJawPlot : na, "Alligator Jaw", color=color.new(ACCENT_COLOR, 45), linewidth=2)
plot(USE_ALLIGATOR ? alligatorTeethPlot : na, "Alligator Teeth", color=color.new(NEGATIVE_COLOR, 45), linewidth=2)
plot(USE_ALLIGATOR ? alligatorLipsPlot : na, "Alligator Lips", color=color.new(POSITIVE_COLOR, 45), linewidth=2)

var line pivotPLine  = na
var line pivotR1Line = na
var line pivotR2Line = na
var line pivotS1Line = na
var line pivotS2Line = na

if isRightVisibleBar and USE_PIVOTS
    [pP, pR1, pR2, pS1, pS2] = f_updatePivotLines(pivotPLine, pivotR1Line, pivotR2Line, pivotS1Line, pivotS2Line, bar_index, pivotP, pivotR1, pivotR2, pivotS1, pivotS2)
    pivotPLine := pP
    pivotR1Line := pR1
    pivotR2Line := pR2
    pivotS1Line := pS1
    pivotS2Line := pS2

var line fib50Line  = na
var line fib382Line = na
var line fib618Line = na

if isRightVisibleBar and USE_FIB_LEVELS
    [f50, f382, f618] = f_updateFibLines(fib50Line, fib382Line, fib618Line, bar_index, fib50, fib382, fib618)
    fib50Line := f50
    fib382Line := f382
    fib618Line := f618

if gapValid and gapUp
    label.new(bar_index, low, "Gap Up", style=label.style_label_up, color=color.new(POSITIVE_COLOR, 30), textcolor=color.white, size=size.tiny)
if gapValid and gapDown
    label.new(bar_index, high, "Gap Dn", style=label.style_label_down, color=color.new(NEGATIVE_COLOR, 30), textcolor=color.white, size=size.tiny)

tfSeconds = timeframe.in_seconds(timeframe.period)
lineLen = tfSeconds >= 86400 ? 8 : tfSeconds >= 14400 ? 10 : tfSeconds >= 3600 ? 12 : 15
signalExpirationBars = tfSeconds >= 86400 ? 100 : tfSeconds >= 14400 ? 80 : tfSeconds >= 3600 ? 60 : tfSeconds >= 900 ? 40 : 30

var int buySignalBarIndex = na
var float buySignalTP = na
var float buySignalSL = na
var int buySignalRightExtent = na
var int sellSignalBarIndex = na
var float sellSignalTP = na
var float sellSignalSL = na
var int sellSignalRightExtent = na

var line buySLLine = na
var line buyTPLine = na
var label buySLLabel = na
var label buyTPLabel = na
var line buyTP2Line = na
var label buyTP2Label = na
var line sellSLLine = na
var line sellTPLine = na
var label sellSLLabel = na
var label sellTPLabel = na
var line sellTP2Line = na
var label sellTP2Label = na
var box buyRiskZone = na
var box buyRewardZone = na
var box buyRewardZone2 = na
var box sellRiskZone = na
var box sellRewardZone = na
var box sellRewardZone2 = na
var line buyEntryLine = na
var label buyEntryLabel = na
var box buyEntryZone = na
var line sellEntryLine = na
var label sellEntryLabel = na
var box sellEntryZone = na
var label buyZoneLabel = na
var label sellZoneLabel = na

if BUY_SELL_AUTO_EXPIRE
    if not na(buySignalBarIndex)
        barsSinceBuySignal = bar_index - buySignalBarIndex
        priceHitBuyTP = not na(buySignalTP) and high >= buySignalTP
        priceHitBuySL = not na(buySignalSL) and low <= buySignalSL
        if priceHitBuyTP or priceHitBuySL or barsSinceBuySignal > signalExpirationBars
            f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
            buyEntryLine := na
            buyEntryLabel := na
            buyEntryZone := na
            buyZoneLabel := na
            buySLLine := na
            buyTPLine := na
            buySLLabel := na
            buyTPLabel := na
            buyRiskZone := na
            buyRewardZone := na
            buyTP2Line := na
            buyTP2Label := na
            buyRewardZone2 := na
            buySignalBarIndex := na
            buySignalTP := na
            buySignalSL := na
            buySignalRightExtent := na
        else
            buySignalRightExtent := math.max(nz(buySignalRightExtent), bar_index)
            extentBuy = na(rightVisibleBarIndex) ? nz(buySignalRightExtent) : math.min(nz(buySignalRightExtent), rightVisibleBarIndex)
            f_extendBuySignalDrawings(buySLLine, buyTPLine, buyEntryLine, buyRiskZone, buyRewardZone, buyEntryZone, buySLLabel, buyTPLabel, buyEntryLabel, not na(buyEntryZone), extentBuy, buyTP2Line, buyTP2Label, buyRewardZone2)
    if not na(sellSignalBarIndex)
        barsSinceSellSignal = bar_index - sellSignalBarIndex
        priceHitSellTP = not na(sellSignalTP) and low <= sellSignalTP
        priceHitSellSL = not na(sellSignalSL) and high >= sellSignalSL
        if priceHitSellTP or priceHitSellSL or barsSinceSellSignal > signalExpirationBars
            f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
            sellEntryLine := na
            sellEntryLabel := na
            sellEntryZone := na
            sellZoneLabel := na
            sellSLLine := na
            sellTPLine := na
            sellSLLabel := na
            sellTPLabel := na
            sellRiskZone := na
            sellRewardZone := na
            sellTP2Line := na
            sellTP2Label := na
            sellRewardZone2 := na
            sellSignalBarIndex := na
            sellSignalTP := na
            sellSignalSL := na
            sellSignalRightExtent := na
        else
            sellSignalRightExtent := math.max(nz(sellSignalRightExtent), bar_index)
            extentSell = na(rightVisibleBarIndex) ? nz(sellSignalRightExtent) : math.min(nz(sellSignalRightExtent), rightVisibleBarIndex)
            f_extendSellSignalDrawings(sellSLLine, sellTPLine, sellEntryLine, sellRiskZone, sellRewardZone, sellEntryZone, sellSLLabel, sellTPLabel, sellEntryLabel, not na(sellEntryZone), extentSell, sellTP2Line, sellTP2Label, sellRewardZone2)
else
    if not na(buySignalBarIndex)
        buySignalRightExtent := math.max(nz(buySignalRightExtent), bar_index)
        extentBuy = na(rightVisibleBarIndex) ? nz(buySignalRightExtent) : math.min(nz(buySignalRightExtent), rightVisibleBarIndex)
        f_extendBuySignalDrawings(buySLLine, buyTPLine, buyEntryLine, buyRiskZone, buyRewardZone, buyEntryZone, buySLLabel, buyTPLabel, buyEntryLabel, not na(buyEntryZone), extentBuy, buyTP2Line, buyTP2Label, buyRewardZone2)
    if not na(sellSignalBarIndex)
        sellSignalRightExtent := math.max(nz(sellSignalRightExtent), bar_index)
        extentSell = na(rightVisibleBarIndex) ? nz(sellSignalRightExtent) : math.min(nz(sellSignalRightExtent), rightVisibleBarIndex)
        f_extendSellSignalDrawings(sellSLLine, sellTPLine, sellEntryLine, sellRiskZone, sellRewardZone, sellEntryZone, sellSLLabel, sellTPLabel, sellEntryLabel, not na(sellEntryZone), extentSell, sellTP2Line, sellTP2Label, sellRewardZone2)

if signalBuy
    buySLSource = structSLBuyOk ? "[Swing]" : structSLBuyOk2 ? "[SwingMomentum]" : "[ATR]"
    buyTooltip = f_signalTooltip(true, buySLSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount, buyEntryPrice, sellEntryPrice)
    if USE_PREVIOUS_SIGNALS
        [grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder] = f_prevSignalGrayColors(PREVIOUS_SELL_RR)
        f_applyGrayToAllSignals(grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
    else
        f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
        f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
        buyEntryLine := na
        buyEntryLabel := na
        buyEntryZone := na
        buyZoneLabel := na
        buySLLine := na
        buyTPLine := na
        buySLLabel := na
        buyTPLabel := na
        buyRiskZone := na
        buyRewardZone := na
        buyTP2Line := na
        buyTP2Label := na
        buyRewardZone2 := na
        sellEntryLine := na
        sellEntryLabel := na
        sellEntryZone := na
        sellZoneLabel := na
        sellSLLine := na
        sellTPLine := na
        sellSLLabel := na
        sellTPLabel := na
        sellRiskZone := na
        sellRewardZone := na
        sellTP2Line := na
        sellTP2Label := na
        sellRewardZone2 := na
    [bE, bEL, bEZ, bZL, bSLn, bTPLn, bSLb, bTPLb, bRZ, bRW, bTP2Ln, bTP2Lb, bRW2, aRR, aSLT, aTP, aSL] = f_createBuySignalDrawings(bar_index, open, close, atr, atrPrev, finalBuyScore, buySL, buyTP, buyTP1, buyTP2, buyActualRR, buyTPSource, vwapValue, fib50, USE_SMC ? lastBullOBHigh : na, USE_BUY_SELL_SLTP_ENTRY, SLTP_DISPLAY_MODE, USE_TWO_T_PS_BUY, buyTooltip, structSLBuyOk, structSLBuyOk2)
    buyEntryLine := bE
    buyEntryLabel := bEL
    buyEntryZone := bEZ
    buyZoneLabel := bZL
    buySLLine := bSLn
    buyTPLine := bTPLn
    buySLLabel := bSLb
    buyTPLabel := bTPLb
    buyRiskZone := bRZ
    buyRewardZone := bRW
    buyTP2Line := bTP2Ln
    buyTP2Label := bTP2Lb
    buyRewardZone2 := bRW2
    activeRR := aRR
    activeSLType := aSLT
    activeTP := aTP
    activeSL := aSL
    buySignalBarIndex := bar_index
    buySignalRightExtent := bar_index
    buySignalTP := buyTP
    buySignalSL := buySL

if signalSell
    sellSLSource = structSLSellOk ? "[Swing]" : structSLSellOk2 ? "[SwingMomentum]" : "[ATR]"
    sellTooltip = f_signalTooltip(false, sellSLSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount, buyEntryPrice, sellEntryPrice)
    if USE_PREVIOUS_SIGNALS
        [grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder] = f_prevSignalGrayColors(PREVIOUS_SELL_RR)
        f_applyGrayToAllSignals(grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
    else
        f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
        f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
        buyEntryLine := na
        buyEntryLabel := na
        buyEntryZone := na
        buyZoneLabel := na
        buySLLine := na
        buyTPLine := na
        buySLLabel := na
        buyTPLabel := na
        buyRiskZone := na
        buyRewardZone := na
        sellEntryLine := na
        sellEntryLabel := na
        sellEntryZone := na
        sellZoneLabel := na
        sellSLLine := na
        sellTPLine := na
        sellSLLabel := na
        sellTPLabel := na
        sellRiskZone := na
        sellRewardZone := na
        sellTP2Line := na
        sellTP2Label := na
        sellRewardZone2 := na
    [sE, sEL, sEZ, sZL, sSLn, sTPLn, sSLb, sTPLb, sRZ, sRW, sTP2Ln, sTP2Lb, sRW2, aRR, aSLT, aTP, aSL] = f_createSellSignalDrawings(bar_index, open, close, atr, atrPrev, finalSellScore, sellSL, sellTP, sellTP1, sellTP2, sellActualRR, sellTPSource, vwapValue, fib50, USE_SMC ? lastBearOBLow : na, USE_BUY_SELL_SLTP_ENTRY, SLTP_DISPLAY_MODE, USE_TWO_T_PS_SELL, sellTooltip, structSLSellOk, structSLSellOk2)
    sellEntryLine := sE
    sellEntryLabel := sEL
    sellEntryZone := sEZ
    sellZoneLabel := sZL
    sellSLLine := sSLn
    sellTPLine := sTPLn
    sellSLLabel := sSLb
    sellTPLabel := sTPLb
    sellRiskZone := sRZ
    sellRewardZone := sRW
    sellTP2Line := sTP2Ln
    sellTP2Label := sTP2Lb
    sellRewardZone2 := sRW2
    activeRR := aRR
    activeSLType := aSLT
    activeTP := aTP
    activeSL := aSL
    sellSignalBarIndex := bar_index
    sellSignalRightExtent := bar_index
    sellSignalTP := sellTP
    sellSignalSL := sellSL

