// ==================================================================================
// FUNCTIONS
// ==================================================================================

f_exhaustionScore(rsiPrev, stochKVal, mfiValue, wrValue, bbPercent, zScore, cciValue, schaffVal, uoValue, volClimaxBuy, extendedBearRun, massBulge, cmoValue, volClimaxSell, extendedBullRun, useStoch) =>
    c = 7.0
    ext = USE_EXTENDED_OSCILLATORS
    bRaw = (rsiPrev < 35 ? 2.0 : rsiPrev < 45 ? 1.0 : 0.0)
         + (useStoch and stochKVal[1] < 25 ? 1.5 : 0.0)
         + (ext and mfiValue[1] < 30 ? 1.0 : 0.0)
         + (ext and wrValue[1] < -75 ? 1.0 : 0.0)
         + (bbPercent[1] < 0.15 ? 1.5 : 0.0)
         + (zScore[1] < -1.5 ? 2.0 : 0.0)
         + (ext and cciValue[1] < -100 ? 1.0 : 0.0)
         + (ext and schaffVal[1] < 20 ? 0.8 : 0.0)
         + (ext and uoValue[1] < 30 ? 0.8 : 0.0)
         + (volClimaxBuy ? 2.5 : 0.0)
         + (extendedBearRun ? 1.5 : 0.0)
         + (ext and massBulge and rsiPrev < 40 ? 1.5 : 0.0)
         + (ext and cmoValue[1] < -50 ? 0.8 : 0.0)
    sRaw = (rsiPrev > 65 ? 2.0 : rsiPrev > 55 ? 1.0 : 0.0)
         + (useStoch and stochKVal[1] > 75 ? 1.5 : 0.0)
         + (ext and mfiValue[1] > 70 ? 1.0 : 0.0)
         + (ext and wrValue[1] > -25 ? 1.0 : 0.0)
         + (bbPercent[1] > 0.85 ? 1.5 : 0.0)
         + (zScore[1] > 1.5 ? 2.0 : 0.0)
         + (ext and cciValue[1] > 100 ? 1.0 : 0.0)
         + (ext and schaffVal[1] > 80 ? 0.8 : 0.0)
         + (ext and uoValue[1] > 70 ? 0.8 : 0.0)
         + (volClimaxSell ? 2.5 : 0.0)
         + (extendedBullRun ? 1.5 : 0.0)
         + (ext and massBulge and rsiPrev > 60 ? 1.5 : 0.0)
         + (ext and cmoValue[1] > 50 ? 0.8 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_reversalScore(macdCrossUpFresh, rsiCrossUpFresh, stochCrossUpFresh, macdHistTurningUp, fisherBullish, trixBullish, kstBullish, sineBullish, coppockBullish, rviBullish, elderImpulseBull, dpoBullish, rsiAccelBuy, chandBullish, ttmFirBull, macdCrossDownFresh, rsiCrossDownFresh, stochCrossDownFresh, macdHistTurningDown, fisherBearish, trixBearish, kstBearish, sineBearish, coppockBearish, rviBearish, elderImpulseBear, dpoBearish, rsiAccelSell, chandBearish, ttmFirBear) =>
    c = 5.0
    ext = USE_EXTENDED_OSCILLATORS
    bRaw = macdCrossUpFresh + rsiCrossUpFresh + stochCrossUpFresh
         + (macdHistTurningUp ? 1.5 : 0.0)
         + (ext and fisherBullish ? 1.0 : 0.0)
         + (ext and trixBullish ? 1.0 : 0.0)
         + (ext and kstBullish ? 1.0 : 0.0)
         + (ext and sineBullish ? 0.8 : 0.0)
         + (ext and coppockBullish ? 0.8 : 0.0)
         + (ext and rviBullish ? 0.7 : 0.0)
         + (ext and elderImpulseBull ? 0.8 : 0.0)
         + (ext and dpoBullish ? 0.6 : 0.0)
         + (ext and rsiAccelBuy ? 1.2 : 0.0)
         + (ext and chandBullish ? 0.8 : 0.0)
         + (ext and ttmFirBull ? 1.0 : 0.0)
    sRaw = macdCrossDownFresh + rsiCrossDownFresh + stochCrossDownFresh
         + (macdHistTurningDown ? 1.5 : 0.0)
         + (ext and fisherBearish ? 1.0 : 0.0)
         + (ext and trixBearish ? 1.0 : 0.0)
         + (ext and kstBearish ? 1.0 : 0.0)
         + (ext and sineBearish ? 0.8 : 0.0)
         + (ext and coppockBearish ? 0.8 : 0.0)
         + (ext and rviBearish ? 0.7 : 0.0)
         + (ext and elderImpulseBear ? 0.8 : 0.0)
         + (ext and dpoBearish ? 0.6 : 0.0)
         + (ext and rsiAccelSell ? 1.2 : 0.0)
         + (ext and chandBearish ? 0.8 : 0.0)
         + (ext and ttmFirBear ? 1.0 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_structureScore(bullEngulfing, hammerBull, morningStar, piercingLine, tweezerBottom, threeWhiteSoldiers, doji, rsiPrev, bullHarami, bearEngulfing, shootingStar, eveningStar, darkCloudCover, tweezerTop, threeBlackCrows, bearHarami, pivotCrossUpR1, pivotCrossDownS1, donchianBreakoutUp, donchianBreakoutDown, nearSupport, wyckSpring, bullishDivergence, bosBull, chochBullish, sfpBull, liqSweepBuy, bullFVG, nearBullOB, wickRejectionBuy, bullDisplacement, nearPivotS1, nearResistance, wyckUpthrust, bearishDivergence, bosBear, chochBearish, sfpBear, liqSweepSell, bearFVG, nearBearOB, wickRejectionSell, bearDisplacement, nearPivotR1) =>
    c = 9.5
    // Indices: only strongest patterns (Engulfing, Hammer/Shooting Star, Morning/Evening Star)
    candleBullRaw = (bullEngulfing ? 1.5 : 0.0) + (hammerBull ? 1.5 : 0.0) + (morningStar ? 1.5 : 0.0)
    candleBullCapped = math.min(candleBullRaw, 2.5)
    candleBearRaw = (bearEngulfing ? 1.5 : 0.0) + (shootingStar ? 1.5 : 0.0) + (eveningStar ? 1.5 : 0.0)
    candleBearCapped = math.min(candleBearRaw, 2.5)
    pivotBreakUpFresh = pivotCrossUpR1[1] ? 1.8 : pivotCrossUpR1[2] ? 1.2 : pivotCrossUpR1[3] ? 0.6 : 0.0
    pivotBreakDownFresh = pivotCrossDownS1[1] ? 1.8 : pivotCrossDownS1[2] ? 1.2 : pivotCrossDownS1[3] ? 0.6 : 0.0
    donchianBreakoutUpFresh = donchianBreakoutUp[1] ? 1.2 : donchianBreakoutUp[2] ? 0.8 : donchianBreakoutUp[3] ? 0.4 : 0.0
    donchianBreakoutDownFresh = donchianBreakoutDown[1] ? 1.2 : donchianBreakoutDown[2] ? 0.8 : donchianBreakoutDown[3] ? 0.4 : 0.0
    bRaw = (nearSupport ? 2.0 : 0.0)
         + (USE_WYCKOFF and wyckSpring ? 2.5 : 0.0)
         + (bullishDivergence ? 2.5 : 0.0)
         + (USE_SMC ? math.max(bosBull ? 1.5 : 0.0, chochBullish ? 2.0 : 0.0) : 0.0)
         + (USE_SMC ? math.max(sfpBull ? 1.5 : 0.0, liqSweepBuy ? 2.0 : 0.0) : 0.0)
         + (USE_SMC and bullFVG ? 1.0 : 0.0)
         + candleBullCapped
         + (USE_SMC and nearBullOB ? 1.5 : 0.0)
         + (wickRejectionBuy ? 1.0 : 0.0)
         + (bullDisplacement ? 1.2 : 0.0)
         + pivotBreakUpFresh
         + (nearPivotS1 ? 0.9 : 0.0)
         + donchianBreakoutUpFresh
    sRaw = (nearResistance ? 2.0 : 0.0)
         + (USE_WYCKOFF and wyckUpthrust ? 2.5 : 0.0)
         + (bearishDivergence ? 2.5 : 0.0)
         + (USE_SMC ? math.max(bosBear ? 1.5 : 0.0, chochBearish ? 2.0 : 0.0) : 0.0)
         + (USE_SMC ? math.max(sfpBear ? 1.5 : 0.0, liqSweepSell ? 2.0 : 0.0) : 0.0)
         + (USE_SMC and bearFVG ? 1.0 : 0.0)
         + candleBearCapped
         + (USE_SMC and nearBearOB ? 1.5 : 0.0)
         + (wickRejectionSell ? 1.0 : 0.0)
         + (bearDisplacement ? 1.2 : 0.0)
         + pivotBreakDownFresh
         + (nearPivotR1 ? 0.9 : 0.0)
         + donchianBreakoutDownFresh
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_volumeScore(volumeConfirm, volumeRising, pressureBullish, pressureBearish, obvBullish, cmfBullish, klingerBullish, twiggsBullish, iiiBullish, eomBullish, nviBullish, pviBullish, efiBullish, adLineBullish, obvBearish, cmfBearish, klingerBearish, twiggsBearish, iiiBearish, eomBearish, nviBearish, pviBearish, efiBearish, adLineBearish) =>
    c = 4.0
    confBuy = volumeConfirm and close[1] > open[1]
    confSell = volumeConfirm and close[1] < open[1]
    risBuyOnly = volumeRising and not pressureBullish
    risSellOnly = volumeRising and not pressureBearish
    bRaw = (confBuy ? 1.2 : 0.0)
         + (risBuyOnly ? 0.6 : 0.0)
         + (obvBullish ? 1.0 : 0.0)
         + (cmfBullish ? 1.0 : 0.0)
         + (pressureBullish ? (volumeRising ? 1.5 : 1.0) : 0.0)
         + (klingerBullish ? 0.8 : 0.0)
         + (twiggsBullish ? 0.7 : 0.0)
         + (iiiBullish ? 0.5 : 0.0)
         + (eomBullish ? 0.5 : 0.0)
         + (nviBullish ? 0.5 : 0.0)
         + (pviBullish ? 0.4 : 0.0)
         + (efiBullish ? 0.6 : 0.0)
         + (adLineBullish ? 0.5 : 0.0)
    sRaw = (confSell ? 1.2 : 0.0)
         + (risSellOnly ? 0.6 : 0.0)
         + (obvBearish ? 1.0 : 0.0)
         + (cmfBearish ? 1.0 : 0.0)
         + (pressureBearish ? (volumeRising ? 1.5 : 1.0) : 0.0)
         + (klingerBearish ? 0.8 : 0.0)
         + (twiggsBearish ? 0.7 : 0.0)
         + (iiiBearish ? 0.5 : 0.0)
         + (eomBearish ? 0.5 : 0.0)
         + (nviBearish ? 0.5 : 0.0)
         + (pviBearish ? 0.4 : 0.0)
         + (efiBearish ? 0.6 : 0.0)
         + (adLineBearish ? 0.5 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_trendAlignScore(mtfD, mtf240, mtf60, mtf15, mtf5, htfTrendUp, adxStrong, vwRsiBullish, vortexBullish, vwapBullish, mcginleyBullish, alligatorBullish, vwRsiBearish, vortexBearish, vwapBearish, mcginleyBearish, alligatorBearish, bullHidden, bearHidden) =>
    c = 10.0
    mtfBuy = (mtfD ? 2.5 : 0.0) + (mtf240 ? 2.0 : 0.0) + (mtf60 ? 1.0 : 0.0) + (mtf15 ? 0.6 : 0.0) + (mtf5 ? 0.4 : 0.0)
    mtfSell = (not mtfD ? 2.5 : 0.0) + (not mtf240 ? 2.0 : 0.0) + (not mtf60 ? 1.0 : 0.0) + (not mtf15 ? 0.6 : 0.0) + (not mtf5 ? 0.4 : 0.0)
    bRaw = mtfBuy + (htfTrendUp ? 2.0 : 0.0) + (adxStrong ? 0.5 : 0.0) + (vwRsiBullish ? 0.8 : 0.0) + (vortexBullish ? 0.6 : 0.0) + (vwapBullish ? 0.7 : 0.0) + (mcginleyBullish ? 0.7 : 0.0) + (alligatorBullish ? 0.8 : 0.0)
    sRaw = mtfSell + (not htfTrendUp ? 2.0 : 0.0) + (adxStrong ? 0.5 : 0.0) + (vwRsiBearish ? 0.8 : 0.0) + (vortexBearish ? 0.6 : 0.0) + (vwapBearish ? 0.7 : 0.0) + (mcginleyBearish ? 0.7 : 0.0) + (alligatorBearish ? 0.8 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_metaMultipliers(exhB, exhS, revB, revS, strB, strS, volB, volS, trdB, trdS, zScore, hvRank, adxValue, adxStrong, lagSellCount, lagEnabledCount, lagBuyCount, USE_SESSION_FILTER, inSession) =>
    // STOCKS: Lower deviation - tighter thresholds (2.5σ vs 2.0σ), reduced impact
    zBuyM = zScore[1] < -2.5 ? 1.10 : zScore[1] < -1.5 ? 1.04 : zScore[1] > 2.5 ? 0.75 : zScore[1] > 1.5 ? 0.90 : 1.0
    zSellM = zScore[1] > 2.5 ? 1.10 : zScore[1] > 1.5 ? 1.04 : zScore[1] < -2.5 ? 0.75 : zScore[1] < -1.5 ? 0.90 : 1.0
    r2M = 1.0
    exhStrength = math.max(exhB, exhS)
    // STOCKS: Stable vol = healthy trends, spikes need confirmation, add low-vol bonus
    vsM = hvRank[1] > 95 ? (exhStrength > 0.6 ? 1.06 : exhStrength > 0.4 ? 0.88 : 0.70) : hvRank[1] > 85 ? (exhStrength > 0.5 ? 1.03 : 0.92) : hvRank[1] < 30 ? 1.05 : 1.0
    adxFall = adxValue[1] < adxValue[4]
    adxRise = adxValue[1] > adxValue[4] and adxStrong
    // STOCKS: Strong trends persist - only boost reversals if trend already weak
    adxM = adxFall and not adxStrong ? 1.04 : adxRise ? 0.90 : 1.0
    lagSellRatio = lagSellCount / math.max(lagEnabledCount, 1)
    lagBuyRatio = lagBuyCount / math.max(lagEnabledCount, 1)
    lagNetBuy = lagSellRatio - lagBuyRatio
    lagNetSell = lagBuyRatio - lagSellRatio
    exBoostB = lagNetBuy >= 0 ? (lagSellRatio >= 0.82 ? 1.15 : lagSellRatio >= 0.65 ? 1.08 : 1.0) : 1.0
    exPenB = (lagNetBuy >= 0 and lagSellRatio >= 0.65) ? 1.0 : (lagSellRatio >= 0.75 ? 0.40 : (lagNetBuy < 0 ? (lagBuyRatio >= 0.82 ? 0.55 : lagBuyRatio >= 0.65 ? 0.75 : 1.0) : 1.0))
    exBoostS = lagNetSell >= 0 ? (lagBuyRatio >= 0.82 ? 1.15 : lagBuyRatio >= 0.65 ? 1.08 : 1.0) : 1.0
    exPenS = (lagNetSell >= 0 and lagBuyRatio >= 0.65) ? 1.0 : (lagBuyRatio >= 0.75 ? 0.40 : (lagNetSell < 0 ? (lagSellRatio >= 0.82 ? 0.55 : lagSellRatio >= 0.65 ? 0.75 : 1.0) : 1.0))
    // STOCKS: Demand more confirmation - higher thresholds, increased rewards
    bAgreeStrong = (exhB > 0.50 ? 1 : 0) + (revB > 0.40 ? 1 : 0) + (strB > 0.40 ? 1 : 0) + (volB > 0.55 ? 1 : 0) + (trdB > 0.60 ? 1 : 0)
    bAgree = (exhB > 0.20 ? 1 : 0) + (revB > 0.12 ? 1 : 0) + (strB > 0.15 ? 1 : 0) + (volB > 0.25 ? 1 : 0) + (trdB > 0.30 ? 1 : 0)
    sAgreeStrong = (exhS > 0.50 ? 1 : 0) + (revS > 0.40 ? 1 : 0) + (strS > 0.40 ? 1 : 0) + (volS > 0.55 ? 1 : 0) + (trdS > 0.60 ? 1 : 0)
    sAgree = (exhS > 0.20 ? 1 : 0) + (revS > 0.12 ? 1 : 0) + (strS > 0.15 ? 1 : 0) + (volS > 0.25 ? 1 : 0) + (trdS > 0.30 ? 1 : 0)
    agreeB = bAgreeStrong >= 4 ? 1.18 : bAgreeStrong >= 3 ? 1.12 : (bAgreeStrong >= 2 and bAgree >= 4) ? 1.08 : bAgree >= 4 ? 1.05 : bAgree >= 3 ? 1.02 : 1.0
    agreeS = sAgreeStrong >= 4 ? 1.18 : sAgreeStrong >= 3 ? 1.12 : (sAgreeStrong >= 2 and sAgree >= 4) ? 1.08 : sAgree >= 4 ? 1.05 : sAgree >= 3 ? 1.02 : 1.0
    // Indices: session multiplier disabled (no forex-style session gaps)
    sessM = 1.0
    [r2M, zBuyM, zSellM, vsM, adxM, exBoostB, exPenB, exBoostS, exPenS, agreeB, agreeS, sessM, bAgreeStrong, bAgree, sAgreeStrong, sAgree]

f_signalTooltip(isBuy, slSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount, buyEntryPrice, sellEntryPrice) =>
    _score = isBuy ? finalBuyScore : finalSellScore
    _conf = isBuy ? buyConfidence : sellConfidence
    _dom = isBuy ? buyDominance : sellDominance
    _domRatio = isBuy ? dominanceRatioBuy : dominanceRatioSell
    _exh = isBuy ? exhBuyScore : exhSellScore
    _rev = isBuy ? revBuyScore : revSellScore
    _str = isBuy ? structBuyScore : structSellScore
    _vol = isBuy ? volBuyScore : volSellScore
    _trd = isBuy ? trendAlignBuyScore : trendAlignSellScore
    _catStrong = isBuy ? buyCatAgreeStrong : sellCatAgreeStrong
    _catAny = isBuy ? buyCatAgree : sellCatAgree
    _sl = isBuy ? buySL : sellSL
    _tp = isBuy ? buyTP : sellTP
    _rr = isBuy ? buyActualRR : sellActualRR
    _tpSrc = isBuy ? buyTPSource : sellTPSource
    _isDivergent = isBuy ? bullishDivergence : bearishDivergence
    _entry = isBuy ? buyEntryPrice : sellEntryPrice
    _slPct = isBuy ? str.tostring((_entry - _sl) / _entry * 100, "#.#") : str.tostring((_sl - _entry) / _entry * 100, "#.#")
    _tpPct = isBuy ? str.tostring((_tp - _entry) / _entry * 100, "#.#") : str.tostring((_entry - _tp) / _entry * 100, "#.#")
    _slSign = isBuy ? "-" : "+"
    _tpSign = isBuy ? "+" : "-"
    _useTwo = isBuy ? USE_TWO_T_PS_BUY : USE_TWO_T_PS_SELL
    _tp1 = isBuy ? buyTP1 : sellTP1
    _tp2 = isBuy ? buyTP2 : sellTP2
    _tp1Pct = isBuy ? str.tostring((_tp1 - _entry) / _entry * 100, "#.#") : str.tostring((_entry - _tp1) / _entry * 100, "#.#")
    _tp2Pct = isBuy ? str.tostring((_tp2 - _entry) / _entry * 100, "#.#") : str.tostring((_entry - _tp2) / _entry * 100, "#.#")
    _side = isBuy ? "Buy" : "Sell"
    _pdLabel = isBuy ? (inPremium ? "Premium ⚠" : "Discount ✓") : (inDiscount ? "Discount ⚠" : "Premium ✓")
    t = _side + " Signal\n"
     + "Dominance: +" + str.tostring(_dom, "#.#") + " (×" + str.tostring(_domRatio, "#.##") + ")\n"
     + "Exhaustion:  " + str.tostring(_exh * 100, "#") + "% (wt 20%)\n"
     + "Reversal:    " + str.tostring(_rev * 100, "#") + "% (wt 18%)\n"
     + "Structure:   " + str.tostring(_str * 100, "#") + "% (wt 22%)\n"
     + "Volume:      " + str.tostring(_vol * 100, "#") + "% (wt 22%)\n"
     + "Trend Align: " + str.tostring(_trd * 100, "#") + "% (wt 18%)\n"
     + "━━━━━━━━━━━━━━━━━━━━\n"
     + "Cats agree: " + str.tostring(_catStrong) + " strong + " + str.tostring(_catAny) + "/5 any\n"
     + "R²: " + str.tostring(rSqValue, "#.##") + " (rev×" + str.tostring(r2Reversal, "#.##") + " trd×" + str.tostring(r2Trend, "#.##") + ") | Z: " + str.tostring(zScore[1], "#.#") + "\n"
     + "HV Rank: " + str.tostring(hvRank[1], "#") + "%" + (volSpikeMult < 1.0 ? " ⚠" : "") + "\n"
     + "P/D Zone: " + _pdLabel + "\n"
     + "Lagging bull/bear: " + str.tostring(lagBuyCount) + "/" + str.tostring(lagSellCount) + " (of " + str.tostring(lagEnabledCount) + ")\n"
     + "Divergence: " + (_isDivergent ? "Yes (+8)" : "No") + "\n"
     + "━━━━━━━━━━━━━━━━━━━━\n"
     + "Entry: " + str.tostring(_entry, "#.##") + "\n"
     + "SL: " + str.tostring(_sl, "#.##") + " (" + _slSign + _slPct + "%) " + slSource + "\n"
     + (_useTwo ? "TP1: " + str.tostring(_tp1, "#.##") + " (" + _tpSign + _tp1Pct + "%) | TP2: " + str.tostring(_tp2, "#.##") + " (" + _tpSign + _tp2Pct + "%) at " + _tpSrc + "\n" : "TP: " + str.tostring(_tp, "#.##") + " (" + _tpSign + _tpPct + "%) at " + _tpSrc + "\n")
     + "R:R = 1:" + str.tostring(_rr, "#.#")
    t

f_deleteBuySignalDrawings(entryLine, entryLabel, entryZone, zoneLabel, slLine, tpLine, slLabel, tpLabel, riskZone, rewardZone, tp2Line, tp2Label, rewardZone2) =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(entryZone)
        box.delete(entryZone)
    if not na(zoneLabel)
        label.delete(zoneLabel)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(riskZone)
        box.delete(riskZone)
    if not na(rewardZone)
        box.delete(rewardZone)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(rewardZone2)
        box.delete(rewardZone2)

f_deleteSellSignalDrawings(entryLine, entryLabel, entryZone, zoneLabel, slLine, tpLine, slLabel, tpLabel, riskZone, rewardZone, tp2Line, tp2Label, rewardZone2) =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(entryZone)
        box.delete(entryZone)
    if not na(zoneLabel)
        label.delete(zoneLabel)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(riskZone)
        box.delete(riskZone)
    if not na(rewardZone)
        box.delete(rewardZone)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(rewardZone2)
        box.delete(rewardZone2)

f_extendBuySignalDrawings(slLine, tpLine, entryLine, riskZone, rewardZone, entryZone, slLabel, tpLabel, entryLabel, hasEntryZone, x, tp2Line, tp2Label, rewardZone2) =>
    if not na(slLine)
        line.set_x2(slLine, x)
    if not na(tpLine)
        line.set_x2(tpLine, x)
    if not na(entryLine)
        line.set_x2(entryLine, x)
    if not na(riskZone)
        box.set_right(riskZone, x)
    if not na(rewardZone)
        box.set_right(rewardZone, x)
    if not na(entryZone)
        box.set_right(entryZone, x)
    if not na(slLabel)
        label.set_x(slLabel, x)
    if not na(tpLabel)
        label.set_x(tpLabel, x)
    if not na(tp2Line)
        line.set_x2(tp2Line, x)
    if not na(tp2Label)
        label.set_x(tp2Label, x)
    if not na(rewardZone2)
        box.set_right(rewardZone2, x)
    if not na(entryLabel) and not hasEntryZone
        label.set_x(entryLabel, x)

f_extendSellSignalDrawings(slLine, tpLine, entryLine, riskZone, rewardZone, entryZone, slLabel, tpLabel, entryLabel, hasEntryZone, x, tp2Line, tp2Label, rewardZone2) =>
    if not na(slLine)
        line.set_x2(slLine, x)
    if not na(tpLine)
        line.set_x2(tpLine, x)
    if not na(entryLine)
        line.set_x2(entryLine, x)
    if not na(riskZone)
        box.set_right(riskZone, x)
    if not na(rewardZone)
        box.set_right(rewardZone, x)
    if not na(entryZone)
        box.set_right(entryZone, x)
    if not na(slLabel)
        label.set_x(slLabel, x)
    if not na(tpLabel)
        label.set_x(tpLabel, x)
    if not na(tp2Line)
        line.set_x2(tp2Line, x)
    if not na(tp2Label)
        label.set_x(tp2Label, x)
    if not na(rewardZone2)
        box.set_right(rewardZone2, x)
    if not na(entryLabel) and not hasEntryZone
        label.set_x(entryLabel, x)

f_prevSignalGrayColors(opacity) =>
    _grayLine = color.new(MUTED_COLOR, 100 - opacity)
    _grayLabel = color.new(MUTED_COLOR, math.min(110 - opacity, 99))
    _grayTxt = color.new(MUTED_COLOR, math.max(80 - opacity, 30))
    _grayBox = color.new(MUTED_COLOR, math.min(108 - opacity, 99))
    _grayBoxBorder = color.new(MUTED_COLOR, 100 - opacity)
    _grayEntryLine = color.new(MUTED_COLOR, math.max(0, 80 - opacity))
    _grayEntryLabel = color.new(MUTED_COLOR, math.max(0, math.min(90 - opacity, 99)))
    _grayEntryTxt = color.new(MUTED_COLOR, math.max(10, 60 - opacity))
    _grayEntryBox = color.new(MUTED_COLOR, math.max(0, math.min(88 - opacity, 99)))
    _grayEntryBoxBorder = color.new(MUTED_COLOR, math.max(0, 80 - opacity))
    [_grayLine, _grayLabel, _grayTxt, _grayBox, _grayBoxBorder, _grayEntryLine, _grayEntryLabel, _grayEntryTxt, _grayEntryBox, _grayEntryBoxBorder]

f_applyGrayToAllSignals(gL, gLbl, gTxt, gBox, gBoxB, gEntL, gEntLbl, gEntTxt, gEntBox, gEntBoxB, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2) =>
    if not na(buyEntryLine)
        line.set_color(buyEntryLine, gEntL)
    if not na(buyEntryLabel)
        label.set_color(buyEntryLabel, gEntLbl)
        label.set_textcolor(buyEntryLabel, gEntTxt)
    if not na(buyEntryZone)
        box.set_bgcolor(buyEntryZone, gEntBox)
        box.set_border_color(buyEntryZone, gEntBoxB)
    if not na(buyZoneLabel)
        label.set_color(buyZoneLabel, gEntLbl)
        label.set_textcolor(buyZoneLabel, gEntTxt)
    if not na(buySLLine)
        line.set_color(buySLLine, gL)
    if not na(buyTPLine)
        line.set_color(buyTPLine, gL)
    if not na(buySLLabel)
        label.set_color(buySLLabel, gLbl)
        label.set_textcolor(buySLLabel, gTxt)
    if not na(buyTPLabel)
        label.set_color(buyTPLabel, gLbl)
        label.set_textcolor(buyTPLabel, gTxt)
    if not na(buyTP2Line)
        line.set_color(buyTP2Line, gL)
    if not na(buyTP2Label)
        label.set_color(buyTP2Label, gLbl)
        label.set_textcolor(buyTP2Label, gTxt)
    if not na(buyRiskZone)
        box.set_bgcolor(buyRiskZone, gBox)
        box.set_border_color(buyRiskZone, gBoxB)
    if not na(buyRewardZone)
        box.set_bgcolor(buyRewardZone, gBox)
        box.set_border_color(buyRewardZone, gBoxB)
    if not na(buyRewardZone2)
        box.set_bgcolor(buyRewardZone2, gBox)
        box.set_border_color(buyRewardZone2, gBoxB)
    if not na(sellRiskZone)
        box.set_bgcolor(sellRiskZone, gBox)
        box.set_border_color(sellRiskZone, gBoxB)
    if not na(sellRewardZone)
        box.set_bgcolor(sellRewardZone, gBox)
        box.set_border_color(sellRewardZone, gBoxB)
    if not na(sellRewardZone2)
        box.set_bgcolor(sellRewardZone2, gBox)
        box.set_border_color(sellRewardZone2, gBoxB)
    if not na(sellEntryLine)
        line.set_color(sellEntryLine, gEntL)
    if not na(sellEntryLabel)
        label.set_color(sellEntryLabel, gEntLbl)
        label.set_textcolor(sellEntryLabel, gEntTxt)
    if not na(sellEntryZone)
        box.set_bgcolor(sellEntryZone, gEntBox)
        box.set_border_color(sellEntryZone, gEntBoxB)
    if not na(sellZoneLabel)
        label.set_color(sellZoneLabel, gEntLbl)
        label.set_textcolor(sellZoneLabel, gEntTxt)
    if not na(sellSLLine)
        line.set_color(sellSLLine, gL)
    if not na(sellTPLine)
        line.set_color(sellTPLine, gL)
    if not na(sellSLLabel)
        label.set_color(sellSLLabel, gLbl)
        label.set_textcolor(sellSLLabel, gTxt)
    if not na(sellTPLabel)
        label.set_color(sellTPLabel, gLbl)
        label.set_textcolor(sellTPLabel, gTxt)
    if not na(sellTP2Line)
        line.set_color(sellTP2Line, gL)
    if not na(sellTP2Label)
        label.set_color(sellTP2Label, gLbl)
        label.set_textcolor(sellTP2Label, gTxt)

f_divergence(src, oscType) =>
    osc = float(na)
    if oscType == "RSI"
        osc := ta.rsi(src, RSI_LENGTH)
    else
        [macdL, _, _] = ta.macd(src, MACD_FAST, MACD_SLOW, MACD_SIGNAL)
        osc := macdL
    lb = 5
    pivotHigh = ta.pivothigh(src, lb, lb)
    pivotLow = ta.pivotlow(src, lb, lb)
    oscPivotHigh = ta.pivothigh(osc, lb, lb)
    oscPivotLow = ta.pivotlow(osc, lb, lb)
    prevPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
    prevPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)
    prevOscPivotHigh = ta.valuewhen(not na(oscPivotHigh), oscPivotHigh, 1)
    prevOscPivotLow = ta.valuewhen(not na(oscPivotLow), oscPivotLow, 1)
    validLow = not na(pivotLow) and not na(oscPivotLow)
    validHigh = not na(pivotHigh) and not na(oscPivotHigh)
    bullDiv = validLow and pivotLow < prevPivotLow and oscPivotLow > prevOscPivotLow
    bearDiv = validHigh and pivotHigh > prevPivotHigh and oscPivotHigh < prevOscPivotHigh
    bullHidden = validLow and pivotLow > prevPivotLow and oscPivotLow < prevOscPivotLow
    bearHidden = validHigh and pivotHigh < prevPivotHigh and oscPivotHigh > prevOscPivotHigh
    [bullDiv, bearDiv, bullHidden, bearHidden]

f_fisherTransform(length) =>
    hl2Val = hl2
    maxH = ta.highest(hl2Val, length)
    minL = ta.lowest(hl2Val, length)
    rangeHL = maxH - minL
    var float val = 0.0
    var float fish = 0.0
    var float prevFish = 0.0
    rawVal = rangeHL > 0 ? 2.0 * ((hl2Val - minL) / rangeHL - 0.5) : 0.0
    val := 0.33 * rawVal + 0.67 * nz(val[1])
    val := math.max(-0.999, math.min(0.999, val))
    prevFish := nz(fish[1])
    fish := 0.5 * math.log((1 + val) / (1 - val)) + 0.5 * prevFish
    [fish, prevFish]

f_ehlersSineWave() =>
    var float smooth = 0.0
    var float detrender = 0.0
    var float i1 = 0.0
    var float q1 = 0.0
    var float ji = 0.0
    var float jq = 0.0
    var float i2 = 0.0
    var float q2 = 0.0
    var float re = 0.0
    var float im = 0.0
    var float period = 0.0
    var float smoothPeriod = 0.0
    var float dcPhase = 0.0
    var float sine = 0.0
    var float leadSine = 0.0
    price = (high + low) / 2.0
    smooth := (4 * price + 3 * nz(price[1]) + 2 * nz(price[2]) + nz(price[3])) / 10.0
    detrender := (0.0962 * smooth + 0.5769 * nz(smooth[2]) - 0.5769 * nz(smooth[4]) - 0.0962 * nz(smooth[6])) * (0.075 * nz(period[1]) + 0.54)
    q1 := (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * (0.075 * nz(period[1]) + 0.54)
    i1 := nz(detrender[3])
    ji := (0.0962 * i1 + 0.5769 * nz(i1[2]) - 0.5769 * nz(i1[4]) - 0.0962 * nz(i1[6])) * (0.075 * nz(period[1]) + 0.54)
    jq := (0.0962 * q1 + 0.5769 * nz(q1[2]) - 0.5769 * nz(q1[4]) - 0.0962 * nz(q1[6])) * (0.075 * nz(period[1]) + 0.54)
    i2 := i1 - jq
    q2 := q1 + ji
    i2 := 0.2 * i2 + 0.8 * nz(i2[1])
    q2 := 0.2 * q2 + 0.8 * nz(q2[1])
    re := i2 * nz(i2[1]) + q2 * nz(q2[1])
    im := i2 * nz(q2[1]) - q2 * nz(i2[1])
    re := 0.2 * re + 0.8 * nz(re[1])
    im := 0.2 * im + 0.8 * nz(im[1])
    tempPeriod = im != 0 and re != 0 ? 2 * math.acos(1) / math.atan(im / re) : nz(period[1])
    tempPeriod2 = math.max(math.min(tempPeriod, 1.5 * nz(period[1])), 0.67 * nz(period[1]))
    tempPeriod3 = math.max(math.min(tempPeriod2, 50.0), 6.0)
    period := 0.2 * tempPeriod3 + 0.8 * nz(period[1])
    smoothPeriod := 0.33 * period + 0.67 * nz(smoothPeriod[1])
    dcPeriod = math.round(smoothPeriod)
    realPart = 0.0
    imagPart = 0.0
    for i = 0 to math.max(dcPeriod - 1, 0)
        realPart += math.sin(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
        imagPart += math.cos(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
    dcPhase := imagPart != 0 ? math.atan(realPart / imagPart) * 180 / math.pi : 90.0 * (realPart > 0 ? 1 : -1)
    dcPhase += 90
    dcPhase += (360 / smoothPeriod > 0 ? 360 / smoothPeriod : 1)
    if imagPart < 0
        dcPhase += 180
    if dcPhase > 315
        dcPhase -= 360
    sine := math.sin(dcPhase * math.acos(1) / 180)
    leadSine := math.sin((dcPhase + 45) * math.acos(1) / 180)
    [sine, leadSine, smoothPeriod]

f_mcginley(src, length) =>
    var float mg = na
    mg := na(mg) ? src : mg[1] + (src - mg[1]) / math.max(length * math.pow(src / math.max(mg[1], 1e-10), 4), 1e-10)
    mg

f_trix(src, length, signalLen) =>
    e1 = ta.ema(src, length)
    e2 = ta.ema(e1, length)
    e3 = ta.ema(e2, length)
    trixVal = ta.roc(e3, 1)
    trixSignal = ta.sma(trixVal, signalLen)
    [trixVal, trixSignal]

f_oscillator(period1, period2, period3) =>
    bp = close - math.min(low, low[1])
    tr_uo = math.max(high, high[1]) - math.min(low, low[1])
    avgTrendFilter = ta.rma(bp, period1) / math.max(ta.rma(tr_uo, period1), 1e-10)
    avgMomentum = ta.rma(bp, period2) / math.max(ta.rma(tr_uo, period2), 1e-10)
    avgVolatility = ta.rma(bp, period3) / math.max(ta.rma(tr_uo, period3), 1e-10)
    uo = 100 * (4 * avgTrendFilter + 2 * avgMomentum + avgVolatility) / 7
    uo

f_dpo(src, length) =>
    halfLen = math.round(length / 2) + 1
    smaVal = ta.sma(src, length)
    dpoVal = src[halfLen] - smaVal[halfLen]
    dpoVal

f_rvi(length) =>
    rviRaw = (close - open) / math.max(high - low, 1e-10)
    rviSmooth = ta.sma(rviRaw, length)
    rviSignal = ta.sma(rviSmooth, 4)
    [rviSmooth, rviSignal]

f_schaffTrendCycle(cycleLen, smooth1, smooth2) =>
    var float xmac = 0.0
    var float xmacd = 0.0
    var float stc = 0.0
    xmac := ta.ema(close - ta.ema(close, cycleLen), smooth1)
    xmacd := ta.ema(xmac, smooth2)
    v1 = ta.highest(xmacd, smooth2) - ta.lowest(xmacd, smooth2)
    v2 = v1 != 0 ? (xmacd - ta.lowest(xmacd, smooth2)) / v1 : 0.0
    stc := 0.0
    if not na(v2)
        var float stcPrev = 50.0
        stcPrev := 0.5 * (stcPrev + 100 * (v2 - 0.5))
        stc := math.max(0, math.min(100, stcPrev))
    [xmacd, stc]

f_smma(src, length) =>
    var float sum = na
    sum := na(sum) ? ta.sma(src, length) : (sum[1] * (length - 1) + src) / length
    sum

f_massIndex(singleLen, sumLen) =>
    hlRange = high - low
    hlEma = ta.ema(hlRange, singleLen)
    hlEma2 = ta.ema(hlEma, singleLen)
    ratio = hlEma2 > 0 ? hlEma / hlEma2 : 0.0
    massSumVal = math.sum(ratio, sumLen)
    massSumVal

f_klinger(fastLen, slowLen, signalLen) =>
    trend = ta.ema(high - low, 5) > ta.ema(high - low, 34) ? 1 : -1
    dm = high - low
    cm = 0.0
    if trend == trend[1]
        cm := nz(cm[1]) + dm
    else
        cm := dm
    vf = volume * math.abs(2 * dm / math.max(cm, 1e-10) - 1) * trend * 100
    kvo = ta.ema(ta.sma(vf, math.min(fastLen, slowLen)), math.max(fastLen, slowLen) - math.min(fastLen, slowLen) + 1)
    kvoSigLine = ta.ema(kvo, signalLen)
    [kvo, kvoSigLine]

f_eom(length) =>
    dm = (high + low) / 2 - (high[1] + low[1]) / 2
    br = volume / math.max(high - low, 1e-10)
    eomRaw = br != 0 ? dm / br : 0.0
    eomSmooth = ta.sma(eomRaw * 1000000, length)
    eomSmooth

f_vortex(len) =>
    plusVM = math.abs(high - low[1])
    minusVM = math.abs(low - high[1])
    trV = ta.atr(len)
    viPlus = trV != 0 ? ta.rma(plusVM, len) / trV : 0.0
    viMinus = trV != 0 ? ta.rma(minusVM, len) / trV : 0.0
    [viPlus, viMinus]

f_condColor(met) =>
    met ? color.new(POSITIVE_COLOR, 65) : color.new(NEGATIVE_COLOR, 65)

f_condColor3(bullish, bearish) =>
    bullish ? color.new(POSITIVE_COLOR, 65) : bearish ? color.new(NEGATIVE_COLOR, 65) : color.new(NEUTRAL_COLOR, 55)

f_condSym(met) =>
    met ? "●" : "○"

f_rowBg(int row) =>
    row % 2 == 0 ? BACKGROUND_COLOR : color.new(BACKGROUND_COLOR, 12)

f_sparkline(series float src, lookback) =>
    asciiLadder = " .:-=+#"
    result = ""
    maxVal = ta.highest(src, lookback)
    minVal = ta.lowest(src, lookback)
    rangeVal = math.max(maxVal - minVal, 1e-10)
    for i = lookback - 1 to 0
        idx = math.round((nz(src[i]) - minVal) / rangeVal * 7)
        idx := math.max(0, math.min(7, idx))
        result += str.substring(asciiLadder, idx, idx + 1)
    result

f_calcTrend() =>
    hullMA = ta.hma(close, HULL_LENGTH)
    hullTrend = hullMA > hullMA[1]
    htfEma = request.security(syminfo.tickerid, HTF_TIMEFRAME, ta.ema(close, HTF_EMA_LENGTH), lookahead=barmerge.lookahead_off)
    htfEmaPrev = htfEma[1]
    htfTrendUp = close[1] > htfEmaPrev
    [plusDI, minusDI, adxValue] = ta.dmi(ADX_LENGTH, ADX_LENGTH)
    adxStrong = adxValue[1] > ADX_THRESHOLD
    trendUp = close[1] > hullMA[1] and hullMA[1] > hullMA[2]
    trendDown = close[1] < hullMA[1] and hullMA[1] < hullMA[2]
    [hullMA, hullTrend, htfEma, htfEmaPrev, htfTrendUp, plusDI, minusDI, adxValue, adxStrong, trendUp, trendDown]

f_calcMomentum(series float hullMA) =>
    rsiValue = ta.rsi(close, RSI_LENGTH)
    rsiPrev = rsiValue[1]
    rsiRegimeBull = close[1] > hullMA[1]
    rsiOS = USE_RSI_REGIME ? (rsiRegimeBull ? RSI_BULL_OVERSOLD : RSI_BEAR_OVERSOLD) : RSI_OVERSOLD
    rsiOB = USE_RSI_REGIME ? (rsiRegimeBull ? RSI_BULL_OVERBOUGHT : RSI_BEAR_OVERBOUGHT) : RSI_OVERBOUGHT
    rsiOversoldCross = ta.crossover(rsiValue, rsiOS)
    rsiOverboughtCross = ta.crossunder(rsiValue, rsiOB)
    rsiBullish = rsiPrev > 50 or rsiOversoldCross[1]
    rsiBearish = rsiPrev < 50 or rsiOverboughtCross[1]
    [macdLine, macdSignalLine, macdHist] = ta.macd(close, MACD_FAST, MACD_SLOW, MACD_SIGNAL)
    macdLinePrev = macdLine[1]
    macdSignalPrev = macdSignalLine[1]
    macdCrossUp = ta.crossover(macdLine, macdSignalLine)
    macdCrossDown = ta.crossunder(macdLine, macdSignalLine)
    macdBullish = macdLinePrev > macdSignalPrev or macdCrossUp[1]
    macdBearish = macdLinePrev < macdSignalPrev or macdCrossDown[1]
    [rsiValue, rsiPrev, rsiOS, rsiOB, rsiOversoldCross, rsiOverboughtCross, rsiBullish, rsiBearish, macdLine, macdSignalLine, macdHist, macdLinePrev, macdSignalPrev, macdCrossUp, macdCrossDown, macdBullish, macdBearish]

f_calcVolatility() =>
    atr = ta.atr(ATR_LENGTH)
    atrPrev = atr[1]
    bbBasis = ta.sma(close, BB_LENGTH)
    bbDev = BB_MULTIPLIER * ta.stdev(close, BB_LENGTH)
    bbUpper = bbBasis + bbDev
    bbLower = bbBasis - bbDev
    bbBullish = USE_BB ? close[1] > bbBasis[1] : true
    bbBearish = USE_BB ? close[1] < bbBasis[1] : true
    bbWidth = bbUpper - bbLower
    bbWidthSma = ta.sma(bbWidth, SQUEEZE_LENGTH)
    bbSqueeze = bbWidth < bbWidthSma * 0.7
    bbPercent = (close - bbLower) / (bbUpper - bbLower)
    notAtExtremes = bbPercent > 0.2 and bbPercent < 0.8
    [atr, atrPrev, bbBasis, bbDev, bbUpper, bbLower, bbBullish, bbBearish, bbWidth, bbWidthSma, bbSqueeze, bbPercent, notAtExtremes]

f_calcVolume() =>
    volumeMA = ta.sma(volume, VOLUME_LENGTH)
    volumeConfirm = volume[1] > volumeMA[1] * VOLUME_MULTIPLIER
    volZScore = (volume - ta.sma(volume, 50)) / math.max(ta.stdev(volume, 50), 1)
    volClimax = volZScore > 2.5
    volClimaxBuy = volClimax and close[1] < open[1]
    volClimaxSell = volClimax and close[1] > open[1]
    [volumeMA, volumeConfirm, volZScore, volClimax, volClimaxBuy, volClimaxSell]

f_calcStructure(series float atr, series bool trendUp, series bool trendDown) =>
    swingHigh = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    swingLow = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)
    lastSwingHigh = ta.valuewhen(not na(swingHigh), swingHigh, 0)
    lastSwingLow = ta.valuewhen(not na(swingLow), swingLow, 0)
    barsSinceSwingLow = bar_index - ta.valuewhen(not na(swingLow), bar_index, 0)
    barsSinceSwingHigh = bar_index - ta.valuewhen(not na(swingHigh), bar_index, 0)
    extendedBearRun = barsSinceSwingLow > 30
    extendedBullRun = barsSinceSwingHigh > 30
    breakoutUp = USE_BREAKOUT ? (na(lastSwingHigh) or close[1] > lastSwingHigh) : true
    breakoutDown = USE_BREAKOUT ? (na(lastSwingLow) or close[1] < lastSwingLow) : true
    nearSupport = not na(lastSwingLow) and lastSwingLow > 0 and low[1] <= lastSwingLow * 1.002
    nearResistance = not na(lastSwingHigh) and lastSwingHigh > 0 and high[1] >= lastSwingHigh * 0.998
    displacementThreshold = atr * SWING_DISPLACEMENT_ATR
    validSwingHigh = not na(swingHigh)
    validSwingLow = not na(swingLow)
    lastValidSwingHigh = ta.valuewhen(validSwingHigh, swingHigh, 0)
    lastValidSwingLow = ta.valuewhen(validSwingLow, swingLow, 0)
    bosBull = USE_BOS_BODY ? (close[1] > lastSwingHigh and lastSwingHigh > 0) : (high[1] > lastSwingHigh and lastSwingHigh > 0)
    bosBear = USE_BOS_BODY ? (close[1] < lastSwingLow and lastSwingLow > 0) : (low[1] < lastSwingLow and lastSwingLow > 0)
    sfpBear = lastSwingHigh > 0 and high[1] > lastSwingHigh and close[1] <= lastSwingHigh
    sfpBull = lastSwingLow > 0 and low[1] < lastSwingLow and close[1] >= lastSwingLow
    liqSweepBuy = low < lastSwingLow and close > lastSwingLow and close > open
    liqSweepSell = high > lastSwingHigh and close < lastSwingHigh and close < open
    chochBearish = trendUp and not na(lastSwingLow) and lastSwingLow > 0 and close[1] < lastSwingLow
    chochBullish = trendDown and not na(lastSwingHigh) and lastSwingHigh > 0 and close[1] > lastSwingHigh
    chochBlockBuy = USE_C_HO_CH_FILTER and chochBearish
    chochBlockSell = USE_C_HO_CH_FILTER and chochBullish
    [swingHigh, swingLow, lastSwingHigh, lastSwingLow, barsSinceSwingLow, barsSinceSwingHigh, extendedBearRun, extendedBullRun, breakoutUp, breakoutDown, nearSupport, nearResistance, lastValidSwingHigh, lastValidSwingLow, bosBull, bosBear, sfpBear, sfpBull, liqSweepBuy, liqSweepSell, chochBearish, chochBullish, chochBlockBuy, chochBlockSell]

f_calcMAStack() =>
    emaFast = ta.ema(close, MA_FAST_LEN)
    emaSlow = ta.ema(close, MA_SLOW_LEN)
    emaSlower = ta.ema(close, MA_SLOWER_LEN)
    ema200 = ta.ema(close, 200)
    maStackUp = USE_MA_STACK ? (emaFast[1] > emaSlow[1] and emaSlow[1] > emaSlower[1]) : true
    maStackDown = USE_MA_STACK ? (emaFast[1] < emaSlow[1] and emaSlow[1] < emaSlower[1]) : true
    [emaFast, emaSlow, emaSlower, ema200, maStackUp, maStackDown]

f_calcFiltersAndMTF(series float atr) =>
    atrAvg = ta.sma(atr, ATR_LENGTH * 2)
    atrInRange = USE_ATR_FILTER ? (ATR_MIN_PCT <= 0 or atr[1] >= atrAvg[1] * (ATR_MIN_PCT / 100.0)) and (ATR_MAX_PCT <= 0 or atr[1] <= atrAvg[1] * (1 + ATR_MAX_PCT / 100.0)) : true
    htfRsi = request.security(syminfo.tickerid, HTF_TIMEFRAME, ta.rsi(close, HTF_RSI_LENGTH), lookahead=barmerge.lookahead_off)
    htfRsiPrev = htfRsi[1]
    htfRsiOkBuy = USE_HTFRSI ? htfRsiPrev < HTF_RSI_NOT_OVERBOUGHT : true
    htfRsiOkSell = USE_HTFRSI ? htfRsiPrev > HTF_RSI_NOT_OVERSOLD : true
    [htfRsiForDiv, htfRsiForDivPrev] = request.security(syminfo.tickerid, HTF_TIMEFRAME, [ta.rsi(close, RSI_LENGTH)[1], ta.rsi(close, RSI_LENGTH)[2]], lookahead=barmerge.lookahead_off)
    mtfEmaLen = 20
    mtf5  = request.security(syminfo.tickerid, "5",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf15 = request.security(syminfo.tickerid, "15", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf60 = request.security(syminfo.tickerid, "60", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf240 = request.security(syminfo.tickerid, "240", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtfD  = request.security(syminfo.tickerid, "D",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    [prevDayHigh, prevDayLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
    inSession = USE_SESSION_FILTER ? not na(time(timeframe.period, SESSION_STR, syminfo.timezone)) : true
    [atrInRange, htfRsi, htfRsiPrev, htfRsiOkBuy, htfRsiOkSell, htfRsiForDiv, htfRsiForDivPrev, mtf5, mtf15, mtf60, mtf240, mtfD, prevDayHigh, prevDayLow, inSession]

f_calcIchimoku() =>
    conv = (ta.highest(high, ICH_CONVERSION) + ta.lowest(low, ICH_CONVERSION)) / 2
    base = (ta.highest(high, ICH_BASE) + ta.lowest(low, ICH_BASE)) / 2
    spanA = (conv + base) / 2
    spanB = (ta.highest(high, ICH_SPAN) + ta.lowest(low, ICH_SPAN)) / 2
    cloudTop = math.max(spanA[ICH_BASE], spanB[ICH_BASE])
    cloudBot = math.min(spanA[ICH_BASE], spanB[ICH_BASE])
    tkCross = conv > base
    aboveCloud = close[1] > cloudTop[1]
    belowCloud = close[1] < cloudBot[1]
    greenCloud = spanA > spanB
    ichBull = USE_ICHIMOKU ? (aboveCloud and tkCross[1]) : true
    ichBear = USE_ICHIMOKU ? (belowCloud and not tkCross[1]) : true
    [conv, base, spanA, spanB, cloudTop, cloudBot, tkCross, aboveCloud, belowCloud, greenCloud, ichBull, ichBear]

f_calcDEMATEMA() =>
    dE1 = ta.ema(close, DEMA_LENGTH)
    dVal = 2 * dE1 - ta.ema(dE1, DEMA_LENGTH)
    tE1 = ta.ema(close, TEMA_LENGTH)
    tE2 = ta.ema(tE1, TEMA_LENGTH)
    tE3 = ta.ema(tE2, TEMA_LENGTH)
    tVal = 3 * tE1 - 3 * tE2 + tE3
    [dVal, tVal, close[1] > dVal[1], close[1] < dVal[1], close[1] > tVal[1], close[1] < tVal[1]]

f_calcGMMA() =>
    s1 = ta.ema(close, 3)
    s2 = ta.ema(close, 5)
    s3 = ta.ema(close, 8)
    s4 = ta.ema(close, 10)
    s5 = ta.ema(close, 12)
    s6 = ta.ema(close, 15)
    l1 = ta.ema(close, 30)
    l2 = ta.ema(close, 35)
    l3 = ta.ema(close, 40)
    l4 = ta.ema(close, 45)
    l5 = ta.ema(close, 50)
    l6 = ta.ema(close, 60)
    shortAvg = (s1 + s2 + s3 + s4 + s5 + s6) / 6
    longAvg = (l1 + l2 + l3 + l4 + l5 + l6) / 6
    gBull = USE_GMMA ? shortAvg[1] > longAvg[1] : true
    gBear = USE_GMMA ? shortAvg[1] < longAvg[1] : true
    [shortAvg, longAvg, gBull, gBear]

f_calcAlligator() =>
    med = (high + low) / 2
    jawVal = f_smma(med, ALLIGATOR_JAW)
    teethVal = f_smma(med, ALLIGATOR_TEETH)
    lipsVal = f_smma(med, ALLIGATOR_LIPS)
    jawPlot = jawVal[8]
    teethPlot = teethVal[5]
    lipsPlot = lipsVal[3]
    aBull = lipsPlot > teethPlot and teethPlot > jawPlot
    aBear = lipsPlot < teethPlot and teethPlot < jawPlot
    gatorUp = math.abs(jawPlot - teethPlot)
    gatorLo = math.abs(teethPlot - lipsPlot)
    gatorExp = (gatorUp > gatorUp[1] or gatorLo > gatorLo[1])
    [jawPlot, teethPlot, lipsPlot, aBull, aBear, gatorUp, gatorLo, gatorExp]

f_calcCandlePatterns(series float atr) =>
    bodySz = math.abs(close[1] - open[1])
    upperW = high[1] - math.max(close[1], open[1])
    lowerW = math.min(close[1], open[1]) - low[1]
    bullEng = (close[2] < open[2] and close[1] > open[1] and open[1] <= close[2] and close[1] >= open[2])
    bearEng = (close[2] > open[2] and close[1] < open[1] and open[1] >= close[2] and close[1] <= open[2])
    hammerB = (lowerW >= bodySz * PIN_BAR_WICK_RATIO and upperW < bodySz and close[1] > open[1])
    shootStar = (upperW >= bodySz * PIN_BAR_WICK_RATIO and lowerW < bodySz and close[1] < open[1])
    wickRejB = (low[1] < low[2]) and (close[1] > (high[1] + low[1]) / 2) and (close[2] > (high[2] + low[2]) / 2)
    wickRejS = (high[1] > high[2]) and (close[1] < (high[1] + low[1]) / 2) and (close[2] < (high[2] + low[2]) / 2)
    bar3Bear = close[3] < open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
    bar2Sm = math.abs(close[2] - open[2]) < atr[2] * 0.3
    bar1Bull = close[1] > open[1] and close[1] > (open[3] + close[3]) / 2
    mornStar = (bar3Bear and bar2Sm and bar1Bull)
    bar3Bull = close[3] > open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
    bar1Bear = close[1] < open[1] and close[1] < (open[3] + close[3]) / 2
    evenStar = (bar3Bull and bar2Sm and bar1Bear)
    candleRng1 = high[1] - low[1]
    doj = (bodySz / math.max(candleRng1, 1e-10) <= DOJI_BODY_PCT and bodySz < atr[1] * 0.2)
    bullHar = (close[2] < open[2] and close[1] > open[1] and open[1] > close[2] and close[1] < open[2])
    bearHar = (close[2] > open[2] and close[1] < open[1] and open[1] < close[2] and close[1] > open[2])
    threeWS = (close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and open[1] > open[2] and open[1] < close[2] and open[2] > open[3] and open[2] < close[3] and close[1] > close[2] and close[2] > close[3])
    threeBC = (close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and open[1] < open[2] and open[1] > close[2] and open[2] < open[3] and open[2] > close[3] and close[1] < close[2] and close[2] < close[3])
    tweezerB = (math.abs(low[1] - low[2]) <= atr * TWEEZER_TOLERANCE and close[1] > open[1] and close[2] < open[2])
    tweezerT = (math.abs(high[1] - high[2]) <= atr * TWEEZER_TOLERANCE and close[1] < open[1] and close[2] > open[2])
    mid2 = (open[2] + close[2]) / 2
    pierceLine = (close[2] < open[2] and open[1] < low[2] and close[1] > mid2 and close[1] < open[2] and close[1] > open[1])
    darkCloud = (close[2] > open[2] and open[1] > high[2] and close[1] < mid2 and close[1] > close[2] and close[1] < open[1])
    [bullEng, bearEng, hammerB, shootStar, mornStar, evenStar, doj, bullHar, bearHar, threeWS, threeBC, tweezerB, tweezerT, pierceLine, darkCloud, wickRejB, wickRejS]

f_calcPivotLevels(series float pivotHighHTF, series float pivotLowHTF, series float pivotCloseHTF) =>
    p = (pivotHighHTF + pivotLowHTF + pivotCloseHTF) / 3
    r1 = 2 * p - pivotLowHTF
    r2 = p + (pivotHighHTF - pivotLowHTF)
    s1 = 2 * p - pivotHighHTF
    s2 = p - (pivotHighHTF - pivotLowHTF)
    nearR1 = close[1] >= r1[1] * 0.998 and close[1] <= r1[1] * 1.002
    nearS1 = close[1] >= s1[1] * 0.998 and close[1] <= s1[1] * 1.002
    crossUpR1 = ta.crossover(close, r1)
    crossDnS1 = ta.crossunder(close, s1)
    brk = crossUpR1 or crossDnS1
    [p, r1, r2, s1, s2, nearR1, nearS1, crossUpR1, crossDnS1, brk]

f_calcFibLevels() =>
    fibHigh = ta.highest(high, FIB_LOOKBACK)
    fibLow = ta.lowest(low, FIB_LOOKBACK)
    fibRng = fibHigh - fibLow
    [fibHigh - 0.236 * fibRng, fibHigh - 0.382 * fibRng, fibHigh - 0.5 * fibRng, fibHigh - 0.618 * fibRng, fibHigh - 0.786 * fibRng]

f_calcStochRocCandle(series float macdHist) =>
    stochK = ta.stoch(close, high, low, STOCH_K)
    stochD = ta.sma(stochK, STOCH_D)
    stochBull = USE_STOCH ? (stochK[1] > stochD[1] or stochK[1] < STOCH_OVERSOLD) : true
    stochBear = USE_STOCH ? (stochK[1] < stochD[1] or stochK[1] > STOCH_OVERBOUGHT) : true
    rocVal = ta.roc(close, ROC_LENGTH)
    rocBull = USE_ROC ? rocVal[1] > 0 : true
    rocBear = USE_ROC ? rocVal[1] < 0 : true
    macdHistBull = USE_MACD_HIST ? macdHist[1] > 0 : true
    macdHistBear = USE_MACD_HIST ? macdHist[1] < 0 : true
    bullCandle = USE_CANDLE_FILTER ? close[1] > open[1] : true
    bearCandle = USE_CANDLE_FILTER ? close[1] < open[1] : true
    [stochK, stochD, stochBull, stochBear, rocVal, rocBull, rocBear, macdHistBull, macdHistBear, bullCandle, bearCandle]

f_calcFVGSTSAR() =>
    bodyPctB = (close[2] - open[2]) / (high[2] - low[2] + 1e-10)
    bodyPctBe = (open[2] - close[2]) / (high[2] - low[2] + 1e-10)
    bullFVGVal = low[2] > high[0] and bodyPctB >= FVG_MIN_BODY_PCT
    bearFVGVal = high[2] < low[0] and bodyPctBe >= FVG_MIN_BODY_PCT
    [stVal, stDirVal] = ta.supertrend(ST_FACTOR, ST_ATR_LEN)
    stBull = USE_SUPER_TREND ? stDirVal[1] < 0 : true
    stBear = USE_SUPER_TREND ? stDirVal[1] > 0 : true
    sarVal = ta.sar(SAR_START, SAR_INCREMENT, SAR_MAX)
    sarBull = USE_SAR ? close[1] > sarVal[1] : true
    sarBear = USE_SAR ? close[1] < sarVal[1] : true
    [bodyPctB, bodyPctBe, bullFVGVal, bearFVGVal, stVal, stDirVal, stBull, stBear, sarVal, sarBull, sarBear]

f_calcAroonLinReg() =>
    aroonU = 100.0 * (AROON_LENGTH - ta.highestbars(high, AROON_LENGTH + 1)) / AROON_LENGTH
    aroonD = 100.0 * (AROON_LENGTH - ta.lowestbars(low, AROON_LENGTH + 1)) / AROON_LENGTH
    aroonBull = (aroonU[1] > 70 and aroonD[1] < 30)
    aroonBear = (aroonD[1] > 70 and aroonU[1] < 30)
    linReg = ta.linreg(close, LIN_REG_LENGTH, 0)
    linRegSl = linReg - ta.linreg(close, LIN_REG_LENGTH, 1)
    corr = ta.correlation(close, bar_index, LIN_REG_LENGTH)
    rSq = corr * corr
    linRegBull = (linRegSl[1] > 0 and rSq[1] > 0.3)
    linRegBear = (linRegSl[1] < 0 and rSq[1] > 0.3)
    [aroonU, aroonD, aroonBull, aroonBear, linReg, linRegSl, corr, rSq, linRegBull, linRegBear]

f_calcKeltnerTTM(series float bbUpper, series float bbLower) =>
    kcB = ta.ema(close, KC_LENGTH)
    kcRng = ta.atr(KC_LENGTH) * KC_MULT
    kcUp = kcB + kcRng
    kcLo = kcB - kcRng
    ttmOn = USE_TTM_SQUEEZE ? (bbUpper < kcUp and bbLower > kcLo) : false
    ttmOff = USE_TTM_SQUEEZE ? not ttmOn : true
    ttmMom = ta.linreg(close - (ta.highest(high, KC_LENGTH) + ta.lowest(low, KC_LENGTH)) / 2, KC_LENGTH, 0)
    ttmFirB = USE_TTM_SQUEEZE ? (not ttmOn and ttmOn[1] and ttmMom > 0) : false
    ttmFirBe = USE_TTM_SQUEEZE ? (not ttmOn and ttmOn[1] and ttmMom < 0) : false
    kcBull = USE_KELTNER ? (close[1] > kcB[1]) : true
    kcBear = USE_KELTNER ? (close[1] < kcB[1]) : true
    [kcB, kcRng, kcUp, kcLo, ttmOn, ttmOff, ttmMom, ttmFirB, ttmFirBe, kcBull, kcBear]

f_calcHVChandVWAP() =>
    hv = ta.stdev(math.log(close / close[1]), HV_LENGTH) * math.sqrt(252)
    hvR = ta.percentrank(hv, HV_RANK_LENGTH)
    hvL = hvR[1] < 25
    hvH = hvR[1] > 75
    chandL = ta.highest(high, CHAND_LENGTH) - CHAND_MULT * ta.atr(CHAND_LENGTH)
    chandS = ta.lowest(low, CHAND_LENGTH) + CHAND_MULT * ta.atr(CHAND_LENGTH)
    chandBull = close[1] > chandL[1]
    chandBear = close[1] < chandS[1]
    vwapV = ta.vwap(close)
    vwapBull = close[1] > vwapV[1]
    vwapBear = close[1] < vwapV[1]
    [hv, hvR, hvL, hvH, chandL, chandS, chandBull, chandBear, vwapV, vwapBull, vwapBear]

f_calcWyckoffVWMADisplacement(series float volumeMA, series float atr) =>
    wyckH = ta.highest(high, WYCKOFF_LOOKBACK)
    wyckL = ta.lowest(low, WYCKOFF_LOOKBACK)
    wyckRng = wyckH - wyckL
    wyckVolA = ta.sma(volume, WYCKOFF_LOOKBACK)
    wyckInR = wyckRng > 0 and wyckRng < atr * WYCKOFF_LOOKBACK * 0.5
    wyckSpr = wyckInR ? (low[1] < wyckL[1] and close[1] > wyckL[1] and volume[1] > wyckVolA[1]) : false
    wyckUp = wyckInR ? (high[1] > wyckH[1] and close[1] < wyckH[1] and volume[1] > wyckVolA[1]) : false
    vwmaV = ta.vwma(close, VWMA_LENGTH)
    smaVwma = ta.sma(close, VWMA_LENGTH)
    vwmaBull = vwmaV[1] > smaVwma[1]
    vwmaBear = vwmaV[1] < smaVwma[1]
    avgB = ta.sma(math.abs(close - open), 20)
    bullDisp = (close[1] > open[1] and math.abs(close[1] - open[1]) > avgB[1] * DISP_BODY_MULT and volume[1] > volumeMA[1])
    bearDisp = (close[1] < open[1] and math.abs(close[1] - open[1]) > avgB[1] * DISP_BODY_MULT and volume[1] > volumeMA[1])
    [wyckH, wyckL, wyckRng, wyckVolA, wyckInR, wyckSpr, wyckUp, vwmaV, smaVwma, vwmaBull, vwmaBear, avgB, bullDisp, bearDisp]

f_calcDonchianMcGinley() =>
    donchUp = ta.highest(high, DONCHIAN_LENGTH)
    donchLo = ta.lowest(low, DONCHIAN_LENGTH)
    donchMid = (donchUp + donchLo) / 2
    donchBull = close[1] > donchMid[1]
    donchBear = close[1] < donchMid[1]
    donchBreakUp = ta.crossover(close, donchUp)
    donchBreakDn = ta.crossunder(close, donchLo)
    mcgVal = f_mcginley(close, MCGINLEY_LENGTH)
    mcgBull = close[1] > mcgVal[1]
    mcgBear = close[1] < mcgVal[1]
    [donchUp, donchLo, donchMid, donchBull, donchBear, donchBreakUp, donchBreakDn, mcgVal, mcgBull, mcgBear]

f_calcMomentumOscillators() =>
    [trixV, trixSig] = f_trix(close, TRIX_LENGTH, TRIX_SIGNAL_LEN)
    trixBull = trixV[1] > trixSig[1]
    trixBear = trixV[1] < trixSig[1]
    uoV = f_oscillator(UO_PERIOD_1, UO_PERIOD_2, UO_PERIOD_3)
    uoBull = uoV[1] > 50
    uoBear = uoV[1] < 50
    kstR1 = ta.roc(close, KST_ROC_1)
    kstR2 = ta.roc(close, KST_ROC_2)
    kstR3 = ta.roc(close, KST_ROC_3)
    kstR4 = ta.roc(close, KST_ROC_4)
    kstV = ta.sma(kstR1 * 1 + kstR2 * 2 + kstR3 * 3 + kstR4 * 4, 10)
    kstSig = ta.sma(kstV, KST_SMA_LEN)
    kstBull = kstV[1] > kstSig[1]
    kstBear = kstV[1] < kstSig[1]
    dpoV = f_dpo(close, DPO_LENGTH)
    dpoBull = dpoV[1] > 0
    dpoBear = dpoV[1] < 0
    [rviV, rviSig] = f_rvi(RVI_LENGTH)
    rviBull = rviV[1] > rviSig[1]
    rviBear = rviV[1] < rviSig[1]
    [_, schaffV] = f_schaffTrendCycle(SCHAFF_CYCLE, SCHAFF_SMOOTH_1, SCHAFF_SMOOTH_2)
    schaffBull = (schaffV[1] > 25 and schaffV[2] <= 25) or schaffV[1] > 75
    schaffBear = (schaffV[1] < 75 and schaffV[2] >= 75) or schaffV[1] < 25
    pgoV = (close - ta.ema(close, PGO_LENGTH)) / math.max(ta.atr(PGO_LENGTH), 1e-10)
    pgoBull = pgoV[1] > 0
    pgoBear = pgoV[1] < 0
    coppockR = ta.roc(close, COPPOCK_ROC_1) + ta.roc(close, COPPOCK_ROC_2)
    coppockV = ta.sma(coppockR, COPPOCK_SMA)
    coppockBull = coppockV[1] > 0
    coppockBear = coppockV[1] < 0
    massV = f_massIndex(MASS_SINGLE, MASS_SUM)
    massB = (massV[1] > MASS_THRESHOLD and massV[1] < massV[2])
    [trixV, trixSig, trixBull, trixBear, uoV, uoBull, uoBear, kstV, kstSig, kstBull, kstBear, dpoV, dpoBull, dpoBear, rviV, rviSig, rviBull, rviBear, schaffV, schaffBull, schaffBear, pgoV, pgoBull, pgoBear, coppockV, coppockBull, coppockBear, massV, massB]

f_calcVortexElderVWRsiTwiggs(series float macdHist) =>
    [viP, viM] = f_vortex(VORTEX_LENGTH)
    vortexBull = viP[1] > viM[1]
    vortexBear = viM[1] > viP[1]
    elderE = ta.ema(close, ELDER_EMA_LEN)
    elderRising = elderE > elderE[1]
    elderImpBull = (elderRising[1] and macdHist[1] > 0)
    elderImpBear = (not elderRising[1] and macdHist[1] < 0)
    vwP = ta.vwma(close, VW_RSI_LENGTH)
    vwRsiV = ta.rsi(vwP, VW_RSI_LENGTH)
    vwRsiBull = vwRsiV[1] > 50
    vwRsiBear = vwRsiV[1] < 50
    twiggsR = ((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume
    twiggsV = ta.sma(twiggsR, TWIGGS_LENGTH)
    twiggsBull = twiggsV[1] > 0
    twiggsBear = twiggsV[1] < 0
    [viP, viM, vortexBull, vortexBear, elderE, elderRising, elderImpBull, elderImpBear, vwP, vwRsiV, vwRsiBull, vwRsiBear, twiggsV, twiggsBull, twiggsBear]

f_dashBuySellSignal(table dash, bool useSignal, float finalBuy, float finalSell, int buyCatAg, int sellCatAg, int barsBuy, int barsSell) =>
    if useSignal
        table.cell(dash, 0, 0, " BUY/SELL SIGNAL", bgcolor=color.new(POSITIVE_COLOR, 30), text_color=TEXT_COLOR, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
        table.cell(dash, 1, 0, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 2, 0, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 3, 0, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 4, 0, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.merge_cells(dash, 0, 0, 4, 0)
        buyScoreBg = finalBuy >= 80 ? color.new(POSITIVE_COLOR, 30) : finalBuy >= 65 ? color.new(color.new(POSITIVE_COLOR, 45), 40) : color.new(NEUTRAL_COLOR, 50)
        sellScoreBg = finalSell >= 80 ? color.new(NEGATIVE_COLOR, 30) : finalSell >= 65 ? color.new(color.new(NEGATIVE_COLOR, 45), 40) : color.new(NEUTRAL_COLOR, 50)
        table.cell(dash, 0, 1, "Buy Score", bgcolor=f_rowBg(1), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 1, 1, str.tostring(finalBuy, "#.#") + "/100", bgcolor=buyScoreBg, text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 2, 1, "Sell Score", bgcolor=f_rowBg(1), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 3, 1, str.tostring(finalSell, "#.#") + "/100", bgcolor=sellScoreBg, text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 4, 1, buyCatAg > sellCatAg ? "BUY" : sellCatAg > buyCatAg ? "SELL" : "-", bgcolor=buyCatAg > sellCatAg ? color.new(POSITIVE_COLOR, 40) : sellCatAg > buyCatAg ? color.new(NEGATIVE_COLOR, 40) : color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 0, 2, "Cats Agree", bgcolor=f_rowBg(2), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 1, 2, str.tostring(buyCatAg) + "/5 Buy", bgcolor=f_condColor(buyCatAg >= 4), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 2, 2, "", bgcolor=f_rowBg(2), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 3, 2, str.tostring(sellCatAg) + "/5 Sell", bgcolor=f_condColor(sellCatAg >= 4), text_color=TEXT_COLOR, text_size=size.tiny)
        table.cell(dash, 4, 2, str.tostring(barsBuy) + "/" + str.tostring(barsSell) + " ago", bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)

f_dashTrend(table dash, bool hullTr, bool stBull, float adxVal, float adxThr, bool adxStr, bool sarBull, bool ichBull, bool ichBear, float aroonUp, float aroonDown, bool aroonBull, float linRegSl, bool linRegBull, bool vwmaBull, bool htfUp, bool maUp, bool maDn, bool donchBull, bool mcgBull, bool demaBull, bool gmmaBull, bool alligBull, bool alligBear, bool vortexBull) =>
    table.cell(dash, 0, 5, " TREND", bgcolor=color.new(color.rgb(156, 107, 255), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 5, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 2, 5, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 3, 5, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 4, 5, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.merge_cells(dash, 0, 5, 4, 5)
    table.cell(dash, 0, 6, "Hull MA", bgcolor=f_rowBg(6), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 6, hullTr ? "Rising" : "Falling", bgcolor=f_condColor(hullTr), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 6, "SuperTrnd", bgcolor=f_rowBg(6), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 6, stBull ? "Above" : "Below", bgcolor=f_condColor(stBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 6, f_condSym(hullTr and stBull), bgcolor=f_condColor(hullTr and stBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 7, "ADX", bgcolor=f_rowBg(7), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(adxVal, "#.#") + ">" + str.tostring(adxThr, "#"), bgcolor=f_condColor(adxStr), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 7, "SAR", bgcolor=f_rowBg(7), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 7, sarBull ? "Below" : "Above", bgcolor=f_condColor(sarBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 7, f_condSym(adxStr and sarBull), bgcolor=f_condColor(adxStr and sarBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 8, "Ichimoku", bgcolor=f_rowBg(8), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 8, ichBull ? "Aligned" : ichBear ? "Bear" : "Mixed", bgcolor=f_condColor(ichBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 8, "Aroon", bgcolor=f_rowBg(8), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 8, "U" + str.tostring(math.round(math.max(0, math.min(100, aroonUp))), "#") + "/D" + str.tostring(math.round(math.max(0, math.min(100, aroonDown))), "#"), bgcolor=f_condColor(aroonBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 8, f_condSym(ichBull and aroonBull), bgcolor=f_condColor(ichBull and aroonBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 9, "LinReg", bgcolor=f_rowBg(9), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 9, linRegSl > 0 ? "+slope" : "-slope", bgcolor=f_condColor(linRegBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 9, "VWMA", bgcolor=f_rowBg(9), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 9, vwmaBull ? ">SMA" : "<SMA", bgcolor=f_condColor(vwmaBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 9, f_condSym(linRegBull and vwmaBull), bgcolor=f_condColor(linRegBull and vwmaBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 10, "HTF EMA", bgcolor=f_rowBg(10), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 10, htfUp ? "Above" : "Below", bgcolor=f_condColor(htfUp), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 10, "MA Stack", bgcolor=f_rowBg(10), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 10, maUp ? "9>21>50" : maDn ? "9<21<50" : "Mixed", bgcolor=f_condColor(maUp), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 10, f_condSym(htfUp and maUp), bgcolor=f_condColor(htfUp and maUp), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 11, "Donchian", bgcolor=f_rowBg(11), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 11, donchBull ? ">Mid" : "<Mid", bgcolor=f_condColor(donchBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 11, "McGinley", bgcolor=f_rowBg(11), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 11, mcgBull ? "Above" : "Below", bgcolor=f_condColor(mcgBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 11, f_condSym(donchBull and mcgBull), bgcolor=f_condColor(donchBull and mcgBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 12, "DEMA", bgcolor=f_rowBg(12), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 12, demaBull ? "Above" : "Below", bgcolor=f_condColor(demaBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 12, "GMMA", bgcolor=f_rowBg(12), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 12, gmmaBull ? "Short>Long" : "Short<Long", bgcolor=f_condColor(gmmaBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 12, f_condSym(demaBull and gmmaBull), bgcolor=f_condColor(demaBull and gmmaBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 13, "Alligator", bgcolor=f_rowBg(13), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 13, alligBull ? "Aligned^" : alligBear ? "Alignedv" : "Mixed", bgcolor=f_condColor(alligBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 13, "Vortex", bgcolor=f_rowBg(13), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 13, vortexBull ? "VI+>VI-" : "VI-<VI+", bgcolor=f_condColor(vortexBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 13, f_condSym(alligBull and vortexBull), bgcolor=f_condColor(alligBull and vortexBull), text_color=TEXT_COLOR, text_size=size.tiny)

f_dashMomentum(table dash, float rsiP, string rsiSpark, bool rsiBull, float stochK, float stochD, bool stochBull, bool macdBull, float macdH, bool macdHBull, float cciV, bool cciBull, float wrV, bool wrBull, float cmoV, bool cmoBull, bool fisherBull, bool efiBull, float rocV, bool rocBull, float mfiV, bool mfiBull, bool sineBull, float trixV, bool trixBull, float uoV, bool uoBull, float kstV, bool kstBull, float dpoV, bool dpoBull, float rviV, bool rviBull, float schaffV, bool schaffBull, float pgoV, bool pgoBull, float coppV, bool coppBull, bool elderBull, bool elderBear, float vwRsiV, bool vwRsiBull) =>
    table.cell(dash, 0, 14, " MOMENTUM", bgcolor=color.new(color.rgb(66, 165, 245), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 14, "", bgcolor=color.new(color.rgb(66, 165, 245), 75))
    table.cell(dash, 2, 14, "", bgcolor=color.new(color.rgb(66, 165, 245), 75))
    table.cell(dash, 3, 14, "", bgcolor=color.new(color.rgb(66, 165, 245), 75))
    table.cell(dash, 4, 14, "", bgcolor=color.new(color.rgb(66, 165, 245), 75))
    table.merge_cells(dash, 0, 14, 4, 14)
    table.cell(dash, 0, 15, "RSI", bgcolor=f_rowBg(15), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 15, str.tostring(rsiP, "#.#") + " " + rsiSpark, bgcolor=f_condColor(rsiBull), text_color=TEXT_COLOR, text_size=size.tiny, text_font_family=font.family_monospace)
    table.cell(dash, 2, 15, "Stoch", bgcolor=f_rowBg(15), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 15, str.tostring(stochK, "#") + "/" + str.tostring(stochD, "#"), bgcolor=f_condColor(stochBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 15, f_condSym(rsiBull and stochBull), bgcolor=f_condColor(rsiBull and stochBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 16, "MACD", bgcolor=f_rowBg(16), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 16, macdBull ? ">Sig" : "<Sig", bgcolor=f_condColor(macdBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 16, "Hist", bgcolor=f_rowBg(16), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 16, str.tostring(macdH, "#.###"), bgcolor=f_condColor(macdHBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 16, f_condSym(macdBull and macdHBull), bgcolor=f_condColor(macdBull and macdHBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 17, "CCI", bgcolor=f_rowBg(17), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 17, str.tostring(cciV, "#"), bgcolor=f_condColor(cciBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 17, "W%R", bgcolor=f_rowBg(17), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 17, str.tostring(wrV, "#"), bgcolor=f_condColor(wrBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 17, f_condSym(cciBull and wrBull), bgcolor=f_condColor(cciBull and wrBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 18, "CMO", bgcolor=f_rowBg(18), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 18, str.tostring(cmoV, "#"), bgcolor=f_condColor(cmoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 18, "Fisher", bgcolor=f_rowBg(18), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 18, fisherBull ? "Cross^" : "Crossv", bgcolor=f_condColor(fisherBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 18, f_condSym(cmoBull and fisherBull), bgcolor=f_condColor(cmoBull and fisherBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 19, "EFI", bgcolor=f_rowBg(19), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 19, efiBull ? ">0" : "<0", bgcolor=f_condColor(efiBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 19, "ROC", bgcolor=f_rowBg(19), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 19, str.tostring(rocV, "#.##") + "%", bgcolor=f_condColor(rocBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 19, f_condSym(efiBull and rocBull), bgcolor=f_condColor(efiBull and rocBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 20, "MFI", bgcolor=f_rowBg(20), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 20, str.tostring(mfiV, "#"), bgcolor=f_condColor(mfiBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 20, "Sine", bgcolor=f_rowBg(20), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 20, sineBull ? "Bull" : "Bear", bgcolor=f_condColor(sineBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 20, f_condSym(mfiBull and sineBull), bgcolor=f_condColor(mfiBull and sineBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 21, "TRIX", bgcolor=f_rowBg(21), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 21, str.tostring(trixV, "#.####"), bgcolor=f_condColor(trixBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 21, "UO", bgcolor=f_rowBg(21), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 21, str.tostring(uoV, "#"), bgcolor=f_condColor(uoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 21, f_condSym(trixBull and uoBull), bgcolor=f_condColor(trixBull and uoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 22, "KST", bgcolor=f_rowBg(22), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 22, str.tostring(kstV, "#.#"), bgcolor=f_condColor(kstBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 22, "DPO", bgcolor=f_rowBg(22), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 22, str.tostring(dpoV, "#.##"), bgcolor=f_condColor(dpoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 22, f_condSym(kstBull and dpoBull), bgcolor=f_condColor(kstBull and dpoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 23, "RVI", bgcolor=f_rowBg(23), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 23, str.tostring(rviV, "#.##"), bgcolor=f_condColor(rviBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 23, "Schaff", bgcolor=f_rowBg(23), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 23, str.tostring(schaffV, "#"), bgcolor=f_condColor(schaffBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 23, f_condSym(rviBull and schaffBull), bgcolor=f_condColor(rviBull and schaffBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 24, "PGO", bgcolor=f_rowBg(24), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 24, str.tostring(pgoV, "#.##"), bgcolor=f_condColor(pgoBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 24, "Coppock", bgcolor=f_rowBg(24), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 24, str.tostring(coppV, "#.#"), bgcolor=f_condColor(coppBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 24, f_condSym(pgoBull and coppBull), bgcolor=f_condColor(pgoBull and coppBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 25, "Elder Imp", bgcolor=f_rowBg(25), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 25, elderBull ? "Bull" : elderBear ? "Bear" : "Neutral", bgcolor=f_condColor3(elderBull, elderBear), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 25, "VW-RSI", bgcolor=f_rowBg(25), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 25, str.tostring(vwRsiV, "#"), bgcolor=f_condColor(vwRsiBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 25, f_condSym(elderBull and vwRsiBull), bgcolor=f_condColor(elderBull and vwRsiBull), text_color=TEXT_COLOR, text_size=size.tiny)

f_dashVolume(table dash, float vol, float volMA, bool volConf, bool vwapBull, bool obvBull, float cmfV, bool cmfBull, bool adBull, bool pvtBull, bool volRising, float pressRatio, bool klingerBull, float eomV, bool eomBull, bool nviBull, bool pviBull, bool iiiBull, bool mfiBWBull, bool twiggsBull) =>
    table.cell(dash, 0, 26, " VOLUME", bgcolor=color.new(color.rgb(0, 200, 83), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 26, "", bgcolor=color.new(color.rgb(0, 200, 83), 75))
    table.cell(dash, 2, 26, "", bgcolor=color.new(color.rgb(0, 200, 83), 75))
    table.cell(dash, 3, 26, "", bgcolor=color.new(color.rgb(0, 200, 83), 75))
    table.cell(dash, 4, 26, "", bgcolor=color.new(color.rgb(0, 200, 83), 75))
    table.merge_cells(dash, 0, 26, 4, 26)
    table.cell(dash, 0, 27, "Vol/MA", bgcolor=f_rowBg(27), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 27, str.tostring(vol / math.max(volMA, 1), "#.#") + "x", bgcolor=f_condColor(volConf), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 27, "VWAP", bgcolor=f_rowBg(27), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 27, vwapBull ? "Above" : "Below", bgcolor=f_condColor(vwapBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 27, f_condSym(volConf and vwapBull), bgcolor=f_condColor(volConf and vwapBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 28, "OBV", bgcolor=f_rowBg(28), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 28, obvBull ? ">MA" : "<MA", bgcolor=f_condColor(obvBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 28, "CMF", bgcolor=f_rowBg(28), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 28, str.tostring(cmfV, "#.##"), bgcolor=f_condColor(cmfBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 28, f_condSym(obvBull and cmfBull), bgcolor=f_condColor(obvBull and cmfBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 29, "A/D", bgcolor=f_rowBg(29), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 29, adBull ? ">MA" : "<MA", bgcolor=f_condColor(adBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 29, "PVT", bgcolor=f_rowBg(29), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 29, pvtBull ? ">MA" : "<MA", bgcolor=f_condColor(pvtBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 29, f_condSym(adBull and pvtBull), bgcolor=f_condColor(adBull and pvtBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 30, "VolTrend", bgcolor=f_rowBg(30), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 30, volRising ? "Rising" : "Flat", bgcolor=f_condColor(volRising), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 30, "B/S Pres", bgcolor=f_rowBg(30), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 30, str.tostring(pressRatio * 100, "#") + "%", bgcolor=f_condColor3(pressRatio > 0.55, pressRatio < 0.45), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 30, f_condSym(volRising and pressRatio > 0.55), bgcolor=f_condColor(volRising and pressRatio > 0.55), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 31, "Klinger", bgcolor=f_rowBg(31), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 31, klingerBull ? ">Sig" : "<Sig", bgcolor=f_condColor(klingerBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 31, "EOM", bgcolor=f_rowBg(31), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 31, str.tostring(eomV, "#.##"), bgcolor=f_condColor(eomBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 31, f_condSym(klingerBull and eomBull), bgcolor=f_condColor(klingerBull and eomBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 32, "NVI", bgcolor=f_rowBg(32), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 32, nviBull ? ">MA" : "<MA", bgcolor=f_condColor(nviBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 32, "PVI", bgcolor=f_rowBg(32), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 32, pviBull ? ">MA" : "<MA", bgcolor=f_condColor(pviBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 32, f_condSym(nviBull and pviBull), bgcolor=f_condColor(nviBull and pviBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 33, "III", bgcolor=f_rowBg(33), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 33, iiiBull ? ">0" : "<0", bgcolor=f_condColor(iiiBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 33, "MFI(BW)", bgcolor=f_rowBg(33), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 33, mfiBWBull ? "Up+Vol" : "Dn+Vol", bgcolor=f_condColor(mfiBWBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 33, f_condSym(iiiBull and mfiBWBull), bgcolor=f_condColor(iiiBull and mfiBWBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 34, "Twiggs MF", bgcolor=f_rowBg(34), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 34, twiggsBull ? ">0" : "<0", bgcolor=f_condColor(twiggsBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 34, "", bgcolor=f_rowBg(34))
    table.cell(dash, 3, 34, "", bgcolor=f_rowBg(34))
    table.cell(dash, 4, 34, "", bgcolor=f_rowBg(34))

f_dashVolatility(table dash, float bbPct, bool bbNotExt, bool ttmOn, bool ttmFirB, bool ttmFirBear, bool kcBull, bool chandBull, bool atrInRng, float massV, bool massBulge, bool bbBull) =>
    table.cell(dash, 0, 35, " VOLATILITY", bgcolor=color.new(color.rgb(255, 177, 66), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 35, "", bgcolor=color.new(color.rgb(255, 177, 66), 75))
    table.cell(dash, 2, 35, "", bgcolor=color.new(color.rgb(255, 177, 66), 75))
    table.cell(dash, 3, 35, "", bgcolor=color.new(color.rgb(255, 177, 66), 75))
    table.cell(dash, 4, 35, "", bgcolor=color.new(color.rgb(255, 177, 66), 75))
    table.merge_cells(dash, 0, 35, 4, 35)
    table.cell(dash, 0, 36, "BB Pos", bgcolor=f_rowBg(36), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 36, str.tostring(bbPct * 100, "#") + "%", bgcolor=f_condColor(bbNotExt), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 36, "Squeeze", bgcolor=f_rowBg(36), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 36, ttmOn ? "ON" : "Off", bgcolor=ttmOn ? color.new(WARNING_COLOR, 40) : f_condColor(true), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 36, f_condSym(bbNotExt and not ttmOn), bgcolor=f_condColor(bbNotExt and not ttmOn), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 37, "TTM", bgcolor=f_rowBg(37), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 37, ttmFirB ? "Fire^" : ttmFirBear ? "Firev" : "-", bgcolor=f_condColor(ttmFirB), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 37, "Keltner", bgcolor=f_rowBg(37), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 37, kcBull ? ">Mid" : "<Mid", bgcolor=f_condColor(kcBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 37, f_condSym(kcBull), bgcolor=f_condColor(kcBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 38, "Chandlr", bgcolor=f_rowBg(38), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 38, chandBull ? "Above" : "Below", bgcolor=f_condColor(chandBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 38, "ATR Rng", bgcolor=f_rowBg(38), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 38, atrInRng ? "OK" : "Out", bgcolor=f_condColor(atrInRng), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 38, f_condSym(chandBull and atrInRng), bgcolor=f_condColor(chandBull and atrInRng), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 39, "Mass Idx", bgcolor=f_rowBg(39), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 39, str.tostring(massV, "#.#") + (massBulge ? " Bulge" : ""), bgcolor=massBulge ? color.new(WARNING_COLOR, 50) : f_condColor(true), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 39, "BB", bgcolor=f_rowBg(39), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 39, bbBull ? ">Basis" : "<Basis", bgcolor=f_condColor(bbBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 39, f_condSym(not massBulge and bbBull), bgcolor=f_condColor(not massBulge and bbBull), text_color=TEXT_COLOR, text_size=size.tiny)

f_dashRegimeMetaRisk(table dash, bool inDisc, bool pdOkBuy, float htfRsiP, bool htfOkBuy, bool rsBull, float corrV, bool corrBull, bool corrBear, float hvR, bool hvLo, bool hvHi, bool wyckSpr, bool wyckUp, float rSq, float zSc, float domPer, bool adxStr, bool trUp, bool trDn, float atrP, float actSL, string actSLT, float actTP, float atrMultSL, float atrMultTP, float actRR, float buySellRR) =>
    table.cell(dash, 0, 40, " REGIME", bgcolor=color.new(color.rgb(255, 112, 67), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 40, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
    table.cell(dash, 2, 40, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
