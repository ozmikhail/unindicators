    table.cell(dash, 0, 41, "P/D Zone", bgcolor=f_rowBg(41), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 41, inDisc ? "Discount" : "Premium", bgcolor=f_condColor(pdOkBuy), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 41, "HTF RSI", bgcolor=f_rowBg(41), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 41, str.tostring(htfRsiP, "#.#"), bgcolor=f_condColor3(htfRsiP >= 40 and htfRsiP <= 70, false), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 41, f_condSym(pdOkBuy and htfOkBuy), bgcolor=f_condColor(pdOkBuy and htfOkBuy), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 42, "RelStr", bgcolor=f_rowBg(42), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 42, rsBull ? ">Bench" : "<Bench", bgcolor=f_condColor(rsBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 42, "Corr", bgcolor=f_rowBg(42), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 42, str.tostring(corrV, "#.##"), bgcolor=f_condColor3(corrBull, corrBear), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 42, f_condSym(rsBull and corrBull), bgcolor=f_condColor(rsBull and corrBull), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 43, "HV Rank", bgcolor=f_rowBg(43), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 43, str.tostring(hvR, "#") + "%", bgcolor=hvLo ? color.new(color.new(POSITIVE_COLOR, 45), 50) : hvHi ? color.new(WARNING_COLOR, 50) : f_condColor(true), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 43, "Wyckoff", bgcolor=f_rowBg(43), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 43, wyckSpr ? "Spring" : wyckUp ? "Upthr" : "-", bgcolor=f_condColor(wyckSpr), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 43, f_condSym(not hvHi), bgcolor=f_condColor(not hvHi), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 0, 44, " META-MODIFIERS", bgcolor=color.new(color.rgb(120, 123, 134), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 44, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 2, 44, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 3, 44, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 4, 44, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.merge_cells(dash, 0, 44, 4, 44)
    table.cell(dash, 0, 45, "R²", bgcolor=f_rowBg(45), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 45, str.tostring(rSq, "#.##") + (rSq > 0.5 ? " Trend" : " Chop"), bgcolor=rSq > 0.5 ? color.new(color.new(POSITIVE_COLOR, 45), 50) : color.new(WARNING_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 45, "Z-Score", bgcolor=f_rowBg(45), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 45, str.tostring(zSc, "#.#"), bgcolor=math.abs(zSc) > 2 ? color.new(WARNING_COLOR, 40) : f_condColor(true), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 45, "", bgcolor=f_rowBg(45))
    table.cell(dash, 0, 46, "Cycle", bgcolor=f_rowBg(46), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 46, str.tostring(domPer, "#") + " bars", bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 46, "Regime", bgcolor=f_rowBg(46), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 46, adxStr ? (trUp ? "Uptrend" : trDn ? "Downtrend" : "Trend") : "Ranging", bgcolor=trUp and adxStr ? color.new(POSITIVE_COLOR, 50) : trDn and adxStr ? color.new(NEGATIVE_COLOR, 50) : color.new(WARNING_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 46, "", bgcolor=f_rowBg(46))
    table.cell(dash, 0, 47, " RISK MANAGEMENT", bgcolor=color.new(color.rgb(234, 57, 67), 30), text_color=color.white, text_size=size.tiny, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 47, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 2, 47, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 3, 47, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 4, 47, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.merge_cells(dash, 0, 47, 4, 47)
    table.cell(dash, 0, 48, "ATR", bgcolor=f_rowBg(48), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 48, str.tostring(atrP, "#.##"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 48, "SL Dist", bgcolor=f_rowBg(48), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 48, not na(actSL) ? str.tostring(math.abs(close - actSL), "#.##") + " (" + actSLT + ")" : str.tostring(atrP * atrMultSL, "#.##") + " (" + str.tostring(atrMultSL, "#.#") + "x)", bgcolor=color.new(color.new(NEGATIVE_COLOR, 45), 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 48, "", bgcolor=f_rowBg(48))
    table.cell(dash, 0, 49, "TP Dist", bgcolor=f_rowBg(49), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 1, 49, not na(actTP) ? str.tostring(math.abs(actTP - close), "#.##") : str.tostring(atrP * atrMultTP, "#.##") + " (" + str.tostring(atrMultTP, "#.#") + "x)", bgcolor=color.new(color.new(POSITIVE_COLOR, 45), 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 2, 49, "R:R", bgcolor=f_rowBg(49), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 3, 49, actRR > 0 ? "1:" + str.tostring(actRR, "#.#") : "1:" + str.tostring(buySellRR, "#.#"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=size.tiny)
    table.cell(dash, 4, 49, "", bgcolor=f_rowBg(49))

