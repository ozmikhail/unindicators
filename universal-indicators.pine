//@version=6
indicator("Universal Indicators", overlay=true, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_polylines_count=100, explicit_plot_zorder=true)

// ==================================================================================
// INPUT PARAMETERS
// ==================================================================================

// === Display Indicators Settings ===
var gDisplayIndicators = "Display Indicators"
useDashboard = input.bool(true, "Display Dashboard", group=gDisplayIndicators)
useHullMA = input.bool(false, "Display Hull MA", group=gDisplayIndicators)
useVWAPLine = input.bool(true, "Display VWAP Line", group=gDisplayIndicators)
useBackground = input.bool(false, "Display Trend Background", group=gDisplayIndicators)
useMTFHeatmap = input.bool(true, "Display MTF Trend Heatmap", group=gDisplayIndicators)
useBB = input.bool(true, "Display Bollinger Bands", group=gDisplayIndicators)
usePatternMarkers = input.bool(false, "Display Candlestick Pattern Markers", group=gDisplayIndicators)
useKeltner = input.bool(false, "Display Keltner Channels", group=gDisplayIndicators)
useDonchian = input.bool(false, "Display Donchian Channel", group=gDisplayIndicators)
useMcGinley = input.bool(false, "Display McGinley Dynamic", group=gDisplayIndicators)
useAlligator = input.bool(false, "Display Alligator", group=gDisplayIndicators)
usePivots = input.bool(true, "Display Pivot Points", group=gDisplayIndicators)
useFibLevels = input.bool(false, "Display Fib Levels", group=gDisplayIndicators)
useGMMA = input.bool(false, "Display GMMA", group=gDisplayIndicators)
useMAStackLines = input.bool(false, "Display MA Stack (9/21/50)", group=gDisplayIndicators, tooltip="EMA 9, 21, 50 lines. Filter logic is controlled by MA Alignment > Use MA Stack Filter.")
useSuperTrend = input.bool(false, "Display SuperTrend", group=gDisplayIndicators)
useSAR = input.bool(false, "Display Parabolic SAR", group=gDisplayIndicators)
useIchimoku = input.bool(false, "Display Ichimoku Cloud", group=gDisplayIndicators)
useTTMSqueeze = input.bool(false, "Display TTM Squeeze", group=gDisplayIndicators)
useGap = input.bool(false, "Display Gap Detection", group=gDisplayIndicators)

// === Buy/Sell Signal ===
var gBuySell = "Buy/Sell Signal"
useBuySellSignal = input.bool(true, "Display Buy/Sell Signal", group=gBuySell, tooltip="Toggle for the Buy/Sell signal system. Uses all ENABLED indicators with weighted category scoring.")
buySellThreshold = input.float(55, "Signal Threshold (0-100)", minval=30, maxval=95, step=5, group=gBuySell, tooltip="Minimum composite score to generate a signal. Higher = fewer but more confident signals.")
buySellCooldown = input.int(5, "Signal Cooldown (bars)", minval=1, maxval=50, group=gBuySell, tooltip="Minimum bars between signals to prevent spam.")
useBuySellSLTPEntry = input.bool(true, "Display SL/TP Levels", group=gBuySell)
slTpDisplayMode = input.string("Zones", "SL/TP/Entry Display", options=["Lines", "Zones"], group=gBuySell, tooltip="Lines: Entry, SL and TP as lines only. Zones: Colored background ranges between the levels.")
buySellRR = input.float(2.0, "Risk:Reward Ratio", minval=1.0, maxval=5.0, step=0.5, group=gBuySell, tooltip="Target R:R ratio for TP calculation. SL is ATR-based + structure.")
usePrevSignals = input.bool(false, "Display Previous Signals", group=gBuySell, tooltip="Display grayed-out previous signal zones and levels. Disable for a cleaner chart.")
prevSignalOpacity = input.int(20, "Previous Signal Opacity (%)", minval=5, maxval=50, step=5, group=gBuySell, tooltip="How visible previous signals appear. Higher = more visible.")
signalAutoExpire = input.bool(true, "Auto-Expire Signals", group=gBuySell, tooltip="Automatically hide signals after expiration or when TP/SL is hit. Expiration is timeframe-adaptive.")

// === Theme ===
var gTheme = "Theme & Colors"
bullPrimary   = input.color(color.rgb(0, 200, 83),   "Bull Primary",    group=gTheme)
bearPrimary   = input.color(color.rgb(234, 57, 67),   "Bear Primary",    group=gTheme)
bullSecondary = input.color(color.rgb(38, 166, 91),   "Bull Secondary",  group=gTheme)
bearSecondary = input.color(color.rgb(178, 50, 58),   "Bear Secondary",  group=gTheme)
neutralColor  = input.color(color.rgb(120, 123, 134), "Neutral",         group=gTheme)
warningColor  = input.color(color.rgb(255, 177, 66),  "Warning/Caution", group=gTheme)
structureClr  = input.color(color.rgb(156, 107, 255), "Structure/Fib",   group=gTheme)
volumeClr     = input.color(color.rgb(66, 165, 245),  "Volume/BB/Alligator Jaw", group=gTheme, tooltip="Used for volume, Bollinger Bands and Alligator Jaw.")
entryClr      = input.color(color.rgb(100, 181, 246), "Entry Line",      group=gTheme)
