    // --- Table Section 6: REGIME ---
    table.cell(dash, 0, 37, " REGIME", bgcolor=color.new(color.rgb(255, 112, 67), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 37, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
    table.cell(dash, 2, 37, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
    table.cell(dash, 3, 37, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
    table.cell(dash, 4, 37, "", bgcolor=color.new(color.rgb(255, 112, 67), 75))
    table.merge_cells(dash, 0, 37, 4, 37)

    table.cell(dash, 0, 38, "P/D Zone", bgcolor=f_rowBg(38), text_color=TEXT_COLOR, text_size=txtSm)
