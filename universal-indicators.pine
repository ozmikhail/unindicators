// === Pivots, Fib, S/R, Gap, Vortex, Elder, VW-RSI, Twiggs ===
pivotTimeframe = input.timeframe("D", "Pivot Timeframe", group=gIndMisc, tooltip="Timeframe for pivot points. Can match Higher Timeframe (Trend) for consistency.")
fibLookback = input.int(20, "Fib Swing Lookback", minval=5, group=gIndMisc)
srPivotCount = input.int(3, "S/R Pivot Count", minval=2, group=gIndMisc)
gapMinATR = input.float(0, "Gap Min ATR (0=any)", minval=0, step=0.1, group=gIndMisc)
