// ==================================================================================
// FUNCTIONS
// ==================================================================================

f_exhaustionScore(rsiPrev, stochKVal, mfiValue, wrValue, bbPercent, zScore, cciValue, schaffVal, uoValue, volClimaxBuy, extendedBearRun, massBulge, cmoValue, volClimaxSell, extendedBullRun) =>
    c = 5.0
    bRaw = (rsiPrev < 35 ? 2.0 : rsiPrev < 45 ? 1.0 : 0.0)
         + (stochKVal[1] < 25 ? 1.5 : 0.0)
         + (mfiValue[1] < 30 ? 1.0 : 0.0)
         + (wrValue[1] < -75 ? 1.0 : 0.0)
         + (bbPercent[1] < 0.15 ? 1.5 : 0.0)
         + (zScore[1] < -1.5 ? 2.0 : 0.0)
         + (cciValue[1] < -100 ? 1.0 : 0.0)
         + (schaffVal[1] < 20 ? 0.8 : 0.0)
         + (uoValue[1] < 30 ? 0.8 : 0.0)
         + (volClimaxBuy ? 2.5 : 0.0)
         + (extendedBearRun ? 1.5 : 0.0)
         + (massBulge ? 1.5 : 0.0)
         + (cmoValue[1] < -50 ? 0.8 : 0.0)
    sRaw = (rsiPrev > 65 ? 2.0 : rsiPrev > 55 ? 1.0 : 0.0)
         + (stochKVal[1] > 75 ? 1.5 : 0.0)
         + (mfiValue[1] > 70 ? 1.0 : 0.0)
         + (wrValue[1] > -25 ? 1.0 : 0.0)
         + (bbPercent[1] > 0.85 ? 1.5 : 0.0)
         + (zScore[1] > 1.5 ? 2.0 : 0.0)
         + (cciValue[1] > 100 ? 1.0 : 0.0)
         + (schaffVal[1] > 80 ? 0.8 : 0.0)
         + (uoValue[1] > 70 ? 0.8 : 0.0)
         + (volClimaxSell ? 2.5 : 0.0)
         + (extendedBullRun ? 1.5 : 0.0)
         + (massBulge ? 1.5 : 0.0)
         + (cmoValue[1] > 50 ? 0.8 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_reversalScore(macdCrossUpFresh, rsiCrossUpFresh, stochCrossUpFresh, macdHistTurningUp, fisherBullish, trixBullish, kstBullish, sineBullish, coppockBullish, rviBullish, elderImpulseBull, dpoBullish, rsiAccelBuy, chandBullish, ttmFirBull, macdCrossDownFresh, rsiCrossDownFresh, stochCrossDownFresh, macdHistTurningDown, fisherBearish, trixBearish, kstBearish, sineBearish, coppockBearish, rviBearish, elderImpulseBear, dpoBearish, rsiAccelSell, chandBearish, ttmFirBear) =>
    c = 5.0
    bRaw = macdCrossUpFresh + rsiCrossUpFresh + stochCrossUpFresh
         + (macdHistTurningUp ? 1.5 : 0.0)
         + (fisherBullish ? 1.0 : 0.0)
         + (trixBullish ? 1.0 : 0.0)
         + (kstBullish ? 1.0 : 0.0)
         + (sineBullish ? 0.8 : 0.0)
         + (coppockBullish ? 0.8 : 0.0)
         + (rviBullish ? 0.7 : 0.0)
         + (elderImpulseBull ? 0.8 : 0.0)
         + (dpoBullish ? 0.6 : 0.0)
         + (rsiAccelBuy ? 1.2 : 0.0)
         + (chandBullish ? 0.8 : 0.0)
         + (ttmFirBull ? 1.0 : 0.0)
    sRaw = macdCrossDownFresh + rsiCrossDownFresh + stochCrossDownFresh
         + (macdHistTurningDown ? 1.5 : 0.0)
         + (fisherBearish ? 1.0 : 0.0)
         + (trixBearish ? 1.0 : 0.0)
         + (kstBearish ? 1.0 : 0.0)
         + (sineBearish ? 0.8 : 0.0)
         + (coppockBearish ? 0.8 : 0.0)
         + (rviBearish ? 0.7 : 0.0)
         + (elderImpulseBear ? 0.8 : 0.0)
         + (dpoBearish ? 0.6 : 0.0)
         + (rsiAccelSell ? 1.2 : 0.0)
         + (chandBearish ? 0.8 : 0.0)
         + (ttmFirBear ? 1.0 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_structureScore(bullEngulfing, hammerBull, morningStar, piercingLine, tweezerBottom, threeWhiteSoldiers, doji, rsiPrev, bullHarami, bearEngulfing, shootingStar, eveningStar, darkCloudCover, tweezerTop, threeBlackCrows, bearHarami, pivotCrossUpR1, pivotCrossDownS1, donchianBreakoutUp, donchianBreakoutDown, nearSupport, wyckSpring, bullishDivergence, bosBull, chochBullish, sfpBull, liqSweepBuy, bullFVG, nearBullOB, wickRejectionBuy, bullDisplacement, nearPivotS1, nearResistance, wyckUpthrust, bearishDivergence, bosBear, chochBearish, sfpBear, liqSweepSell, bearFVG, nearBearOB, wickRejectionSell, bearDisplacement, nearPivotR1) =>
    c = 9.5
    candleBullRaw = (bullEngulfing ? 1.5 : 0.0) + (hammerBull ? 1.5 : 0.0) + (morningStar ? 1.5 : 0.0)
         + (piercingLine ? 1.0 : 0.0) + (tweezerBottom ? 1.0 : 0.0) + (threeWhiteSoldiers ? 1.0 : 0.0)
         + (doji and rsiPrev < 40 ? 0.5 : 0.0) + (bullHarami ? 0.8 : 0.0)
    candleBullCapped = math.min(candleBullRaw, 2.5)
    candleBearRaw = (bearEngulfing ? 1.5 : 0.0) + (shootingStar ? 1.5 : 0.0) + (eveningStar ? 1.5 : 0.0)
         + (darkCloudCover ? 1.0 : 0.0) + (tweezerTop ? 1.0 : 0.0) + (threeBlackCrows ? 1.0 : 0.0)
         + (doji and rsiPrev > 60 ? 0.5 : 0.0) + (bearHarami ? 0.8 : 0.0)
    candleBearCapped = math.min(candleBearRaw, 2.5)
    pivotBreakUpFresh = pivotCrossUpR1[1] ? 1.8 : pivotCrossUpR1[2] ? 1.2 : pivotCrossUpR1[3] ? 0.6 : 0.0
    pivotBreakDownFresh = pivotCrossDownS1[1] ? 1.8 : pivotCrossDownS1[2] ? 1.2 : pivotCrossDownS1[3] ? 0.6 : 0.0
    donchianBreakoutUpFresh = donchianBreakoutUp[1] ? 1.2 : donchianBreakoutUp[2] ? 0.8 : donchianBreakoutUp[3] ? 0.4 : 0.0
    donchianBreakoutDownFresh = donchianBreakoutDown[1] ? 1.2 : donchianBreakoutDown[2] ? 0.8 : donchianBreakoutDown[3] ? 0.4 : 0.0
    bRaw = (nearSupport ? 2.0 : 0.0)
         + (wyckSpring ? 2.5 : 0.0)
         + (bullishDivergence ? 2.5 : 0.0)
         + math.max(bosBull ? 1.5 : 0.0, chochBullish ? 2.0 : 0.0)
         + math.max(sfpBull ? 1.5 : 0.0, liqSweepBuy ? 2.0 : 0.0)
         + (bullFVG ? 1.0 : 0.0)
         + candleBullCapped
         + (nearBullOB ? 1.5 : 0.0)
         + (wickRejectionBuy ? 1.0 : 0.0)
         + (bullDisplacement ? 1.2 : 0.0)
         + pivotBreakUpFresh
         + (nearPivotS1 ? 0.9 : 0.0)
         + donchianBreakoutUpFresh
    sRaw = (nearResistance ? 2.0 : 0.0)
         + (wyckUpthrust ? 2.5 : 0.0)
         + (bearishDivergence ? 2.5 : 0.0)
         + math.max(bosBear ? 1.5 : 0.0, chochBearish ? 2.0 : 0.0)
         + math.max(sfpBear ? 1.5 : 0.0, liqSweepSell ? 2.0 : 0.0)
         + (bearFVG ? 1.0 : 0.0)
         + candleBearCapped
         + (nearBearOB ? 1.5 : 0.0)
         + (wickRejectionSell ? 1.0 : 0.0)
         + (bearDisplacement ? 1.2 : 0.0)
         + pivotBreakDownFresh
         + (nearPivotR1 ? 0.9 : 0.0)
         + donchianBreakoutDownFresh
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_volumeScore(volumeConfirm, volumeRising, pressureBullish, pressureBearish, obvBullish, cmfBullish, klingerBullish, twiggsBullish, iiiBullish, eomBullish, nviBullish, pviBullish, efiBullish, adLineBullish, obvBearish, cmfBearish, klingerBearish, twiggsBearish, iiiBearish, eomBearish, nviBearish, pviBearish, efiBearish, adLineBearish) =>
    c = 4.0
    confBuy = volumeConfirm and close[1] > open[1]
    confSell = volumeConfirm and close[1] < open[1]
    risBuyOnly = volumeRising and not pressureBullish
    risSellOnly = volumeRising and not pressureBearish
    bRaw = (confBuy ? 1.2 : 0.0)
         + (risBuyOnly ? 0.6 : 0.0)
         + (obvBullish ? 1.0 : 0.0)
         + (cmfBullish ? 1.0 : 0.0)
         + (pressureBullish ? (volumeRising ? 1.5 : 1.0) : 0.0)
         + (klingerBullish ? 0.8 : 0.0)
         + (twiggsBullish ? 0.7 : 0.0)
         + (iiiBullish ? 0.5 : 0.0)
         + (eomBullish ? 0.5 : 0.0)
         + (nviBullish ? 0.5 : 0.0)
         + (pviBullish ? 0.4 : 0.0)
         + (efiBullish ? 0.6 : 0.0)
         + (adLineBullish ? 0.5 : 0.0)
    sRaw = (confSell ? 1.2 : 0.0)
         + (risSellOnly ? 0.6 : 0.0)
         + (obvBearish ? 1.0 : 0.0)
         + (cmfBearish ? 1.0 : 0.0)
         + (pressureBearish ? (volumeRising ? 1.5 : 1.0) : 0.0)
         + (klingerBearish ? 0.8 : 0.0)
         + (twiggsBearish ? 0.7 : 0.0)
         + (iiiBearish ? 0.5 : 0.0)
         + (eomBearish ? 0.5 : 0.0)
         + (nviBearish ? 0.5 : 0.0)
         + (pviBearish ? 0.4 : 0.0)
         + (efiBearish ? 0.6 : 0.0)
         + (adLineBearish ? 0.5 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_trendAlignScore(mtfD, mtf240, mtf60, mtf15, mtf5, htfTrendUp, adxStrong, vwRsiBullish, vortexBullish, vwapBullish, mcginleyBullish, alligatorBullish, vwRsiBearish, vortexBearish, vwapBearish, mcginleyBearish, alligatorBearish) =>
    c = 8.5
    mtfBuy = (mtfD ? 2.5 : 0.0) + (mtf240 ? 2.0 : 0.0) + (mtf60 ? 1.0 : 0.0) + (mtf15 ? 0.6 : 0.0) + (mtf5 ? 0.4 : 0.0)
    mtfSell = (not mtfD ? 2.5 : 0.0) + (not mtf240 ? 2.0 : 0.0) + (not mtf60 ? 1.0 : 0.0) + (not mtf15 ? 0.6 : 0.0) + (not mtf5 ? 0.4 : 0.0)
    bRaw = mtfBuy + (htfTrendUp ? 2.0 : 0.0) + (adxStrong ? 0.5 : 0.0) + (vwRsiBullish ? 0.8 : 0.0) + (vortexBullish ? 0.6 : 0.0) + (vwapBullish ? 0.7 : 0.0) + (mcginleyBullish ? 0.7 : 0.0) + (alligatorBullish ? 0.8 : 0.0)
    sRaw = mtfSell + (not htfTrendUp ? 2.0 : 0.0) + (adxStrong ? 0.5 : 0.0) + (vwRsiBearish ? 0.8 : 0.0) + (vortexBearish ? 0.6 : 0.0) + (vwapBearish ? 0.7 : 0.0) + (mcginleyBearish ? 0.7 : 0.0) + (alligatorBearish ? 0.8 : 0.0)
    [math.min(bRaw / c, 1.0), math.min(sRaw / c, 1.0)]

f_metaMultipliers(exhB, exhS, revB, revS, strB, strS, volB, volS, trdB, trdS, zScore, hvRank, adxValue, adxStrong, lagSellCount, lagEnabledCount, lagBuyCount, USE_SESSION_FILTER, inSession) =>
    zBuyM = zScore[1] < -2.0 ? 1.15 : zScore[1] < -1.0 ? 1.05 : zScore[1] > 2.0 ? 0.65 : zScore[1] > 1.5 ? 0.85 : 1.0
    zSellM = zScore[1] > 2.0 ? 1.15 : zScore[1] > 1.0 ? 1.05 : zScore[1] < -2.0 ? 0.65 : zScore[1] < -1.5 ? 0.85 : 1.0
    r2M = 1.0  
    exhStrength = math.max(exhB, exhS)
    vsM = hvRank[1] > 95 ? (exhStrength > 0.5 ? 1.08 : exhStrength > 0.3 ? 0.85 : 0.65) : hvRank[1] > 90 ? (exhStrength > 0.5 ? 1.04 : exhStrength > 0.3 ? 0.88 : 0.75) : hvRank[1] > 80 ? 0.92 : 1.0
    adxFall = adxValue[1] < adxValue[4]
    adxRise = adxValue[1] > adxValue[4] and adxStrong
    adxM = adxFall ? 1.06 : adxRise ? 0.85 : 1.0    
    lagSellRatio = lagSellCount / math.max(lagEnabledCount, 1)
    lagBuyRatio = lagBuyCount / math.max(lagEnabledCount, 1)
    lagNetBuy = lagSellRatio - lagBuyRatio
    lagNetSell = lagBuyRatio - lagSellRatio
    exBoostB = lagNetBuy >= 0 ? (lagSellRatio >= 0.82 ? 1.15 : lagSellRatio >= 0.65 ? 1.08 : 1.0) : 1.0
    exPenB = lagNetBuy < 0 ? (lagBuyRatio >= 0.82 ? 0.55 : lagBuyRatio >= 0.65 ? 0.75 : 1.0) : 1.0
    exBoostS = lagNetSell >= 0 ? (lagBuyRatio >= 0.82 ? 1.15 : lagBuyRatio >= 0.65 ? 1.08 : 1.0) : 1.0
    exPenS = lagNetSell < 0 ? (lagSellRatio >= 0.82 ? 0.55 : lagSellRatio >= 0.65 ? 0.75 : 1.0) : 1.0
    bAgreeStrong = (exhB > 0.55 ? 1 : 0) + (revB > 0.45 ? 1 : 0) + (strB > 0.35 ? 1 : 0) + (volB > 0.50 ? 1 : 0) + (trdB > 0.55 ? 1 : 0)
    bAgree = (exhB > 0.25 ? 1 : 0) + (revB > 0.15 ? 1 : 0) + (strB > 0.10 ? 1 : 0) + (volB > 0.20 ? 1 : 0) + (trdB > 0.25 ? 1 : 0)
    sAgreeStrong = (exhS > 0.55 ? 1 : 0) + (revS > 0.45 ? 1 : 0) + (strS > 0.35 ? 1 : 0) + (volS > 0.50 ? 1 : 0) + (trdS > 0.55 ? 1 : 0)
    sAgree = (exhS > 0.25 ? 1 : 0) + (revS > 0.15 ? 1 : 0) + (strS > 0.10 ? 1 : 0) + (volS > 0.20 ? 1 : 0) + (trdS > 0.25 ? 1 : 0)
    agreeB = bAgreeStrong >= 3 ? 1.15 : (bAgreeStrong >= 2 and bAgree >= 4) ? 1.10 : bAgree >= 4 ? 1.06 : bAgree >= 3 ? 1.03 : 1.0
    agreeS = sAgreeStrong >= 3 ? 1.15 : (sAgreeStrong >= 2 and sAgree >= 4) ? 1.10 : sAgree >= 4 ? 1.06 : sAgree >= 3 ? 1.03 : 1.0
    hod = hour(time, syminfo.timezone)
    midSess = hod >= 10 and hod <= 14
    sessM = USE_SESSION_FILTER ? (inSession ? (midSess ? 1.05 : 1.0) : 0.90) : 1.0
    [r2M, zBuyM, zSellM, vsM, adxM, exBoostB, exPenB, exBoostS, exPenS, agreeB, agreeS, sessM, bAgreeStrong, bAgree, sAgreeStrong, sAgree]

f_signalTooltip(isBuy, slSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount) =>
    _score = isBuy ? finalBuyScore : finalSellScore
    _conf = isBuy ? buyConfidence : sellConfidence
    _dom = isBuy ? buyDominance : sellDominance
    _domRatio = isBuy ? dominanceRatioBuy : dominanceRatioSell
    _exh = isBuy ? exhBuyScore : exhSellScore
    _rev = isBuy ? revBuyScore : revSellScore
    _str = isBuy ? structBuyScore : structSellScore
    _vol = isBuy ? volBuyScore : volSellScore
    _trd = isBuy ? trendAlignBuyScore : trendAlignSellScore
    _catStrong = isBuy ? buyCatAgreeStrong : sellCatAgreeStrong
    _catAny = isBuy ? buyCatAgree : sellCatAgree
    _sl = isBuy ? buySL : sellSL
    _tp = isBuy ? buyTP : sellTP
    _rr = isBuy ? buyActualRR : sellActualRR
    _tpSrc = isBuy ? buyTPSource : sellTPSource
    _isDivergent = isBuy ? bullishDivergence : bearishDivergence
    _slPct = isBuy ? str.tostring((close - _sl) / close * 100, "#.#") : str.tostring((_sl - close) / close * 100, "#.#")
    _tpPct = isBuy ? str.tostring((_tp - close) / close * 100, "#.#") : str.tostring((close - _tp) / close * 100, "#.#")
    _slSign = isBuy ? "-" : "+"
    _tpSign = isBuy ? "+" : "-"
    _useTwo = isBuy ? USE_TWO_T_PS_BUY : USE_TWO_T_PS_SELL
    _tp1 = isBuy ? buyTP1 : sellTP1
    _tp2 = isBuy ? buyTP2 : sellTP2
    _tp1Pct = isBuy ? str.tostring((_tp1 - close) / close * 100, "#.#") : str.tostring((close - _tp1) / close * 100, "#.#")
    _tp2Pct = isBuy ? str.tostring((_tp2 - close) / close * 100, "#.#") : str.tostring((close - _tp2) / close * 100, "#.#")
    _side = isBuy ? "Buy" : "Sell"
    _pdLabel = isBuy ? (inPremium ? "Premium ⚠" : "Discount ✓") : (inDiscount ? "Discount ⚠" : "Premium ✓")
    t = _side + " Signal\n"
     + "Dominance: +" + str.tostring(_dom, "#.#") + " (×" + str.tostring(_domRatio, "#.##") + ")\n"
     + "Exhaustion:  " + str.tostring(_exh * 100, "#") + "% (wt 30%)\n"
     + "Reversal:    " + str.tostring(_rev * 100, "#") + "% (wt 25%)\n"
     + "Structure:   " + str.tostring(_str * 100, "#") + "% (wt 20%)\n"
     + "Volume:      " + str.tostring(_vol * 100, "#") + "% (wt 15%)\n"
     + "Trend Align: " + str.tostring(_trd * 100, "#") + "% (wt 10%)\n"
     + "━━━━━━━━━━━━━━━━━━━━\n"
     + "Cats agree: " + str.tostring(_catStrong) + " strong + " + str.tostring(_catAny) + "/5 any\n"
     + "R²: " + str.tostring(rSqValue, "#.##") + " (rev×" + str.tostring(r2Reversal, "#.##") + " trd×" + str.tostring(r2Trend, "#.##") + ") | Z: " + str.tostring(zScore[1], "#.#") + "\n"
     + "HV Rank: " + str.tostring(hvRank[1], "#") + "%" + (volSpikeMult < 1.0 ? " ⚠" : "") + "\n"
     + "P/D Zone: " + _pdLabel + "\n"
     + "Lagging bull/bear: " + str.tostring(lagBuyCount) + "/" + str.tostring(lagSellCount) + " (of " + str.tostring(lagEnabledCount) + ")\n"
     + "Divergence: " + (_isDivergent ? "Yes (+8)" : "No") + "\n"
     + "━━━━━━━━━━━━━━━━━━━━\n"
     + "Entry: " + str.tostring(close, "#.##") + "\n"
     + "SL: " + str.tostring(_sl, "#.##") + " (" + _slSign + _slPct + "%) " + slSource + "\n"
     + (_useTwo ? "TP1: " + str.tostring(_tp1, "#.##") + " (" + _tpSign + _tp1Pct + "%) | TP2: " + str.tostring(_tp2, "#.##") + " (" + _tpSign + _tp2Pct + "%) at " + _tpSrc + "\n" : "TP: " + str.tostring(_tp, "#.##") + " (" + _tpSign + _tpPct + "%) at " + _tpSrc + "\n")
     + "R:R = 1:" + str.tostring(_rr, "#.#")
    t

f_deleteBuySignalDrawings(entryLine, entryLabel, entryZone, zoneLabel, slLine, tpLine, slLabel, tpLabel, riskZone, rewardZone, tp2Line, tp2Label, rewardZone2) =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(entryZone)
        box.delete(entryZone)
    if not na(zoneLabel)
        label.delete(zoneLabel)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(riskZone)
        box.delete(riskZone)
    if not na(rewardZone)
        box.delete(rewardZone)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(rewardZone2)
        box.delete(rewardZone2)

f_deleteSellSignalDrawings(entryLine, entryLabel, entryZone, zoneLabel, slLine, tpLine, slLabel, tpLabel, riskZone, rewardZone, tp2Line, tp2Label, rewardZone2) =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(entryZone)
        box.delete(entryZone)
    if not na(zoneLabel)
        label.delete(zoneLabel)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(riskZone)
        box.delete(riskZone)
    if not na(rewardZone)
        box.delete(rewardZone)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(rewardZone2)
        box.delete(rewardZone2)

f_extendBuySignalDrawings(slLine, tpLine, entryLine, riskZone, rewardZone, entryZone, slLabel, tpLabel, entryLabel, hasEntryZone, x, tp2Line, tp2Label, rewardZone2) =>
    if not na(slLine)
        line.set_x2(slLine, x)
    if not na(tpLine)
        line.set_x2(tpLine, x)
    if not na(entryLine)
        line.set_x2(entryLine, x)
    if not na(riskZone)
        box.set_right(riskZone, x)
    if not na(rewardZone)
        box.set_right(rewardZone, x)
    if not na(entryZone)
        box.set_right(entryZone, x)
    if not na(slLabel)
        label.set_x(slLabel, x)
    if not na(tpLabel)
        label.set_x(tpLabel, x)
    if not na(tp2Line)
        line.set_x2(tp2Line, x)
    if not na(tp2Label)
        label.set_x(tp2Label, x)
    if not na(rewardZone2)
        box.set_right(rewardZone2, x)
    if not na(entryLabel) and not hasEntryZone
        label.set_x(entryLabel, x)

f_extendSellSignalDrawings(slLine, tpLine, entryLine, riskZone, rewardZone, entryZone, slLabel, tpLabel, entryLabel, hasEntryZone, x, tp2Line, tp2Label, rewardZone2) =>
    if not na(slLine)
        line.set_x2(slLine, x)
    if not na(tpLine)
        line.set_x2(tpLine, x)
    if not na(entryLine)
        line.set_x2(entryLine, x)
    if not na(riskZone)
        box.set_right(riskZone, x)
    if not na(rewardZone)
        box.set_right(rewardZone, x)
    if not na(entryZone)
        box.set_right(entryZone, x)
    if not na(slLabel)
        label.set_x(slLabel, x)
    if not na(tpLabel)
        label.set_x(tpLabel, x)
    if not na(tp2Line)
        line.set_x2(tp2Line, x)
    if not na(tp2Label)
        label.set_x(tp2Label, x)
    if not na(rewardZone2)
        box.set_right(rewardZone2, x)
    if not na(entryLabel) and not hasEntryZone
        label.set_x(entryLabel, x)

f_prevSignalGrayColors(opacity) =>
    _grayLine = color.new(MUTED_COLOR, 100 - opacity)
    _grayLabel = color.new(MUTED_COLOR, math.min(110 - opacity, 99))
    _grayTxt = color.new(MUTED_COLOR, math.max(80 - opacity, 30))
    _grayBox = color.new(MUTED_COLOR, math.min(108 - opacity, 99))
    _grayBoxBorder = color.new(MUTED_COLOR, 100 - opacity)
    _grayEntryLine = color.new(MUTED_COLOR, math.max(0, 80 - opacity))
    _grayEntryLabel = color.new(MUTED_COLOR, math.max(0, math.min(90 - opacity, 99)))
    _grayEntryTxt = color.new(MUTED_COLOR, math.max(10, 60 - opacity))
    _grayEntryBox = color.new(MUTED_COLOR, math.max(0, math.min(88 - opacity, 99)))
    _grayEntryBoxBorder = color.new(MUTED_COLOR, math.max(0, 80 - opacity))
    [_grayLine, _grayLabel, _grayTxt, _grayBox, _grayBoxBorder, _grayEntryLine, _grayEntryLabel, _grayEntryTxt, _grayEntryBox, _grayEntryBoxBorder]

f_applyGrayToAllSignals(gL, gLbl, gTxt, gBox, gBoxB, gEntL, gEntLbl, gEntTxt, gEntBox, gEntBoxB, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2) =>
    if not na(buyEntryLine)
        line.set_color(buyEntryLine, gEntL)
    if not na(buyEntryLabel)
        label.set_color(buyEntryLabel, gEntLbl)
        label.set_textcolor(buyEntryLabel, gEntTxt)
    if not na(buyEntryZone)
        box.set_bgcolor(buyEntryZone, gEntBox)
        box.set_border_color(buyEntryZone, gEntBoxB)
    if not na(buyZoneLabel)
        label.set_color(buyZoneLabel, gEntLbl)
        label.set_textcolor(buyZoneLabel, gEntTxt)
    if not na(buySLLine)
        line.set_color(buySLLine, gL)
    if not na(buyTPLine)
        line.set_color(buyTPLine, gL)
    if not na(buySLLabel)
        label.set_color(buySLLabel, gLbl)
        label.set_textcolor(buySLLabel, gTxt)
    if not na(buyTPLabel)
        label.set_color(buyTPLabel, gLbl)
        label.set_textcolor(buyTPLabel, gTxt)
    if not na(buyTP2Line)
        line.set_color(buyTP2Line, gL)
    if not na(buyTP2Label)
        label.set_color(buyTP2Label, gLbl)
        label.set_textcolor(buyTP2Label, gTxt)
    if not na(buyRiskZone)
        box.set_bgcolor(buyRiskZone, gBox)
        box.set_border_color(buyRiskZone, gBoxB)
    if not na(buyRewardZone)
        box.set_bgcolor(buyRewardZone, gBox)
        box.set_border_color(buyRewardZone, gBoxB)
    if not na(buyRewardZone2)
        box.set_bgcolor(buyRewardZone2, gBox)
        box.set_border_color(buyRewardZone2, gBoxB)
    if not na(sellRiskZone)
        box.set_bgcolor(sellRiskZone, gBox)
        box.set_border_color(sellRiskZone, gBoxB)
    if not na(sellRewardZone)
        box.set_bgcolor(sellRewardZone, gBox)
        box.set_border_color(sellRewardZone, gBoxB)
    if not na(sellRewardZone2)
        box.set_bgcolor(sellRewardZone2, gBox)
        box.set_border_color(sellRewardZone2, gBoxB)
    if not na(sellEntryLine)
        line.set_color(sellEntryLine, gEntL)
    if not na(sellEntryLabel)
        label.set_color(sellEntryLabel, gEntLbl)
        label.set_textcolor(sellEntryLabel, gEntTxt)
    if not na(sellEntryZone)
        box.set_bgcolor(sellEntryZone, gEntBox)
        box.set_border_color(sellEntryZone, gEntBoxB)
    if not na(sellZoneLabel)
        label.set_color(sellZoneLabel, gEntLbl)
        label.set_textcolor(sellZoneLabel, gEntTxt)
    if not na(sellSLLine)
        line.set_color(sellSLLine, gL)
    if not na(sellTPLine)
        line.set_color(sellTPLine, gL)
    if not na(sellSLLabel)
        label.set_color(sellSLLabel, gLbl)
        label.set_textcolor(sellSLLabel, gTxt)
    if not na(sellTPLabel)
        label.set_color(sellTPLabel, gLbl)
        label.set_textcolor(sellTPLabel, gTxt)
    if not na(sellTP2Line)
        line.set_color(sellTP2Line, gL)
    if not na(sellTP2Label)
        label.set_color(sellTP2Label, gLbl)
        label.set_textcolor(sellTP2Label, gTxt)

f_divergence(src, oscType) =>
    osc = float(na)
    if oscType == "RSI"
        osc := ta.rsi(src, RSI_LENGTH)
    else
        [macdL, _, _] = ta.macd(src, MACD_FAST, MACD_SLOW, MACD_SIGNAL)
        osc := macdL
    lb = 5
    pivotHigh = ta.pivothigh(src, lb, lb)
    pivotLow = ta.pivotlow(src, lb, lb)
    oscPivotHigh = ta.pivothigh(osc, lb, lb)
    oscPivotLow = ta.pivotlow(osc, lb, lb)
    validLow = not na(pivotLow) and not na(oscPivotLow)
    validHigh = not na(pivotHigh) and not na(oscPivotHigh)
    bullDiv = validLow and pivotLow < pivotLow[lb] and oscPivotLow > oscPivotLow[lb]
    bearDiv = validHigh and pivotHigh > pivotHigh[lb] and oscPivotHigh < oscPivotHigh[lb]
    bullHidden = validLow and pivotLow > pivotLow[lb] and oscPivotLow < oscPivotLow[lb]
    bearHidden = validHigh and pivotHigh < pivotHigh[lb] and oscPivotHigh > oscPivotHigh[lb]
    [bullDiv, bearDiv, bullHidden, bearHidden]

f_fisherTransform(length) =>
    hl2Val = hl2
    maxH = ta.highest(hl2Val, length)
    minL = ta.lowest(hl2Val, length)
    rangeHL = maxH - minL
    var float val = 0.0
    var float fish = 0.0
    var float prevFish = 0.0
    rawVal = rangeHL > 0 ? 2.0 * ((hl2Val - minL) / rangeHL - 0.5) : 0.0
    val := 0.33 * rawVal + 0.67 * nz(val[1])
    val := math.max(-0.999, math.min(0.999, val))
    prevFish := nz(fish[1])
    fish := 0.5 * math.log((1 + val) / (1 - val)) + 0.5 * prevFish
    [fish, prevFish]

f_ehlersSineWave() =>
    var float smooth = 0.0
    var float detrender = 0.0
    var float i1 = 0.0
    var float q1 = 0.0
    var float ji = 0.0
    var float jq = 0.0
    var float i2 = 0.0
    var float q2 = 0.0
    var float re = 0.0
    var float im = 0.0
    var float period = 0.0
    var float smoothPeriod = 0.0
    var float dcPhase = 0.0
    var float sine = 0.0
    var float leadSine = 0.0
    price = (high + low) / 2.0
    smooth := (4 * price + 3 * nz(price[1]) + 2 * nz(price[2]) + nz(price[3])) / 10.0
    detrender := (0.0962 * smooth + 0.5769 * nz(smooth[2]) - 0.5769 * nz(smooth[4]) - 0.0962 * nz(smooth[6])) * (0.075 * nz(period[1]) + 0.54)
    q1 := (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * (0.075 * nz(period[1]) + 0.54)
    i1 := nz(detrender[3])
    ji := (0.0962 * i1 + 0.5769 * nz(i1[2]) - 0.5769 * nz(i1[4]) - 0.0962 * nz(i1[6])) * (0.075 * nz(period[1]) + 0.54)
    jq := (0.0962 * q1 + 0.5769 * nz(q1[2]) - 0.5769 * nz(q1[4]) - 0.0962 * nz(q1[6])) * (0.075 * nz(period[1]) + 0.54)
    i2 := i1 - jq
    q2 := q1 + ji
    i2 := 0.2 * i2 + 0.8 * nz(i2[1])
    q2 := 0.2 * q2 + 0.8 * nz(q2[1])
    re := i2 * nz(i2[1]) + q2 * nz(q2[1])
    im := i2 * nz(q2[1]) - q2 * nz(i2[1])
    re := 0.2 * re + 0.8 * nz(re[1])
    im := 0.2 * im + 0.8 * nz(im[1])
    tempPeriod = im != 0 and re != 0 ? 2 * math.acos(1) / math.atan(im / re) : nz(period[1])
    tempPeriod2 = math.max(math.min(tempPeriod, 1.5 * nz(period[1])), 0.67 * nz(period[1]))
    tempPeriod3 = math.max(math.min(tempPeriod2, 50.0), 6.0)
    period := 0.2 * tempPeriod3 + 0.8 * nz(period[1])
    smoothPeriod := 0.33 * period + 0.67 * nz(smoothPeriod[1])
    dcPeriod = math.round(smoothPeriod)
    realPart = 0.0
    imagPart = 0.0
    for i = 0 to math.max(dcPeriod - 1, 0)
        realPart += math.sin(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
        imagPart += math.cos(2 * math.acos(1) * i / math.max(dcPeriod, 1)) * nz(smooth[i])
    dcPhase := imagPart != 0 ? math.atan(realPart / imagPart) * 180 / math.pi : 90.0 * (realPart > 0 ? 1 : -1)
    dcPhase += 90
    dcPhase += (360 / smoothPeriod > 0 ? 360 / smoothPeriod : 1)
    if imagPart < 0
        dcPhase += 180
    if dcPhase > 315
        dcPhase -= 360
    sine := math.sin(dcPhase * math.acos(1) / 180)
    leadSine := math.sin((dcPhase + 45) * math.acos(1) / 180)
    [sine, leadSine, smoothPeriod]

f_mcginley(src, length) =>
    var float mg = na
    mg := na(mg) ? src : mg[1] + (src - mg[1]) / math.max(length * math.pow(src / math.max(mg[1], 1e-10), 4), 1e-10)
    mg

f_trix(src, length, signalLen) =>
    e1 = ta.ema(src, length)
    e2 = ta.ema(e1, length)
    e3 = ta.ema(e2, length)
    trixVal = ta.roc(e3, 1)
    trixSignal = ta.sma(trixVal, signalLen)
    [trixVal, trixSignal]

f_oscillator(period1, period2, period3) =>
    bp = close - math.min(low, low[1])
    tr_uo = math.max(high, high[1]) - math.min(low, low[1])
    avgTrendFilter = ta.rma(bp, period1) / math.max(ta.rma(tr_uo, period1), 1e-10)
    avgMomentum = ta.rma(bp, period2) / math.max(ta.rma(tr_uo, period2), 1e-10)
    avgVolatility = ta.rma(bp, period3) / math.max(ta.rma(tr_uo, period3), 1e-10)
    uo = 100 * (4 * avgTrendFilter + 2 * avgMomentum + avgVolatility) / 7
    uo

f_dpo(src, length) =>
    halfLen = math.round(length / 2) + 1
    smaVal = ta.sma(src, halfLen)
    dpoVal = src[halfLen] - smaVal[halfLen]
    dpoVal

f_rvi(length) =>
    rviRaw = (close - open) / math.max(high - low, 1e-10)
    rviSmooth = ta.sma(rviRaw, length)
    rviSignal = ta.sma(rviSmooth, 4)
    [rviSmooth, rviSignal]

f_schaffTrendCycle(cycleLen, smooth1, smooth2) =>
    var float xmac = 0.0
    var float xmacd = 0.0
    var float stc = 0.0
    xmac := ta.ema(close - ta.ema(close, cycleLen), smooth1)
    xmacd := ta.ema(xmac, smooth2)
    v1 = ta.lowest(xmacd, smooth2) - ta.highest(xmacd, smooth2)
    v2 = v1 != 0 ? (xmacd - ta.lowest(xmacd, smooth2)) / v1 : 0.0
    stc := 0.0
    if not na(v2)
        var float stcPrev = 50.0
        stcPrev := 0.5 * (stcPrev + 100 * (v2 - 0.5))
        stc := math.max(0, math.min(100, stcPrev))
    [xmacd, stc]

f_smma(src, length) =>
    var float sum = na
    sum := na(sum) ? ta.sma(src, length) : (sum[1] * (length - 1) + src) / length
    sum

f_massIndex(singleLen, sumLen) =>
    hlRange = high - low
    hlEma = ta.ema(hlRange, singleLen)
    ratio = hlEma > 0 ? hlRange / hlEma : 0.0
    massSumVal = math.sum(ratio, sumLen)
    massSumVal

f_klinger(fastLen, slowLen, signalLen) =>
    trend = ta.ema(high - low, 5) > ta.ema(high - low, 34) ? 1 : -1
    dm = high - low
    cm = 0.0
    if trend == trend[1]
        cm := nz(cm[1]) + dm
    else
        cm := nz(cm[1]) + dm
    vf = volume * math.abs(2 * dm / math.max(cm, 1e-10) - 1) * trend * 100
    kvo = ta.ema(ta.sma(vf, math.min(fastLen, slowLen)), math.max(fastLen, slowLen) - math.min(fastLen, slowLen) + 1)
    kvoSigLine = ta.ema(kvo, signalLen)
    [kvo, kvoSigLine]

f_eom(length) =>
    dm = (high + low) / 2 - (high[1] + low[1]) / 2
    br = volume / math.max(high - low, 1e-10)
    eomRaw = br != 0 ? dm / br : 0.0
    eomSmooth = ta.sma(eomRaw * 1000000, length)
    eomSmooth

f_vortex(len) =>
    plusVM = math.abs(high - low[1])
    minusVM = math.abs(low - high[1])
    plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
    minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0
    trV = ta.atr(len)
    viPlus = trV != 0 ? ta.rma(plusVM, len) / trV : 0.0
    viMinus = trV != 0 ? ta.rma(minusVM, len) / trV : 0.0
    [viPlus, viMinus]

f_condColor(met) =>
    met ? color.new(POSITIVE_COLOR, 65) : color.new(NEGATIVE_COLOR, 65)

f_condColor3(bullish, bearish) =>
    bullish ? color.new(POSITIVE_COLOR, 65) : bearish ? color.new(NEGATIVE_COLOR, 65) : color.new(NEUTRAL_COLOR, 55)

f_condSym(met) =>
    met ? "●" : "○"

f_rowBg(int row) =>
    row % 2 == 0 ? BACKGROUND_COLOR : color.new(BACKGROUND_COLOR, 12)

f_sparkline(series float src, lookback) =>
    asciiLadder = " .:-=+#"
    result = ""
    maxVal = ta.highest(src, lookback)
    minVal = ta.lowest(src, lookback)
    rangeVal = math.max(maxVal - minVal, 1e-10)
    for i = lookback - 1 to 0
        idx = math.round((nz(src[i]) - minVal) / rangeVal * 7)
        idx := math.max(0, math.min(7, idx))
        result += str.substring(asciiLadder, idx, idx + 1)
    result

f_calcTrend() =>
    hullMA = ta.hma(close, HULL_LENGTH)
    hullTrend = hullMA > hullMA[1]
    htfEma = request.security(syminfo.tickerid, HTF_TIMEFRAME, ta.ema(close, HTF_EMA_LENGTH), lookahead=barmerge.lookahead_off)
    htfEmaPrev = htfEma[1]
    htfTrendUp = close[1] > htfEmaPrev
    [plusDI, minusDI, adxValue] = ta.dmi(ADX_LENGTH, ADX_LENGTH)
    adxStrong = adxValue[1] > ADX_THRESHOLD
    trendUp = close[1] > hullMA[1] and hullMA[1] > hullMA[2]
    trendDown = close[1] < hullMA[1] and hullMA[1] < hullMA[2]
    [hullMA, hullTrend, htfEma, htfEmaPrev, htfTrendUp, plusDI, minusDI, adxValue, adxStrong, trendUp, trendDown]

f_calcMomentum(series float hullMA) =>
    rsiValue = ta.rsi(close, RSI_LENGTH)
    rsiPrev = rsiValue[1]
    rsiRegimeBull = close[1] > hullMA[1]
    rsiOS = USE_RSI_REGIME ? (rsiRegimeBull ? RSI_BULL_OVERSOLD : RSI_BEAR_OVERSOLD) : RSI_OVERSOLD
    rsiOB = USE_RSI_REGIME ? (rsiRegimeBull ? RSI_BULL_OVERBOUGHT : RSI_BEAR_OVERBOUGHT) : RSI_OVERBOUGHT
    rsiOversoldCross = ta.crossover(rsiValue, rsiOS)
    rsiOverboughtCross = ta.crossunder(rsiValue, rsiOB)
    rsiBullish = rsiPrev > 50 or rsiOversoldCross[1]
    rsiBearish = rsiPrev < 50 or rsiOverboughtCross[1]
    [macdLine, macdSignalLine, macdHist] = ta.macd(close, MACD_FAST, MACD_SLOW, MACD_SIGNAL)
    macdLinePrev = macdLine[1]
    macdSignalPrev = macdSignalLine[1]
    macdCrossUp = ta.crossover(macdLine, macdSignalLine)
    macdCrossDown = ta.crossunder(macdLine, macdSignalLine)
    macdBullish = macdLinePrev > macdSignalPrev or macdCrossUp[1]
    macdBearish = macdLinePrev < macdSignalPrev or macdCrossDown[1]
    [rsiValue, rsiPrev, rsiOS, rsiOB, rsiOversoldCross, rsiOverboughtCross, rsiBullish, rsiBearish, macdLine, macdSignalLine, macdHist, macdLinePrev, macdSignalPrev, macdCrossUp, macdCrossDown, macdBullish, macdBearish]

f_calcVolatility() =>
    atr = ta.atr(ATR_LENGTH)
    atrPrev = atr[1]
    bbBasis = ta.sma(close, BB_LENGTH)
    bbDev = BB_MULTIPLIER * ta.stdev(close, BB_LENGTH)
    bbUpper = bbBasis + bbDev
    bbLower = bbBasis - bbDev
    bbBullish = USE_BB ? close[1] > bbBasis[1] : true
    bbBearish = USE_BB ? close[1] < bbBasis[1] : true
    bbWidth = bbUpper - bbLower
    bbWidthSma = ta.sma(bbWidth, SQUEEZE_LENGTH)
    bbSqueeze = bbWidth < bbWidthSma * 0.7
    bbPercent = (close - bbLower) / (bbUpper - bbLower)
    notAtExtremes = bbPercent > 0.2 and bbPercent < 0.8
    [atr, atrPrev, bbBasis, bbDev, bbUpper, bbLower, bbBullish, bbBearish, bbWidth, bbWidthSma, bbSqueeze, bbPercent, notAtExtremes]

f_calcVolume() =>
    volumeMA = ta.sma(volume, VOLUME_LENGTH)
    volumeConfirm = volume[1] > volumeMA[1] * VOLUME_MULTIPLIER
    volZScore = (volume - ta.sma(volume, 50)) / math.max(ta.stdev(volume, 50), 1)
    volClimax = volZScore > 2.5
    volClimaxBuy = volClimax and close[1] < open[1]
    volClimaxSell = volClimax and close[1] > open[1]
    [volumeMA, volumeConfirm, volZScore, volClimax, volClimaxBuy, volClimaxSell]

f_calcStructure(series float atr, series bool trendUp, series bool trendDown) =>
    swingHigh = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    swingLow = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)
    lastSwingHigh = ta.valuewhen(not na(swingHigh), swingHigh, 0)
    lastSwingLow = ta.valuewhen(not na(swingLow), swingLow, 0)
    barsSinceSwingLow = bar_index - ta.valuewhen(not na(swingLow), bar_index, 0)
    barsSinceSwingHigh = bar_index - ta.valuewhen(not na(swingHigh), bar_index, 0)
    extendedBearRun = barsSinceSwingLow > 30
    extendedBullRun = barsSinceSwingHigh > 30
    breakoutUp = USE_BREAKOUT ? (na(lastSwingHigh) or close[1] > lastSwingHigh) : true
    breakoutDown = USE_BREAKOUT ? (na(lastSwingLow) or close[1] < lastSwingLow) : true
    nearSupport = not na(lastSwingLow) and lastSwingLow > 0 and low[1] <= lastSwingLow * 1.002
    nearResistance = not na(lastSwingHigh) and lastSwingHigh > 0 and high[1] >= lastSwingHigh * 0.998
    displacementThreshold = atr * SWING_DISPLACEMENT_ATR
    validSwingHigh = not na(swingHigh)
    validSwingLow = not na(swingLow)
    lastValidSwingHigh = ta.valuewhen(validSwingHigh, swingHigh, 0)
    lastValidSwingLow = ta.valuewhen(validSwingLow, swingLow, 0)
    bosBull = USE_BOS_BODY ? (close[1] > lastSwingHigh and lastSwingHigh > 0) : (high[1] > lastSwingHigh and lastSwingHigh > 0)
    bosBear = USE_BOS_BODY ? (close[1] < lastSwingLow and lastSwingLow > 0) : (low[1] < lastSwingLow and lastSwingLow > 0)
    sfpBear = lastSwingHigh > 0 and high[1] > lastSwingHigh and close[1] <= lastSwingHigh
    sfpBull = lastSwingLow > 0 and low[1] < lastSwingLow and close[1] >= lastSwingLow
    liqSweepBuy = low < lastSwingLow and close > lastSwingLow and close > open
    liqSweepSell = high > lastSwingHigh and close < lastSwingHigh and close < open
    chochBearish = trendUp and not na(lastSwingLow) and lastSwingLow > 0 and close[1] < lastSwingLow
    chochBullish = trendDown and not na(lastSwingHigh) and lastSwingHigh > 0 and close[1] > lastSwingHigh
    chochBlockBuy = USE_C_HO_CH_FILTER and chochBearish
    chochBlockSell = USE_C_HO_CH_FILTER and chochBullish
    [swingHigh, swingLow, lastSwingHigh, lastSwingLow, barsSinceSwingLow, barsSinceSwingHigh, extendedBearRun, extendedBullRun, breakoutUp, breakoutDown, nearSupport, nearResistance, lastValidSwingHigh, lastValidSwingLow, bosBull, bosBear, sfpBear, sfpBull, liqSweepBuy, liqSweepSell, chochBearish, chochBullish, chochBlockBuy, chochBlockSell]

f_calcMAStack() =>
    emaFast = ta.ema(close, MA_FAST_LEN)
    emaSlow = ta.ema(close, MA_SLOW_LEN)
    emaSlower = ta.ema(close, MA_SLOWER_LEN)
    ema200 = ta.ema(close, 200)
    maStackUp = USE_MA_STACK ? (emaFast[1] > emaSlow[1] and emaSlow[1] > emaSlower[1]) : true
    maStackDown = USE_MA_STACK ? (emaFast[1] < emaSlow[1] and emaSlow[1] < emaSlower[1]) : true
    [emaFast, emaSlow, emaSlower, ema200, maStackUp, maStackDown]

f_calcFiltersAndMTF(series float atr) =>
    atrAvg = ta.sma(atr, ATR_LENGTH * 2)
    atrInRange = USE_ATR_FILTER ? (ATR_MIN_PCT <= 0 or atr[1] >= atrAvg[1] * (ATR_MIN_PCT / 100.0)) and (ATR_MAX_PCT <= 0 or atr[1] <= atrAvg[1] * (1 + ATR_MAX_PCT / 100.0)) : true
    htfRsi = request.security(syminfo.tickerid, HTF_TIMEFRAME, ta.rsi(close, HTF_RSI_LENGTH), lookahead=barmerge.lookahead_off)
    htfRsiPrev = htfRsi[1]
    htfRsiOkBuy = USE_HTFRSI ? htfRsiPrev < HTF_RSI_NOT_OVERBOUGHT : true
    htfRsiOkSell = USE_HTFRSI ? htfRsiPrev > HTF_RSI_NOT_OVERSOLD : true
    [htfRsiForDiv, htfRsiForDivPrev] = request.security(syminfo.tickerid, HTF_TIMEFRAME, [ta.rsi(close, RSI_LENGTH)[1], ta.rsi(close, RSI_LENGTH)[2]], lookahead=barmerge.lookahead_off)
    mtfEmaLen = 20
    mtf5  = request.security(syminfo.tickerid, "5",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf15 = request.security(syminfo.tickerid, "15", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf60 = request.security(syminfo.tickerid, "60", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtf240 = request.security(syminfo.tickerid, "240", close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    mtfD  = request.security(syminfo.tickerid, "D",  close > ta.ema(close, mtfEmaLen), lookahead=barmerge.lookahead_off)
    [prevDayHigh, prevDayLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
    inSession = USE_SESSION_FILTER ? not na(time(timeframe.period, SESSION_STR, syminfo.timezone)) : true
    [atrInRange, htfRsi, htfRsiPrev, htfRsiOkBuy, htfRsiOkSell, htfRsiForDiv, htfRsiForDivPrev, mtf5, mtf15, mtf60, mtf240, mtfD, prevDayHigh, prevDayLow, inSession]

f_calcIchimoku() =>
    conv = (ta.highest(high, ICH_CONVERSION) + ta.lowest(low, ICH_CONVERSION)) / 2
    base = (ta.highest(high, ICH_BASE) + ta.lowest(low, ICH_BASE)) / 2
    spanA = (conv + base) / 2
    spanB = (ta.highest(high, ICH_SPAN) + ta.lowest(low, ICH_SPAN)) / 2
    cloudTop = math.max(spanA[ICH_BASE], spanB[ICH_BASE])
    cloudBot = math.min(spanA[ICH_BASE], spanB[ICH_BASE])
    tkCross = conv > base
    aboveCloud = close[1] > cloudTop[1]
    belowCloud = close[1] < cloudBot[1]
    greenCloud = spanA > spanB
    ichBull = USE_ICHIMOKU ? (aboveCloud and tkCross[1]) : true
    ichBear = USE_ICHIMOKU ? (belowCloud and not tkCross[1]) : true
    [conv, base, spanA, spanB, cloudTop, cloudBot, tkCross, aboveCloud, belowCloud, greenCloud, ichBull, ichBear]

f_calcDEMATEMA() =>
    dE1 = ta.ema(close, DEMA_LENGTH)
    dVal = 2 * dE1 - ta.ema(dE1, DEMA_LENGTH)
    tE1 = ta.ema(close, TEMA_LENGTH)
    tE2 = ta.ema(tE1, TEMA_LENGTH)
    tE3 = ta.ema(tE2, TEMA_LENGTH)
    tVal = 3 * tE1 - 3 * tE2 + tE3
    [dVal, tVal, close[1] > dVal[1], close[1] < dVal[1], close[1] > tVal[1], close[1] < tVal[1]]

f_calcGMMA() =>
    s1 = ta.ema(close, 3)
    s2 = ta.ema(close, 5)
    s3 = ta.ema(close, 8)
    s4 = ta.ema(close, 10)
    s5 = ta.ema(close, 12)
    s6 = ta.ema(close, 15)
    l1 = ta.ema(close, 30)
    l2 = ta.ema(close, 35)
    l3 = ta.ema(close, 40)
    l4 = ta.ema(close, 45)
    l5 = ta.ema(close, 50)
    l6 = ta.ema(close, 60)
    shortAvg = (s1 + s2 + s3 + s4 + s5 + s6) / 6
    longAvg = (l1 + l2 + l3 + l4 + l5 + l6) / 6
    gBull = USE_GMMA ? shortAvg[1] > longAvg[1] : true
    gBear = USE_GMMA ? shortAvg[1] < longAvg[1] : true
    [shortAvg, longAvg, gBull, gBear]

f_calcAlligator() =>
    med = (high + low) / 2
    jawVal = f_smma(med, ALLIGATOR_JAW)
    teethVal = f_smma(med, ALLIGATOR_TEETH)
    lipsVal = f_smma(med, ALLIGATOR_LIPS)
    jawPlot = jawVal[8]
    teethPlot = teethVal[5]
    lipsPlot = lipsVal[3]
    aBull = lipsPlot > teethPlot and teethPlot > jawPlot
    aBear = lipsPlot < teethPlot and teethPlot < jawPlot
    gatorUp = math.abs(jawPlot - teethPlot)
    gatorLo = math.abs(teethPlot - lipsPlot)
    gatorExp = (gatorUp > gatorUp[1] or gatorLo > gatorLo[1])
    [jawPlot, teethPlot, lipsPlot, aBull, aBear, gatorUp, gatorLo, gatorExp]

f_calcCandlePatterns(series float atr) =>
    bodySz = math.abs(close[1] - open[1])
    upperW = high[1] - math.max(close[1], open[1])
    lowerW = math.min(close[1], open[1]) - low[1]
    bullEng = (close[2] < open[2] and close[1] > open[1] and open[1] <= close[2] and close[1] >= open[2])
    bearEng = (close[2] > open[2] and close[1] < open[1] and open[1] >= close[2] and close[1] <= open[2])
    hammerB = (lowerW >= bodySz * PIN_BAR_WICK_RATIO and upperW < bodySz and close[1] > open[1])
    shootStar = (upperW >= bodySz * PIN_BAR_WICK_RATIO and lowerW < bodySz and close[1] < open[1])
    wickRejB = (low[1] < low[2]) and (close[1] > (high[1] + low[1]) / 2) and (close[2] > (high[2] + low[2]) / 2)
    wickRejS = (high[1] > high[2]) and (close[1] < (high[1] + low[1]) / 2) and (close[2] < (high[2] + low[2]) / 2)
    bar3Bear = close[3] < open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
    bar2Sm = math.abs(close[2] - open[2]) < atr[2] * 0.3
    bar1Bull = close[1] > open[1] and close[1] > (open[3] + close[3]) / 2
    mornStar = (bar3Bear and bar2Sm and bar1Bull)
    bar3Bull = close[3] > open[3] and math.abs(close[3] - open[3]) > atr[3] * 0.5
    bar1Bear = close[1] < open[1] and close[1] < (open[3] + close[3]) / 2
    evenStar = (bar3Bull and bar2Sm and bar1Bear)
    candleRng1 = high[1] - low[1]
    doj = (bodySz / math.max(candleRng1, 1e-10) <= DOJI_BODY_PCT and bodySz < atr[1] * 0.2)
    bullHar = (close[2] < open[2] and close[1] > open[1] and open[1] > close[2] and close[1] < open[2])
    bearHar = (close[2] > open[2] and close[1] < open[1] and open[1] < close[2] and close[1] > open[2])
    threeWS = (close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and open[1] > open[2] and open[1] < close[2] and open[2] > open[3] and open[2] < close[3] and close[1] > close[2] and close[2] > close[3])
    threeBC = (close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and open[1] < open[2] and open[1] > close[2] and open[2] < open[3] and open[2] > close[3] and close[1] < close[2] and close[2] < close[3])
    tweezerB = (math.abs(low[1] - low[2]) <= atr * TWEEZER_TOLERANCE and close[1] > open[1] and close[2] < open[2])
    tweezerT = (math.abs(high[1] - high[2]) <= atr * TWEEZER_TOLERANCE and close[1] < open[1] and close[2] > open[2])
    mid2 = (open[2] + close[2]) / 2
    pierceLine = (close[2] < open[2] and open[1] < low[2] and close[1] > mid2 and close[1] < open[2] and close[1] > open[1])
    darkCloud = (close[2] > open[2] and open[1] > high[2] and close[1] < mid2 and close[1] > close[2] and close[1] < open[1])
    [bullEng, bearEng, hammerB, shootStar, mornStar, evenStar, doj, bullHar, bearHar, threeWS, threeBC, tweezerB, tweezerT, pierceLine, darkCloud, wickRejB, wickRejS]

f_calcPivotLevels(series float pivotHighHTF, series float pivotLowHTF, series float pivotCloseHTF) =>
    p = (pivotHighHTF + pivotLowHTF + pivotCloseHTF) / 3
    r1 = 2 * p - pivotLowHTF
    r2 = p + (pivotHighHTF - pivotLowHTF)
    s1 = 2 * p - pivotHighHTF
    s2 = p - (pivotHighHTF - pivotLowHTF)
    nearR1 = close[1] >= r1[1] * 0.998 and close[1] <= r1[1] * 1.002
    nearS1 = close[1] >= s1[1] * 0.998 and close[1] <= s1[1] * 1.002
    crossUpR1 = ta.crossover(close, r1)
    crossDnS1 = ta.crossunder(close, s1)
    brk = crossUpR1 or crossDnS1
    [p, r1, r2, s1, s2, nearR1, nearS1, crossUpR1, crossDnS1, brk]

f_calcFibLevels() =>
    fibHigh = ta.highest(high, FIB_LOOKBACK)
    fibLow = ta.lowest(low, FIB_LOOKBACK)
    fibRng = fibHigh - fibLow
    [fibHigh - 0.236 * fibRng, fibHigh - 0.382 * fibRng, fibHigh - 0.5 * fibRng, fibHigh - 0.618 * fibRng, fibHigh - 0.786 * fibRng]

f_calcStochRocCandle(series float macdHist) =>
    stochK = ta.stoch(close, high, low, STOCH_K)
    stochD = ta.sma(stochK, STOCH_D)
    stochBull = USE_STOCH ? (stochK[1] > stochD[1] or stochK[1] < STOCH_OVERSOLD) : true
    stochBear = USE_STOCH ? (stochK[1] < stochD[1] or stochK[1] > STOCH_OVERBOUGHT) : true
    rocVal = ta.roc(close, ROC_LENGTH)
    rocBull = USE_ROC ? rocVal[1] > 0 : true
    rocBear = USE_ROC ? rocVal[1] < 0 : true
    macdHistBull = USE_MACD_HIST ? macdHist[1] > 0 : true
    macdHistBear = USE_MACD_HIST ? macdHist[1] < 0 : true
    bullCandle = USE_CANDLE_FILTER ? close[1] > open[1] : true
    bearCandle = USE_CANDLE_FILTER ? close[1] < open[1] : true
    [stochK, stochD, stochBull, stochBear, rocVal, rocBull, rocBear, macdHistBull, macdHistBear, bullCandle, bearCandle]

f_calcFVGSTSAR() =>
    bodyPctB = (close[2] - open[2]) / (high[2] - low[2] + 1e-10)
    bodyPctBe = (open[2] - close[2]) / (high[2] - low[2] + 1e-10)
    bullFVGVal = low[2] > high[0] and bodyPctB >= FVG_MIN_BODY_PCT
    bearFVGVal = high[2] < low[0] and bodyPctBe >= FVG_MIN_BODY_PCT
    [stVal, stDirVal] = ta.supertrend(ST_FACTOR, ST_ATR_LEN)
    stBull = USE_SUPER_TREND ? stDirVal[1] < 0 : true
    stBear = USE_SUPER_TREND ? stDirVal[1] > 0 : true
    sarVal = ta.sar(SAR_START, SAR_INCREMENT, SAR_MAX)
    sarBull = USE_SAR ? close[1] > sarVal[1] : true
    sarBear = USE_SAR ? close[1] < sarVal[1] : true
    [bodyPctB, bodyPctBe, bullFVGVal, bearFVGVal, stVal, stDirVal, stBull, stBear, sarVal, sarBull, sarBear]

f_calcAroonLinReg() =>
    aroonU = 100.0 * (AROON_LENGTH - ta.highestbars(high, AROON_LENGTH + 1)) / AROON_LENGTH
    aroonD = 100.0 * (AROON_LENGTH - ta.lowestbars(low, AROON_LENGTH + 1)) / AROON_LENGTH
    aroonBull = (aroonU[1] > 70 and aroonD[1] < 30)
    aroonBear = (aroonD[1] > 70 and aroonU[1] < 30)
    linReg = ta.linreg(close, LIN_REG_LENGTH, 0)
    linRegSl = linReg - ta.linreg(close, LIN_REG_LENGTH, 1)
    corr = ta.correlation(close, bar_index, LIN_REG_LENGTH)
    rSq = corr * corr
    linRegBull = (linRegSl[1] > 0 and rSq[1] > 0.3)
    linRegBear = (linRegSl[1] < 0 and rSq[1] > 0.3)
    [aroonU, aroonD, aroonBull, aroonBear, linReg, linRegSl, corr, rSq, linRegBull, linRegBear]

f_calcKeltnerTTM(series float bbUpper, series float bbLower) =>
    kcB = ta.ema(close, KC_LENGTH)
    kcRng = ta.atr(KC_LENGTH) * KC_MULT
    kcUp = kcB + kcRng
    kcLo = kcB - kcRng
    ttmOn = USE_TTM_SQUEEZE ? (bbUpper < kcUp and bbLower > kcLo) : false
    ttmOff = USE_TTM_SQUEEZE ? not ttmOn : true
    ttmMom = ta.linreg(close - (ta.highest(high, KC_LENGTH) + ta.lowest(low, KC_LENGTH)) / 2, KC_LENGTH, 0)
    ttmFirB = USE_TTM_SQUEEZE ? (not ttmOn and ttmOn[1] and ttmMom > 0) : false
    ttmFirBe = USE_TTM_SQUEEZE ? (not ttmOn and ttmOn[1] and ttmMom < 0) : false
    kcBull = USE_KELTNER ? (close[1] > kcB[1]) : true
    kcBear = USE_KELTNER ? (close[1] < kcB[1]) : true
    [kcB, kcRng, kcUp, kcLo, ttmOn, ttmOff, ttmMom, ttmFirB, ttmFirBe, kcBull, kcBear]

f_calcHVChandVWAP() =>
    hv = ta.stdev(math.log(close / close[1]), HV_LENGTH) * math.sqrt(252)
    hvR = ta.percentrank(hv, HV_RANK_LENGTH)
    hvL = hvR[1] < 25
    hvH = hvR[1] > 75
    chandL = ta.highest(high, CHAND_LENGTH) - CHAND_MULT * ta.atr(CHAND_LENGTH)
    chandS = ta.lowest(low, CHAND_LENGTH) + CHAND_MULT * ta.atr(CHAND_LENGTH)
    chandBull = close[1] > chandL[1]
    chandBear = close[1] < chandS[1]
    vwapV = ta.vwap(close)
    vwapBull = close[1] > vwapV[1]
    vwapBear = close[1] < vwapV[1]
    [hv, hvR, hvL, hvH, chandL, chandS, chandBull, chandBear, vwapV, vwapBull, vwapBear]

f_calcWyckoffVWMADisplacement(series float volumeMA, series float atr) =>
    wyckH = ta.highest(high, WYCKOFF_LOOKBACK)
    wyckL = ta.lowest(low, WYCKOFF_LOOKBACK)
    wyckRng = wyckH - wyckL
    wyckVolA = ta.sma(volume, WYCKOFF_LOOKBACK)
    wyckInR = wyckRng > 0 and wyckRng < atr * WYCKOFF_LOOKBACK * 0.5
    wyckSpr = wyckInR ? (low[1] < wyckL[1] and close[1] > wyckL[1] and volume[1] > wyckVolA[1]) : false
    wyckUp = wyckInR ? (high[1] > wyckH[1] and close[1] < wyckH[1] and volume[1] > wyckVolA[1]) : false
    vwmaV = ta.vwma(close, VWMA_LENGTH)
    smaVwma = ta.sma(close, VWMA_LENGTH)
    vwmaBull = vwmaV[1] > smaVwma[1]
    vwmaBear = vwmaV[1] < smaVwma[1]
    avgB = ta.sma(math.abs(close - open), 20)
    bullDisp = (close[1] > open[1] and math.abs(close[1] - open[1]) > avgB[1] * DISP_BODY_MULT and volume[1] > volumeMA[1])
    bearDisp = (close[1] < open[1] and math.abs(close[1] - open[1]) > avgB[1] * DISP_BODY_MULT and volume[1] > volumeMA[1])
    [wyckH, wyckL, wyckRng, wyckVolA, wyckInR, wyckSpr, wyckUp, vwmaV, smaVwma, vwmaBull, vwmaBear, avgB, bullDisp, bearDisp]

f_calcDonchianMcGinley() =>
    donchUp = ta.highest(high, DONCHIAN_LENGTH)
    donchLo = ta.lowest(low, DONCHIAN_LENGTH)
    donchMid = (donchUp + donchLo) / 2
    donchBull = close[1] > donchMid[1]
    donchBear = close[1] < donchMid[1]
    donchBreakUp = ta.crossover(close, donchUp)
    donchBreakDn = ta.crossunder(close, donchLo)
    mcgVal = f_mcginley(close, MCGINLEY_LENGTH)
    mcgBull = close[1] > mcgVal[1]
    mcgBear = close[1] < mcgVal[1]
    [donchUp, donchLo, donchMid, donchBull, donchBear, donchBreakUp, donchBreakDn, mcgVal, mcgBull, mcgBear]

f_calcMomentumOscillators() =>
    [trixV, trixSig] = f_trix(close, TRIX_LENGTH, TRIX_SIGNAL_LEN)
    trixBull = trixV[1] > trixSig[1]
    trixBear = trixV[1] < trixSig[1]
    uoV = f_oscillator(UO_PERIOD_1, UO_PERIOD_2, UO_PERIOD_3)
    uoBull = uoV[1] > 50
    uoBear = uoV[1] < 50
    kstR1 = ta.roc(close, KST_ROC_1)
    kstR2 = ta.roc(close, KST_ROC_2)
    kstR3 = ta.roc(close, KST_ROC_3)
    kstR4 = ta.roc(close, KST_ROC_4)
    kstV = ta.sma(kstR1 * 1 + kstR2 * 2 + kstR3 * 3 + kstR4 * 4, 10)
    kstSig = ta.sma(kstV, KST_SMA_LEN)
    kstBull = kstV[1] > kstSig[1]
    kstBear = kstV[1] < kstSig[1]
    dpoV = f_dpo(close, DPO_LENGTH)
    dpoBull = dpoV[1] > 0
    dpoBear = dpoV[1] < 0
    [rviV, rviSig] = f_rvi(RVI_LENGTH)
    rviBull = rviV[1] > rviSig[1]
    rviBear = rviV[1] < rviSig[1]
    [_, schaffV] = f_schaffTrendCycle(SCHAFF_CYCLE, SCHAFF_SMOOTH_1, SCHAFF_SMOOTH_2)
    schaffBull = (schaffV[1] > 25 and schaffV[2] <= 25) or schaffV[1] > 75
    schaffBear = (schaffV[1] < 75 and schaffV[2] >= 75) or schaffV[1] < 25
    pgoV = (close - ta.ema(close, PGO_LENGTH)) / math.max(ta.atr(PGO_LENGTH), 1e-10)
    pgoBull = pgoV[1] > 0
    pgoBear = pgoV[1] < 0
    coppockR = ta.roc(close, COPPOCK_ROC_1) + ta.roc(close, COPPOCK_ROC_2)
    coppockV = ta.sma(coppockR, COPPOCK_SMA)
    coppockBull = coppockV[1] > 0
    coppockBear = coppockV[1] < 0
    massV = f_massIndex(MASS_SINGLE, MASS_SUM)
    massB = (massV[1] > MASS_THRESHOLD and massV[1] < massV[2])
    [trixV, trixSig, trixBull, trixBear, uoV, uoBull, uoBear, kstV, kstSig, kstBull, kstBear, dpoV, dpoBull, dpoBear, rviV, rviSig, rviBull, rviBear, schaffV, schaffBull, schaffBear, pgoV, pgoBull, pgoBear, coppockV, coppockBull, coppockBear, massV, massB]

f_calcVortexElderVWRsiTwiggs(series float macdHist) =>
    [viP, viM] = f_vortex(VORTEX_LENGTH)
    vortexBull = viP[1] > viM[1]
    vortexBear = viM[1] > viP[1]
    elderE = ta.ema(close, ELDER_EMA_LEN)
    elderRising = elderE > elderE[1]
    elderImpBull = (elderRising[1] and macdHist[1] > 0)
    elderImpBear = (not elderRising[1] and macdHist[1] < 0)
    vwP = ta.vwma(close, VW_RSI_LENGTH)
    vwRsiV = ta.rsi(vwP, VW_RSI_LENGTH)
    vwRsiBull = vwRsiV[1] > 50
    vwRsiBear = vwRsiV[1] < 50
    twiggsR = ((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume
    twiggsV = ta.sma(twiggsR, TWIGGS_LENGTH)
    twiggsBull = twiggsV[1] > 0
    twiggsBear = twiggsV[1] < 0
    [viP, viM, vortexBull, vortexBear, elderE, elderRising, elderImpBull, elderImpBear, vwP, vwRsiV, vwRsiBull, vwRsiBear, twiggsV, twiggsBull, twiggsBear]

// ==================================================================================
// CALCULATIONS
// ==================================================================================

// --- Trend ---
[hullMA, hullTrend, htfEma, htfEmaPrev, htfTrendUp, plusDI, minusDI, adxValue, adxStrong, trendUp, trendDown] = f_calcTrend()

// --- Momentum ---
[rsiValue, rsiPrev, rsiOS, rsiOB, rsiOversoldCross, rsiOverboughtCross, rsiBullish, rsiBearish, macdLine, macdSignalLine, macdHist, macdLinePrev, macdSignalPrev, macdCrossUp, macdCrossDown, macdBullish, macdBearish] = f_calcMomentum(hullMA)

// --- Volatility ---
[atr, atrPrev, bbBasis, bbDev, bbUpper, bbLower, bbBullish, bbBearish, bbWidth, bbWidthSma, bbSqueeze, bbPercent, notAtExtremes] = f_calcVolatility()

// --- Volume ---
[volumeMA, volumeConfirm, volZScore, volClimax, volClimaxBuy, volClimaxSell] = f_calcVolume()

// --- Divergence ---
[rsiBullDiv, rsiBearDiv, rsiBullHidden, rsiBearHidden] = f_divergence(close, "RSI")
[macdBullDiv, macdBearDiv, macdBullHidden, macdBearHidden] = f_divergence(close, "MACD")
bullDivAny = rsiBullDiv or macdBullDiv
bearDivAny = rsiBearDiv or macdBearDiv
bullHiddenAny = rsiBullHidden or macdBullHidden
bearHiddenAny = rsiBearHidden or macdBearHidden
bullishDivergence = bullDivAny or bullHiddenAny
bearishDivergence = bearDivAny or bearHiddenAny

// --- DI ---
plusDIPrev = plusDI[1]
minusDIPrev = minusDI[1]
diBullish = plusDIPrev > minusDIPrev
diBearish = minusDIPrev > plusDIPrev

// --- Premium/Discount ---
rangeHigh = ta.highest(high, PD_LOOKBACK)
rangeLow = ta.lowest(low, PD_LOOKBACK)
equilibrium = (rangeHigh + rangeLow) / 2
inPremium = close[1] >= equilibrium
inDiscount = close[1] <= equilibrium
premiumDiscountOkBuy = not USE_PREMIUM_DISCOUNT or inDiscount
premiumDiscountOkSell = not USE_PREMIUM_DISCOUNT or inPremium

// --- Structure ---
[swingHigh, swingLow, lastSwingHigh, lastSwingLow, barsSinceSwingLow, barsSinceSwingHigh, extendedBearRun, extendedBullRun, breakoutUp, breakoutDown, nearSupport, nearResistance, lastValidSwingHigh, lastValidSwingLow, bosBull, bosBear, sfpBear, sfpBull, liqSweepBuy, liqSweepSell, chochBearish, chochBullish, chochBlockBuy, chochBlockSell] = f_calcStructure(atr, trendUp, trendDown)

structureBull = (not USE_STRUCTURE or (breakoutUp or nearSupport)) and premiumDiscountOkBuy
structureBear = (not USE_STRUCTURE or (breakoutDown or nearResistance)) and premiumDiscountOkSell

// --- MA Stack ---
[emaFast, emaSlow, emaSlower, ema200, maStackUp, maStackDown] = f_calcMAStack()

// --- Volatility extended ---
bbNotExtremes = USE_BB_NOT_EXTREMES ? notAtExtremes[1] : true
noSqueeze = USE_NO_SQUEEZE ? not bbSqueeze[1] : true
atrMA = ta.sma(atr, ATR_LENGTH)
atrExpanding = USE_ATR_EXPANDING ? atr[1] >= atrMA[1] : true

// --- Volume extended ---
volumeRising = USE_VOLUME_TREND ? (volume[1] >= volume[2] and volume[2] >= volume[VOLUME_TREND_BARS]) : true
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvMA = ta.sma(obv, OBV_LENGTH)
obvBullish = USE_OBV ? obv[1] > obvMA[1] : true
obvBearish = USE_OBV ? obv[1] < obvMA[1] : true

// --- Stochastic, ROC, MACD Hist, Candle direction ---
[stochKVal, stochDVal, stochBullish, stochBearish, roc, rocBullish, rocBearish, macdHistBullish, macdHistBearish, bullishCandle, bearishCandle] = f_calcStochRocCandle(macdHist)

// --- Session, HTF RSI, MTF Heatmap, ATR Range ---
[atrInRange, htfRsi, htfRsiPrev, htfRsiOkBuy, htfRsiOkSell, htfRsiForDiv, htfRsiForDivPrev, mtf5, mtf15, mtf60, mtf240, mtfD, prevDayHigh, prevDayLow, inSession] = f_calcFiltersAndMTF(atr)

// --- FVG, SuperTrend, Parabolic SAR ---
[bodyPctBull, bodyPctBear, bullFVG, bearFVG, stValue, stDir, stBullish, stBearish, sarValue, sarBullish, sarBearish] = f_calcFVGSTSAR()

// --- Ichimoku Cloud ---
[ichConvLine, ichBaseLine, ichSpanA, ichSpanB, ichCloudTop, ichCloudBot, ichTKCross, ichAboveCloud, ichBelowCloud, ichGreenCloud, ichBullish, ichBearish] = f_calcIchimoku()

// --- Aroon, Linear Regression, R-Squared ---
[aroonUp, aroonDown, aroonBullish, aroonBearish, linRegVal, linRegSlope, corrVal, rSquared, linRegBullish, linRegBearish] = f_calcAroonLinReg()

// --- Keltner Channels + TTM Squeeze ---
[kcBasis, kcRange, kcUpper, kcLower, ttmSqueezeOn, ttmSqueezeOff, ttmMomentum, ttmFirBull, ttmFirBear, kcBullish, kcBearish] = f_calcKeltnerTTM(bbUpper, bbLower)

// --- Historical Volatility, Chandelier, VWAP ---
[hvol, hvRank, hvLow, hvHigh, chandLong, chandShort, chandBullish, chandBearish, vwapValue, vwapBullish, vwapBearish] = f_calcHVChandVWAP()

// --- Chaikin Money Flow ---
clv = ((close - low) - (high - close)) / math.max(high - low, 1e-10)
cmfValue = ta.sma(clv * volume, CMF_LENGTH) / math.max(ta.sma(volume, CMF_LENGTH), 1e-10)
cmfBullish = cmfValue[1] > 0
cmfBearish = cmfValue[1] < 0

// --- Money Flow Index ---
mfiValue = ta.mfi(hlc3, MFI_LENGTH)
mfiBullish = mfiValue[1] > 50
mfiBearish = mfiValue[1] < 50

// --- Accumulation/Distribution Line ---
adLine = ta.cum(((close - low) - (high - close)) / math.max(high - low, 1e-10) * volume)
adLineMA = ta.sma(adLine, AD_LINE_MA_LEN)
adLineBullish = adLine[1] > adLineMA[1]
adLineBearish = adLine[1] < adLineMA[1]

// --- Price Volume Trend ---
pvtVal = ta.cum(ta.change(close) / math.max(close[1], 1e-10) * volume)
pvtMA = ta.sma(pvtVal, PVT_MA_LEN)
pvtBullish = pvtVal[1] > pvtMA[1]
pvtBearish = pvtVal[1] < pvtMA[1]

// --- CCI ---
cciValue = ta.cci(close, CCI_LENGTH)
cciBullish = cciValue[1] > 0
cciBearish = cciValue[1] < 0

// --- Williams %R ---
wrValue = -100 * (ta.highest(high, WR_LENGTH) - close) / math.max(ta.highest(high, WR_LENGTH) - ta.lowest(low, WR_LENGTH), 1e-10)
wrBullish = wrValue[1] > -50
wrBearish = wrValue[1] < -50

// --- Chande Momentum Oscillator ---
cmoValue = ta.cmo(close, CMO_LENGTH)
cmoBullish = cmoValue[1] > 0
cmoBearish = cmoValue[1] < 0

// --- Fisher Transform ---
[fisherVal, fisherPrev] = f_fisherTransform(FISHER_LENGTH)
fisherBullish = (fisherVal[1] > fisherPrev[1])
fisherBearish = (fisherVal[1] < fisherPrev[1])

// --- Elder Force Index ---
efiValue = ta.ema(volume * (close - close[1]), EFI_LENGTH)
efiBullish = efiValue[1] > 0
efiBearish = efiValue[1] < 0

// --- Order Blocks ---
obDispThreshold = atr * OB_DISPLACEMENT_MULT
bullOBCandle = close[2] < open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] > open[1]
bearOBCandle = close[2] > open[2] and math.abs(close[1] - open[1]) > obDispThreshold[1] and close[1] < open[1]
var float lastBullOBHigh = na
var float lastBullOBLow = na
var float lastBearOBHigh = na
var float lastBearOBLow = na
if bullOBCandle
    lastBullOBHigh := high[2]
    lastBullOBLow := low[2]
if bearOBCandle
    lastBearOBHigh := high[2]
    lastBearOBLow := low[2]
nearBullOB = not na(lastBullOBLow) ? (low[1] <= lastBullOBHigh and low[1] >= lastBullOBLow) : false
nearBearOB = not na(lastBearOBHigh) ? (high[1] >= lastBearOBLow and high[1] <= lastBearOBHigh) : false

// --- Intermarket (Correlation + Relative Strength) ---
benchClose = request.security(BENCHMARK_SYMBOL, timeframe.period, close, lookahead=barmerge.lookahead_off)
corrValue = ta.correlation(close, benchClose, CORR_LENGTH)
benchTrendUp = benchClose > benchClose[1]
corrBullish = (corrValue[1] > 0.5 and benchTrendUp[1]) or (corrValue[1] < -0.3 and not benchTrendUp[1])
corrBearish = (corrValue[1] > 0.5 and not benchTrendUp[1]) or (corrValue[1] < -0.3 and benchTrendUp[1])

rsRatio = close / math.max(benchClose, 1e-10)
rsMA = ta.sma(rsRatio, CORR_LENGTH)
rsBullish = rsRatio[1] > rsMA[1]
rsBearish = rsRatio[1] < rsMA[1]

// --- Candlestick Patterns ---
[bullEngulfing, bearEngulfing, hammerBull, shootingStar, morningStar, eveningStar, doji, bullHarami, bearHarami, threeWhiteSoldiers, threeBlackCrows, tweezerBottom, tweezerTop, piercingLine, darkCloudCover, wickRejectionBuy, wickRejectionSell] = f_calcCandlePatterns(atr)

// --- Z-Score ---
zScore = (close - ta.sma(close, Z_SCORE_LENGTH)) / math.max(ta.stdev(close, Z_SCORE_LENGTH), 1e-10)
zScoreOverextBull = zScore[1] > 2.0
zScoreOverextBear = zScore[1] < -2.0

// --- R-Squared (for meta-modifier) ---
rSqValue = rSquared[1]

// --- ATR Acceleration (Sentiment) ---
atrRoc = ta.roc(atr, 10)
atrDecelerating = atrRoc[1] < 0 and atrRoc[2] > 0
atrAccelerating = atrRoc[1] > 0 and atrRoc[2] < 0

// --- Buying/Selling Pressure ---
buyPressure = ta.sma((close - low) / math.max(high - low, 1e-10) * volume, PRESSURE_LENGTH)
sellPressure = ta.sma((high - close) / math.max(high - low, 1e-10) * volume, PRESSURE_LENGTH)
pressureRatio = buyPressure / math.max(buyPressure + sellPressure, 1e-10)
pressureBullish = pressureRatio[1] > 0.55
pressureBearish = pressureRatio[1] < 0.45

// --- Ehlers Sine Wave ---
[sineVal, leadSineVal, dominantPeriod] = f_ehlersSineWave()
sineBullish = (sineVal[1] > leadSineVal[1] and sineVal[2] <= leadSineVal[2]) or sineVal[1] > leadSineVal[1]
sineBearish = (sineVal[1] < leadSineVal[1] and sineVal[2] >= leadSineVal[2]) or sineVal[1] < leadSineVal[1]

// --- Wyckoff, VWMA, Displacement ---
[wyckHigh, wyckLow, wyckRange, wyckVolAvg, wyckInRange, wyckSpring, wyckUpthrust, vwmaVal, smaForVwma, vwmaBullish, vwmaBearish, avgBody, bullDisplacement, bearDisplacement] = f_calcWyckoffVWMADisplacement(volumeMA, atr)

// --- Donchian Channel, McGinley Dynamic ---
[donchianUpper, donchianLower, donchianMid, donchianBullish, donchianBearish, donchianBreakoutUp, donchianBreakoutDown, mcginleyVal, mcginleyBullish, mcginleyBearish] = f_calcDonchianMcGinley()

// --- DEMA / TEMA / GMMA / Alligator ---
[demaVal, temaVal, demaBullish, demaBearish, temaBullish, temaBearish] = f_calcDEMATEMA()
[gmmaShortAvg, gmmaLongAvg, gmmaBullish, gmmaBearish] = f_calcGMMA()
[alligatorJawPlot, alligatorTeethPlot, alligatorLipsPlot, alligatorBullish, alligatorBearish, gatorUpper, gatorLower, gatorExpanding] = f_calcAlligator()

// --- TRIX, UO, KST, DPO, RVI, Schaff, PGO, Coppock, Mass ---
[trixVal, trixSignalVal, trixBullish, trixBearish, uoValue, uoBullish, uoBearish, kstValue, kstSignalVal, kstBullish, kstBearish, dpoValue, dpoBullish, dpoBearish, rviValue, rviSignalVal, rviBullish, rviBearish, schaffVal, schaffBullish, schaffBearish, pgoValue, pgoBullish, pgoBearish, coppockValue, coppockBullish, coppockBearish, massValue, massBulge] = f_calcMomentumOscillators()

// --- Klinger Volume ---
[kvoValue, KVO_SIGNALLine] = f_klinger(KVO_FAST, KVO_SLOW, KVO_SIGNAL)
klingerBullish = kvoValue[1] > KVO_SIGNALLine[1]
klingerBearish = kvoValue[1] < KVO_SIGNALLine[1]

// --- Ease of Movement ---
eomValue = f_eom(EOM_LENGTH)
eomBullish = eomValue[1] > 0
eomBearish = eomValue[1] < 0

// --- NVI ---
var float nviVal = 1000.0
nviVal := volume < volume[1] ? nviVal[1] * (close / math.max(close[1], 1e-10)) : nviVal[1]
nviMA = ta.sma(nviVal, NVI_PVI_MA_LEN)
nviBullish = nviVal[1] > nviMA[1]
nviBearish = nviVal[1] < nviMA[1]

// --- PVI ---
var float pviVal = 1000.0
pviVal := volume > volume[1] ? pviVal[1] * (close / math.max(close[1], 1e-10)) : pviVal[1]
pviMA = ta.sma(pviVal, NVI_PVI_MA_LEN)
pviBullish = pviVal[1] > pviMA[1]
pviBearish = pviVal[1] < pviMA[1]

// --- Intraday Intensity Index ---
iiiRaw = (high - low) > 0 ? (2 * close - high - low) / (high - low) * volume : 0.0
iiiValue = ta.sma(iiiRaw, III_LENGTH)
iiiCum = ta.cum(iiiRaw)
iiiBullish = iiiValue[1] > 0
iiiBearish = iiiValue[1] < 0

// --- Market Facilitation Index (Bill Williams) ---
mfiBWValue = (high - low) / math.max(volume, 1)
mfiBWUp = close > close[1]
mfiBWVolUp = volume > volume[1]
mfiBWBullish = (mfiBWUp and mfiBWVolUp)
mfiBWBearish = (not mfiBWUp and mfiBWVolUp)

// --- Pivot Points (HTF) & Fibonacci ---
[pivotHighHTF, pivotLowHTF, pivotCloseHTF] = request.security(syminfo.tickerid, PIVOT_TIMEFRAME, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
[pivotP, pivotR1, pivotR2, pivotS1, pivotS2, nearPivotR1, nearPivotS1, pivotCrossUpR1, pivotCrossDownS1, pivotBreak] = f_calcPivotLevels(pivotHighHTF, pivotLowHTF, pivotCloseHTF)
[fib236, fib382, fib50, fib618, fib786] = f_calcFibLevels()

// --- Gap Detection ---
gapUp = USE_GAP and open > high[1]
gapDown = USE_GAP and open < low[1]
gapSize = gapUp ? open - high[1] : gapDown ? low[1] - open : 0.0
gapValid = (GAP_MIN_ATR <= 0 or gapSize >= atr * GAP_MIN_ATR) and (gapUp or gapDown)

// --- S/R Zones (display only; multiple factors: pivots, clustering, touch count, break detection) ---
srPivotHigh = ta.pivothigh(high, SR_ZONE_PIVOT_LB, SR_ZONE_PIVOT_LB)
srPivotLow  = ta.pivotlow(low, SR_ZONE_PIVOT_LB, SR_ZONE_PIVOT_LB)
var array<float> srPhPrices = array.new_float(0)
var array<int>   srPhBars   = array.new_int(0)
var array<float> srPlPrices = array.new_float(0)
var array<int>   srPlBars   = array.new_int(0)
if not na(srPivotHigh)
    array.push(srPhPrices, srPivotHigh)
    array.push(srPhBars, bar_index - SR_ZONE_PIVOT_LB)
    if array.size(srPhPrices) > 50
        array.shift(srPhPrices)
        array.shift(srPhBars)
if not na(srPivotLow)
    array.push(srPlPrices, srPivotLow)
    array.push(srPlBars, bar_index - SR_ZONE_PIVOT_LB)
    if array.size(srPlPrices) > 50
        array.shift(srPlPrices)
        array.shift(srPlBars)

srZoneWidth = atr * SR_ZONE_WIDTH_ATR
srBreakMarg = atr * SR_ZONE_BREAK_ATR
var float srR1Top = na
var float srR1Bot = na
var int   srR1Start = na
var float srR2Top = na
var float srR2Bot = na
var int   srR2Start = na
var float srS1Top = na
var float srS1Bot = na
var int   srS1Start = na
var float srS2Top = na
var float srS2Bot = na
var int   srS2Start = na

if USE_SR_ZONES and array.size(srPhPrices) >= 1
    rLo      = array.new_float(20, na)
    rHi      = array.new_float(20, na)
    rStartB  = array.new_int(20, 2147483647)
    rTouches = array.new_int(20, 0)
    numR     = 0
    lb       = math.max(0, bar_index - SR_ZONE_LOOKBACK)
    for i = 0 to array.size(srPhPrices) - 1
        bi = array.get(srPhBars, i)
        if bi >= lb
            p = array.get(srPhPrices, i)
            found = false
            for j = 0 to numR - 1
                zl = array.get(rLo, j) - srZoneWidth
                zh = array.get(rHi, j) + srZoneWidth
                if p >= zl and p <= zh
                    array.set(rLo, j, math.min(array.get(rLo, j), p - srZoneWidth * 0.5))
                    array.set(rHi, j, math.max(array.get(rHi, j), p + srZoneWidth * 0.5))
                    array.set(rStartB, j, math.min(array.get(rStartB, j), bi))
                    found := true
                    break
            if not found and numR < 20
                array.set(rLo, numR, p - srZoneWidth * 0.5)
                array.set(rHi, numR, p + srZoneWidth * 0.5)
                array.set(rStartB, numR, bi)
                numR += 1
    for j = 0 to numR - 1
        tc = 0
        for k = 1 to math.min(SR_ZONE_LOOKBACK, bar_index)
            if high[k] >= array.get(rLo, j) and low[k] <= array.get(rHi, j)
                tc += 1
        array.set(rTouches, j, tc)
    bestR = -1
    bestRt = 0
    for j = 0 to numR - 1
        if array.get(rTouches, j) >= SR_ZONE_MIN_TOUCHES and array.get(rTouches, j) > bestRt
            bestRt := array.get(rTouches, j)
            bestR := j
    secondR = -1
    secondRt = 0
    for j = 0 to numR - 1
        if j != bestR and array.get(rTouches, j) >= SR_ZONE_MIN_TOUCHES and array.get(rTouches, j) > secondRt
            secondRt := array.get(rTouches, j)
            secondR := j
    if bestR >= 0
        srR1Top   := array.get(rHi, bestR)
        srR1Bot   := array.get(rLo, bestR)
        srR1Start := array.get(rStartB, bestR)
    else
        srR1Top   := na
        srR1Bot   := na
        srR1Start := na
    if secondR >= 0 and SR_ZONE_MAX_ZONES >= 2
        srR2Top   := array.get(rHi, secondR)
        srR2Bot   := array.get(rLo, secondR)
        srR2Start := array.get(rStartB, secondR)
    else
        srR2Top   := na
        srR2Bot   := na
        srR2Start := na

if USE_SR_ZONES and array.size(srPlPrices) >= 1
    sLo      = array.new_float(20, na)
    sHi      = array.new_float(20, na)
    sStartB  = array.new_int(20, 2147483647)
    sTouches = array.new_int(20, 0)
    numS     = 0
    lb       = math.max(0, bar_index - SR_ZONE_LOOKBACK)
    for i = 0 to array.size(srPlPrices) - 1
        bi = array.get(srPlBars, i)
        if bi >= lb
            p = array.get(srPlPrices, i)
            found = false
            for j = 0 to numS - 1
                zl = array.get(sLo, j) - srZoneWidth
                zh = array.get(sHi, j) + srZoneWidth
                if p >= zl and p <= zh
                    array.set(sLo, j, math.min(array.get(sLo, j), p - srZoneWidth * 0.5))
                    array.set(sHi, j, math.max(array.get(sHi, j), p + srZoneWidth * 0.5))
                    array.set(sStartB, j, math.min(array.get(sStartB, j), bi))
                    found := true
                    break
            if not found and numS < 20
                array.set(sLo, numS, p - srZoneWidth * 0.5)
                array.set(sHi, numS, p + srZoneWidth * 0.5)
                array.set(sStartB, numS, bi)
                numS += 1
    for j = 0 to numS - 1
        tc = 0
        for k = 1 to math.min(SR_ZONE_LOOKBACK, bar_index)
            if high[k] >= array.get(sLo, j) and low[k] <= array.get(sHi, j)
                tc += 1
        array.set(sTouches, j, tc)
    bestS = -1
    bestSt = 0
    for j = 0 to numS - 1
        if array.get(sTouches, j) >= SR_ZONE_MIN_TOUCHES and array.get(sTouches, j) > bestSt
            bestSt := array.get(sTouches, j)
            bestS := j
    secondS = -1
    secondSt = 0
    for j = 0 to numS - 1
        if j != bestS and array.get(sTouches, j) >= SR_ZONE_MIN_TOUCHES and array.get(sTouches, j) > secondSt
            secondSt := array.get(sTouches, j)
            secondS := j
    if bestS >= 0
        srS1Top   := array.get(sHi, bestS)
        srS1Bot   := array.get(sLo, bestS)
        srS1Start := array.get(sStartB, bestS)
    else
        srS1Top   := na
        srS1Bot   := na
        srS1Start := na
    if secondS >= 0 and SR_ZONE_MAX_ZONES >= 2
        srS2Top   := array.get(sHi, secondS)
        srS2Bot   := array.get(sLo, secondS)
        srS2Start := array.get(sStartB, secondS)
    else
        srS2Top   := na
        srS2Bot   := na
        srS2Start := na

srR1Broken = USE_SR_ZONES and not na(srR1Top) and close > srR1Top + srBreakMarg
srR2Broken = USE_SR_ZONES and not na(srR2Top) and close > srR2Top + srBreakMarg
srS1Broken = USE_SR_ZONES and not na(srS1Bot) and close < srS1Bot - srBreakMarg
srS2Broken = USE_SR_ZONES and not na(srS2Bot) and close < srS2Bot - srBreakMarg

// --- Vortex, Elder Impulse, VW-RSI, Twiggs ---
[viPlus, viMinus, vortexBullish, vortexBearish, elderEma, elderEmaRising, elderImpulseBull, elderImpulseBear, vwPrice, vwRsiValue, vwRsiBullish, vwRsiBearish, twiggsValue, twiggsBullish, twiggsBearish] = f_calcVortexElderVWRsiTwiggs(macdHist)

// ==================================================================================
// BUY/SELL SIGNAL ENGINE
// ==================================================================================

stochCrossUp = ta.crossover(stochKVal, stochDVal)
stochCrossDown = ta.crossunder(stochKVal, stochDVal)
macdHistTurningUp = macdHist[1] > macdHist[2] and macdHist[2] < 0
macdHistTurningDown = macdHist[1] < macdHist[2] and macdHist[2] > 0
macdCrossUpFresh = macdCrossUp[1] ? 2.0 : macdCrossUp[2] ? 1.2 : macdCrossUp[3] ? 0.5 : 0.0
macdCrossDownFresh = macdCrossDown[1] ? 2.0 : macdCrossDown[2] ? 1.2 : macdCrossDown[3] ? 0.5 : 0.0
rsiCrossUpFresh = rsiOversoldCross[1] ? 2.0 : rsiOversoldCross[2] ? 1.2 : rsiOversoldCross[3] ? 0.5 : 0.0
rsiCrossDownFresh = rsiOverboughtCross[1] ? 2.0 : rsiOverboughtCross[2] ? 1.2 : rsiOverboughtCross[3] ? 0.5 : 0.0
stochCrossUpFresh = stochCrossUp[1] ? 1.5 : stochCrossUp[2] ? 0.9 : stochCrossUp[3] ? 0.4 : 0.0
stochCrossDownFresh = stochCrossDown[1] ? 1.5 : stochCrossDown[2] ? 0.9 : stochCrossDown[3] ? 0.4 : 0.0
rsiVelocity = rsiValue - rsiValue[3]
rsiAccelBuy = rsiPrev < 40 and rsiVelocity > 8
rsiAccelSell = rsiPrev > 60 and rsiVelocity < -8

lagEnabledCount = 8 + (USE_MA_STACK ? 1 : 0) + (USE_SUPER_TREND ? 1 : 0) + (USE_SAR ? 1 : 0) + (USE_ICHIMOKU ? 1 : 0) + 1 + 1 + (USE_GMMA ? 1 : 0) + 1 + (USE_ROC ? 1 : 0)
lagBuyCount = (trendUp ? 1 : 0) + (USE_MA_STACK and maStackUp ? 1 : 0) + (USE_SUPER_TREND and stBullish ? 1 : 0) + (USE_SAR and sarBullish ? 1 : 0) + (USE_ICHIMOKU and ichBullish ? 1 : 0) + (aroonBullish ? 1 : 0) + (linRegBullish ? 1 : 0) + (donchianBullish ? 1 : 0) + (mcginleyBullish ? 1 : 0) + (alligatorBullish ? 1 : 0) + (vortexBullish ? 1 : 0) + (demaBullish ? 1 : 0) + (temaBullish ? 1 : 0) + (USE_GMMA and gmmaBullish ? 1 : 0) + (macdBullish ? 1 : 0) + (rsiBullish ? 1 : 0) + (USE_ROC and rocBullish ? 1 : 0)
lagSellCount = (trendDown ? 1 : 0) + (USE_MA_STACK and maStackDown ? 1 : 0) + (USE_SUPER_TREND and stBearish ? 1 : 0) + (USE_SAR and sarBearish ? 1 : 0) + (USE_ICHIMOKU and ichBearish ? 1 : 0) + (aroonBearish ? 1 : 0) + (linRegBearish ? 1 : 0) + (donchianBearish ? 1 : 0) + (mcginleyBearish ? 1 : 0) + (alligatorBearish ? 1 : 0) + (vortexBearish ? 1 : 0) + (demaBearish ? 1 : 0) + (temaBearish ? 1 : 0) + (USE_GMMA and gmmaBearish ? 1 : 0) + (macdBearish ? 1 : 0) + (rsiBearish ? 1 : 0) + (USE_ROC and rocBearish ? 1 : 0)

// --- Category Scores ---
[exhBuyScore, exhSellScore] = f_exhaustionScore(rsiPrev, stochKVal, mfiValue, wrValue, bbPercent, zScore, cciValue, schaffVal, uoValue, volClimaxBuy, extendedBearRun, massBulge, cmoValue, volClimaxSell, extendedBullRun)
[revBuyScore, revSellScore] = f_reversalScore(macdCrossUpFresh, rsiCrossUpFresh, stochCrossUpFresh, macdHistTurningUp, fisherBullish, trixBullish, kstBullish, sineBullish, coppockBullish, rviBullish, elderImpulseBull, dpoBullish, rsiAccelBuy, chandBullish, ttmFirBull, macdCrossDownFresh, rsiCrossDownFresh, stochCrossDownFresh, macdHistTurningDown, fisherBearish, trixBearish, kstBearish, sineBearish, coppockBearish, rviBearish, elderImpulseBear, dpoBearish, rsiAccelSell, chandBearish, ttmFirBear)
[structBuyScore, structSellScore] = f_structureScore(bullEngulfing, hammerBull, morningStar, piercingLine, tweezerBottom, threeWhiteSoldiers, doji, rsiPrev, bullHarami, bearEngulfing, shootingStar, eveningStar, darkCloudCover, tweezerTop, threeBlackCrows, bearHarami, pivotCrossUpR1, pivotCrossDownS1, donchianBreakoutUp, donchianBreakoutDown, nearSupport, wyckSpring, bullishDivergence, bosBull, chochBullish, sfpBull, liqSweepBuy, bullFVG, nearBullOB, wickRejectionBuy, bullDisplacement, nearPivotS1, nearResistance, wyckUpthrust, bearishDivergence, bosBear, chochBearish, sfpBear, liqSweepSell, bearFVG, nearBearOB, wickRejectionSell, bearDisplacement, nearPivotR1)
[volBuyScore, volSellScore] = f_volumeScore(volumeConfirm, volumeRising, pressureBullish, pressureBearish, obvBullish, cmfBullish, klingerBullish, twiggsBullish, iiiBullish, eomBullish, nviBullish, pviBullish, efiBullish, adLineBullish, obvBearish, cmfBearish, klingerBearish, twiggsBearish, iiiBearish, eomBearish, nviBearish, pviBearish, efiBearish, adLineBearish)
[trendAlignBuyScore, trendAlignSellScore] = f_trendAlignScore(mtfD, mtf240, mtf60, mtf15, mtf5, htfTrendUp, adxStrong, vwRsiBullish, vortexBullish, vwapBullish, mcginleyBullish, alligatorBullish, vwRsiBearish, vortexBearish, vwapBearish, mcginleyBearish, alligatorBearish)

// --- R² Context Weighting (per-category instead of global multiplier) ---
r2Trend = rSqValue > 0.7 ? 1.08 : rSqValue > 0.5 ? 1.0 : rSqValue > 0.3 ? 0.92 : 0.85
r2Reversal = rSqValue < 0.3 ? 1.10 : rSqValue < 0.5 ? 1.0 : rSqValue < 0.7 ? 0.95 : 0.90

// --- Composite (R² applied per-category: reversal cats boosted in choppy, trend cat boosted in trending) ---
rawBuyScore = (exhBuyScore * 0.30 * r2Reversal + revBuyScore * 0.25 * r2Reversal + structBuyScore * 0.20 + volBuyScore * 0.15 + trendAlignBuyScore * 0.10 * r2Trend) * 100.0
rawSellScore = (exhSellScore * 0.30 * r2Reversal + revSellScore * 0.25 * r2Reversal + structSellScore * 0.20 + volSellScore * 0.15 + trendAlignSellScore * 0.10 * r2Trend) * 100.0

// --- Meta-Modifiers ---
[rSqMult, zScoreBuyMult, zScoreSellMult, volSpikeMult, adxReversalMult, exhaustionBoostBuy, exhaustionPenaltyBuy, exhaustionBoostSell, exhaustionPenaltySell, agreeMult, agreeMsell, sessionMult, buyCatAgreeStrong, buyCatAgree, sellCatAgreeStrong, sellCatAgree] = f_metaMultipliers(exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, zScore, hvRank, adxValue, adxStrong, lagSellCount, lagEnabledCount, lagBuyCount, USE_SESSION_FILTER, inSession)

// --- Bonuses ---
divBonusBuy = bullishDivergence ? 8.0 : 0.0
divBonusSell = bearishDivergence ? 8.0 : 0.0
wyckBonusBuy = wyckSpring ? 8.0 : 0.0
wyckBonusSell = wyckUpthrust ? 8.0 : 0.0
chochBonusBuy = chochBullish ? 5.0 : 0.0
chochBonusSell = chochBearish ? 5.0 : 0.0

// --- MTF divergence ---
mtfDivAlignedBuy = bullishDivergence and htfRsiForDiv > htfRsiForDivPrev
mtfDivAlignedSell = bearishDivergence and htfRsiForDiv < htfRsiForDivPrev
mtfDivMultBuy = mtfDivAlignedBuy ? 1.20 : 1.0
mtfDivMultSell = mtfDivAlignedSell ? 1.20 : 1.0

// --- Premium/Discount ---
pdPenaltyBuy = inPremium ? 0.82 : 1.0
pdPenaltySell = inDiscount ? 0.82 : 1.0

// --- Body Quality ---
signalBodyPct = math.abs(close - open) / math.max(high - low, 1e-10)
bodyMult = signalBodyPct > 0.6 ? 1.08 : signalBodyPct < 0.25 ? 0.85 : 1.0

// ADX direction flags (for tooltip access)
adxFalling = adxValue[1] < adxValue[4]
adxRisingStrong = adxValue[1] > adxValue[4] and adxStrong

// --- Final Score ---
multProductBuy = zScoreBuyMult * exhaustionBoostBuy * exhaustionPenaltyBuy * agreeMult * sessionMult * volSpikeMult * pdPenaltyBuy * mtfDivMultBuy * bodyMult * adxReversalMult
multProductSell = zScoreSellMult * exhaustionBoostSell * exhaustionPenaltySell * agreeMsell * sessionMult * volSpikeMult * pdPenaltySell * mtfDivMultSell * bodyMult * adxReversalMult
finalBuyScore = math.min((rawBuyScore + divBonusBuy + wyckBonusBuy + chochBonusBuy) * math.min(multProductBuy, 1.80), 100.0)
finalSellScore = math.min((rawSellScore + divBonusSell + wyckBonusSell + chochBonusSell) * math.min(multProductSell, 1.80), 100.0)

// --- Signal Generation ---
var int barsSinceLastBuy = 999
var int barsSinceLastSell = 999
barsSinceLastBuy := barsSinceLastBuy + 1
barsSinceLastSell := barsSinceLastSell + 1

buyConfidence = finalBuyScore >= 80 ? "High" : finalBuyScore >= 65 ? "Medium" : "Low"
sellConfidence = finalSellScore >= 80 ? "High" : finalSellScore >= 65 ? "Medium" : "Low"

// --- Opposing Signal Suppression ---
buyDominance = finalBuyScore - finalSellScore
sellDominance = finalSellScore - finalBuyScore
dominanceRatioBuy = finalBuyScore / math.max(finalSellScore, 1.0)
dominanceRatioSell = finalSellScore / math.max(finalBuyScore, 1.0)
signalBarBullish = close > open and signalBodyPct > 0.15
signalBarBearish = close < open and signalBodyPct > 0.15
signalBarInside = high <= high[1] and low >= low[1]

// --- Hard Exhaustion Gate ---
signalBuy = USE_BUY_SELL_SIGNAL and barstate.isconfirmed and finalBuyScore >= BUY_SELL_THRESHOLD and barsSinceLastBuy >= BUY_SELL_COOLDOWN and dominanceRatioBuy >= 1.25 and buyDominance >= 8.0 and signalBarBullish and not signalBarInside and exhBuyScore > 0.25 and structBuyScore > 0.20
signalSell = USE_BUY_SELL_SIGNAL and barstate.isconfirmed and finalSellScore >= BUY_SELL_THRESHOLD and barsSinceLastSell >= BUY_SELL_COOLDOWN and dominanceRatioSell >= 1.25 and sellDominance >= 8.0 and signalBarBearish and not signalBarInside and exhSellScore > 0.25 and structSellScore > 0.20

if signalBuy
    barsSinceLastBuy := 0
if signalSell
    barsSinceLastSell := 0

rsiSparkline = f_sparkline(rsiValue, 8)

// --- Active signal tracking for dashboard ---
var float activeRR = 0.0
var string activeSLType = "-"
var float activeTP = na
var float activeSL = na

if USE_DASHBOARD and isRightVisibleBar
    var table dash = table.new(position.top_right, 5, 61, border_width=0, frame_width=0)
    txtSm = size.tiny

    // --- Table Section 1: BUY/SELL SIGNAL ---
    if USE_BUY_SELL_SIGNAL
        table.cell(dash, 0, 49, " BUY/SELL SIGNAL", bgcolor=color.new(POSITIVE_COLOR, 30), text_color=TEXT_COLOR, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
        table.cell(dash, 1, 49, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 2, 49, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 3, 49, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.cell(dash, 4, 49, "", bgcolor=color.new(POSITIVE_COLOR, 75))
        table.merge_cells(dash, 0, 49, 4, 49)

        buyScoreBg = finalBuyScore >= 80 ? color.new(POSITIVE_COLOR, 30) : finalBuyScore >= 65 ? color.new(color.new(POSITIVE_COLOR, 45), 40) : color.new(NEUTRAL_COLOR, 50)
        sellScoreBg = finalSellScore >= 80 ? color.new(NEGATIVE_COLOR, 30) : finalSellScore >= 65 ? color.new(color.new(NEGATIVE_COLOR, 45), 40) : color.new(NEUTRAL_COLOR, 50)

        table.cell(dash, 0, 50, "Buy Score", bgcolor=f_rowBg(50), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 1, 50, str.tostring(finalBuyScore, "#.#") + "/100", bgcolor=buyScoreBg, text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 2, 50, "Sell Score", bgcolor=f_rowBg(50), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 3, 50, str.tostring(finalSellScore, "#.#") + "/100", bgcolor=sellScoreBg, text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 4, 50, buyCatAgree > sellCatAgree ? "BUY" : sellCatAgree > buyCatAgree ? "SELL" : "-", bgcolor=buyCatAgree > sellCatAgree ? color.new(POSITIVE_COLOR, 40) : sellCatAgree > buyCatAgree ? color.new(NEGATIVE_COLOR, 40) : color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)

        table.cell(dash, 0, 51, "Cats Agree", bgcolor=f_rowBg(51), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 1, 51, str.tostring(buyCatAgree) + "/5 Buy", bgcolor=f_condColor(buyCatAgree >= 4), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 2, 51, "", bgcolor=f_rowBg(51), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 3, 51, str.tostring(sellCatAgree) + "/5 Sell", bgcolor=f_condColor(sellCatAgree >= 4), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 4, 51, str.tostring(barsSinceLastBuy) + "/" + str.tostring(barsSinceLastSell) + " ago", bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)

    // --- Table Section 2: TREND ---
    table.cell(dash, 0, 2, " TREND", bgcolor=color.new(color.rgb(156, 107, 255), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 2, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 2, 2, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 3, 2, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.cell(dash, 4, 2, "", bgcolor=color.new(color.rgb(156, 107, 255), 75))
    table.merge_cells(dash, 0, 2, 4, 2)

    table.cell(dash, 0, 3, "Hull MA", bgcolor=f_rowBg(3), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 3, hullTrend ? "Rising" : "Falling", bgcolor=f_condColor(hullTrend), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 3, "SuperTrnd", bgcolor=f_rowBg(3), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 3, stBullish ? "Above" : "Below", bgcolor=f_condColor(stBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 3, f_condSym(hullTrend and stBullish), bgcolor=f_condColor(hullTrend and stBullish), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 4, "ADX", bgcolor=f_rowBg(4), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 4, str.tostring(adxValue[1], "#.#") + ">" + str.tostring(ADX_THRESHOLD, "#"), bgcolor=f_condColor(adxStrong), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 4, "SAR", bgcolor=f_rowBg(4), text_color=TEXT_COLOR, text_size=txtSm)
