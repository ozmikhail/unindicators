    table.cell(dash, 4, 35, f_condSym(chandBullish and atrInRange), bgcolor=f_condColor(chandBullish and atrInRange), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 36, "Mass Idx", bgcolor=f_rowBg(36), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 36, str.tostring(massValue[1], "#.#") + (massBulge ? " Bulge" : ""), bgcolor=massBulge ? color.new(WARNING_COLOR, 50) : f_condColor(true), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 36, "BB", bgcolor=f_rowBg(36), text_color=TEXT_COLOR, text_size=txtSm)
