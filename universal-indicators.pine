    table.cell(dash, 4, 40, f_condSym(not hvHigh), bgcolor=f_condColor(not hvHigh), text_color=TEXT_COLOR, text_size=txtSm)

    // --- Table Section 7: META-MODIFIERS ---
    table.cell(dash, 0, 41, " META-MODIFIERS", bgcolor=color.new(color.rgb(120, 123, 134), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 41, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 2, 41, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 3, 41, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.cell(dash, 4, 41, "", bgcolor=color.new(color.rgb(120, 123, 134), 75))
    table.merge_cells(dash, 0, 41, 4, 41)

    table.cell(dash, 0, 42, "R²", bgcolor=f_rowBg(42), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 42, str.tostring(rSqValue, "#.##") + (rSqValue > 0.5 ? " Trend" : " Chop"), bgcolor=rSqValue > 0.5 ? color.new(color.new(POSITIVE_COLOR, 45), 50) : color.new(WARNING_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 42, "Z-Score", bgcolor=f_rowBg(42), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 42, str.tostring(zScore[1], "#.#"), bgcolor=math.abs(zScore[1]) > 2 ? color.new(WARNING_COLOR, 40) : f_condColor(true), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 42, "", bgcolor=f_rowBg(42))

    table.cell(dash, 0, 43, "Cycle", bgcolor=f_rowBg(43), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 43, str.tostring(dominantPeriod, "#") + " bars", bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 43, "Regime", bgcolor=f_rowBg(43), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 43, adxStrong ? (trendUp ? "Uptrend" : trendDown ? "Downtrend" : "Trend") : "Ranging", bgcolor=trendUp and adxStrong ? color.new(POSITIVE_COLOR, 50) : trendDown and adxStrong ? color.new(NEGATIVE_COLOR, 50) : color.new(WARNING_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 43, "", bgcolor=f_rowBg(43))

    // --- Table Section 8: RISK ---
    table.cell(dash, 0, 44, " RISK MANAGEMENT", bgcolor=color.new(color.rgb(234, 57, 67), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 44, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 2, 44, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 3, 44, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.cell(dash, 4, 44, "", bgcolor=color.new(color.rgb(234, 57, 67), 75))
    table.merge_cells(dash, 0, 44, 4, 44)

    table.cell(dash, 0, 45, "ATR", bgcolor=f_rowBg(45), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 45, str.tostring(atrPrev, "#.##"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 45, "SL Dist", bgcolor=f_rowBg(45), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 45, not na(activeSL) ? str.tostring(math.abs(close - activeSL), "#.##") + " (" + activeSLType + ")" : str.tostring(atrPrev * ATR_MULTIPLIER_SL, "#.##") + " (" + str.tostring(ATR_MULTIPLIER_SL, "#.#") + "x)", bgcolor=color.new(color.new(NEGATIVE_COLOR, 45), 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 45, "", bgcolor=f_rowBg(45))

    table.cell(dash, 0, 46, "TP Dist", bgcolor=f_rowBg(46), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 46, not na(activeTP) ? str.tostring(math.abs(activeTP - close), "#.##") : str.tostring(atrPrev * ATR_MULTIPLIER_TP, "#.##") + " (" + str.tostring(ATR_MULTIPLIER_TP, "#.#") + "x)", bgcolor=color.new(color.new(POSITIVE_COLOR, 45), 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 46, "R:R", bgcolor=f_rowBg(46), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 46, activeRR > 0 ? "1:" + str.tostring(activeRR, "#.#") : "1:" + str.tostring(BUY_SELL_RR, "#.#"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 46, "", bgcolor=f_rowBg(46))

    // --- Table Section 9: MTF HEATMAP ---
    if USE_MTF_HEATMAP
        table.cell(dash, 0, 47, " MTF HEATMAP", bgcolor=color.new(color.rgb(255, 215, 0), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
        table.cell(dash, 1, 47, "", bgcolor=color.new(color.rgb(255, 215, 0), 75))
        table.cell(dash, 2, 47, "", bgcolor=color.new(color.rgb(255, 215, 0), 75))
        table.cell(dash, 3, 47, "", bgcolor=color.new(color.rgb(255, 215, 0), 75))
        table.cell(dash, 4, 47, "", bgcolor=color.new(color.rgb(255, 215, 0), 75))
        table.merge_cells(dash, 0, 47, 4, 47)

        table.cell(dash, 0, 48, "M5", bgcolor=mtf5 ? color.new(POSITIVE_COLOR, 40) : color.new(NEGATIVE_COLOR, 40), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 1, 48, "M15", bgcolor=mtf15 ? color.new(POSITIVE_COLOR, 40) : color.new(NEGATIVE_COLOR, 40), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 2, 48, "H1", bgcolor=mtf60 ? color.new(POSITIVE_COLOR, 40) : color.new(NEGATIVE_COLOR, 40), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 3, 48, "H4", bgcolor=mtf240 ? color.new(POSITIVE_COLOR, 40) : color.new(NEGATIVE_COLOR, 40), text_color=TEXT_COLOR, text_size=txtSm)
        table.cell(dash, 4, 48, "D", bgcolor=mtfD ? color.new(POSITIVE_COLOR, 40) : color.new(NEGATIVE_COLOR, 40), text_color=TEXT_COLOR, text_size=txtSm)

    // --- Table Section 10: LEVELS ---
    table.cell(dash, 0, 53, " LEVELS", bgcolor=color.new(color.rgb(255, 167, 38), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
    table.cell(dash, 1, 53, "", bgcolor=color.new(color.rgb(255, 167, 38), 75))
    table.cell(dash, 2, 53, "", bgcolor=color.new(color.rgb(255, 167, 38), 75))
    table.cell(dash, 3, 53, "", bgcolor=color.new(color.rgb(255, 167, 38), 75))
    table.cell(dash, 4, 53, "", bgcolor=color.new(color.rgb(255, 167, 38), 75))
    table.merge_cells(dash, 0, 53, 4, 53)
    table.cell(dash, 0, 54, "Pivot P", bgcolor=f_rowBg(54), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 54, str.tostring(pivotP[1], "#.##"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 54, "R1/S1", bgcolor=f_rowBg(54), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 54, USE_PIVOTS ? str.tostring(pivotR1, "#.#") + "/" + str.tostring(pivotS1, "#.#") : "-", bgcolor=nearPivotR1 ? color.new(color.new(NEGATIVE_COLOR, 45), 50) : nearPivotS1 ? color.new(color.new(POSITIVE_COLOR, 45), 50) : color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 54, "", bgcolor=f_rowBg(54))
    table.cell(dash, 0, 55, "Fib 0.5", bgcolor=f_rowBg(55), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 55, str.tostring(fib50[1], "#.##"), bgcolor=color.new(NEUTRAL_COLOR, 50), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 55, "Gap", bgcolor=f_rowBg(55), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 55, gapUp ? "Up" : gapDown ? "Dn" : "None", bgcolor=f_condColor3(gapUp, gapDown), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 55, "", bgcolor=f_rowBg(55))


// --- SL-specific Swing detection (wider lookback for more significant structural levels) ---
slSwingHigh = ta.pivothigh(high, SL_SWING_LOOKBACK, SL_SWING_LOOKBACK)
slSwingLow = ta.pivotlow(low, SL_SWING_LOOKBACK, SL_SWING_LOOKBACK)
slLastSwingHigh = ta.valuewhen(not na(slSwingHigh), slSwingHigh, 0)
slLastSwingLow = ta.valuewhen(not na(slSwingLow), slSwingLow, 0)
slSwingAgeBuy = bar_index - ta.valuewhen(not na(slSwingLow), bar_index, 0)
slSwingAgeSell = bar_index - ta.valuewhen(not na(slSwingHigh), bar_index, 0)
slLastSwingLow2 = ta.valuewhen(not na(slSwingLow), slSwingLow, 1)
slSwingAgeBuy2 = bar_index - ta.valuewhen(not na(slSwingLow), bar_index, 1)
slLastSwingHigh2 = ta.valuewhen(not na(slSwingHigh), slSwingHigh, 1)
slSwingAgeSell2 = bar_index - ta.valuewhen(not na(slSwingHigh), bar_index, 1)

// --- SL/TP calculation ---
atrSLDist = atrPrev * ATR_MULTIPLIER_SL

// --- Primary Swing: recent (≤30 bars), reasonable distance (0.5-4.5 ATR) ---
structDistBuy = close - slLastSwingLow
structSLBuyOk = not na(slLastSwingLow) and slLastSwingLow > 0 and slSwingAgeBuy <= 30 and structDistBuy >= atrPrev * 0.5 and structDistBuy <= atrPrev * 4.5

// --- Secondary Swing: older occurrence (≤50 bars, same distance range) ---
structDistBuy2 = close - slLastSwingLow2
structSLBuyOk2 = not na(slLastSwingLow2) and slLastSwingLow2 > 0 and slSwingAgeBuy2 <= 50 and structDistBuy2 >= atrPrev * 0.5 and structDistBuy2 <= atrPrev * 4.5

structDistSell = slLastSwingHigh - close
structSLSellOk = not na(slLastSwingHigh) and slLastSwingHigh > 0 and slSwingAgeSell <= 30 and structDistSell >= atrPrev * 0.5 and structDistSell <= atrPrev * 4.5

structDistSell2 = slLastSwingHigh2 - close
structSLSellOk2 = not na(slLastSwingHigh2) and slLastSwingHigh2 > 0 and slSwingAgeSell2 <= 50 and structDistSell2 >= atrPrev * 0.5 and structDistSell2 <= atrPrev * 4.5

slBufferBuy = finalBuyScore >= 80 ? 0.30 : finalBuyScore >= 65 ? 0.40 : 0.50
slBufferSell = finalSellScore >= 80 ? 0.30 : finalSellScore >= 65 ? 0.40 : 0.50
buySL = structSLBuyOk ? (slLastSwingLow - atrPrev * slBufferBuy) : structSLBuyOk2 ? (slLastSwingLow2 - atrPrev * slBufferBuy) : (close - atrSLDist)
sellSL = structSLSellOk ? (slLastSwingHigh + atrPrev * slBufferSell) : structSLSellOk2 ? (slLastSwingHigh2 + atrPrev * slBufferSell) : (close + atrSLDist)

// --- Floor (min): 1.0 ---
buySL := math.min(buySL, close - atrPrev * 1.0)
sellSL := math.max(sellSL, close + atrPrev * 1.0)

fixedBuyTP = close + (close - buySL) * BUY_SELL_RR
fixedSellTP = close - (sellSL - close) * BUY_SELL_RR

// --- Precompute Entry Zone Bounds for TP ---
entryZoneMultPre = finalBuyScore >= 80 ? 0.5 : finalBuyScore >= 65 ? 0.7 : 0.9
buyZoneHighPre = math.min(open, close) + atrPrev * entryZoneMultPre
sellZoneLowPre = math.max(open, close) - atrPrev * (finalSellScore >= 80 ? 0.5 : finalSellScore >= 65 ? 0.7 : 0.9)

// --- Nearest Structural Target Above BUY ---
buyRisk = close - buySL
nearBuyTarget = fixedBuyTP
buyTPSource = "R:R"
if lastSwingHigh > close + atrPrev * 0.15 and (lastSwingHigh - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, lastSwingHigh)
    if nearBuyTarget == lastSwingHigh
        buyTPSource := "S/R"
if USE_PIVOTS and pivotR1 > close + atrPrev * 0.15 and (pivotR1 - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, pivotR1)
    if nearBuyTarget == pivotR1
        buyTPSource := "R1"
if not na(lastBearOBHigh) and lastBearOBHigh > close + atrPrev * 0.15 and (lastBearOBHigh - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, lastBearOBHigh)
    if nearBuyTarget == lastBearOBHigh
        buyTPSource := "OB"
if fib382 > close + atrPrev * 0.15 and fib382 < close + atrPrev * 6 and (fib382 - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, fib382)
    if nearBuyTarget == fib382
        buyTPSource := "Fib38"
if fib618 > close + atrPrev * 0.15 and fib618 < close + atrPrev * 6 and (fib618 - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, fib618)
    if nearBuyTarget == fib618
        buyTPSource := "Fib62"
if vwapValue > close + atrPrev * 0.15 and (vwapValue - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, vwapValue)
    if nearBuyTarget == vwapValue
        buyTPSource := "VWAP"
if bbUpper > close + atrPrev * 0.15 and (bbUpper - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, bbUpper)
    if nearBuyTarget == bbUpper
        buyTPSource := "BB"
if ema200 > close + atrPrev * 0.15 and (ema200 - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, ema200)
    if nearBuyTarget == ema200
        buyTPSource := "EMA200"
if not na(prevDayHigh) and prevDayHigh > close + atrPrev * 0.15 and (prevDayHigh - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, prevDayHigh)
    if nearBuyTarget == prevDayHigh
        buyTPSource := "PDH"
if USE_PIVOTS and pivotR2 > close + atrPrev * 0.15 and (pivotR2 - close) / buyRisk >= 1.2
    nearBuyTarget := math.min(nearBuyTarget, pivotR2)
    if nearBuyTarget == pivotR2
        buyTPSource := "R2"
trendExtendBuy = trendUp and adxStrong and trendAlignBuyScore > 0.5
buyTP = (trendExtendBuy and nearBuyTarget < fixedBuyTP) ? fixedBuyTP : nearBuyTarget
if trendExtendBuy and nearBuyTarget < fixedBuyTP
    buyTPSource := "R:R"
buyTP := math.max(buyTP, buyZoneHighPre + atrPrev * 0.2)
buyTP := math.min(buyTP, close + atrPrev * ATR_MULTIPLIER_TP)
buyActualRR = buyRisk > 0 ? (buyTP - close) / buyRisk : BUY_SELL_RR

// --- Nearest Structural Target Below BUY ---
sellRisk = sellSL - close
nearSellTarget = fixedSellTP
sellTPSource = "R:R"
if lastSwingLow < close - atrPrev * 0.15 and (close - lastSwingLow) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, lastSwingLow)
    if nearSellTarget == lastSwingLow
        sellTPSource := "S/R"
if USE_PIVOTS and pivotS1 < close - atrPrev * 0.15 and (close - pivotS1) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, pivotS1)
    if nearSellTarget == pivotS1
        sellTPSource := "S1"
if not na(lastBullOBLow) and lastBullOBLow < close - atrPrev * 0.15 and (close - lastBullOBLow) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, lastBullOBLow)
    if nearSellTarget == lastBullOBLow
        sellTPSource := "OB"
if fib618 < close - atrPrev * 0.15 and fib618 > close - atrPrev * 6 and (close - fib618) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, fib618)
    if nearSellTarget == fib618
        sellTPSource := "Fib62"
if fib382 < close - atrPrev * 0.15 and fib382 > close - atrPrev * 6 and (close - fib382) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, fib382)
    if nearSellTarget == fib382
        sellTPSource := "Fib38"
if vwapValue < close - atrPrev * 0.15 and (close - vwapValue) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, vwapValue)
    if nearSellTarget == vwapValue
        sellTPSource := "VWAP"
if bbLower < close - atrPrev * 0.15 and (close - bbLower) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, bbLower)
    if nearSellTarget == bbLower
        sellTPSource := "BB"
if ema200 < close - atrPrev * 0.15 and (close - ema200) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, ema200)
    if nearSellTarget == ema200
        sellTPSource := "EMA200"
if not na(prevDayLow) and prevDayLow < close - atrPrev * 0.15 and (close - prevDayLow) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, prevDayLow)
    if nearSellTarget == prevDayLow
        sellTPSource := "PDL"
if USE_PIVOTS and pivotS2 < close - atrPrev * 0.15 and (close - pivotS2) / sellRisk >= 1.2
    nearSellTarget := math.max(nearSellTarget, pivotS2)
    if nearSellTarget == pivotS2
        sellTPSource := "S2"
trendExtendSell = trendDown and adxStrong and trendAlignSellScore > 0.5
sellTP = (trendExtendSell and nearSellTarget > fixedSellTP) ? fixedSellTP : nearSellTarget
if trendExtendSell and nearSellTarget > fixedSellTP
    sellTPSource := "R:R"
sellTP := math.min(sellTP, sellZoneLowPre - atrPrev * 0.2)
sellTP := math.max(sellTP, close - atrPrev * ATR_MULTIPLIER_TP)
sellActualRR = sellRisk > 0 ? (close - sellTP) / sellRisk : BUY_SELL_RR

// --- Split TP When >8%: Half-% (TP1) and Full (TP2) ---
buyTPPct = (buyTP - close) / close * 100
sellTPPct = (close - sellTP) / close * 100
USE_TWO_T_PS_BUY = buyTPPct > 8.0
USE_TWO_T_PS_SELL = sellTPPct > 8.0
buyTP1 = USE_TWO_T_PS_BUY ? close + (buyTP - close) * 0.5 : buyTP
buyTP2 = buyTP
sellTP1 = USE_TWO_T_PS_SELL ? close - (close - sellTP) * 0.5 : sellTP
sellTP2 = sellTP

// ==================================================================================
// VISUALIZATION
// ==================================================================================

// --- Combined Background (Trend/TTM Squeeze/Elder) ---
bgColor = USE_BACKGROUND ? (trendUp and adxStrong ? color.new(POSITIVE_COLOR, 95) : trendDown and adxStrong ? color.new(NEGATIVE_COLOR, 95) : na) : na
squeezeBg = USE_TTM_SQUEEZE and ttmSqueezeOn ? color.new(WARNING_COLOR, 95) : na
elderBgColor = elderImpulseBull ? color.new(POSITIVE_COLOR, 91) : elderImpulseBear ? color.new(NEGATIVE_COLOR, 91) : color.new(NEUTRAL_COLOR, 96)
combinedBg = not na(squeezeBg) ? squeezeBg : not na(bgColor) ? bgColor : USE_BACKGROUND ? elderBgColor : na
bgcolor(combinedBg, title="Trend/Squeeze/Elder Background")

// --- Ichimoku Cloud ---
ichSpanAPlot = plot(USE_ICHIMOKU ? ichSpanA : na, "Ichimoku Span A", color=color.new(color.new(POSITIVE_COLOR, 45), 82), offset=ICH_BASE, display=display.all)
ichSpanBPlot = plot(USE_ICHIMOKU ? ichSpanB : na, "Ichimoku Span B", color=color.new(color.new(NEGATIVE_COLOR, 45), 82), offset=ICH_BASE, display=display.all)
fill(ichSpanAPlot, ichSpanBPlot, color=color.new(POSITIVE_COLOR, 90), title="Ichimoku Cloud")

// --- Bollinger Bands ---
bbRelevant = USE_BB and (bbSqueeze or bbPercent < 0.1 or bbPercent > 0.9 or true)
bbUpperPlot = plot(bbRelevant ? bbUpper : na, "BB Upper", color=color.new(ACCENT_COLOR, 82), linewidth=1)
bbLowerPlot = plot(bbRelevant ? bbLower : na, "BB Lower", color=color.new(ACCENT_COLOR, 82), linewidth=1)
plot(bbRelevant ? bbBasis : na, "BB Basis", color=color.new(ACCENT_COLOR, 65), linewidth=1)
fill(bbUpperPlot, bbLowerPlot, color=color.new(ACCENT_COLOR, 93), title="BB Fill")

// --- Keltner Channels (only when relevant) ---
kcVisible = USE_KELTNER
plot(kcVisible ? kcUpper : na, "KC Upper", color=color.new(ACCENT_COLOR, 82), linewidth=1, style=plot.style_circles)
plot(kcVisible ? kcLower : na, "KC Lower", color=color.new(ACCENT_COLOR, 82), linewidth=1, style=plot.style_circles)

// --- FVG Boxes ---
var box lastBullFvg = na
var box lastBearFvg = na
if USE_FVG and bullFVG
    if not na(lastBullFvg)
        box.delete(lastBullFvg)
    lastBullFvg := box.new(bar_index - 2, low[2], bar_index + 6, high[0], border_color=color.new(POSITIVE_COLOR, 45), bgcolor=color.new(POSITIVE_COLOR, 88), border_width=1)
if USE_FVG and bearFVG
    if not na(lastBearFvg)
        box.delete(lastBearFvg)
    lastBearFvg := box.new(bar_index - 2, low[0], bar_index + 6, high[2], border_color=color.new(NEGATIVE_COLOR, 45), bgcolor=color.new(NEGATIVE_COLOR, 88), border_width=1)

// --- EMA Stack (display controlled by Display Indicators; filter by MA Alignment) ---
plot(USE_MA_STACK_LINES ? emaFast : na, "EMA 9", color=color.new(color.new(ACCENT_COLOR, 35), 35), linewidth=1)
plot(USE_MA_STACK_LINES ? emaSlow : na, "EMA 21", color=color.new(color.new(ACCENT_COLOR, 45), 45), linewidth=1)
plot(USE_MA_STACK_LINES ? emaSlower : na, "EMA 50", color=color.new(color.new(ACCENT_COLOR, 55), 55), linewidth=1)

// --- VWAP ---
plot(USE_VWAP_LINE ? vwapValue : na, "VWAP", color=color.new(ACCENT_COLOR, 25), linewidth=1, style=plot.style_line)

// --- Hull MA (fixed color to stay under 64 plot limit) ---
plot(USE_HULL_MA ? hullMA : na, "Hull MA", color=color.new(ACCENT_COLOR, 40), linewidth=2)

// --- SuperTrend line (fixed color to stay under 64 plot limit) ---
plot(USE_SUPER_TREND ? stValue : na, "SuperTrend", color=color.new(ACCENT_COLOR, 20), linewidth=2, style=plot.style_line)

// --- Parabolic SAR dots ---
plotshape(USE_SAR ? sarValue : na, "SAR", shape.cross, location.absolute, color=color.new(NEUTRAL_COLOR, 40), size=size.tiny)

// --- Primary tier: strongest patterns ---
if USE_PATTERN_MARKERS and bullEngulfing
    label.new(bar_index, low - atr * 0.25, "E", style=label.style_label_up, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Engulfing")
if USE_PATTERN_MARKERS and bearEngulfing
    label.new(bar_index, high + atr * 0.25, "E", style=label.style_label_down, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Engulfing")
if USE_PATTERN_MARKERS and morningStar
    label.new(bar_index, low - atr * 0.25, "MoS", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Morning Star")
if USE_PATTERN_MARKERS and eveningStar
    label.new(bar_index, high + atr * 0.25, "EvS", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Evening Star")
if USE_PATTERN_MARKERS and threeWhiteSoldiers
    label.new(bar_index, low - atr * 0.25, "3WS", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Three White Soldiers")
if USE_PATTERN_MARKERS and threeBlackCrows
    label.new(bar_index, high + atr * 0.25, "3BC", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 20), textcolor=color.white, size=size.tiny, tooltip="Three Black Crows")
// --- Secondary tier: reversal patterns ---
if USE_PATTERN_MARKERS and hammerBull
    label.new(bar_index, low - atr * 0.45, "H", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Hammer")
if USE_PATTERN_MARKERS and shootingStar
    label.new(bar_index, high + atr * 0.45, "S", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Shooting Star")
if USE_PATTERN_MARKERS and bullHarami
    label.new(bar_index, low - atr * 0.45, "Ha", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Bullish Harami")
if USE_PATTERN_MARKERS and bearHarami
    label.new(bar_index, high + atr * 0.45, "Ha", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Bearish Harami")
if USE_PATTERN_MARKERS and tweezerBottom
    label.new(bar_index, low - atr * 0.45, "TB", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Bottoms")
if USE_PATTERN_MARKERS and tweezerTop
    label.new(bar_index, high + atr * 0.45, "TT", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Tweezer Tops")
// --- Tertiary tier: minor patterns ---
if USE_PATTERN_MARKERS and doji
    label.new(bar_index, low - atr * 0.65, "Do", style=label.style_label_up, color=color.new(ACCENT_COLOR, 30), textcolor=color.white, size=size.tiny, tooltip="Doji")
if USE_PATTERN_MARKERS and piercingLine
    label.new(bar_index, low - atr * 0.65, "PL", style=label.style_label_up, color=color.new(color.new(POSITIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Piercing Line")
if USE_PATTERN_MARKERS and darkCloudCover
    label.new(bar_index, high + atr * 0.65, "DCC", style=label.style_label_down, color=color.new(color.new(NEGATIVE_COLOR, 45), 30), textcolor=color.white, size=size.tiny, tooltip="Dark Cloud Cover")

// --- Donchian Channel ---
var line donchianUpperLine = na
var line donchianLowerLine = na
var line donchianMidLine = na
if isRightVisibleBar
    line.delete(donchianUpperLine)
    line.delete(donchianLowerLine)
    line.delete(donchianMidLine)
    if USE_DONCHIAN
        donchianUpperLine := line.new(bar_index - 200, donchianUpper, bar_index + 20, donchianUpper, color=color.new(ACCENT_COLOR, 72), width=1)
        donchianLowerLine := line.new(bar_index - 200, donchianLower, bar_index + 20, donchianLower, color=color.new(ACCENT_COLOR, 72), width=1)
        donchianMidLine := line.new(bar_index - 200, donchianMid, bar_index + 20, donchianMid, color=color.new(ACCENT_COLOR, 80), width=1)
    else
        donchianUpperLine := na
        donchianLowerLine := na
        donchianMidLine := na

// --- McGinley Dynamic ---
plot(USE_MC_GINLEY ? mcginleyVal : na, "McGinley", color=color.new(ACCENT_COLOR, 50), linewidth=1)

// --- DEMA / TEMA — using line.new to save plot slots ---
if USE_MC_GINLEY and not na(demaVal[1])
    line.new(bar_index - 1, demaVal[1], bar_index, demaVal, color=color.new(WARNING_COLOR, 60), width=1)
if USE_MC_GINLEY and not na(temaVal[1])
    line.new(bar_index - 1, temaVal[1], bar_index, temaVal, color=color.new(WARNING_COLOR, 70), width=1)

// --- GMMA Bands (Short AVG and Long AVG) ---
plot(USE_GMMA ? gmmaShortAvg : na, "GMMA Short", color=color.new(color.new(POSITIVE_COLOR, 45), 70), linewidth=1)
plot(USE_GMMA ? gmmaLongAvg : na, "GMMA Long", color=color.new(color.new(NEGATIVE_COLOR, 45), 70), linewidth=1)

// --- Williams Alligator ---
plot(USE_ALLIGATOR ? alligatorJawPlot : na, "Alligator Jaw", color=color.new(ACCENT_COLOR, 45), linewidth=2)
plot(USE_ALLIGATOR ? alligatorTeethPlot : na, "Alligator Teeth", color=color.new(NEGATIVE_COLOR, 45), linewidth=2)
plot(USE_ALLIGATOR ? alligatorLipsPlot : na, "Alligator Lips", color=color.new(POSITIVE_COLOR, 45), linewidth=2)

// --- Pivot Lines (horizontal) — using line.new to save plot slots ---
var line pivotPLine  = na
var line pivotR1Line = na
var line pivotR2Line = na
var line pivotS1Line = na
var line pivotS2Line = na

if isRightVisibleBar and USE_PIVOTS
    line.delete(pivotPLine)
    line.delete(pivotR1Line)
    line.delete(pivotR2Line)
    line.delete(pivotS1Line)
    line.delete(pivotS2Line)
    pivotPLine  := line.new(bar_index - 200, pivotP,  bar_index + 20, pivotP,  color=color.new(NEUTRAL_COLOR, 50), width=1, style=line.style_dotted)
    pivotR1Line := line.new(bar_index - 200, pivotR1, bar_index + 20, pivotR1, color=color.new(NEGATIVE_COLOR, 65),  width=1, style=line.style_dotted)
    pivotR2Line := line.new(bar_index - 200, pivotR2, bar_index + 20, pivotR2, color=color.new(NEGATIVE_COLOR, 75),  width=1, style=line.style_dotted)
    pivotS1Line := line.new(bar_index - 200, pivotS1, bar_index + 20, pivotS1, color=color.new(POSITIVE_COLOR, 65),  width=1, style=line.style_dotted)
    pivotS2Line := line.new(bar_index - 200, pivotS2, bar_index + 20, pivotS2, color=color.new(POSITIVE_COLOR, 75),  width=1, style=line.style_dotted)

// --- Fibonacci Levels — using line.new to save plot slots ---
var line fib50Line  = na
var line fib382Line = na
var line fib618Line = na

if isRightVisibleBar and USE_FIB_LEVELS
    line.delete(fib50Line)
    line.delete(fib382Line)
    line.delete(fib618Line)
    fib50Line  := line.new(bar_index - 200, fib50,  bar_index + 20, fib50,  color=color.new(ACCENT_COLOR, 70), width=1, style=line.style_dotted)
    fib382Line := line.new(bar_index - 200, fib382, bar_index + 20, fib382, color=color.new(ACCENT_COLOR, 80), width=1, style=line.style_dotted)
    fib618Line := line.new(bar_index - 200, fib618, bar_index + 20, fib618, color=color.new(ACCENT_COLOR, 80), width=1, style=line.style_dotted)

// --- S/R lines ---
var line srR1Line = na
var line srR2Line = na
var line srS1Line = na
var line srS2Line = na
var label srR1Label = na
var label srR2Label = na
var label srS1Label = na
var label srS2Label = na
if isRightVisibleBar and USE_SR_ZONES
    line.delete(srR1Line)
    line.delete(srR2Line)
    line.delete(srS1Line)
    line.delete(srS2Line)
    label.delete(srR1Label)
    label.delete(srR2Label)
    label.delete(srS1Label)
    label.delete(srS2Label)
    srR1Line := na
    srR2Line := na
    srS1Line := na
    srS2Line := na
    srR1Label := na
    srR2Label := na
    srS1Label := na
    srS2Label := na
    rightExt = bar_index + 20
    if not na(srR1Start) and not na(srR1Top)
        srR1Line := line.new(srR1Start, srR1Top, rightExt, srR1Top, color=color.new(NEGATIVE_COLOR, 50), width=2, style=line.style_solid)
        srR1Label := label.new(rightExt, srR1Top, "RESISTANCE", style=label.style_label_up, color=color.new(NEGATIVE_COLOR, 30), textcolor=color.white, size=size.small)
    if not na(srR2Start) and not na(srR2Top)
        srR2Line := line.new(srR2Start, srR2Top, rightExt, srR2Top, color=color.new(NEGATIVE_COLOR, 55), width=2, style=line.style_solid)
        srR2Label := label.new(rightExt, srR2Top, "RESISTANCE 2", style=label.style_label_up, color=color.new(NEGATIVE_COLOR, 40), textcolor=color.white, size=size.small)
    if not na(srS1Start) and not na(srS1Bot)
        srS1Line := line.new(srS1Start, srS1Bot, rightExt, srS1Bot, color=color.new(POSITIVE_COLOR, 50), width=2, style=line.style_solid)
        srS1Label := label.new(rightExt, srS1Bot, "SUPPORT", style=label.style_label_up, color=color.new(POSITIVE_COLOR, 30), textcolor=color.white, size=size.small)
    if not na(srS2Start) and not na(srS2Bot)
        srS2Line := line.new(srS2Start, srS2Bot, rightExt, srS2Bot, color=color.new(POSITIVE_COLOR, 55), width=2, style=line.style_solid)
        srS2Label := label.new(rightExt, srS2Bot, "SUPPORT 2", style=label.style_label_up, color=color.new(POSITIVE_COLOR, 40), textcolor=color.white, size=size.small)

// --- Gap Labels ---
if gapValid and gapUp
    label.new(bar_index, low, "Gap Up", style=label.style_label_up, color=color.new(POSITIVE_COLOR, 30), textcolor=color.white, size=size.tiny)
if gapValid and gapDown
    label.new(bar_index, high, "Gap Dn", style=label.style_label_down, color=color.new(NEGATIVE_COLOR, 30), textcolor=color.white, size=size.tiny)

// --- Timeframe-adaptive line length and expiration ---
tfSeconds = timeframe.in_seconds(timeframe.period)
lineLen = tfSeconds >= 86400 ? 8 : tfSeconds >= 14400 ? 10 : tfSeconds >= 3600 ? 12 : 15
signalExpirationBars = tfSeconds >= 86400 ? 100 : tfSeconds >= 14400 ? 80 : tfSeconds >= 3600 ? 60 : tfSeconds >= 900 ? 40 : 30

// --- Signal tracking for expiration and TP/SL detection ---
var int buySignalBarIndex = na
var float buySignalTP = na
var float buySignalSL = na
var int buySignalRightExtent = na
var int sellSignalBarIndex = na
var float sellSignalTP = na
var float sellSignalSL = na
var int sellSignalRightExtent = na

// --- Signal Drawing Elements ---
var line buySLLine = na
var line buyTPLine = na
var label buySLLabel = na
var label buyTPLabel = na
var line buyTP2Line = na
var label buyTP2Label = na
var line sellSLLine = na
var line sellTPLine = na
var label sellSLLabel = na
var label sellTPLabel = na
var line sellTP2Line = na
var label sellTP2Label = na
var box buyRiskZone = na
var box buyRewardZone = na
var box buyRewardZone2 = na
var box sellRiskZone = na
var box sellRewardZone = na
var box sellRewardZone2 = na
var line buyEntryLine = na
var label buyEntryLabel = na
var box buyEntryZone = na
var line sellEntryLine = na
var label sellEntryLabel = na
var box sellEntryZone = na
var label buyZoneLabel = na
var label sellZoneLabel = na

// --- Signal Expiration and TP/SL Hit Detection ---
if BUY_SELL_AUTO_EXPIRE
    if not na(buySignalBarIndex)
        barsSinceBuySignal = bar_index - buySignalBarIndex
        priceHitBuyTP = not na(buySignalTP) and high >= buySignalTP
        priceHitBuySL = not na(buySignalSL) and low <= buySignalSL
        if priceHitBuyTP or priceHitBuySL or barsSinceBuySignal > signalExpirationBars
            f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
            buyEntryLine := na
            buyEntryLabel := na
            buyEntryZone := na
            buyZoneLabel := na
            buySLLine := na
            buyTPLine := na
            buySLLabel := na
            buyTPLabel := na
            buyRiskZone := na
            buyRewardZone := na
            buyTP2Line := na
            buyTP2Label := na
            buyRewardZone2 := na
            buySignalBarIndex := na
            buySignalTP := na
            buySignalSL := na
            buySignalRightExtent := na
        else
            buySignalRightExtent := math.max(nz(buySignalRightExtent), bar_index)
            extentBuy = na(rightVisibleBarIndex) ? nz(buySignalRightExtent) : math.min(nz(buySignalRightExtent), rightVisibleBarIndex)
            f_extendBuySignalDrawings(buySLLine, buyTPLine, buyEntryLine, buyRiskZone, buyRewardZone, buyEntryZone, buySLLabel, buyTPLabel, buyEntryLabel, not na(buyEntryZone), extentBuy, buyTP2Line, buyTP2Label, buyRewardZone2)
    if not na(sellSignalBarIndex)
        barsSinceSellSignal = bar_index - sellSignalBarIndex
        priceHitSellTP = not na(sellSignalTP) and low <= sellSignalTP
        priceHitSellSL = not na(sellSignalSL) and high >= sellSignalSL
        if priceHitSellTP or priceHitSellSL or barsSinceSellSignal > signalExpirationBars
            f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
            sellEntryLine := na
            sellEntryLabel := na
            sellEntryZone := na
            sellZoneLabel := na
            sellSLLine := na
            sellTPLine := na
            sellSLLabel := na
            sellTPLabel := na
            sellRiskZone := na
            sellRewardZone := na
            sellTP2Line := na
            sellTP2Label := na
            sellRewardZone2 := na
            sellSignalBarIndex := na
            sellSignalTP := na
            sellSignalSL := na
            sellSignalRightExtent := na
        else
            sellSignalRightExtent := math.max(nz(sellSignalRightExtent), bar_index)
            extentSell = na(rightVisibleBarIndex) ? nz(sellSignalRightExtent) : math.min(nz(sellSignalRightExtent), rightVisibleBarIndex)
            f_extendSellSignalDrawings(sellSLLine, sellTPLine, sellEntryLine, sellRiskZone, sellRewardZone, sellEntryZone, sellSLLabel, sellTPLabel, sellEntryLabel, not na(sellEntryZone), extentSell, sellTP2Line, sellTP2Label, sellRewardZone2)
else
    if not na(buySignalBarIndex)
        buySignalRightExtent := math.max(nz(buySignalRightExtent), bar_index)
        extentBuy = na(rightVisibleBarIndex) ? nz(buySignalRightExtent) : math.min(nz(buySignalRightExtent), rightVisibleBarIndex)
        f_extendBuySignalDrawings(buySLLine, buyTPLine, buyEntryLine, buyRiskZone, buyRewardZone, buyEntryZone, buySLLabel, buyTPLabel, buyEntryLabel, not na(buyEntryZone), extentBuy, buyTP2Line, buyTP2Label, buyRewardZone2)
    if not na(sellSignalBarIndex)
        sellSignalRightExtent := math.max(nz(sellSignalRightExtent), bar_index)
        extentSell = na(rightVisibleBarIndex) ? nz(sellSignalRightExtent) : math.min(nz(sellSignalRightExtent), rightVisibleBarIndex)
        f_extendSellSignalDrawings(sellSLLine, sellTPLine, sellEntryLine, sellRiskZone, sellRewardZone, sellEntryZone, sellSLLabel, sellTPLabel, sellEntryLabel, not na(sellEntryZone), extentSell, sellTP2Line, sellTP2Label, sellRewardZone2)

if signalBuy
    buySLSource = structSLBuyOk ? "[Swing]" : structSLBuyOk2 ? "[SwingMomentum]" : "[ATR]"
    buyTooltip = f_signalTooltip(true, buySLSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount)

    if USE_PREVIOUS_SIGNALS
        [grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder] = f_prevSignalGrayColors(PREVIOUS_SELL_RR)
        f_applyGrayToAllSignals(grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
    else
        f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
        f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
        buyEntryLine := na
        buyEntryLabel := na
        buyEntryZone := na
        buyZoneLabel := na
        buySLLine := na
        buyTPLine := na
        buySLLabel := na
        buyTPLabel := na
        buyRiskZone := na
        buyRewardZone := na
        buyTP2Line := na
        buyTP2Label := na
        buyRewardZone2 := na
        sellEntryLine := na
        sellEntryLabel := na
        sellEntryZone := na
        sellZoneLabel := na
        sellSLLine := na
        sellTPLine := na
        sellSLLabel := na
        sellTPLabel := na
        sellRiskZone := na
        sellRewardZone := na
        sellTP2Line := na
        sellTP2Label := na
        sellRewardZone2 := na
    entryZoneMult = finalBuyScore >= 80 ? 0.5 : finalBuyScore >= 65 ? 0.7 : 0.9
    zoneHalfH = atrPrev * entryZoneMult
    bodyLow = math.min(open, close)
    buyZoneLow = math.max(bodyLow - zoneHalfH * 0.3, buySL)
    buyZoneHigh = bodyLow + zoneHalfH
    buyZoneBorder = finalBuyScore >= 80 ? color.new(POSITIVE_COLOR, 35) : color.new(color.new(POSITIVE_COLOR, 45), 50)
    buyZoneLabel := label.new(bar_index, buyZoneLow - atr * 0.15, "▲", style=label.style_label_up, color=buyZoneBorder, textcolor=color.white, size=size.small, tooltip=buyTooltip)

    buyEntryPrice = (buyZoneHigh + buyZoneLow) / 2
    if vwapValue >= buyZoneLow and vwapValue <= buyZoneHigh
        buyEntryPrice := vwapValue
    else if fib50 >= buyZoneLow and fib50 <= buyZoneHigh
        buyEntryPrice := fib50
    else if not na(lastBullOBHigh) and lastBullOBHigh >= buyZoneLow and lastBullOBHigh <= buyZoneHigh
        buyEntryPrice := lastBullOBHigh
    // --- Store signal tracking info ---
    buySignalBarIndex := bar_index
    buySignalRightExtent := bar_index
    buySignalTP := buyTP
    buySignalSL := buySL

    if USE_BUY_SELL_SLTP_ENTRY and SLTP_DISPLAY_MODE == "Zones"
        buyEntryZone := box.new(bar_index, buyZoneHigh, bar_index, buyZoneLow, border_color=color.new(ACCENT_COLOR, 40), bgcolor=color.new(ACCENT_COLOR, 85), border_width=1)
        buyEntryLabel := label.new(bar_index, buyEntryPrice, "ENTRY " + str.tostring(buyEntryPrice, "#.##"), style=label.style_label_center, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny, tooltip="ENTRY " + str.tostring(buyEntryPrice, "#.##"))
        buyEntryLine := na
    else
        buyEntryZone := na
        buyEntryLine := line.new(bar_index, buyEntryPrice, bar_index, buyEntryPrice, color=color.new(ACCENT_COLOR, 15), style=line.style_solid, width=2)
        buyEntryLabel := label.new(bar_index, buyEntryPrice, "ENTRY " + str.tostring(buyEntryPrice, "#.##"), style=label.style_label_left, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny)

    if USE_BUY_SELL_SLTP_ENTRY
        if SLTP_DISPLAY_MODE == "Zones"
            buyRiskZone := box.new(bar_index, buyZoneLow, bar_index, buySL, border_color=color.new(NEGATIVE_COLOR, 40), bgcolor=color.new(NEGATIVE_COLOR, 85), border_width=1)
            if USE_TWO_T_PS_BUY
                buyRewardZone := box.new(bar_index, buyTP1, bar_index, buyZoneHigh, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 65), border_width=1)
                buyRewardZone2 := box.new(bar_index, buyTP2, bar_index, buyTP1, border_color=color.new(POSITIVE_COLOR, 25), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
            else
                buyRewardZone := box.new(bar_index, buyTP, bar_index, buyZoneHigh, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
        buySLLine := line.new(bar_index, buySL, bar_index, buySL, color=color.new(NEGATIVE_COLOR, 25), style=line.style_dashed, width=2)
        buySLLabel := label.new(bar_index, buySL, "SL " + str.tostring(buySL, "#.##") + " (" + str.tostring((buySL - close) / close * 100, "#.#") + "%)", style=label.style_label_left, color=color.new(NEGATIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
        if USE_TWO_T_PS_BUY
            buyTPLine := line.new(bar_index, buyTP1, bar_index, buyTP1, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            buyTPLabel := label.new(bar_index, buyTP1, "TP1 " + str.tostring(buyTP1, "#.##") + " (" + str.tostring((buyTP1 - close) / close * 100, "#.#") + "%) " + buyTPSource, style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
            buyTP2Line := line.new(bar_index, buyTP2, bar_index, buyTP2, color=color.new(POSITIVE_COLOR, 20), style=line.style_dashed, width=1)
            buyTP2Label := label.new(bar_index, buyTP2, "TP2 " + str.tostring(buyTP2, "#.##") + " (" + str.tostring((buyTP2 - close) / close * 100, "#.#") + "%) (1:" + str.tostring(buyActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 40), textcolor=color.white, size=size.tiny)
        else
            buyTPLine := line.new(bar_index, buyTP, bar_index, buyTP, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            buyTPLabel := label.new(bar_index, buyTP, "TP " + str.tostring(buyTP, "#.##") + " (" + str.tostring((buyTP - close) / close * 100, "#.#") + "%) " + buyTPSource + " (1:" + str.tostring(buyActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)

    activeRR := buyActualRR
    activeSLType := structSLBuyOk ? "Swing" : structSLBuyOk2 ? "SwingMomentum" : "ATR"
    activeTP := buyTP
    activeSL := buySL

if signalSell
    sellSLSource = structSLSellOk ? "[Swing]" : structSLSellOk2 ? "[SwingMomentum]" : "[ATR]"
    sellTooltip = f_signalTooltip(false, sellSLSource, finalBuyScore, finalSellScore, buyConfidence, sellConfidence, buyDominance, sellDominance, dominanceRatioBuy, dominanceRatioSell, exhBuyScore, exhSellScore, revBuyScore, revSellScore, structBuyScore, structSellScore, volBuyScore, volSellScore, trendAlignBuyScore, trendAlignSellScore, buyCatAgreeStrong, sellCatAgreeStrong, buyCatAgree, sellCatAgree, buySL, sellSL, buyTP, sellTP, buyActualRR, sellActualRR, buyTPSource, sellTPSource, bullishDivergence, bearishDivergence, USE_TWO_T_PS_BUY, USE_TWO_T_PS_SELL, buyTP1, sellTP1, buyTP2, sellTP2, inPremium, inDiscount, rSqValue, r2Reversal, r2Trend, zScore, hvRank, volSpikeMult, lagBuyCount, lagSellCount, lagEnabledCount)

    if USE_PREVIOUS_SIGNALS
        [grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder] = f_prevSignalGrayColors(PREVIOUS_SELL_RR)
        f_applyGrayToAllSignals(grayLine, grayLabel, grayTxt, grayBox, grayBoxBorder, grayEntryLine, grayEntryLabel, grayEntryTxt, grayEntryBox, grayEntryBoxBorder, buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2, sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
    else
        f_deleteBuySignalDrawings(buyEntryLine, buyEntryLabel, buyEntryZone, buyZoneLabel, buySLLine, buyTPLine, buySLLabel, buyTPLabel, buyRiskZone, buyRewardZone, buyTP2Line, buyTP2Label, buyRewardZone2)
        f_deleteSellSignalDrawings(sellEntryLine, sellEntryLabel, sellEntryZone, sellZoneLabel, sellSLLine, sellTPLine, sellSLLabel, sellTPLabel, sellRiskZone, sellRewardZone, sellTP2Line, sellTP2Label, sellRewardZone2)
        buyEntryLine := na
        buyEntryLabel := na
        buyEntryZone := na
        buyZoneLabel := na
        buySLLine := na
        buyTPLine := na
        buySLLabel := na
        buyTPLabel := na
        buyRiskZone := na
        buyRewardZone := na
        sellEntryLine := na
        sellEntryLabel := na
        sellEntryZone := na
        sellZoneLabel := na
        sellSLLine := na
        sellTPLine := na
        sellSLLabel := na
        sellTPLabel := na
        sellRiskZone := na
        sellRewardZone := na
        sellTP2Line := na
        sellTP2Label := na
        sellRewardZone2 := na

    sellEntryZoneMult = finalSellScore >= 80 ? 0.5 : finalSellScore >= 65 ? 0.7 : 0.9
    sellZoneHalfH = atrPrev * sellEntryZoneMult
    bodyHigh = math.max(open, close)
    sellZoneHigh = math.min(bodyHigh + sellZoneHalfH * 0.3, sellSL)
    sellZoneLow = bodyHigh - sellZoneHalfH
    sellZoneBorder = finalSellScore >= 80 ? color.new(NEGATIVE_COLOR, 35) : color.new(color.new(NEGATIVE_COLOR, 45), 50)
    sellZoneLabel := label.new(bar_index, sellZoneHigh + atr * 0.15, "▼", style=label.style_label_down, color=sellZoneBorder, textcolor=color.white, size=size.small, tooltip=sellTooltip)

    sellEntryPrice = (sellZoneHigh + sellZoneLow) / 2
    if vwapValue >= sellZoneLow and vwapValue <= sellZoneHigh
        sellEntryPrice := vwapValue
    else if fib50 >= sellZoneLow and fib50 <= sellZoneHigh
        sellEntryPrice := fib50
    else if not na(lastBearOBLow) and lastBearOBLow >= sellZoneLow and lastBearOBLow <= sellZoneHigh
        sellEntryPrice := lastBearOBLow
    sellSignalBarIndex := bar_index
    sellSignalRightExtent := bar_index
    sellSignalTP := sellTP
    sellSignalSL := sellSL

    if USE_BUY_SELL_SLTP_ENTRY and SLTP_DISPLAY_MODE == "Zones"
        sellEntryZone := box.new(bar_index, sellZoneHigh, bar_index, sellZoneLow, border_color=color.new(ACCENT_COLOR, 40), bgcolor=color.new(ACCENT_COLOR, 85), border_width=1)
        sellEntryLabel := label.new(bar_index, sellEntryPrice, "ENTRY " + str.tostring(sellEntryPrice, "#.##"), style=label.style_label_center, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny, tooltip="ENTRY " + str.tostring(sellEntryPrice, "#.##"))
        sellEntryLine := na
    else
        sellEntryZone := na
        sellEntryLine := line.new(bar_index, sellEntryPrice, bar_index, sellEntryPrice, color=color.new(ACCENT_COLOR, 15), style=line.style_solid, width=2)
        sellEntryLabel := label.new(bar_index, sellEntryPrice, "ENTRY " + str.tostring(sellEntryPrice, "#.##"), style=label.style_label_left, color=color.new(ACCENT_COLOR, 35), textcolor=color.white, size=size.tiny)

    if USE_BUY_SELL_SLTP_ENTRY
        if SLTP_DISPLAY_MODE == "Zones"
            if USE_TWO_T_PS_SELL
                sellRewardZone := box.new(bar_index, sellZoneLow, bar_index, sellTP1, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 75), border_width=1)
                sellRewardZone2 := box.new(bar_index, sellTP1, bar_index, sellTP2, border_color=color.new(POSITIVE_COLOR, 25), bgcolor=color.new(POSITIVE_COLOR, 50), border_width=1)
            else
                sellRewardZone := box.new(bar_index, sellZoneLow, bar_index, sellTP, border_color=color.new(POSITIVE_COLOR, 40), bgcolor=color.new(POSITIVE_COLOR, 85), border_width=1)
            sellRiskZone := box.new(bar_index, sellSL, bar_index, sellZoneHigh, border_color=color.new(NEGATIVE_COLOR, 40), bgcolor=color.new(NEGATIVE_COLOR, 85), border_width=1)
        sellSLLine := line.new(bar_index, sellSL, bar_index, sellSL, color=color.new(NEGATIVE_COLOR, 25), style=line.style_dashed, width=2)
        sellSLLabel := label.new(bar_index, sellSL, "SL " + str.tostring(sellSL, "#.##") + " (" + str.tostring((sellSL - close) / close * 100, "#.#") + "%)", style=label.style_label_left, color=color.new(NEGATIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
        if USE_TWO_T_PS_SELL
            sellTPLine := line.new(bar_index, sellTP1, bar_index, sellTP1, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            sellTPLabel := label.new(bar_index, sellTP1, "TP1 " + str.tostring(sellTP1, "#.##") + " (" + str.tostring((sellTP1 - close) / close * 100, "#.#") + "%) " + sellTPSource, style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)
            sellTP2Line := line.new(bar_index, sellTP2, bar_index, sellTP2, color=color.new(POSITIVE_COLOR, 20), style=line.style_dashed, width=1)
            sellTP2Label := label.new(bar_index, sellTP2, "TP2 " + str.tostring(sellTP2, "#.##") + " (" + str.tostring((sellTP2 - close) / close * 100, "#.#") + "%) (1:" + str.tostring(sellActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 40), textcolor=color.white, size=size.tiny)
        else
            sellTPLine := line.new(bar_index, sellTP, bar_index, sellTP, color=color.new(POSITIVE_COLOR, 25), style=line.style_dashed, width=1)
            sellTPLabel := label.new(bar_index, sellTP, "TP " + str.tostring(sellTP, "#.##") + " (" + str.tostring((sellTP - close) / close * 100, "#.#") + "%) " + sellTPSource + " (1:" + str.tostring(sellActualRR, "#.#") + ")", style=label.style_label_left, color=color.new(POSITIVE_COLOR, 45), textcolor=color.white, size=size.tiny)

    activeRR := sellActualRR
    activeSLType := structSLSellOk ? "Swing" : structSLSellOk2 ? "SwingMomentum" : "ATR"
    activeTP := sellTP
    activeSL := sellSL

