    table.cell(dash, 0, 40, "HV Rank", bgcolor=f_rowBg(40), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 40, str.tostring(hvRank[1], "#") + "%", bgcolor=hvLow ? color.new(color.new(POSITIVE_COLOR, 45), 50) : hvHigh ? color.new(WARNING_COLOR, 50) : f_condColor(true), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 40, "Wyckoff", bgcolor=f_rowBg(40), text_color=TEXT_COLOR, text_size=txtSm)
