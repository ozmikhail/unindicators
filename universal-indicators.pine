//@version=6
indicator("Universal Indicators", overlay=true, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_polylines_count=100, explicit_plot_zorder=true)

// Rightmost visible bar: when true, dashboard and floating drawings (pivots, fib, S/R, Donchian) redraw so they adapt on scroll/zoom
isRightVisibleBar = (time == chart.right_visible_bar_time) or barstate.islast
var int rightVisibleBarIndex = na
if isRightVisibleBar
    rightVisibleBarIndex := bar_index

// ==================================================================================
// INPUT PARAMETERS
// ==================================================================================

// --- Automatic Constants ---
TF_SEC           = timeframe.in_seconds(timeframe.period)
HTF_TIMEFRAME    = TF_SEC >= 604800 ? "M" : TF_SEC >= 86400 ? "W" : "D"
PIVOT_TIMEFRAME  = HTF_TIMEFRAME
SESSION_STR      = syminfo.timezone == "America/New_York" ? "0930-1600" : syminfo.timezone == "Europe/London" ? "0800-1630" : "0800-1700"
BENCHMARK_SYMBOL = syminfo.currency == "USD" ? "SPY" : syminfo.currency == "EUR" ? "STOXX50E" : "SPY"

// --- Group 1: Display & UI ---
var gDisplay        = "Display Indicators"
USE_DASHBOARD       = input.bool(true, "Display Dashboard", group=gDisplay)
USE_HULL_MA         = input.bool(false, "Display Hull MA", group=gDisplay)
USE_VWAP_LINE       = input.bool(true, "Display VWAP Line", group=gDisplay)
