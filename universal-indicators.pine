donchClr    = color.rgb(77, 208, 225)           // Cyan — Donchian
emaFastClr  = color.rgb(255, 183, 77)           // Light amber — Fast MA (see MA Alignment lengths)
emaMidClr   = color.rgb(255, 138, 50)           // Deeper amber — Slow MA
emaSlowClr  = color.rgb(215, 100, 30)           // Dark amber — Slower MA
