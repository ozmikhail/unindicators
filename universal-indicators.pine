    table.cell(dash, 2, 25, "CMF", bgcolor=f_rowBg(25), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 25, str.tostring(cmfValue[1], "#.##"), bgcolor=f_condColor(cmfBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 25, f_condSym(obvBullish and cmfBullish), bgcolor=f_condColor(obvBullish and cmfBullish), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 26, "A/D", bgcolor=f_rowBg(26), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 26, adLineBullish ? ">MA" : "<MA", bgcolor=f_condColor(adLineBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 26, "PVT", bgcolor=f_rowBg(26), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 26, pvtBullish ? ">MA" : "<MA", bgcolor=f_condColor(pvtBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 26, f_condSym(adLineBullish and pvtBullish), bgcolor=f_condColor(adLineBullish and pvtBullish), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 27, "VolTrend", bgcolor=f_rowBg(27), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 27, volumeRising ? "Rising" : "Flat", bgcolor=f_condColor(volumeRising), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 27, "B/S Pres", bgcolor=f_rowBg(27), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 27, str.tostring(pressureRatio[1] * 100, "#") + "%", bgcolor=f_condColor3(pressureRatio[1] > 0.55, pressureRatio[1] < 0.45), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 27, f_condSym(volumeRising and pressureBullish), bgcolor=f_condColor(volumeRising and pressureBullish), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 28, "Klinger", bgcolor=f_rowBg(28), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 28, klingerBullish ? ">Sig" : "<Sig", bgcolor=f_condColor(klingerBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 28, "EOM", bgcolor=f_rowBg(28), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 28, str.tostring(eomValue[1], "#.##"), bgcolor=f_condColor(eomBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 28, f_condSym(klingerBullish and eomBullish), bgcolor=f_condColor(klingerBullish and eomBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 0, 29, "NVI", bgcolor=f_rowBg(29), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 29, nviBullish ? ">MA" : "<MA", bgcolor=f_condColor(nviBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 29, "PVI", bgcolor=f_rowBg(29), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 3, 29, pviBullish ? ">MA" : "<MA", bgcolor=f_condColor(pviBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 29, f_condSym(nviBullish and pviBullish), bgcolor=f_condColor(nviBullish and pviBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 0, 30, "III", bgcolor=f_rowBg(30), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 30, iiiBullish ? ">0" : "<0", bgcolor=f_condColor(iiiBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 30, "MFI(BW)", bgcolor=f_rowBg(30), text_color=TEXT_COLOR, text_size=txtSm)
