    table.cell(dash, 1, 24, str.tostring(volume[1] / math.max(volumeMA[1], 1), "#.#") + "x", bgcolor=f_condColor(volumeConfirm), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 24, "VWAP", bgcolor=f_rowBg(24), text_color=TEXT_COLOR, text_size=txtSm)
