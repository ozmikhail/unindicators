    table.cell(dash, 3, 12, str.tostring(stochKVal[1], "#") + "/" + str.tostring(stochDVal[1], "#"), bgcolor=f_condColor(stochBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 12, f_condSym(rsiBullish and stochBullish), bgcolor=f_condColor(rsiBullish and stochBullish), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 13, "MACD", bgcolor=f_rowBg(13), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 13, macdBullish ? ">Sig" : "<Sig", bgcolor=f_condColor(macdBullish), text_color=TEXT_COLOR, text_size=txtSm)
