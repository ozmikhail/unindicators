    table.cell(dash, 0, 22, "Elder Imp", bgcolor=f_rowBg(22), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 22, elderImpulseBull ? "Bull" : elderImpulseBear ? "Bear" : "Neutral", bgcolor=f_condColor3(elderImpulseBull, elderImpulseBear), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 22, "VW-RSI", bgcolor=f_rowBg(22), text_color=TEXT_COLOR, text_size=txtSm)
