    table.cell(dash, 3, 38, str.tostring(htfRsiPrev, "#.#"), bgcolor=f_condColor3(htfRsiPrev >= 40 and htfRsiPrev <= 70, false), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 4, 38, f_condSym(premiumDiscountOkBuy and htfRsiOkBuy), bgcolor=f_condColor(premiumDiscountOkBuy and htfRsiOkBuy), text_color=TEXT_COLOR, text_size=txtSm)

    table.cell(dash, 0, 39, "RelStr", bgcolor=f_rowBg(39), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 39, rsBullish ? ">Bench" : "<Bench", bgcolor=f_condColor(rsBullish), text_color=TEXT_COLOR, text_size=txtSm)
