    table.cell(dash, 4, 30, f_condSym(iiiBullish and mfiBWBullish), bgcolor=f_condColor(iiiBullish and mfiBWBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 0, 31, "Twiggs MF", bgcolor=f_rowBg(31), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 1, 31, twiggsBullish ? ">0" : "<0", bgcolor=f_condColor(twiggsBullish), text_color=TEXT_COLOR, text_size=txtSm)
    table.cell(dash, 2, 31, "", bgcolor=f_rowBg(31))
    table.cell(dash, 3, 31, "", bgcolor=f_rowBg(31))
    table.cell(dash, 4, 31, "", bgcolor=f_rowBg(31))

    // --- Table Section 5: VOLATILITY ---
    table.cell(dash, 0, 32, " VOLATILITY", bgcolor=color.new(color.rgb(255, 177, 66), 30), text_color=color.white, text_size=txtSm, text_font_family=font.family_monospace, text_halign=text.align_left)
